@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<div class="app-layout">

    <Sidebar />

    <div class="main-area">

        <header class="topbar">

            <!-- MOBILE MENU -->

            <button type="button"
                    class="mobile-menu-button"
                    aria-label="Menü öffnen"
                    onclick="warehouseToggleSidebar()">
                ☰
            </button>


            <!-- HEADER RIGHT -->

            <div class="topbar-actions">

                <!-- SPRACHEN -->

                <div class="language-switcher">

                    <button type="button"
                            class="language-button active"
                            title="Deutsch">

                        <span class="language-flag">🇩🇪</span>
                        <span class="language-name">Deutsch</span>

                    </button>

                    <button type="button"
                            class="language-button"
                            title="Mazedonisch">

                        <span class="language-flag">🇲🇰</span>
                        <span class="language-name">Македонски</span>

                    </button>

                    <button type="button"
                            class="language-button"
                            title="Kroatisch">

                        <span class="language-flag">🇭🇷</span>
                        <span class="language-name">Hrvatski</span>

                    </button>

                </div>


                <!-- ABMELDEN -->

                <AuthorizeView>

                    <Authorized>

                        <form action="/Account/Logout"
                              method="post"
                              class="logout-form">

                            <AntiforgeryToken />

                            <input type="hidden"
                                   name="returnUrl"
                                   value="/" />

                            <button type="submit"
                                    class="logout-button">

                                <span class="logout-icon">↪</span>
                                <span>Abmelden</span>

                            </button>

                        </form>

                    </Authorized>

                </AuthorizeView>

            </div>

        </header>


        <main class="content-area">

            @Body

        </main>

    </div>

</div>


<div id="blazor-error-ui"
     data-nosnippet>

    An unhandled error has occurred.

    <a href="."
       class="reload">
        Reload
    </a>

    <span class="dismiss">
        🗙
    </span>

</div>