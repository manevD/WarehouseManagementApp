@inherits LayoutComponentBase

<div class="app-layout">

    <Sidebar />

    <div class="main-area">

        <header class="topbar">

            <button type="button"
                    class="mobile-menu-button"
                    aria-label="Menü öffnen"
                    onclick="warehouseToggleSidebar()">
                ☰
            </button>

        </header>

        <main class="content-area">
            @Body
        </main>

    </div>

</div>

<div id="blazor-error-ui"
     data-nosnippet>

    An unhandled error has occurred.

    <a href="." class="reload">
        Reload
    </a>

    <span class="dismiss">
        🗙
    </span>

</div>