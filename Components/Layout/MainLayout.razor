@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation

<div class="app-layout">

    <Sidebar />

    <div class="main-area">

        <header class="topbar">

            <!-- MOBILE MENU -->

            <button type="button"
                    class="mobile-menu-button"
                    aria-label="Menü öffnen"
                    onclick="warehouseToggleSidebar()">
                ☰
            </button>


            <!-- HEADER RIGHT -->

            <div class="topbar-actions">

                <!-- SPRACHEN -->

                <div class="language-switcher">

                    <!-- DEUTSCH -->

                    <form action="/Account/SetLanguage"
                          method="post">

                        <AntiforgeryToken />

                        <input type="hidden"
                               name="culture"
                               value="de" />

                        <input type="hidden"
                               name="returnUrl"
                               value="@GetReturnUrl()" />

                        <button type="submit"
                                class="language-button @(IsCurrentCulture("de") ? "active" : "")"
                                title="Deutsch">

                            <span class="language-flag">
                                🇩🇪
                            </span>

                            <span class="language-name">
                                Deutsch
                            </span>

                        </button>

                    </form>


                    <!-- MAKEDONISCH -->

                    <form action="/Account/SetLanguage"
                          method="post">

                        <AntiforgeryToken />

                        <input type="hidden"
                               name="culture"
                               value="mk" />

                        <input type="hidden"
                               name="returnUrl"
                               value="@GetReturnUrl()" />

                        <button type="submit"
                                class="language-button @(IsCurrentCulture("mk") ? "active" : "")"
                                title="Mazedonisch">

                            <span class="language-flag">
                                🇲🇰
                            </span>

                            <span class="language-name">
                                Македонски
                            </span>

                        </button>

                    </form>


                    <!-- KROATISCH -->

                    <form action="/Account/SetLanguage"
                          method="post">

                        <AntiforgeryToken />

                        <input type="hidden"
                               name="culture"
                               value="hr" />

                        <input type="hidden"
                               name="returnUrl"
                               value="@GetReturnUrl()" />

                        <button type="submit"
                                class="language-button @(IsCurrentCulture("hr") ? "active" : "")"
                                title="Kroatisch">

                            <span class="language-flag">
                                🇭🇷
                            </span>

                            <span class="language-name">
                                Hrvatski
                            </span>

                        </button>

                    </form>


                    <!-- ENGLISH -->

                    <form action="/Account/SetLanguage"
                          method="post">

                        <AntiforgeryToken />

                        <input type="hidden"
                               name="culture"
                               value="en" />

                        <input type="hidden"
                               name="returnUrl"
                               value="@GetReturnUrl()" />

                        <button type="submit"
                                class="language-button @(IsCurrentCulture("en") ? "active" : "")"
                                title="English">

                            <span class="language-flag">
                                🇬🇧
                            </span>

                            <span class="language-name">
                                English
                            </span>

                        </button>

                    </form>

                </div>


                <!-- ABMELDEN -->

                <AuthorizeView>

                    <Authorized>

                        <form action="/Account/Logout"
                              method="post"
                              class="logout-form">

                            <AntiforgeryToken />

                            <input type="hidden"
                                   name="returnUrl"
                                   value="/" />

                            <button type="submit"
                                    class="logout-button">

                                <span class="logout-icon">
                                    ↪
                                </span>

                                <span>
                                    Abmelden
                                </span>

                            </button>

                        </form>

                    </Authorized>

                </AuthorizeView>

            </div>

        </header>


        <main class="content-area">

            @Body

        </main>

    </div>

</div>


<div id="blazor-error-ui"
     data-nosnippet>

    An unhandled error has occurred.

    <a href="."
       class="reload">
        Reload
    </a>

    <span class="dismiss">
        🗙
    </span>

</div>


@code {

    private string GetReturnUrl()
    {
        var uri = new Uri(Navigation.Uri);

        var returnUrl =
            uri.PathAndQuery;

        if (string.IsNullOrWhiteSpace(returnUrl))
        {
            return "/";
        }

        return returnUrl;
    }


    private bool IsCurrentCulture(
        string culture)
    {
        return
            System.Globalization
                .CultureInfo
                .CurrentUICulture
                .Name
                .StartsWith(
                    culture,
                    StringComparison.OrdinalIgnoreCase);
    }
}