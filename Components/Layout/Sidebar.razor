@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@using WarehouseManagement.Data
@using WarehouseManagement.Localization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResource> L

@rendermode InteractiveServer

<aside class="sidebar">

    <button type="button"
            class="sidebar-close-button"
            aria-label="@L["CloseMenu"]"
            title="@L["CloseMenu"]"
            onclick="warehouseCloseSidebar()">
        ×
    </button>


    <div class="sidebar-brand">
        <div class="brand-logo">
            <img class="brand-logo-image" src="/images/wm-logo-premium.webp" />
        </div>
    </div>


    <nav class="sidebar-nav">

        <!-- ÜBERSICHT -->

        <div class="nav-section">
            @L["Overview"]
        </div>

        <NavLink href="/dashboard"
                 Match="NavLinkMatch.All"
                 class="nav-item">

            <span class="nav-icon">⌂</span>
            <span>@L["Dashboard"]</span>

        </NavLink>


        <!-- LAGER -->

        <div class="nav-section">
            @L["WarehouseSection"]
        </div>

        <NavLink href="/products" class="nav-item">

            <span class="nav-icon">▦</span>
            <span>@L["Products"]</span>

        </NavLink>

        <NavLink href="/categories" class="nav-item">

            <span class="nav-icon">▤</span>
            <span>@L["Categories"]</span>

        </NavLink>

        <NavLink href="/warehouses" class="nav-item">

            <span class="nav-icon">▥</span>
            <span>@L["Warehouses"]</span>

        </NavLink>

        <NavLink href="/locations" class="nav-item">

            <span class="nav-icon">⌖</span>
            <span>@L["StorageLocations"]</span>

        </NavLink>


        <!-- BESTAND -->

        <div class="nav-section">
            @L["StockSection"]
        </div>

        <NavLink href="/stock" class="nav-item">

            <span class="nav-icon">▣</span>
            <span>@L["Stock"]</span>

        </NavLink>

        <NavLink href="/stock/incoming" class="nav-item">

            <span class="nav-icon">↓</span>
            <span>@L["IncomingGoods"]</span>

        </NavLink>

        <NavLink href="/stock/outgoing" class="nav-item">

            <span class="nav-icon">↑</span>
            <span>@L["OutgoingGoods"]</span>

        </NavLink>

        <NavLink href="/stock/transfer" class="nav-item">

            <span class="nav-icon">↔</span>
            <span>@L["Transfers"]</span>

        </NavLink>

        <NavLink href="/stock/movements" class="nav-item">

            <span class="nav-icon">↕</span>
            <span>@L["Movements"]</span>

        </NavLink>
        @if (isLagerMitarbeiter || isAdmin)
        {

            <!-- VERWALTUNG -->
            <div class="nav-section">
                @L["Administration"]
            </div>

            <NavLink href="/suppliers" class="nav-item">

                <span class="nav-icon">♙</span>
                <span>@L["Suppliers"]</span>

            </NavLink>

            <NavLink href="/customers" class="nav-item">

                <span class="nav-icon">♙</span>
                <span>@L["Customers"]</span>

            </NavLink>

            <NavLink href="/orders" class="nav-item">

                <span class="nav-icon">☷</span>
                <span>@L["Orders"]</span>

            </NavLink>

            <NavLink href="/purchase-orders" class="nav-item">

                <span class="nav-icon">☷</span>
                <span>@L["SupplierOrders"]</span>

            </NavLink>
        }

   

        <!-- ANALYSE -->

        <div class="nav-section">
            @L["Analysis"]
        </div>

        <NavLink href="/inventory" class="nav-item">

            <span class="nav-icon">✓</span>
            <span>@L["Inventory"]</span>

        </NavLink>

        <NavLink href="/reports" class="nav-item">

            <span class="nav-icon">▥</span>
            <span>@L["Reports"]</span>

        </NavLink>


        <!-- EINSTELLUNGEN -->

        <div class="nav-section">
            @L["Settings"]
        </div>

        <button type="button"
                class="nav-item settings-title"
                @onclick="ToggleSettings">

            <span class="nav-icon">⚙</span>

            <span>@L["Settings"]</span>

            <span class="settings-arrow @(SettingsOpen ? "open" : "")">
                ▼
            </span>

        </button>


        @if (SettingsOpen)
        {
            <div class="settings-submenu">

                <NavLink href="/Account/Manage"
                         Match="NavLinkMatch.All"
                         class="nav-item">

                    <span class="nav-icon">•</span>
                    <span>@L["Profile"]</span>

                </NavLink>


                <NavLink href="/Account/Manage/PersonalData"
                         class="nav-item">

                    <span class="nav-icon">•</span>
                    <span>@L["PersonalData"]</span>

                </NavLink>
                @if (isAdmin)
                {
                    <NavLink href="/users" class="nav-item">
                        <span class="nav-icon">•</span>
                        <span>@L["UserManagement"]</span>

                    </NavLink>


                    <NavLink href="/roles"
                             class="nav-item">

                        <span class="nav-icon">•</span>
                        <span>@L["RoleManagement"]</span>

                    </NavLink>

                }
            </div>
        }

    </nav>

</aside>


@code {
    private bool isAdmin;
    private bool isLagerMitarbeiter;
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAdmin = authState.User.IsInRole("Admin");
        isLagerMitarbeiter = authState.User.IsInRole("Warehouse Manager");
    }
    private bool SettingsOpen = false;


    private void ToggleSettings()
    {
        SettingsOpen = !SettingsOpen;
    }

}