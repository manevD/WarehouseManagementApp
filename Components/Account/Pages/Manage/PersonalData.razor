@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using WarehouseManagement.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager


<PageTitle>Persönliche Daten</PageTitle>


<div class="personal-data-page">


    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="personal-data-header">

        <h1>
            Persönliche Daten
        </h1>

        <p>
            Verwalten Sie die persönlichen Daten Ihres Kontos.
        </p>

    </div>


    <!-- =========================================================
         STATUS
         ========================================================= -->

    <div class="personal-data-status">

        <StatusMessage />

    </div>


    <!-- =========================================================
         CARD
         ========================================================= -->

    <div class="personal-data-card">


        <div class="personal-data-card-title">

            <h2>
                Ihre persönlichen Daten
            </h2>

            <span>
                Sie können Ihre gespeicherten Daten herunterladen oder Ihr Konto löschen.
            </span>

        </div>


        <!-- =====================================================
             INFORMATION
             ===================================================== -->

        <div class="personal-data-text">

            Ihr Konto enthält persönliche Daten, die Sie uns zur Verfügung
            gestellt haben. Auf dieser Seite können Sie diese Daten
            herunterladen oder Ihr Konto löschen.

        </div>


        <!-- =====================================================
             WARNING
             ===================================================== -->

        <div class="personal-data-warning">

            <strong>
                Achtung:
            </strong>

            Das Löschen dieser Daten entfernt Ihr Konto dauerhaft.
            Dieser Vorgang kann nicht rückgängig gemacht werden.

        </div>


        <!-- =====================================================
             ACTIONS
             ===================================================== -->

        <div class="personal-data-actions">


            <!-- DOWNLOAD -->

            <form action="Account/Manage/DownloadPersonalData"
                  method="post">

                <AntiforgeryToken />

                <button class="personal-data-download"
                        type="submit">

                    Daten herunterladen

                </button>

            </form>


            <!-- DELETE -->

            <a href="Account/Manage/DeletePersonalData"
               class="personal-data-delete">

                Konto löschen

            </a>


        </div>

    </div>

</div>


@code {

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;


    protected override async Task OnInitializedAsync()
    {

        var user =
            await UserManager.GetUserAsync(
                HttpContext.User);


        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(
                UserManager,
                HttpContext);

            return;
        }

    }

}