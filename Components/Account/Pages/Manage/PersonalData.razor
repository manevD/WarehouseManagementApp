@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@using WarehouseManagement.Data
@using WarehouseManagement.Localization

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject IStringLocalizer<SharedResource> L


<PageTitle>@L["PersonalData"]</PageTitle>


<div class="personal-data-page">


    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="personal-data-header">

        <h1>
            @L["PersonalData"]
        </h1>

        <p>
            @L["ManagePersonalDataDescription"]
        </p>

    </div>


    <!-- =========================================================
         STATUS
         ========================================================= -->

    <div class="personal-data-status">

        <StatusMessage />

    </div>


    <!-- =========================================================
         CARD
         ========================================================= -->

    <div class="personal-data-card">


        <div class="personal-data-card-title">

            <h2>
                @L["YourPersonalData"]
            </h2>

            <span>
                @L["PersonalDataActionsDescription"]
            </span>

        </div>


        <!-- =====================================================
             INFORMATION
             ===================================================== -->

        <div class="personal-data-text">

            @L["PersonalDataInformation"]

        </div>


        <!-- =====================================================
             WARNING
             ===================================================== -->

        <div class="personal-data-warning">

            <strong>
                @L["Warning"]
            </strong>

            @L["DeleteAccountWarning"]

        </div>


        <!-- =====================================================
             ACTIONS
             ===================================================== -->

        <div class="personal-data-actions">


            <!-- DOWNLOAD -->

            <form action="Account/Manage/DownloadPersonalData"
                  method="post">

                <AntiforgeryToken />

                <button class="personal-data-download"
                        type="submit">

                    @L["DownloadPersonalData"]

                </button>

            </form>


            <!-- DELETE -->

            <a href="Account/Manage/DeletePersonalData"
               class="personal-data-delete">

                @L["DeleteAccount"]

            </a>


        </div>

    </div>

</div>


@code {

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;


    protected override async Task OnInitializedAsync()
    {

        var user =
            await UserManager.GetUserAsync(
                HttpContext.User);


        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(
                UserManager,
                HttpContext);

            return;
        }

    }

}