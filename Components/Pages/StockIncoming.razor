@page "/stock/incoming"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using WarehouseManagement.Data
@using WarehouseManagement.Localization
@using WarehouseManagement.Models

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["IncomingGoods"]</PageTitle>

<div class="product-form-page">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="page-header">

        <div>

            <h1>@L["IncomingGoods"]</h1>

            <p>
                @L["IncomingGoodsDescription"]
            </p>

        </div>

        <a href="/stock"
           class="btn-secondary">

            ← @L["Back"]

        </a>

    </div>


    <div class="form-card">

        <EditForm Model="@Model"
                  OnValidSubmit="@BookIncoming"
                  FormName="GoodsReceiptForm">

            <DataAnnotationsValidator />


            <!-- =====================================================
                 BESTELLUNG
                 ===================================================== -->

            <div class="form-section">

                <div class="form-section-title">

                    <h2>
                        @L["PurchaseOrder"]
                    </h2>

                    <p>
                        @L["OptionalOpenPurchaseOrder"]
                    </p>

                </div>


                <div class="form-grid">

                    <!-- BESTELLUNG -->

                    <div class="form-group">

                        <label>
                            @L["PurchaseOrder"]
                        </label>

                        <SearchableSelect TItem="PurchaseOrder"
                                          TValue="int"
                                          Items="PurchaseOrders"
                                          Value="@Model.PurchaseOrderId"
                                          ValueChanged="OnPurchaseOrderChanged"
                                          ValueSelector="@(x => x.Id)"
                                          TextSelector="@(x => $"{x.OrderNumber} - {x.Supplier?.CompanyName ?? "-"}")"
                                          Placeholder="@L["NoPurchaseOrderManual"]"
                                          NoResultsText="@L["NoResultsFound"]" />

                    </div>


                    <!-- SUPPLIER AUTOMATIC FROM BESTELLUNG -->
                    @if (SelectedPurchaseOrder != null)
                    {
                        <div class="form-group">

                            <label>
                                @L["Supplier"]
                            </label>

                            <input class="form-control"
                                   value="@(
                                   SelectedPurchaseOrder.Supplier?.CompanyName
                                   ?? "-"
                                                           )"
                                   readonly />

                            <small class="form-help">
                                Lieferant wird automatisch aus der Bestellung übernommen.
                            </small>

                        </div>
                    }

                </div>

            </div>


            <!-- =====================================================
                 WARENEINGANG
                 ===================================================== -->

            <div class="form-section">

                <div class="form-section-title">

                    <h2>
                        @L["IncomingGoods"]
                    </h2>

                    <p>
                        @L["SelectProductSupplierWarehouseLocationQuantity"]
                    </p>

                </div>


                <div class="form-grid">


                    <!-- =================================================
                         PRODUCT
                         ONLY MANUAL MODE
                         ================================================= -->
                    @if (SelectedPurchaseOrder == null)
                    {
                        <div class="form-group">

                            <label>
                                @L["Product"] <span>*</span>
                            </label>

                            <SearchableSelect TItem="Product"
                                              TValue="int"
                                              Items="Products"
                                              Value="@Model.ProductId"
                                              ValueChanged="OnProductChanged"
                                              ValueSelector="@(p => p.Id)"
                                              TextSelector="@(p => $"{p.SKU} - {p.Name}")"
                                              Placeholder="@L["SelectProduct"]"
                                              NoResultsText="@L["NoResultsFound"]" />

                            <ValidationMessage For="@(() => Model.ProductId)" />

                        </div>
                    }


                    <!-- =================================================
                         WAREHOUSE
                         ================================================= -->

                    <div class="form-group">

                        <label>
                            @L["Warehouse"] <span>*</span>
                        </label>

                        <SearchableSelect TItem="Warehouse"
                                          TValue="int"
                                          Items="Warehouses"
                                          Value="@Model.WarehouseId"
                                          ValueChanged="OnWarehouseChanged"
                                          ValueSelector="@(x => x.Id)"
                                          TextSelector="@(x => x.Name)"
                                          Placeholder="@L["SelectWarehouse"]"
                                          NoResultsText="@L["NoResultsFound"]" />

                        <ValidationMessage For="@(() => Model.WarehouseId)" />

                    </div>


                    <!-- =================================================
                         LAGERPLATZ
                         ================================================= -->

                    <div class="form-group">

                        <label>
                            @L["Location"] <span>*</span>
                        </label>

                        <SearchableSelect TItem="WarehouseLocation"
                                          TValue="int"
                                          Items="Locations"
                                          Value="@Model.WarehouseLocationId"
                                          ValueChanged="OnLocationChanged"
                                          ValueSelector="@(x => x.Id)"
                                          TextSelector="@(x => $"{x.Code}{(string.IsNullOrWhiteSpace(x.Name) ? "" : $" - {x.Name}")}")"
                                          Placeholder="@L["SelectLocation"]"
                                          NoResultsText="@L["NoResultsFound"]"
                                          Disabled="@(Model.WarehouseId <= 0)" />

                        <ValidationMessage For="@(() => Model.WarehouseLocationId)" />

                    </div>


                    <!-- =================================================
                         QUANTITY
                         ================================================= -->
                    @if (SelectedPurchaseOrder != null)
                    {
                        <!-- =================================================
                             BESTELLUNG MODE

NO INPUT!
                             USER CANNOT CHANGE QUANTITY.
                             ================================================= -->

                        <div class="form-group">

                            <label>
                                @L["Quantity"]
                            </label>

                            <div class="form-control"
                                 style="background-color:#f5f5f5;
                                cursor:not-allowed;
                                user-select:none;">

                                @TotalIncomingQuantity.ToString("N2")

                            </div>

                            <small class="form-help">

                                @L["PurchaseOrder"]:
                                <strong>
                                    @SelectedPurchaseOrder.OrderNumber
                                </strong>

                                <br />

                                @L["Quantity"]:
                                <strong>
                                    @TotalIncomingQuantity.ToString("N2")
                                </strong>

                                <br />

                                <span>
                                    Automatisch aus der Bestellung übernommen.
                                </span>

                            </small>

                        </div>
                    }
                    else
                    {
                        <!-- =================================================
                             MANUAL MODE

USER CAN ENTER QUANTITY.
                             ================================================= -->

                        <div class="form-group">

                            <label>
                                @L["Quantity"] <span>*</span>
                            </label>

                            <InputNumber @bind-Value="Model.Quantity"
                                         class="form-control"
                                         step="0.01"
                                         min="0.01" />

                            <ValidationMessage For="@(() => Model.Quantity)" />

                        </div>
                    }


                    <!-- =================================================
                         REFERENZ
                         ================================================= -->

                    <div class="form-group">

                        <label>
                            @L["ReferenceNumber"]
                        </label>

                        <InputText @bind-Value="Model.ReferenceNumber"
                                   class="form-control"
                                   placeholder="@L["IncomingReferencePlaceholder"]" />

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 PURCHASE ORDER INFORMATION
                 ===================================================== -->
            @if (SelectedPurchaseOrder != null)
            {
                <div class="form-section">

                    <div class="form-section-title">

                        <h2>
                            @L["DeliveryProgress"]
                        </h2>

                        <p>

                            @L["PurchaseOrder"]:

                            <strong>
                                @SelectedPurchaseOrder.OrderNumber
                            </strong>

                        </p>

                    </div>


                    <!-- =================================================
                         SUMMARY
                         ================================================= -->

                    <div class="stock-summary-grid">


                        <!-- ORDERED -->

                        <div class="stock-summary-card">

                            <span>
                                @L["Ordered"]
                            </span>

                            <strong>
                                @TotalOrderedQuantity.ToString("N2")
                            </strong>

                        </div>


                        <!-- ALREADY DELIVERED -->

                        <div class="stock-summary-card">

                            <span>
                                @L["AlreadyDelivered"]
                            </span>

                            <strong>
                                @TotalDeliveredQuantity.ToString("N2")
                            </strong>

                        </div>


                        <!-- THIS RECEIPT -->

                        <div class="stock-summary-card">

                            <span>
                                @L["ThisReceipt"]
                            </span>

                            <strong>
                                @TotalIncomingQuantity.ToString("N2")
                            </strong>

                        </div>


                        <!-- REMAINING -->

                        <div class="stock-summary-card">

                            <span>
                                @L["RemainingAfterReceipt"]
                            </span>

                            <strong>
                                @Math.Max(
                                    0,
                                    TotalRemainingQuantity -
                                    TotalIncomingQuantity
                                ).ToString("N2")
                            </strong>

                        </div>

                    </div>


                    <!-- =================================================
                         PRODUCTS IN BESTELLUNG
                         ================================================= -->

                    <div style="margin-top:20px;">

                        <h3>
                            @L["Product"]
                        </h3>


                        <div class="table-responsive">

                            <table class="table">

                                <thead>

                                    <tr>

                                        <th>
                                            @L["Product"]
                                        </th>

                                        <th>
                                            @L["Ordered"]
                                        </th>

                                        <th>
                                            @L["AlreadyDelivered"]
                                        </th>

                                        <th>
                                            @L["RemainingQuantity"]
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>

                                    @if (IncomingOrderItems.Any())
                                    {
                                        @foreach (var item in IncomingOrderItems)
                                        {
                                            <tr>

                                                <td>

                                                    @(item.Product?.SKU ?? "-")
                                                    -
                                                    @(item.Product?.Name ?? "-")

                                                </td>

                                                <td>
                                                    @item.Quantity.ToString("N2")
                                                </td>

                                                <td>
                                                    @item.DeliveredQuantity.ToString("N2")
                                                </td>

                                                <td>
                                                    @Math.Max(
                                                        0,
                                                        item.Quantity -
                                                        item.DeliveredQuantity
                                                    ).ToString("N2")
                                                </td>

                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>

                                            <td colspan="4"
                                                style="text-align:center;">

                                                Keine offenen Positionen.

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>
            }


            <!-- =====================================================
                 NOTIZ
                 ===================================================== -->

            <div class="form-section">

                <div class="form-section-title">

                    <h2>
                        @L["Note"]
                    </h2>

                    <p>
                        @L["OptionalIncomingGoodsInformation"]
                    </p>

                </div>


                <div class="form-group">

                    <InputTextArea @bind-Value="Model.Note"
                                   class="form-control textarea"
                                   rows="5"
                                   placeholder="@L["NotePlaceholder"]" />

                </div>

            </div>


            <!-- =====================================================
                 ERROR
                 ===================================================== -->
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="form-error">
                    @ErrorMessage
                </div>
            }


            <!-- =====================================================
                 SUCCESS
                 ===================================================== -->
            @if (!string.IsNullOrWhiteSpace(SuccessMessage))
            {
                <div class="form-success">
                    @SuccessMessage
                </div>
            }


            <!-- =====================================================
                 ACTIONS
                 ===================================================== -->

            <div class="form-actions">

                <a href="/stock"
                   class="btn-secondary">

                    @L["Cancel"]

                </a>


                <button type="submit"
                        class="btn-primary"
                        disabled="@IsSaving">

                    @(IsSaving
                        ? L["Booking"]
                        : L["BookIncomingGoods"])

                </button>

            </div>

        </EditForm>

    </div>

</div>


@code {

    // =========================================================
    // DATA
    // =========================================================

    private GoodsReceiptModel Model = new();

    private List<Product> Products = new();

    private List<Supplier> Suppliers = new();

    private List<Warehouse> Warehouses = new();

    private List<WarehouseLocation> Locations = new();

    private List<PurchaseOrder> PurchaseOrders = new();


    // =========================================================
    // SELECTED PURCHASE ORDER
    // =========================================================

    private PurchaseOrder? SelectedPurchaseOrder;


    // =========================================================
    // STATE
    // =========================================================

    private bool IsSaving;

    private string? ErrorMessage;

    private string? SuccessMessage;


    // =========================================================
    // OPEN ITEMS
    // =========================================================

    private List<PurchaseOrderItem> IncomingOrderItems =>
        SelectedPurchaseOrder?.Items
            .Where(x =>
                x.Quantity >
                x.DeliveredQuantity)
            .ToList()
        ?? new List<PurchaseOrderItem>();


    // =========================================================
    // TOTAL ORDERED
    // =========================================================

    private decimal TotalOrderedQuantity =>
        SelectedPurchaseOrder?.Items
            .Sum(x =>
                x.Quantity)
        ?? 0;


    // =========================================================
    // TOTAL DELIVERED
    // =========================================================

    private decimal TotalDeliveredQuantity =>
        SelectedPurchaseOrder?.Items
            .Sum(x =>
                x.DeliveredQuantity)
        ?? 0;


    // =========================================================
    // TOTAL REMAINING
    // =========================================================

    private decimal TotalRemainingQuantity =>
        SelectedPurchaseOrder?.Items
            .Sum(x =>
                Math.Max(
                    0,
                    x.Quantity -
                    x.DeliveredQuantity))
        ?? 0;


    // =========================================================
    // TOTAL INCOMING
    //
    // BESTELLUNG:
    // automatically calculated.
    //
    // MANUAL:
    // user entered quantity.
    // =========================================================

    private decimal TotalIncomingQuantity =>
        SelectedPurchaseOrder != null
            ? TotalRemainingQuantity
            : Model.Quantity;


    // =========================================================
    // INITIALIZATION
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        await using var db =
            await DbFactory.CreateDbContextAsync();


        // =====================================================
        // PRODUCTS
        // =====================================================

        Products =
            await db.Products
                .AsNoTracking()
                .Where(x =>
                    x.IsActive)
                .OrderBy(x =>
                    x.Name)
                .ToListAsync();


        // =====================================================
        // SUPPLIERS
        // =====================================================

        Suppliers =
            await db.Suppliers
                .AsNoTracking()
                .Where(x =>
                    x.IsActive)
                .OrderBy(x =>
                    x.CompanyName)
                .ToListAsync();


        // =====================================================
        // WAREHOUSES
        // =====================================================

        Warehouses =
            await db.Warehouses
                .AsNoTracking()
                .Where(x =>
                    x.IsActive)
                .OrderBy(x =>
                    x.Name)
                .ToListAsync();


        // =====================================================
        // OPEN PURCHASE ORDERS
        // =====================================================

        await LoadPurchaseOrders(db);
    }


    // =========================================================
    // LOAD PURCHASE ORDERS
    // =========================================================

    private async Task LoadPurchaseOrders(
        ApplicationDbContext db)
    {
        PurchaseOrders =
            await db.PurchaseOrders
                .AsNoTracking()
                .Include(x =>
                    x.Supplier)
                .Include(x =>
                    x.Items)
                    .ThenInclude(x =>
                        x.Product)
                .Where(x =>
                    x.Status ==
                        PurchaseOrderStatus.Bestellt
                    ||
                    x.Status ==
                        PurchaseOrderStatus.TeilweiseGeliefert)
                .OrderByDescending(x =>
                    x.OrderDate)
                .ThenByDescending(x =>
                    x.Id)
                .ToListAsync();
    }


    // =========================================================
    // PURCHASE ORDER CHANGED
    // =========================================================

    private async Task OnPurchaseOrderChanged(
        int purchaseOrderId)
    {
        ErrorMessage = null;

        SuccessMessage = null;

        Model.PurchaseOrderId =
            purchaseOrderId;

        SelectedPurchaseOrder = null;


        // =====================================================
        // MANUAL MODE
        // =====================================================

        if (purchaseOrderId <= 0)
        {
            Model.ProductId = 0;

            Model.SupplierId = 0;

            Model.Quantity = 0;

            Locations.Clear();

            StateHasChanged();

            return;
        }


        await using var db =
            await DbFactory.CreateDbContextAsync();


        // =====================================================
        // LOAD PURCHASE ORDER
        // =====================================================

        SelectedPurchaseOrder =
            await db.PurchaseOrders
                .AsNoTracking()
                .Include(x =>
                    x.Supplier)
                .Include(x =>
                    x.Items)
                    .ThenInclude(x =>
                        x.Product)
                .FirstOrDefaultAsync(x =>
                    x.Id ==
                    purchaseOrderId);


        if (SelectedPurchaseOrder == null)
        {
            ErrorMessage =
                L["PurchaseOrderNotFound"];

            return;
        }


        // =====================================================
        // CHECK STATUS
        // =====================================================

        if (SelectedPurchaseOrder.Status !=
                PurchaseOrderStatus.Bestellt
            &&
            SelectedPurchaseOrder.Status !=
                PurchaseOrderStatus.TeilweiseGeliefert)
        {
            ErrorMessage =
                L["PurchaseOrderCannotReceive"];

            SelectedPurchaseOrder = null;

            return;
        }


        // =====================================================
        // SUPPLIER AUTOMATICALLY
        // =====================================================

        Model.SupplierId =
            SelectedPurchaseOrder.SupplierId;


        // =====================================================
        // PRODUCT IS NOT USED
        //
        // IMPORTANT:
        // User does NOT select a Product.
        // ProductId is not validated.
        // ProductId is not used by BookIncoming()
        // in PurchaseOrder mode.
        // =====================================================

        Model.ProductId = 0;


        // =====================================================
        // QUANTITY AUTOMATICALLY
        //
        // SUM OF ALL REMAINING ITEMS
        // =====================================================

        Model.Quantity =
            SelectedPurchaseOrder.Items
                .Sum(x =>
                    Math.Max(
                        0,
                        x.Quantity -
                        x.DeliveredQuantity));


        StateHasChanged();
    }


    // =========================================================
    // PRODUCT CHANGED
    //
    // ONLY MANUAL MODE
    // =========================================================

    private Task OnProductChanged(
        int productId)
    {
        ErrorMessage = null;

        SuccessMessage = null;

        // Product can only be changed in manual mode.
        if (Model.PurchaseOrderId > 0)
            return Task.CompletedTask;

        Model.ProductId =
            productId;

        return Task.CompletedTask;
    }


    // =========================================================
    // SUPPLIER CHANGED
    //
    // ONLY MANUAL MODE
    // =========================================================

    private Task OnSupplierChanged(
        int supplierId)
    {
        ErrorMessage = null;

        SuccessMessage = null;

        // Supplier from Bestellung cannot be changed.
        if (Model.PurchaseOrderId > 0)
            return Task.CompletedTask;

        Model.SupplierId =
            supplierId;

        return Task.CompletedTask;
    }


    // =========================================================
    // WAREHOUSE CHANGED
    // =========================================================

    private async Task OnWarehouseChanged(
        int warehouseId)
    {
        ErrorMessage = null;

        SuccessMessage = null;

        Model.WarehouseId =
            warehouseId;

        Model.WarehouseLocationId =
            0;

        Locations.Clear();


        if (warehouseId <= 0)
        {
            StateHasChanged();

            return;
        }


        await using var db =
            await DbFactory.CreateDbContextAsync();


        Locations =
            await db.WarehouseLocations
                .AsNoTracking()
                .Where(x =>
                    x.IsActive
                    &&
                    x.WarehouseId ==
                        warehouseId)
                .OrderBy(x =>
                    x.Code)
                .ToListAsync();


        StateHasChanged();
    }


    // =========================================================
    // LOCATION CHANGED
    // =========================================================

    private Task OnLocationChanged(
        int locationId)
    {
        Model.WarehouseLocationId =
            locationId;

        return Task.CompletedTask;
    }


    // =========================================================
    // BOOK INCOMING
    // =========================================================

    private async Task BookIncoming()
    {
        if (IsSaving)
            return;


        IsSaving = true;

        ErrorMessage = null;

        SuccessMessage = null;


        try
        {
            // =================================================
            // WAREHOUSE
            // =================================================

            if (Model.WarehouseId <= 0)
            {
                ErrorMessage =
                    L["WarehouseSelectionRequired"];

                return;
            }


            // =================================================
            // LOCATION
            // =================================================

            if (Model.WarehouseLocationId <= 0)
            {
                ErrorMessage =
                    L["LocationSelectionRequired"];

                return;
            }


            await using var db =
                await DbFactory.CreateDbContextAsync();


            // =================================================
            // BESTELLUNG MODE
            // =================================================

            if (Model.PurchaseOrderId > 0)
            {
                // =============================================
                // LOAD BESTELLUNG
                // =============================================

                var purchaseOrder =
                    await db.PurchaseOrders
                        .Include(x =>
                            x.Supplier)
                        .Include(x =>
                            x.Items)
                            .ThenInclude(x =>
                                x.Product)
                        .FirstOrDefaultAsync(x =>
                            x.Id ==
                            Model.PurchaseOrderId);


                if (purchaseOrder == null)
                {
                    ErrorMessage =
                        L["PurchaseOrderNotFound"];

                    return;
                }


                // =============================================
                // CHECK STATUS
                // =============================================

                if (purchaseOrder.Status !=
                        PurchaseOrderStatus.Bestellt
                    &&
                    purchaseOrder.Status !=
                        PurchaseOrderStatus.TeilweiseGeliefert)
                {
                    ErrorMessage =
                        L["PurchaseOrderCannotReceive"];

                    return;
                }


                // =============================================
                // SUPPLIER
                //
                // AUTOMATIC FROM BESTELLUNG
                // =============================================

                if (purchaseOrder.SupplierId <= 0)
                {
                    ErrorMessage =
                        L["SelectedSupplierNotFound"];

                    return;
                }


                // =============================================
                // LOCATION
                // =============================================

                var location =
                    await db.WarehouseLocations
                        .FirstOrDefaultAsync(x =>
                            x.Id ==
                                Model.WarehouseLocationId
                            &&
                            x.WarehouseId ==
                                Model.WarehouseId
                            &&
                            x.IsActive);


                if (location == null)
                {
                    ErrorMessage =
                        L["SelectedLocationNotFound"];

                    return;
                }


                // =============================================
                // CHECK OPEN ITEMS
                // =============================================

                var openItems =
                    purchaseOrder.Items
                        .Where(x =>
                            x.Quantity >
                            x.DeliveredQuantity)
                        .ToList();


                if (!openItems.Any())
                {
                    ErrorMessage =
                        L["PurchaseOrderCannotReceive"];

                    return;
                }


                // =============================================
                // PROCESS ALL PRODUCTS
                //
                // IMPORTANT:
                //
                // NO Model.ProductId
                //
                // Product comes directly from:
                //
                // orderItem.ProductId
                //
                // =============================================

                foreach (var orderItem in openItems)
                {
                    // -----------------------------------------
                    // REMAINING
                    // -----------------------------------------

                    var remaining =
                        Math.Max(
                            0,
                            orderItem.Quantity -
                            orderItem.DeliveredQuantity);


                    if (remaining <= 0)
                        continue;


                    // -----------------------------------------
                    // PRODUCT FROM BESTELLUNG
                    // -----------------------------------------

                    var product =
                        await db.Products
                            .FirstOrDefaultAsync(x =>
                                x.Id ==
                                    orderItem.ProductId
                                &&
                                x.IsActive);


                    if (product == null)
                    {
                        ErrorMessage =
                            L["SelectedProductNotFound"];

                        return;
                    }


                    // =========================================
                    // STOCK
                    // =========================================

                    var stock =
                        await db.Stocks
                            .FirstOrDefaultAsync(x =>
                                x.ProductId ==
                                    orderItem.ProductId
                                &&
                                x.WarehouseLocationId ==
                                    Model.WarehouseLocationId);


                    // =========================================
                    // CREATE STOCK
                    // =========================================

                    if (stock == null)
                    {
                        stock =
                            new Stock
                            {
                                ProductId =
                                    orderItem.ProductId,

                                WarehouseLocationId =
                                    Model.WarehouseLocationId,

                                Quantity =
                                    remaining,

                                ReservedQuantity =
                                    0,

                                UpdatedAt =
                                    DateTime.UtcNow
                            };

                        db.Stocks.Add(stock);
                    }
                    else
                    {
                        stock.Quantity +=
                            remaining;

                        stock.UpdatedAt =
                            DateTime.UtcNow;
                    }


                    // =========================================
                    // STOCK MOVEMENT
                    // =========================================

                    var movement =
                        new StockMovement
                        {
                            ProductId =
                                orderItem.ProductId,

                            SupplierId =
                                purchaseOrder.SupplierId,

                            PurchaseOrderId =
                                purchaseOrder.Id,

                            Quantity =
                                remaining,

                            Type =
                                StockMovementType.Wareneingang,

                            FromWarehouseLocationId =
                                null,

                            ToWarehouseLocationId =
                                Model.WarehouseLocationId,

                            ReferenceNumber =
                                string.IsNullOrWhiteSpace(
                                    Model.ReferenceNumber)
                                    ? null
                                    : Model.ReferenceNumber.Trim(),

                            Note =
                                string.IsNullOrWhiteSpace(
                                    Model.Note)
                                    ? null
                                    : Model.Note.Trim(),

                            UserId =
                                null,

                            CreatedAt =
                                DateTime.UtcNow
                        };


                    db.StockMovements.Add(
                        movement);


                    // =========================================
                    // UPDATE DELIVERED
                    // =========================================

                    orderItem.DeliveredQuantity +=
                        remaining;
                }


                // =============================================
                // PURCHASE ORDER STATUS
                // =============================================

                var allDelivered =
                    purchaseOrder.Items.All(x =>
                        x.DeliveredQuantity >=
                        x.Quantity);


                var someDelivered =
                    purchaseOrder.Items.Any(x =>
                        x.DeliveredQuantity > 0);


                if (allDelivered)
                {
                    purchaseOrder.Status =
                        PurchaseOrderStatus.Geliefert;
                }
                else if (someDelivered)
                {
                    purchaseOrder.Status =
                        PurchaseOrderStatus.TeilweiseGeliefert;
                }
                else
                {
                    purchaseOrder.Status =
                        PurchaseOrderStatus.Bestellt;
                }


                purchaseOrder.UpdatedAt =
                    DateTime.UtcNow;


                // =============================================
                // SAVE ALL
                // =============================================

                await db.SaveChangesAsync();


                // =============================================
                // SUCCESS
                // =============================================

                var receivedQuantity =
                    openItems.Sum(x =>
                        Math.Max(
                            0,
                            x.Quantity -
                            x.DeliveredQuantity));

                SuccessMessage =
                    L["PurchaseOrderReceiptSuccess",
                        Model.Quantity.ToString("N2"),
                        purchaseOrder.OrderNumber];
            }
            else
            {
                // =================================================
                // MANUAL MODE
                // =================================================

                // =============================================
                // PRODUCT
                // =============================================

                if (Model.ProductId <= 0)
                {
                    ErrorMessage =
                        L["ProductSelectionRequired"];

                    return;
                }


                // =============================================
                // SUPPLIER
                // =============================================

                if (Model.SupplierId <= 0)
                {
                    ErrorMessage =
                        L["SupplierSelectionRequired"];

                    return;
                }


                // =============================================
                // QUANTITY
                // =============================================

                if (Model.Quantity <= 0)
                {
                    ErrorMessage =
                        L["QuantityMustBeGreaterThanZero"];

                    return;
                }


                // =============================================
                // PRODUCT
                // =============================================

                var product =
                    await db.Products
                        .FirstOrDefaultAsync(x =>
                            x.Id ==
                                Model.ProductId
                            &&
                            x.IsActive);


                if (product == null)
                {
                    ErrorMessage =
                        L["SelectedProductNotFound"];

                    return;
                }


                // =============================================
                // SUPPLIER
                // =============================================

                var supplier =
                    await db.Suppliers
                        .FirstOrDefaultAsync(x =>
                            x.Id ==
                                Model.SupplierId
                            &&
                            x.IsActive);


                if (supplier == null)
                {
                    ErrorMessage =
                        L["SelectedSupplierNotFound"];

                    return;
                }


                // =============================================
                // WAREHOUSE
                // =============================================

                var warehouse =
                    await db.Warehouses
                        .FirstOrDefaultAsync(x =>
                            x.Id ==
                                Model.WarehouseId
                            &&
                            x.IsActive);


                if (warehouse == null)
                {
                    ErrorMessage =
                        L["SelectedWarehouseNotFound"];

                    return;
                }


                // =============================================
                // LOCATION
                // =============================================

                var location =
                    await db.WarehouseLocations
                        .FirstOrDefaultAsync(x =>
                            x.Id ==
                                Model.WarehouseLocationId
                            &&
                            x.WarehouseId ==
                                Model.WarehouseId
                            &&
                            x.IsActive);


                if (location == null)
                {
                    ErrorMessage =
                        L["SelectedLocationNotFound"];

                    return;
                }


                // =============================================
                // STOCK
                // =============================================

                var stock =
                    await db.Stocks
                        .FirstOrDefaultAsync(x =>
                            x.ProductId ==
                                Model.ProductId
                            &&
                            x.WarehouseLocationId ==
                                Model.WarehouseLocationId);


                // =============================================
                // CREATE / UPDATE STOCK
                // =============================================

                if (stock == null)
                {
                    stock =
                        new Stock
                        {
                            ProductId =
                                Model.ProductId,

                            WarehouseLocationId =
                                Model.WarehouseLocationId,

                            Quantity =
                                Model.Quantity,

                            ReservedQuantity =
                                0,

                            UpdatedAt =
                                DateTime.UtcNow
                        };

                    db.Stocks.Add(stock);
                }
                else
                {
                    stock.Quantity +=
                        Model.Quantity;

                    stock.UpdatedAt =
                        DateTime.UtcNow;
                }


                // =============================================
                // STOCK MOVEMENT
                // =============================================

                var movement =
                    new StockMovement
                    {
                        ProductId =
                            Model.ProductId,

                        SupplierId =
                            Model.SupplierId,

                        PurchaseOrderId =
                            null,

                        Quantity =
                            Model.Quantity,

                        Type =
                            StockMovementType.Wareneingang,

                        FromWarehouseLocationId =
                            null,

                        ToWarehouseLocationId =
                            Model.WarehouseLocationId,

                        ReferenceNumber =
                            string.IsNullOrWhiteSpace(
                                Model.ReferenceNumber)
                                ? null
                                : Model.ReferenceNumber.Trim(),

                        Note =
                            string.IsNullOrWhiteSpace(
                                Model.Note)
                                ? null
                                : Model.Note.Trim(),

                        UserId =
                            null,

                        CreatedAt =
                            DateTime.UtcNow
                    };


                db.StockMovements.Add(
                    movement);


                // =============================================
                // SAVE
                // =============================================

                await db.SaveChangesAsync();


                // =============================================
                // SUCCESS
                // =============================================

                SuccessMessage =
                    L["ManualReceiptSuccess",
                        Model.Quantity.ToString("N2"),
                        supplier.CompanyName];
            }


            // =====================================================
            // RESET
            // =====================================================

            Model =
                new GoodsReceiptModel();

            SelectedPurchaseOrder =
                null;

            Locations.Clear();


            // =====================================================
            // RELOAD PURCHASE ORDERS
            // =====================================================

            await LoadPurchaseOrders(db);


            StateHasChanged();
        }
        catch (DbUpdateException ex)
        {
            var error =
                ex.InnerException?.InnerException?.Message
                ??
                ex.InnerException?.Message
                ??
                ex.Message;

            ErrorMessage =
                $"Database error: {error}";

            Console.WriteLine(
                "========== INCOMING GOODS DB ERROR ==========");

            Console.WriteLine(
                ex.ToString());

            Console.WriteLine(
                "==============================================");
        }
        catch (Exception ex)
        {
            ErrorMessage =
                $"Error: {ex.Message}";

            Console.WriteLine(
                "========== INCOMING GOODS ERROR ==========");

            Console.WriteLine(
                ex.ToString());

            Console.WriteLine(
                "==========================================");
        }
        finally
        {
            IsSaving = false;
        }
    }


    // =========================================================
    // MODEL
    // =========================================================

    private class GoodsReceiptModel
    {
        public int PurchaseOrderId
        {
            get;
            set;
        }


        // =====================================================
        // NO VALIDATION!
        //
        // Product is NOT required here because:
        //
        // PurchaseOrder mode:
        //     ProductId is completely ignored.
        //
        // Manual mode:
        //     ProductId is validated manually in BookIncoming().
        // =====================================================

        public int ProductId
        {
            get;
            set;
        }


        // =====================================================
        // NO VALIDATION!
        //
        // PurchaseOrder mode:
        //     Supplier comes automatically from Bestellung.
        //
        // Manual mode:
        //     Supplier is validated manually.
        // =====================================================

        public int SupplierId
        {
            get;
            set;
        }


        // =====================================================
        // WAREHOUSE
        // =====================================================

        [Range(
            1,
            int.MaxValue,
            ErrorMessageResourceType =
                typeof(SharedResource),
            ErrorMessageResourceName =
                "WarehouseSelectionRequired")]
        public int WarehouseId
        {
            get;
            set;
        }


        // =====================================================
        // LOCATION
        // =====================================================

        [Range(
            1,
            int.MaxValue,
            ErrorMessageResourceType =
                typeof(SharedResource),
            ErrorMessageResourceName =
                "LocationSelectionRequired")]
        public int WarehouseLocationId
        {
            get;
            set;
        }


        // =====================================================
        // NO DATA ANNOTATION VALIDATION!
        //
        // PurchaseOrder:
        //     automatically calculated.
        //
        // Manual:
        //     validated manually in BookIncoming().
        // =====================================================

        public decimal Quantity
        {
            get;
            set;
        }


        // =====================================================
        // REFERENCE
        // =====================================================

        [MaxLength(100)]
        public string? ReferenceNumber
        {
            get;
            set;
        }


        // =====================================================
        // NOTE
        // =====================================================

        [MaxLength(500)]
        public string? Note
        {
            get;
            set;
        }
    }
}