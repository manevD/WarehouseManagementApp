@page "/inventory/create"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using WarehouseManagement.Data
@using WarehouseManagement.Localization
@using WarehouseManagement.Models
@using WarehouseManagement.Components
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization

@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["NewInventory"]</PageTitle>

<div class="product-form-page">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="page-header">

        <div>

            <h1>@L["NewInventory"]</h1>

            <p>
                @L["CreateNewInventoryDescription"]
            </p>

        </div>


        <a href="/inventory"
           class="btn-secondary">

            ← @L["Back"]

        </a>

    </div>


    <!-- =========================================================
         FORM
         ========================================================= -->

    <div class="form-card">

        <!-- =====================================================
             INVENTUR INFORMATIONEN
             ===================================================== -->

        <div class="form-section">

            <div class="form-section-title">

                <div>

                    <h2>
                        @L["InventoryInformation"]
                    </h2>

                    <p>
                        @L["InventoryInformationDescription"]
                    </p>

                </div>

            </div>


            <div class="form-grid">

                <!-- LAGER -->

                <div class="form-group">

                    <label>
                        @L["Warehouse"] <span>*</span>
                    </label>

                    <SearchableSelect TItem="Warehouse"
                                      TValue="int"
                                      Items="Warehouses"
                                      Value="SelectedWarehouseId"
                                      ValueChanged="OnWarehouseChanged"
                                      ValueSelector="@(x => x.Id)"
                                      TextSelector="@(x => string.IsNullOrWhiteSpace(x.City)
                                          ? x.Name
                                          : $"{x.Name} - {x.City}")"
                                      Placeholder="@L["SelectWarehouse"]"
                                      NoResultsText="@L["NoResultsFound"]"
                                      ShowAllOption="false"
                                      AllValue="0" />


                    @if (SelectedWarehouseId > 0)
                    {
                        var selectedWarehouse =
                            Warehouses.FirstOrDefault(
                                x => x.Id == SelectedWarehouseId);

                        if (selectedWarehouse != null)
                        {
                            <div class="form-help">

                                <i class="bi bi-info-circle me-1"></i>

                                @selectedWarehouse.Locations.Count
                                @L["ActiveStorageLocations"]

                            </div>
                        }
                    }

                </div>


                <!-- NOTIZ -->

                <div class="form-group">

                    <label>
                        @L["Note"]
                    </label>

                    <textarea class="form-control"
                              rows="4"
                              maxlength="500"
                              placeholder="@L["InventoryNotePlaceholder"]"
                              @bind="Note">
                    </textarea>

                    <div class="form-help">
                        @L["Maximum500Characters"]
                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             INFORMATION
             ===================================================== -->

        <div class="form-section">

            <div class="form-section-title">

                <div>

                    <h2>
                        @L["HowInventoryWorks"]
                    </h2>

                    <p>
                        @L["HowInventoryWorksDescription"]
                    </p>

                </div>

            </div>


            <div class="form-info-box">

                <div class="form-info-icon">

                    <i class="bi bi-info-circle"></i>

                </div>


                <div>

                    <strong>
                        @L["WhatHappensWhenStarted"]
                    </strong>

                    <p>
                        @L["InventoryStartExplanation"]
                    </p>

                </div>

            </div>


            <!-- STEPS -->

            <div class="form-steps">

                <!-- STEP 1 -->

                <div class="form-step">

                    <div class="form-step-number">
                        1
                    </div>

                    <div>

                        <strong>
                            @L["SelectWarehouse"]
                        </strong>

                        <p>
                            @L["SelectWarehouseDescription"]
                        </p>

                    </div>

                </div>


                <!-- STEP 2 -->

                <div class="form-step">

                    <div class="form-step-number">
                        2
                    </div>

                    <div>

                        <strong>
                            @L["CountStock"]
                        </strong>

                        <p>
                            @L["CountStockDescription"]
                        </p>

                    </div>

                </div>


                <!-- STEP 3 -->

                <div class="form-step">

                    <div class="form-step-number">
                        3
                    </div>

                    <div>

                        <strong>
                            @L["CompleteInventory"]
                        </strong>

                        <p>
                            @L["CompleteInventoryDescription"]
                        </p>

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             ERROR
             ===================================================== -->
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="form-error">

                <i class="bi bi-exclamation-triangle me-1"></i>

                @ErrorMessage

            </div>
        }


        <!-- =====================================================
             ACTIONS
             ===================================================== -->

        <div class="form-actions">

            <a href="/inventory"
               class="btn-secondary">

                @L["Cancel"]

            </a>


            <button type="button"
                    class="btn-primary"
                    disabled="@IsSaving"
                    @onclick="StartInventory">

                @if (IsSaving)
                {
                    <span class="spinner-border spinner-border-sm me-2">
                    </span>

                    <span>
                        @L["Creating"]
                    </span>
                }
                else
                {
                    <i class="bi bi-play-fill me-1"></i>

                    <span>
                        @L["StartInventory"]
                    </span>
                }

            </button>

        </div>

    </div>

</div>


@code {

    // =========================================================
    // DATA
    // =========================================================

    private List<Warehouse> Warehouses = new();


    // =========================================================
    // FORM
    // =========================================================

    private int SelectedWarehouseId;

    private string? Note;


    // =========================================================
    // STATE
    // =========================================================

    private bool IsSaving;

    private string? ErrorMessage;


    // =========================================================
    // INITIALIZATION
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadWarehouses();
    }


    // =========================================================
    // LOAD WAREHOUSES
    // =========================================================

    private async Task LoadWarehouses()
    {
        Warehouses =
            await Db.Warehouses

                .Where(x =>
                    x.IsActive)

                .Include(x =>
                    x.Locations
                        .Where(l =>
                            l.IsActive))

                .AsNoTracking()

                .OrderBy(x =>
                    x.Name)

                .ToListAsync();
    }


    // =========================================================
    // WAREHOUSE CHANGED
    // =========================================================

    private Task OnWarehouseChanged(int warehouseId)
    {
        SelectedWarehouseId = warehouseId;

        ErrorMessage = null;

        return Task.CompletedTask;
    }


    // =========================================================
    // START INVENTORY
    // =========================================================

    private async Task StartInventory()
    {
        ErrorMessage = null;


        if (SelectedWarehouseId <= 0)
        {
            ErrorMessage =
                L["WarehouseRequired"].Value;

            return;
        }


        IsSaving = true;


        try
        {
            var warehouse =
                await Db.Warehouses

                    .FirstOrDefaultAsync(x =>
                        x.Id == SelectedWarehouseId &&
                        x.IsActive);


            if (warehouse == null)
            {
                ErrorMessage =
                    L["WarehouseNotFound"].Value;

                return;
            }


            // =====================================================
            // AKTIVE LAGERPLÄTZE
            // =====================================================

            var locationIds =
                await Db.WarehouseLocations

                    .Where(x =>
                        x.WarehouseId == SelectedWarehouseId &&
                        x.IsActive)

                    .Select(x =>
                        x.Id)

                    .ToListAsync();


            if (!locationIds.Any())
            {
                ErrorMessage =
                    L["NoActiveStorageLocations"].Value;

                return;
            }


            // =====================================================
            // AKTUELLE BESTÄNDE
            // =====================================================

            var stocks =
                await Db.Stocks

                    .Include(x =>
                        x.Product)

                    .Where(x =>
                        locationIds.Contains(
                            x.WarehouseLocationId)

                        &&

                        x.Product != null

                        &&

                        x.Product.IsActive)

                    .AsNoTracking()

                    .ToListAsync();


            if (!stocks.Any())
            {
                ErrorMessage =
                    L["NoStockFoundForWarehouse"].Value;

                return;
            }


            // =====================================================
            // INVENTUR ERSTELLEN
            // =====================================================

            var inventory =
                new Inventory
                {
                    WarehouseId =
                        SelectedWarehouseId,

                    Status =
                        InventoryStatus.InBearbeitung,

                    Note =
                        string.IsNullOrWhiteSpace(Note)
                            ? null
                            : Note.Trim(),

                    CreatedAt =
                        DateTime.UtcNow
                };


            // =====================================================
            // INVENTUR POSITIONEN
            // =====================================================

            foreach (var stock in stocks)
            {
                var item =
                    new InventoryItem
                    {
                        Inventory =
                            inventory,

                        ProductId =
                            stock.ProductId,

                        WarehouseLocationId =
                            stock.WarehouseLocationId,

                        SystemQuantity =
                            stock.Quantity,

                        CountedQuantity =
                            null,

                        Difference =
                            0
                    };


                inventory.Items.Add(item);
            }


            // =====================================================
            // SAVE
            // =====================================================

            Db.Inventories.Add(
                inventory);

            await Db.SaveChangesAsync();


            // =====================================================
            // DETAILS
            // =====================================================

            Navigation.NavigateTo(
                $"/inventory/details/{inventory.Id}");
        }
        catch (Exception ex)
        {
            ErrorMessage =
                L["InventoryCreationError",
                    ex.GetBaseException().Message].Value;
        }
        finally
        {
            IsSaving = false;
        }
    }

}