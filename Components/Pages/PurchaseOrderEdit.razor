@page "/purchase-orders/edit/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using WarehouseManagement.Data
@using WarehouseManagement.Localization
@using WarehouseManagement.Models

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["EditPurchaseOrder"]</PageTitle>

@if (IsLoading)
{
    <div class="loading-state">
        @L["PurchaseOrderLoading"]
    </div>
}
else if (Order == null)
{
    <div class="empty-products">

        <div class="empty-products-icon">
            ⚠
        </div>

        <h3>
            @L["PurchaseOrderNotFound"]
        </h3>

        <a href="/purchase-orders"
           class="btn-primary">

            @L["BackToPurchaseOrders"]

        </a>

    </div>
}
else if (Order.Status != PurchaseOrderStatus.Entwurf)
{
    <div class="empty-products">

        <div class="empty-products-icon">
            🔒
        </div>

        <h3>
            @L["PurchaseOrderCannotBeEdited"]
        </h3>

        <p>
            @L["PurchaseOrderAlreadyHasStatus"]
            <strong>
                @GetStatusText(Order.Status)
            </strong>.
        </p>

        <a href="/purchase-orders/details/@Order.Id"
           class="btn-primary">

            @L["ToPurchaseOrder"]

        </a>

    </div>
}
else
{
    <div class="product-form-page">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="page-header">

            <div>

                <h1>
                    @L["EditPurchaseOrder"]
                </h1>

                <p>
                    @Order.OrderNumber
                    -
                    @(Order.Supplier?.CompanyName ?? "-")
                </p>

            </div>

            <a href="/purchase-orders/details/@Order.Id"
               class="btn-secondary">

                ← @L["Back"]

            </a>

        </div>


        <div class="form-card">

            <EditForm Model="@Model"
                      OnValidSubmit="@UpdatePurchaseOrder"
                      FormName="PurchaseOrderEditForm">

                <DataAnnotationsValidator />


                <!-- =================================================
                     PURCHASE ORDER
                     ================================================= -->

                <div class="form-section">

                    <div class="form-section-title">

                        <h2>
                            @L["PurchaseOrder"]
                        </h2>

                        <p>
                            @L["EditSupplierAndOrderData"]
                        </p>

                    </div>


                    <div class="form-grid">

                        <!-- SUPPLIER -->

                        <div class="form-group">

                            <label>
                                @L["Supplier"]
                                <span>*</span>
                            </label>

                            <select class="form-control"
                                    value="@Model.SupplierId"
                                    @onchange="SupplierChanged">

                                <option value="0">
                                    @L["SelectSupplier"]
                                </option>

                                @foreach (var supplier in Suppliers)
                                {
                                    <option value="@supplier.Id">

                                        @supplier.CompanyName

                                        @if (!string.IsNullOrWhiteSpace(
                                            supplier.SupplierNumber))
                                        {
                                            @($" ({supplier.SupplierNumber})")
                                        }

                                    </option>
                                }

                            </select>

                            @if (Model.SupplierId <= 0)
                            {
                                <div class="form-error">
                                    @L["SupplierSelectionRequired"]
                                </div>
                            }

                        </div>


                        <!-- ORDER NUMBER -->

                        <div class="form-group">

                            <label>
                                @L["OrderNumber"]
                                <span>*</span>
                            </label>

                            <InputText @bind-Value="Model.OrderNumber"
                                       class="form-control" />

                        </div>


                        <!-- DATE -->

                        <div class="form-group">

                            <label>
                                @L["OrderDate"]
                                <span>*</span>
                            </label>

                            <InputDate @bind-Value="Model.OrderDate"
                                       class="form-control" />

                        </div>


                        <!-- REFERENCE -->

                        <div class="form-group">

                            <label>
                                @L["ReferenceNumber"]
                            </label>

                            <InputText @bind-Value="Model.ReferenceNumber"
                                       class="form-control"
                                       placeholder="@L["PurchaseOrderReferencePlaceholder"]" />

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     ITEMS
                     ================================================= -->

                <div class="form-section">

                    <div class="form-section-title">

                        <div class="section-title-row">

                            <div>

                                <h2>
                                    @L["OrderItems"]
                                </h2>

                                <p>
                                    @L["EditProductsQuantitiesAndPrices"]
                                </p>

                            </div>


                            <button type="button"
                                    class="btn-primary"
                                    @onclick="AddItem">

                                + @L["AddProduct"]

                            </button>

                        </div>

                    </div>


                    @if (Model.Items.Count == 0)
                    {
                        <div class="empty-products">

                            <div class="empty-products-icon">
                                📦
                            </div>

                            <h3>
                                @L["NoPurchaseOrderItems"]
                            </h3>

                            <p>
                                @L["AddAtLeastOneProduct"]
                            </p>

                            <button type="button"
                                    class="btn-primary"
                                    @onclick="AddItem">

                                + @L["AddProduct"]

                            </button>

                        </div>
                    }
                    else
                    {
                        <div class="order-items-table-wrapper">

                            <table class="products-table">

                                <thead>

                                    <tr>

                                        <th>
                                            @L["Product"]
                                        </th>

                                        <th>
                                            @L["Quantity"]
                                        </th>

                                        <th>
                                            @L["UnitPrice"]
                                        </th>

                                        <th>
                                            @L["Total"]
                                        </th>

                                        <th>
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>

                                    @foreach (var item in Model.Items)
                                    {
                                        <tr>

                                            <!-- PRODUCT -->

                                            <td>

                                                <select class="form-control"
                                                        value="@item.ProductId"
                                                        @onchange="(e) => ProductChanged(item, e)">

                                                    <option value="0">
                                                        @L["SelectProduct"]
                                                    </option>

                                                    @foreach (var product in
                                                        GetAvailableProducts(item))
                                                    {
                                                        <option value="@product.Id">

                                                            @product.SKU -
                                                            @product.Name

                                                        </option>
                                                    }

                                                </select>


                                                @if (item.ProductId <= 0)
                                                {
                                                    <div class="form-error">
                                                        @L["ProductSelectionRequired"]
                                                    </div>
                                                }

                                            </td>


                                            <!-- QUANTITY -->

                                            <td>

                                                <InputNumber @bind-Value="item.Quantity"
                                                             class="form-control"
                                                             step="0.01"
                                                             min="0.01" />


                                                @if (item.ProductId > 0 &&
                                                     item.Quantity <= 0)
                                                {
                                                    <div class="form-error">
                                                        @L["QuantityMustBeGreaterThanZero"]
                                                    </div>
                                                }


                                                @if (item.DeliveredQuantity > 0)
                                                {
                                                    <small class="form-help">

                                                        @L["AlreadyDelivered"]:

                                                        <strong>
                                                            @item.DeliveredQuantity.ToString("N2")
                                                        </strong>

                                                    </small>
                                                }

                                            </td>


                                            <!-- UNIT PRICE -->

                                            <td>

                                                <InputNumber @bind-Value="item.UnitPrice"
                                                             class="form-control"
                                                             step="0.01"
                                                             min="0" />


                                                @if (item.ProductId > 0 &&
                                                     item.UnitPrice < 0)
                                                {
                                                    <div class="form-error">
                                                        @L["PriceCannotBeNegative"]
                                                    </div>
                                                }

                                            </td>


                                            <!-- TOTAL -->

                                            <td>

                                                <strong>

                                                    @(
                                                        (
                                                            item.Quantity *
                                                            item.UnitPrice
                                                        ).ToString("N2")
                                                    )

                                                    €

                                                </strong>

                                            </td>


                                            <!-- DELETE -->

                                            <td>

                                                @if (item.DeliveredQuantity <= 0)
                                                {
                                                    <button type="button"
                                                            class="action-button delete-button"
                                                            title="@L["RemoveItem"]"
                                                            @onclick="() => RemoveItem(item)">

                                                        🗑

                                                    </button>
                                                }
                                                else
                                                {
                                                    <span title="@L["DeliveredItemCannotBeRemoved"]">

                                                        🔒

                                                    </span>
                                                }

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }

                </div>


                <!-- =================================================
                     TOTAL
                     ================================================= -->

                <div class="form-section">

                    <div class="order-total-box">

                        <span>
                            @L["GrandTotal"]
                        </span>

                        <strong>
                            @CalculateTotal().ToString("N2") €
                        </strong>

                    </div>

                </div>


                <!-- =================================================
                     NOTE
                     ================================================= -->

                <div class="form-section">

                    <div class="form-section-title">

                        <h2>
                            @L["Note"]
                        </h2>

                        <p>
                            @L["OptionalPurchaseOrderInformation"]
                        </p>

                    </div>


                    <div class="form-group">

                        <InputTextArea @bind-Value="Model.Note"
                                       class="form-control textarea"
                                       rows="5"
                                       placeholder="@L["NotePlaceholder"]" />

                    </div>

                </div>


                <!-- =================================================
                     ERROR
                     ================================================= -->
                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="form-error">
                        @ErrorMessage
                    </div>
                }


                <!-- =================================================
                     ACTIONS
                     ================================================= -->

                <div class="form-actions">

                    <a href="/purchase-orders/details/@Order.Id"
                       class="btn-secondary">

                        @L["Cancel"]

                    </a>


                    <button type="submit"
                            class="btn-primary"
                            disabled="@IsSaving">

                        @(IsSaving
                            ? L["Saving"]
                            : L["SaveChanges"])

                    </button>

                </div>

            </EditForm>

        </div>

    </div>
}


@code {

    [Parameter]
    public int Id { get; set; }


    private PurchaseOrder? Order;

    private List<Supplier> Suppliers = new();

    private List<Product> Products = new();

    private PurchaseOrderEditModel Model = new();

    private bool IsLoading = true;

    private bool IsSaving;

    private string? ErrorMessage;


    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }


    private async Task LoadData()
    {
        IsLoading = true;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            Suppliers =
                await db.Suppliers
                    .AsNoTracking()
                    .Where(x => x.IsActive)
                    .OrderBy(x => x.CompanyName)
                    .ToListAsync();


            Products =
                await db.Products
                    .AsNoTracking()
                    .Where(x => x.IsActive)
                    .OrderBy(x => x.Name)
                    .ToListAsync();


            Order =
                await db.PurchaseOrders

                    .Include(x => x.Supplier)

                    .Include(x => x.Items)

                    .FirstOrDefaultAsync(x =>
                        x.Id == Id);


            if (Order == null)
                return;


            Model.SupplierId =
                Order.SupplierId;

            Model.OrderNumber =
                Order.OrderNumber;

            Model.OrderDate =
                Order.OrderDate;

            Model.ReferenceNumber =
                Order.ReferenceNumber;

            Model.Note =
                Order.Note;


            foreach (var item in Order.Items)
            {
                Model.Items.Add(
                    new PurchaseOrderItemModel
                    {
                        Id =
                            item.Id,

                        ProductId =
                            item.ProductId,

                        Quantity =
                            item.Quantity,

                        UnitPrice =
                            item.UnitPrice,

                        DeliveredQuantity =
                            item.DeliveredQuantity
                    });
            }
        }
        finally
        {
            IsLoading = false;
        }
    }


    private Task SupplierChanged(
        ChangeEventArgs e)
    {
        ErrorMessage = null;

        if (int.TryParse(
                e.Value?.ToString(),
                out var supplierId))
        {
            Model.SupplierId =
                supplierId;
        }
        else
        {
            Model.SupplierId =
                0;
        }

        return Task.CompletedTask;
    }


    private void AddItem()
    {
        ErrorMessage = null;


        var availableProductExists =
            Products.Any(product =>
                !Model.Items.Any(item =>
                    item.ProductId ==
                    product.Id));


        if (!availableProductExists)
        {
            ErrorMessage =
                L["AllProductsAlreadyAdded"];

            return;
        }


        Model.Items.Add(
            new PurchaseOrderItemModel());
    }


    private IEnumerable<Product> GetAvailableProducts(
        PurchaseOrderItemModel currentItem)
    {
        var selectedProductIds =
            Model.Items

                .Where(item =>
                    item != currentItem
                    &&
                    item.ProductId > 0)

                .Select(item =>
                    item.ProductId)

                .ToHashSet();


        return Products.Where(product =>

            product.Id ==
                currentItem.ProductId

            ||

            !selectedProductIds.Contains(
                product.Id));
    }


    private Task ProductChanged(
        PurchaseOrderItemModel item,
        ChangeEventArgs e)
    {
        ErrorMessage = null;


        if (!int.TryParse(
                e.Value?.ToString(),
                out var productId))
        {
            item.ProductId = 0;
            item.Quantity = 0;
            item.UnitPrice = 0;

            return Task.CompletedTask;
        }


        if (productId <= 0)
        {
            item.ProductId = 0;
            item.Quantity = 0;
            item.UnitPrice = 0;

            return Task.CompletedTask;
        }


        var duplicate =
            Model.Items.Any(x =>
                x != item
                &&
                x.ProductId == productId);


        if (duplicate)
        {
            ErrorMessage =
                L["ProductAlreadyAdded"];

            return Task.CompletedTask;
        }


        if (item.DeliveredQuantity > 0 &&
            item.ProductId != 0 &&
            item.ProductId != productId)
        {
            ErrorMessage =
                L["DeliveredItemProductCannotBeChanged"];

            return Task.CompletedTask;
        }


        item.ProductId =
            productId;


        var product =
            Products.FirstOrDefault(x =>
                x.Id == productId);


        if (product != null &&
            item.UnitPrice <= 0)
        {
            item.UnitPrice =
                product.PurchasePrice;
        }


        return Task.CompletedTask;
    }


    private void RemoveItem(
        PurchaseOrderItemModel item)
    {
        ErrorMessage = null;


        if (item.DeliveredQuantity > 0)
        {
            ErrorMessage =
                L["DeliveredItemCannotBeRemoved"];

            return;
        }


        Model.Items.Remove(item);
    }


    private decimal CalculateTotal()
    {
        return Model.Items.Sum(item =>
            item.Quantity *
            item.UnitPrice);
    }


    private async Task UpdatePurchaseOrder()
    {
        if (Order == null ||
            IsSaving)
        {
            return;
        }


        IsSaving = true;

        ErrorMessage = null;


        try
        {
            // =================================================
            // STATUS
            // =================================================

            if (Order.Status !=
                PurchaseOrderStatus.Entwurf)
            {
                ErrorMessage =
                    L["PurchaseOrderCannotBeEdited"];

                return;
            }


            // =================================================
            // SUPPLIER
            // =================================================

            if (Model.SupplierId <= 0)
            {
                ErrorMessage =
                    L["SupplierSelectionRequired"];

                return;
            }


            // =================================================
            // ORDER NUMBER
            // =================================================

            var orderNumber =
                Model.OrderNumber?.Trim();


            if (string.IsNullOrWhiteSpace(
                orderNumber))
            {
                ErrorMessage =
                    L["OrderNumberRequired"];

                return;
            }


            if (orderNumber.Length > 50)
            {
                ErrorMessage =
                    L["OrderNumberMaxLength"];

                return;
            }


            // =================================================
            // ITEMS
            // =================================================

            if (Model.Items.Count == 0)
            {
                ErrorMessage =
                    L["AtLeastOneProductRequired"];

                return;
            }


            // =================================================
            // VALIDATION
            // =================================================

            var selectedProductIds =
                new HashSet<int>();


            foreach (var item in Model.Items)
            {
                if (item.ProductId <= 0)
                {
                    ErrorMessage =
                        L["ProductRequiredForEveryItem"];

                    return;
                }


                if (!selectedProductIds.Add(
                    item.ProductId))
                {
                    ErrorMessage =
                        L["ProductCanOnlyBeAddedOnce"];

                    return;
                }


                if (item.Quantity <= 0)
                {
                    ErrorMessage =
                        L["QuantityMustBeGreaterThanZero"];

                    return;
                }


                if (item.UnitPrice < 0)
                {
                    ErrorMessage =
                        L["PriceCannotBeNegative"];

                    return;
                }


                if (item.DeliveredQuantity >
                    item.Quantity)
                {
                    ErrorMessage =
                        L["DeliveredQuantityCannotExceedOrdered"];

                    return;
                }
            }


            // =================================================
            // DATABASE
            // =================================================

            await using var db =
                await DbFactory.CreateDbContextAsync();


            // =================================================
            // LOAD ACTUAL ORDER
            // =================================================

            var order =
                await db.PurchaseOrders

                    .Include(x =>
                        x.Items)

                    .FirstOrDefaultAsync(x =>
                        x.Id == Id);


            if (order == null)
            {
                ErrorMessage =
                    L["PurchaseOrderNotFound"];

                return;
            }


            // =================================================
            // STATUS CHECK
            // =================================================

            if (order.Status !=
                PurchaseOrderStatus.Entwurf)
            {
                ErrorMessage =
                    L["PurchaseOrderChangedMeanwhile"];

                return;
            }


            // =================================================
            // SUPPLIER EXISTS
            // =================================================

            var supplierExists =
                await db.Suppliers

                    .AnyAsync(x =>
                        x.Id ==
                            Model.SupplierId
                        &&
                        x.IsActive);


            if (!supplierExists)
            {
                ErrorMessage =
                    L["SelectedSupplierNotFoundOrInactive"];

                return;
            }


            // =================================================
            // ORDER NUMBER UNIQUE
            // =================================================

            var duplicateNumber =
                await db.PurchaseOrders

                    .AnyAsync(x =>
                        x.Id != Id
                        &&
                        x.OrderNumber ==
                            orderNumber);


            if (duplicateNumber)
            {
                ErrorMessage =
                    L["OrderNumberAlreadyExists"];

                return;
            }


            // =================================================
            // PRODUCTS EXIST
            // =================================================

            var validProductIds =
                await db.Products

                    .Where(x =>
                        selectedProductIds.Contains(
                            x.Id)
                        &&
                        x.IsActive)

                    .Select(x =>
                        x.Id)

                    .ToListAsync();


            if (validProductIds.Count !=
                selectedProductIds.Count)
            {
                ErrorMessage =
                    L["SelectedProductsNotFoundOrInactive"];

                return;
            }


            // =================================================
            // EXISTING ITEMS
            // =================================================

            var existingItems =
                order.Items.ToList();


            var incomingExistingIds =
                Model.Items

                    .Where(x =>
                        x.Id > 0)

                    .Select(x =>
                        x.Id)

                    .ToHashSet();


            // =================================================
            // DELETE REMOVED ITEMS
            // =================================================

            foreach (var existingItem in existingItems)
            {
                if (incomingExistingIds.Contains(
                    existingItem.Id))
                {
                    continue;
                }


                if (existingItem.DeliveredQuantity > 0)
                {
                    ErrorMessage =
                        L["DeliveredItemCannotBeRemoved"];

                    return;
                }


                db.PurchaseOrderItems.Remove(
                    existingItem);
            }


            // =================================================
            // UPDATE / ADD ITEMS
            // =================================================

            foreach (var itemModel in Model.Items)
            {
                // =================================================
                // EXISTING
                // =================================================

                if (itemModel.Id > 0)
                {
                    var existingItem =
                        existingItems.FirstOrDefault(x =>
                            x.Id ==
                            itemModel.Id);


                    if (existingItem == null)
                    {
                        ErrorMessage =
                            L["PurchaseOrderItemNotFound"];

                        return;
                    }


                    // =============================================
                    // PRODUCT CHANGE PROTECTION
                    // =============================================

                    if (existingItem.DeliveredQuantity > 0 &&
                        existingItem.ProductId !=
                            itemModel.ProductId)
                    {
                        ErrorMessage =
                            L["DeliveredItemProductCannotBeChanged"];

                        return;
                    }


                    // =============================================
                    // QUANTITY PROTECTION
                    // =============================================

                    if (itemModel.Quantity <
                        existingItem.DeliveredQuantity)
                    {
                        ErrorMessage =
                            L["QuantityCannotBeLessThanDelivered"];

                        return;
                    }


                    existingItem.ProductId =
                        itemModel.ProductId;

                    existingItem.Quantity =
                        itemModel.Quantity;

                    existingItem.UnitPrice =
                        itemModel.UnitPrice;
                }
                else
                {
                    // =================================================
                    // NEW
                    // =================================================

                    var newItem =
                        new PurchaseOrderItem
                        {
                            PurchaseOrderId =
                                order.Id,

                            ProductId =
                                itemModel.ProductId,

                            Quantity =
                                itemModel.Quantity,

                            UnitPrice =
                                itemModel.UnitPrice,

                            DeliveredQuantity =
                                0
                        };


                    db.PurchaseOrderItems.Add(
                        newItem);
                }
            }


            // =================================================
            // UPDATE HEADER
            // =================================================

            order.SupplierId =
                Model.SupplierId;

            order.OrderNumber =
                orderNumber;

            order.OrderDate =
                Model.OrderDate;

            order.ReferenceNumber =
                string.IsNullOrWhiteSpace(
                    Model.ReferenceNumber)
                    ? null
                    : Model.ReferenceNumber.Trim();

            order.Note =
                string.IsNullOrWhiteSpace(
                    Model.Note)
                    ? null
                    : Model.Note.Trim();

            order.Total =
                CalculateTotal();

            order.UpdatedAt =
                DateTime.UtcNow;


            // =================================================
            // SAVE
            // =================================================

            await db.SaveChangesAsync();


            Navigation.NavigateTo(
                $"/purchase-orders/details/{order.Id}");
        }
        catch (DbUpdateException)
        {
            ErrorMessage =
                L["PurchaseOrderSaveError"];
        }
        catch (Exception ex)
        {
            ErrorMessage =
                L["PurchaseOrderSaveException", ex.Message];
        }
        finally
        {
            IsSaving = false;
        }
    }


    // =========================================================
    // STATUS TEXT
    // =========================================================

    private string GetStatusText(
        PurchaseOrderStatus status)
    {
        return status switch
        {
            PurchaseOrderStatus.Entwurf =>
                L["PurchaseOrderStatusDraft"],

            PurchaseOrderStatus.Bestellt =>
                L["PurchaseOrderStatusOrdered"],

            PurchaseOrderStatus.TeilweiseGeliefert =>
                L["PurchaseOrderStatusPartiallyDelivered"],

            PurchaseOrderStatus.Geliefert =>
                L["PurchaseOrderStatusDelivered"],

            PurchaseOrderStatus.Storniert =>
                L["PurchaseOrderStatusCancelled"],

            _ =>
                status.ToString()
        };
    }


    // =========================================================
    // EDIT MODEL
    // =========================================================

    private class PurchaseOrderEditModel
    {
        public int SupplierId { get; set; }

        public string OrderNumber { get; set; }
            = string.Empty;

        public DateTime OrderDate { get; set; }
            = DateTime.Today;

        public string? ReferenceNumber { get; set; }

        public string? Note { get; set; }

        public List<PurchaseOrderItemModel> Items { get; set; }
            = new();
    }


    // =========================================================
    // ITEM MODEL
    // =========================================================

    private class PurchaseOrderItemModel
    {
        public int Id { get; set; }

        public int ProductId { get; set; }

        public decimal Quantity { get; set; }

        public decimal UnitPrice { get; set; }

        public decimal DeliveredQuantity { get; set; }
    }

}