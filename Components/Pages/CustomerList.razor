@page "/customers"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@using WarehouseManagement.Data
@using WarehouseManagement.Localization
@using WarehouseManagement.Models
@using WarehouseManagement.Services
@using WarehouseManagement.Components

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@inject ExcelExportService ExcelExport
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Customers"]</PageTitle>

<div class="product-list-page">

    <!-- HEADER -->

    <div class="page-header">

        <div>

            <h1>
                @L["Customers"]
            </h1>

            <p>
                @L["ManageCustomersDescription"]
            </p>

        </div>


        <div>

            <button type="button"
                    class="btn-secondary"
                    @onclick="ExportExcel"
                    disabled="@(PagedCustomers.Count == 0)">

                📊 @L["ExportExcel"]

            </button>


            <a href="/customers/create"
               class="btn-primary">

                + @L["NewCustomer"]

            </a>

        </div>

    </div>


    <!-- SEARCH / FILTER -->

    <div class="filter-card">

        <div class="search-box">

            <span class="search-icon">
                ⌕
            </span>

            <input type="text"
                   class="search-input"
                   placeholder="@L["SearchCustomerPlaceholder"]"
                   @bind="SearchTerm"
                   @bind:event="oninput"
                   @bind:after="SearchChanged"
                   autocomplete="off" />

        </div>


        <SearchableSelect TItem="StatusOption"
                          TValue="string"
                          Items="StatusOptions"
                          Value="SelectedStatus"
                          ValueChanged="OnCustomerStatusChanged"
                          ValueSelector="@(x => x.Value)"
                          TextSelector="@(x => x.Text)"
                          Placeholder="@L["AllCustomers"]"
                          NoResultsText="@L["NoResultsFound"]"
                          ShowAllOption="true"
                          AllOptionText="@L["AllCustomers"]"
                          AllValue="@("all")" />

    </div>


    <!-- SUMMARY -->

    <div class="stock-summary-grid">

        <div class="stock-summary-card">

            <span>
                @L["Customers"]
            </span>

            <strong>
                @Customers.Count
            </strong>

        </div>


        <div class="stock-summary-card">

            <span>
                @L["Active"]
            </span>

            <strong>
                @ActiveCount
            </strong>

        </div>


        <div class="stock-summary-card">

            <span>
                @L["Inactive"]
            </span>

            <strong>
                @InactiveCount
            </strong>

        </div>

    </div>


    <!-- TABLE -->

    <div class="products-card">

        <div class="products-card-header">

            <div>

                <strong>
                    @L["CustomerList"]
                </strong>

                <span>
                    @Customers.Count @L["EntriesCount"]
                </span>

            </div>

        </div>


        @if (IsLoading)
        {
            <div class="loading-state">

                @L["CustomersLoading"]

            </div>
        }
        else if (Customers.Count == 0)
        {
            <div class="empty-products">

                <div class="empty-products-icon">
                    👤
                </div>

                <h3>
                    @L["NoCustomersFound"]
                </h3>

                <p>
                    @L["NoCustomersForSearch"]
                </p>

            </div>
        }
        else
        {
            <div class="products-table-wrapper">

                <table class="products-table">

                    <thead>

                        <tr>

                            <th>
                                @L["Number"]
                            </th>

                            <th>
                                @L["Company"]
                            </th>

                            <th>
                                @L["ContactPerson"]
                            </th>

                            <th>
                                @L["Email"]
                            </th>

                            <th>
                                @L["Phone"]
                            </th>

                            <th>
                                @L["City"]
                            </th>

                            <th>
                                @L["VatNumber"]
                            </th>

                            <th>
                                @L["Status"]
                            </th>

                            <th>
                                @L["Actions"]
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var customer in PagedCustomers)
                        {
                            <tr>

                                <!-- NUMBER -->

                                <td>

                                    <span class="product-sku">

                                        @(string.IsNullOrWhiteSpace(
                                            customer.CustomerNumber)
                                            ? $"#{customer.Id}"
                                            : customer.CustomerNumber)

                                    </span>

                                </td>


                                <!-- COMPANY -->

                                <td>

                                    <div class="product-name">

                                        <div class="product-avatar">

                                            @GetInitials(
                                                customer.CompanyName)

                                        </div>


                                        <div>

                                            <strong>
                                                @customer.CompanyName
                                            </strong>


                                            @if (!string.IsNullOrWhiteSpace(
                                                customer.Street))
                                            {
                                                <small>
                                                    @customer.Street
                                                </small>
                                            }

                                        </div>

                                    </div>

                                </td>


                                <!-- CONTACT PERSON -->

                                <td>

                                    @(string.IsNullOrWhiteSpace(
                                        customer.ContactPerson)
                                        ? "-"
                                        : customer.ContactPerson)

                                </td>


                                <!-- EMAIL -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        customer.Email))
                                    {
                                        <a href="mailto:@customer.Email">

                                            @customer.Email

                                        </a>
                                    }
                                    else
                                    {
                                        <span>
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- PHONE -->

                                <td>

                                    @(string.IsNullOrWhiteSpace(
                                        customer.Phone)
                                        ? "-"
                                        : customer.Phone)

                                </td>


                                <!-- CITY -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        customer.PostalCode) ||
                                        !string.IsNullOrWhiteSpace(
                                            customer.City))
                                    {
                                        @($"{customer.PostalCode} {customer.City}")
                                    }
                                    else
                                    {
                                        <span>
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- VAT -->

                                <td>

                                    @(string.IsNullOrWhiteSpace(
                                        customer.VatNumber)
                                        ? "-"
                                        : customer.VatNumber)

                                </td>


                                <!-- STATUS -->

                                <td>

                                    @if (customer.IsActive)
                                    {
                                        <span class="status-badge status-active">

                                            @L["Active"]

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-low">

                                            @L["Inactive"]

                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->

                                <td>

                                    <div class="product-actions">

                                        <a href="/customers/edit/@customer.Id"
                                           class="action-button"
                                           title="@L["Edit"]">

                                            ✎

                                        </a>


                                        @if (customer.IsActive)
                                        {
                                            <button type="button"
                                                    class="action-button delete-button"
                                                    title="@L["Deactivate"]"
                                                    @onclick="() => DeactivateCustomer(customer)">

                                                🗑

                                            </button>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- PAGINATION -->
            @if (TotalPages > 1)
            {
                <div class="pagination">

                    <button type="button"
                            class="pagination-button"
                            disabled="@(CurrentPage <= 1)"
                            @onclick="PreviousPage">

                        ‹

                    </button>


                    <div class="pagination-pages">

                        @for (int page = 1;
                              page <= TotalPages;
                              page++)
                        {
                            var pageNumber = page;

                            <button type="button"
                                    class="pagination-button @(CurrentPage == pageNumber ? "active" : "")"
                                    @onclick="() => GoToPage(pageNumber)">

                                @pageNumber

                            </button>
                        }

                    </div>


                    <button type="button"
                            class="pagination-button"
                            disabled="@(CurrentPage >= TotalPages)"
                            @onclick="NextPage">

                        ›

                    </button>

                </div>
            }


            <div class="pagination-info">

                @L["PageInfo", CurrentPage, TotalPages]

                ·

                @PagedCustomers.Count
                @L["OfCustomers"]
                @Customers.Count

            </div>
        }

    </div>

</div>


@code {

    // =========================================================
    // SETTINGS
    // =========================================================

    private const int PageSize = 10;


    // =========================================================
    // STATE
    // =========================================================

    private int CurrentPage = 1;


    private List<Customer> Customers = new();


    private string SearchTerm = string.Empty;


    // IMPORTANT:
    //
    // all      = ALL CUSTOMERS
    // active   = ACTIVE CUSTOMERS ONLY
    // inactive = INACTIVE CUSTOMERS ONLY

    private string SelectedStatus = "all";


    private bool IsLoading = true;


    // =========================================================
    // STATUS OPTIONS
    // =========================================================

    private class StatusOption
    {
        public string Value { get; set; } = "";

        public string Text { get; set; } = "";
    }


    private List<StatusOption> StatusOptions = new();


    // =========================================================
    // SUMMARY
    // =========================================================

    private int ActiveCount =>
        Customers.Count(x =>
            x.IsActive);


    private int InactiveCount =>
        Customers.Count(x =>
            !x.IsActive);


    // =========================================================
    // PAGINATION
    // =========================================================

    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                Customers.Count /
                (double)PageSize));


    private List<Customer> PagedCustomers =>
        Customers
            .Skip(
                (CurrentPage - 1) *
                PageSize)
            .Take(PageSize)
            .ToList();


    // =========================================================
    // INITIALIZATION
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        // Default = ALL

        SelectedStatus = "all";


        StatusOptions = new List<StatusOption>
        {
            new StatusOption
            {
                Value = "active",
                Text = L["ActiveOnly"].Value
            },

            new StatusOption
            {
                Value = "inactive",
                Text = L["InactiveOnly"].Value
            }
        };


        // Initial database load

        await LoadCustomers();
    }


    // =========================================================
    // LOAD CUSTOMERS FROM DATABASE
    // =========================================================

    private async Task LoadCustomers()
    {
        IsLoading = true;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            // Start fresh query every time.
            //
            // This is important because changing
            // the status must create a NEW DB query.

            var query =
                db.Customers
                    .AsNoTracking()
                    .AsQueryable();


            // =================================================
            // SEARCH
            // =================================================

            if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                var search =
                    SearchTerm.Trim();


                query =
                    query.Where(x =>

                        x.CompanyName.Contains(search)

                        ||

                        (
                            x.ContactPerson != null
                            &&
                            x.ContactPerson.Contains(search)
                        )

                        ||

                        (
                            x.Email != null
                            &&
                            x.Email.Contains(search)
                        )

                        ||

                        (
                            x.Phone != null
                            &&
                            x.Phone.Contains(search)
                        )

                        ||

                        (
                            x.City != null
                            &&
                            x.City.Contains(search)
                        )

                        ||

                        (
                            x.CustomerNumber != null
                            &&
                            x.CustomerNumber.Contains(search)
                        )

                        ||

                        (
                            x.VatNumber != null
                            &&
                            x.VatNumber.Contains(search)
                        )

                    );
            }


            // =================================================
            // STATUS FILTER
            // =================================================

            if (SelectedStatus == "active")
            {
                // ONLY ACTIVE CUSTOMERS

                query =
                    query.Where(x =>
                        x.IsActive);
            }
            else if (SelectedStatus == "inactive")
            {
                // ONLY INACTIVE CUSTOMERS

                query =
                    query.Where(x =>
                        !x.IsActive);
            }
            else
            {
                // ALL CUSTOMERS
                //
                // IMPORTANT:
                // No IsActive WHERE clause.
                //
                // Therefore both active and inactive
                // customers are returned.

                query = query;
            }


            // =================================================
            // EXECUTE QUERY
            // =================================================

            Customers =
                await query
                    .OrderBy(x =>
                        x.CompanyName)
                    .ToListAsync();


            // Always return to first page
            // after search/filter change.

            CurrentPage = 1;
        }
        finally
        {
            IsLoading = false;
        }
    }


    // =========================================================
    // SEARCH CHANGED
    // =========================================================

    private async Task SearchChanged()
    {
        CurrentPage = 1;

        await LoadCustomers();
    }


    // =========================================================
    // CUSTOMER STATUS CHANGED
    // =========================================================

    private async Task OnCustomerStatusChanged(
        string value)
    {
        // Set the NEW value first.

        if (string.IsNullOrWhiteSpace(value))
        {
            SelectedStatus = "all";
        }
        else
        {
            SelectedStatus = value;
        }


        // Reset pagination.

        CurrentPage = 1;


        // IMPORTANT:
        //
        // Make a completely NEW query against
        // the DATABASE with the new status.

        await LoadCustomers();
    }


    // =========================================================
    // PAGINATION
    // =========================================================

    private void GoToPage(int page)
    {
        if (page < 1 ||
            page > TotalPages)
        {
            return;
        }


        CurrentPage = page;
    }


    private void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
        }
    }


    private void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
        }
    }


    // =========================================================
    // DEACTIVATE CUSTOMER
    // =========================================================

    private async Task DeactivateCustomer(
        Customer customer)
    {
        await using var db =
            await DbFactory.CreateDbContextAsync();


        var entity =
            await db.Customers
                .FirstOrDefaultAsync(
                    x =>
                        x.Id ==
                        customer.Id);


        if (entity == null)
        {
            return;
        }


        entity.IsActive = false;


        await db.SaveChangesAsync();


        // Reload FROM DATABASE.
        //
        // Current status filter is respected.
        //
        // If ACTIVE is selected:
        // customer disappears.
        //
        // If INACTIVE is selected:
        // customer appears.
        //
        // If ALL is selected:
        // customer appears as inactive.

        await LoadCustomers();
    }


    // =========================================================
    // EXCEL EXPORT
    // =========================================================

    private async Task ExportExcel()
    {
        var data =
            PagedCustomers
                .Where(x => x != null)
                .ToList();


        if (data.Count == 0)
        {
            return;
        }


        var customersText =
            L["Customers"].Value;


        var pageText =
            L["Page"].Value;


        var exportTitle =
            customersText
            + " - "
            + pageText
            + " "
            + CurrentPage;


        var fileBytes =
            ExcelExport.Export(
                data,

                customersText,

                exportTitle,

                (
                    L["Number"].Value,

                    x =>
                        string.IsNullOrWhiteSpace(
                            x.CustomerNumber)

                            ? $"#{x.Id}"

                            : x.CustomerNumber
                ),

                (
                    L["Company"].Value,

                    x =>
                        x.CompanyName ?? ""
                ),

                (
                    L["ContactPerson"].Value,

                    x =>
                        x.ContactPerson ?? ""
                ),

                (
                    L["Email"].Value,

                    x =>
                        x.Email ?? ""
                ),

                (
                    L["Phone"].Value,

                    x =>
                        x.Phone ?? ""
                ),

                (
                    L["Street"].Value,

                    x =>
                        x.Street ?? ""
                ),

                (
                    L["PostalCode"].Value,

                    x =>
                        x.PostalCode ?? ""
                ),

                (
                    L["City"].Value,

                    x =>
                        x.City ?? ""
                ),

                (
                    L["Country"].Value,

                    x =>
                        x.Country ?? ""
                ),

                (
                    L["VatNumber"].Value,

                    x =>
                        x.VatNumber ?? ""
                ),

                (
                    L["Status"].Value,

                    x =>
                        x.IsActive
                            ? L["Active"].Value
                            : L["Inactive"].Value
                ),

                (
                    L["Note"].Value,

                    x =>
                        x.Note ?? ""
                )
            );


        var base64 =
            Convert.ToBase64String(
                fileBytes);


        await JS.InvokeVoidAsync(
            "downloadFile",

            customersText
                + "_"
                + pageText
                + "_"
                + CurrentPage
                + ".xlsx",

            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",

            base64);
    }


    // =========================================================
    // INITIALS
    // =========================================================

    private string GetInitials(
        string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }


        var words =
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);


        if (words.Length == 1)
        {
            return words[0]
                .Substring(
                    0,
                    Math.Min(
                        2,
                        words[0].Length))
                .ToUpper();
        }


        return
            $"{words[0][0]}{words[1][0]}"
                .ToUpper();
    }

}