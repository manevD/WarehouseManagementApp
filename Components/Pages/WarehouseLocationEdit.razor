@page "/locations/edit/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using WarehouseManagement.Data
@using WarehouseManagement.Models
@using WarehouseManagement.Localization

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["EditStorageLocation"]</PageTitle>


@if (IsLoading)
{
    <div class="loading-state">

        @L["LoadingStorageLocation"]

    </div>
}
else if (Location == null)
{
    <div class="empty-products">

        <div class="empty-products-icon">
            ⚠
        </div>

        <h3>
            @L["StorageLocationNotFound"]
        </h3>

        <a href="/locations"
           class="btn-primary">

            @L["Back"]

        </a>

    </div>
}
else
{
    <div class="product-form-page">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="page-header">

            <div>

                <h1>
                    @L["EditStorageLocation"]
                </h1>

                <p>
                    @Location.Code
                    -
                    @Location.Warehouse?.Name
                </p>

            </div>

            <a href="/locations"
               class="btn-secondary">

                ← @L["Back"]

            </a>

        </div>


        <!-- =====================================================
             FORM
             ===================================================== -->

        <div class="form-card">

            <EditForm Model="@Model"
                      OnValidSubmit="@UpdateLocation"
                      FormName="WarehouseLocationEditForm">

                <DataAnnotationsValidator />


                <!-- =================================================
                     STORAGE LOCATION INFORMATION
                     ================================================= -->

                <div class="form-section">

                    <div class="form-section-title">

                        <h2>
                            @L["StorageLocationInformation"]
                        </h2>

                    </div>


                    <div class="form-grid">


                        <!-- =========================================
                             WAREHOUSE
                             ========================================= -->

                        <div class="form-group">

                            <label>
                                @L["Warehouse"]
                                <span>*</span>
                            </label>


                            <SearchableSelect TItem="Warehouse"
                                              TValue="int"
                                              Items="Warehouses"
                                              @bind-Value="Model.WarehouseId"
                                              ValueSelector="@(x => x.Id)"
                                              TextSelector="@(x => x.Name ?? "")"
                                              Placeholder="@L["SelectWarehouse"]"
                                              NoResultsText="@L["NoResultsFound"]"
                                              Disabled="@IsSaving" />


                            <ValidationMessage
                                For="@(() => Model.WarehouseId)" />

                        </div>


                        <!-- =========================================
                             CODE
                             ========================================= -->

                        <div class="form-group">

                            <label>
                                @L["Code"]
                                <span>*</span>
                            </label>

                            <InputText @bind-Value="Model.Code"
                                       class="form-control" />

                            <ValidationMessage
                                For="@(() => Model.Code)" />

                        </div>


                        <!-- =========================================
                             NAME
                             ========================================= -->

                        <div class="form-group">

                            <label>
                                @L["Name"]
                            </label>

                            <InputText @bind-Value="Model.Name"
                                       class="form-control" />

                        </div>


                        <!-- =========================================
                             ACTIVE
                             ========================================= -->

                        <div class="form-group checkbox-group">

                            <label class="checkbox-label">

                                <InputCheckbox
                                    @bind-Value="Model.IsActive" />

                                <span>
                                    @L["StorageLocationIsActive"]
                                </span>

                            </label>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     DESCRIPTION
                     ================================================= -->

                <div class="form-section">

                    <div class="form-section-title">

                        <h2>
                            @L["Description"]
                        </h2>

                    </div>


                    <div class="form-group">

                        <InputTextArea
                            @bind-Value="Model.Description"
                            class="form-control textarea"
                            rows="5" />

                    </div>

                </div>


                <!-- =================================================
                     ERROR
                     ================================================= -->

                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="form-error">

                        @ErrorMessage

                    </div>
                }


                <!-- =================================================
                     ACTIONS
                     ================================================= -->

                <div class="form-actions">

                    <a href="/locations"
                       class="btn-secondary">

                        @L["Cancel"]

                    </a>


                    <button type="submit"
                            class="btn-primary"
                            disabled="@IsSaving">

                        @(IsSaving
                            ? L["Saving"]
                            : L["SaveChanges"])

                    </button>

                </div>

            </EditForm>

        </div>

    </div>
}


@code {

    // =========================================================
    // PARAMETER
    // =========================================================

    [Parameter]
    public int Id { get; set; }


    // =========================================================
    // DATA
    // =========================================================

    private WarehouseLocation? Location;

    private List<Warehouse> Warehouses = new();

    private LocationModel Model = new();


    // =========================================================
    // STATE
    // =========================================================

    private bool IsLoading = true;

    private bool IsSaving;

    private string? ErrorMessage;


    // =========================================================
    // INITIALIZE
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        await using var db =
            await DbFactory.CreateDbContextAsync();


        // =====================================================
        // LOAD LOCATION
        // =====================================================

        Location =
            await db.WarehouseLocations
                .Include(x => x.Warehouse)
                .FirstOrDefaultAsync(
                    x => x.Id == Id);


        // =====================================================
        // LOAD ACTIVE WAREHOUSES
        // =====================================================

        Warehouses =
            await db.Warehouses
                .Where(x => x.IsActive)
                .OrderBy(x => x.Name)
                .ToListAsync();


        // =====================================================
        // CREATE EDIT MODEL
        // =====================================================

        if (Location != null)
        {
            Model = new LocationModel
            {
                WarehouseId =
                    Location.WarehouseId,

                Code =
                    Location.Code,

                Name =
                    Location.Name,

                Description =
                    Location.Description,

                IsActive =
                    Location.IsActive
            };
        }


        IsLoading = false;
    }


    // =========================================================
    // UPDATE
    // =========================================================

    private async Task UpdateLocation()
    {
        if (Location == null ||
            IsSaving)
        {
            return;
        }


        IsSaving = true;

        ErrorMessage = null;


        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            // =================================================
            // NORMALIZE CODE
            // =================================================

            var code =
                Model.Code
                    .Trim()
                    .ToUpper();


            // =================================================
            // WAREHOUSE EXISTS
            // =================================================

            var warehouseExists =
                await db.Warehouses
                    .AnyAsync(x =>
                        x.Id ==
                            Model.WarehouseId
                        &&
                        x.IsActive);


            if (!warehouseExists)
            {
                ErrorMessage =
                    L["SelectedWarehouseNotFound"];

                return;
            }


            // =================================================
            // DUPLICATE CODE
            // =================================================

            var codeExists =
                await db.WarehouseLocations
                    .AnyAsync(x =>
                        x.Id != Id
                        &&
                        x.WarehouseId ==
                            Model.WarehouseId
                        &&
                        x.Code == code);


            if (codeExists)
            {
                ErrorMessage =
                    L["StorageLocationCodeAlreadyExists"];

                return;
            }


            // =================================================
            // LOAD LOCATION
            // =================================================

            var location =
                await db.WarehouseLocations
                    .FirstOrDefaultAsync(
                        x => x.Id == Id);


            if (location == null)
            {
                ErrorMessage =
                    L["StorageLocationNotFound"];

                return;
            }


            // =================================================
            // UPDATE WAREHOUSE
            // =================================================

            location.WarehouseId =
                Model.WarehouseId;


            // =================================================
            // UPDATE CODE
            // =================================================

            location.Code =
                code;


            // =================================================
            // UPDATE NAME
            // =================================================

            location.Name =
                string.IsNullOrWhiteSpace(
                    Model.Name)

                    ? null

                    : Model.Name.Trim();


            // =================================================
            // UPDATE DESCRIPTION
            // =================================================

            location.Description =
                string.IsNullOrWhiteSpace(
                    Model.Description)

                    ? null

                    : Model.Description.Trim();


            // =================================================
            // UPDATE STATUS
            // =================================================

            location.IsActive =
                Model.IsActive;


            // =================================================
            // SAVE
            // =================================================

            await db.SaveChangesAsync();


            // =================================================
            // REDIRECT
            // =================================================

            Navigation.NavigateTo(
                "/locations");
        }
        catch (Exception ex)
        {
            ErrorMessage =
                $"{L["ErrorSaving"]}: {ex.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }


    // =========================================================
    // MODEL
    // =========================================================

    private class LocationModel
    {
        // =====================================================
        // WAREHOUSE
        // =====================================================

        [Range(
            1,
            int.MaxValue,

            ErrorMessageResourceType =
                typeof(SharedResource),

            ErrorMessageResourceName =
                "WarehouseRequired")]

        public int WarehouseId { get; set; }


        // =====================================================
        // CODE
        // =====================================================

        [Required(
            ErrorMessageResourceType =
                typeof(SharedResource),

            ErrorMessageResourceName =
                "CodeRequired")]

        [MaxLength(50)]

        public string Code { get; set; }
            = string.Empty;


        // =====================================================
        // NAME
        // =====================================================

        [MaxLength(200)]

        public string? Name { get; set; }


        // =====================================================
        // DESCRIPTION
        // =====================================================

        [MaxLength(500)]

        public string? Description { get; set; }


        // =====================================================
        // ACTIVE
        // =====================================================

        public bool IsActive { get; set; } = true;
    }

}