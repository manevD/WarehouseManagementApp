@page "/suppliers/edit/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using WarehouseManagement.Data
@using WarehouseManagement.Models

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>Lieferant bearbeiten</PageTitle>

<div class="product-form-page">

    <div class="page-header">

        <div>

            <h1>Lieferant bearbeiten</h1>

            @if (Supplier != null)
            {
                <p>
                    @Supplier.CompanyName
                </p>
            }

        </div>

        <a href="/suppliers"
           class="btn-secondary">

            ← Zurück

        </a>

    </div>


    @if (IsLoading)
    {
        <div class="loading-state">
            Lieferant wird geladen...
        </div>
    }
    else if (Supplier == null)
    {
        <div class="empty-products">

            <h3>
                Lieferant nicht gefunden
            </h3>

            <a href="/suppliers"
               class="btn-secondary">

                Zurück zu Lieferanten

            </a>

        </div>
    }
    else
    {

        <div class="form-card">

            <EditForm Model="@Model"
                      OnValidSubmit="@UpdateSupplier"
                      FormName="SupplierEditForm">

                <DataAnnotationsValidator />


                <!-- =====================================================
                     INFORMATIONEN
                     ===================================================== -->

                <div class="form-section">

                    <div class="form-section-title">

                        <h2>Lieferanteninformationen</h2>

                    </div>


                    <div class="form-grid">


                        <div class="form-group">

                            <label>
                                Firmenname <span>*</span>
                            </label>

                            <InputText @bind-Value="Model.CompanyName"
                                       class="form-control" />

                            <ValidationMessage For="@(() => Model.CompanyName)" />

                        </div>


                        <div class="form-group">

                            <label>
                                Lieferantennummer
                            </label>

                            <InputText @bind-Value="Model.SupplierNumber"
                                       class="form-control" />

                            <ValidationMessage For="@(() => Model.SupplierNumber)" />

                        </div>


                        <div class="form-group">

                            <label>
                                Ansprechpartner
                            </label>

                            <InputText @bind-Value="Model.ContactPerson"
                                       class="form-control" />

                        </div>


                        <div class="form-group">

                            <label>
                                USt-IdNr.
                            </label>

                            <InputText @bind-Value="Model.VatNumber"
                                       class="form-control" />

                        </div>

                    </div>

                </div>


                <!-- =====================================================
                     KONTAKT
                     ===================================================== -->

                <div class="form-section">

                    <div class="form-section-title">

                        <h2>Kontakt</h2>

                    </div>


                    <div class="form-grid">


                        <div class="form-group">

                            <label>
                                E-Mail
                            </label>

                            <InputText @bind-Value="Model.Email"
                                       class="form-control"
                                       type="email" />

                            <ValidationMessage For="@(() => Model.Email)" />

                        </div>


                        <div class="form-group">

                            <label>
                                Telefon
                            </label>

                            <InputText @bind-Value="Model.Phone"
                                       class="form-control" />

                        </div>

                    </div>

                </div>


                <!-- =====================================================
                     ADRESSE
                     ===================================================== -->

                <div class="form-section">

                    <div class="form-section-title">

                        <h2>Adresse</h2>

                    </div>


                    <div class="form-grid">


                        <div class="form-group">

                            <label>
                                Straße
                            </label>

                            <InputText @bind-Value="Model.Street"
                                       class="form-control" />

                        </div>


                        <div class="form-group">

                            <label>
                                PLZ
                            </label>

                            <InputText @bind-Value="Model.PostalCode"
                                       class="form-control" />

                        </div>


                        <div class="form-group">

                            <label>
                                Ort
                            </label>

                            <InputText @bind-Value="Model.City"
                                       class="form-control" />

                        </div>


                        <div class="form-group">

                            <label>
                                Land
                            </label>

                            <InputText @bind-Value="Model.Country"
                                       class="form-control" />

                        </div>

                    </div>

                </div>


                <!-- =====================================================
                     NOTE
                     ===================================================== -->

                <div class="form-section">

                    <div class="form-section-title">

                        <h2>Notiz</h2>

                    </div>


                    <div class="form-group">

                        <InputTextArea @bind-Value="Model.Note"
                                       class="form-control textarea"
                                       rows="5" />

                    </div>

                </div>


                <!-- =====================================================
                     STATUS
                     ===================================================== -->

                <div class="form-section">

                    <div class="form-group checkbox-group">

                        <label class="checkbox-label">

                            <InputCheckbox @bind-Value="Model.IsActive" />

                            <span>
                                Lieferant ist aktiv
                            </span>

                        </label>

                    </div>

                </div>


                <!-- ERROR -->
                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="form-error">
                        @ErrorMessage
                    </div>
                }


                <!-- ACTIONS -->

                <div class="form-actions">

                    <a href="/suppliers"
                       class="btn-secondary">

                        Abbrechen

                    </a>

                    <button type="submit"
                            class="btn-primary"
                            disabled="@IsSaving">

                        @(IsSaving
                            ? "Speichern..."
                            : "Änderungen speichern")

                    </button>

                </div>

            </EditForm>

        </div>

    }

</div>


@code {

    [Parameter]
    public int Id { get; set; }


    private Supplier? Supplier;

    private SupplierEditModel Model = new();

    private bool IsLoading = true;

    private bool IsSaving;

    private string? ErrorMessage;


    protected override async Task OnInitializedAsync()
    {
        await LoadSupplier();
    }


    private async Task LoadSupplier()
    {
        IsLoading = true;


        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            Supplier =
                await db.Suppliers
                    .AsNoTracking()
                    .FirstOrDefaultAsync(
                        x => x.Id == Id);


            if (Supplier == null)
                return;


            Model =
                new SupplierEditModel
                {
                    CompanyName =
                        Supplier.CompanyName,

                    SupplierNumber =
                        Supplier.SupplierNumber,

                    ContactPerson =
                        Supplier.ContactPerson,

                    Email =
                        Supplier.Email,

                    Phone =
                        Supplier.Phone,

                    Street =
                        Supplier.Street,

                    PostalCode =
                        Supplier.PostalCode,

                    City =
                        Supplier.City,

                    Country =
                        Supplier.Country,

                    VatNumber =
                        Supplier.VatNumber,

                    Note =
                        Supplier.Note,

                    IsActive =
                        Supplier.IsActive
                };
        }
        finally
        {
            IsLoading = false;
        }
    }


    private async Task UpdateSupplier()
    {
        if (IsSaving)
            return;


        IsSaving = true;

        ErrorMessage = null;


        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            var entity =
                await db.Suppliers
                    .FirstOrDefaultAsync(
                        x => x.Id == Id);


            if (entity == null)
            {
                ErrorMessage =
                    "Lieferant wurde nicht gefunden.";

                return;
            }


            // Supplier number prüfen

            if (!string.IsNullOrWhiteSpace(
                Model.SupplierNumber))
            {
                var number =
                    Model.SupplierNumber.Trim();


                var exists =
                    await db.Suppliers
                        .AnyAsync(x =>
                            x.Id != Id &&
                            x.SupplierNumber == number);


                if (exists)
                {
                    ErrorMessage =
                        "Diese Lieferantennummer existiert bereits.";

                    return;
                }
            }


            entity.CompanyName =
                Model.CompanyName.Trim();


            entity.SupplierNumber =
                string.IsNullOrWhiteSpace(
                    Model.SupplierNumber)
                    ? null
                    : Model.SupplierNumber.Trim();


            entity.ContactPerson =
                string.IsNullOrWhiteSpace(
                    Model.ContactPerson)
                    ? null
                    : Model.ContactPerson.Trim();


            entity.Email =
                string.IsNullOrWhiteSpace(
                    Model.Email)
                    ? null
                    : Model.Email.Trim();


            entity.Phone =
                string.IsNullOrWhiteSpace(
                    Model.Phone)
                    ? null
                    : Model.Phone.Trim();


            entity.Street =
                string.IsNullOrWhiteSpace(
                    Model.Street)
                    ? null
                    : Model.Street.Trim();


            entity.PostalCode =
                string.IsNullOrWhiteSpace(
                    Model.PostalCode)
                    ? null
                    : Model.PostalCode.Trim();


            entity.City =
                string.IsNullOrWhiteSpace(
                    Model.City)
                    ? null
                    : Model.City.Trim();


            entity.Country =
                string.IsNullOrWhiteSpace(
                    Model.Country)
                    ? null
                    : Model.Country.Trim();


            entity.VatNumber =
                string.IsNullOrWhiteSpace(
                    Model.VatNumber)
                    ? null
                    : Model.VatNumber.Trim();


            entity.Note =
                string.IsNullOrWhiteSpace(
                    Model.Note)
                    ? null
                    : Model.Note.Trim();


            entity.IsActive =
                Model.IsActive;


            await db.SaveChangesAsync();


            Navigation.NavigateTo("/suppliers");
        }
        catch (Exception ex)
        {
            ErrorMessage =
                $"Fehler beim Speichern: {ex.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }


    private class SupplierEditModel
    {
        [Required(
            ErrorMessage =
                "Firmenname ist erforderlich.")]
        [MaxLength(200)]
        public string CompanyName { get; set; }
            = string.Empty;


        [MaxLength(100)]
        public string? SupplierNumber { get; set; }


        [MaxLength(150)]
        public string? ContactPerson { get; set; }


        [EmailAddress(
            ErrorMessage =
                "Ungültige E-Mail-Adresse.")]
        [MaxLength(200)]
        public string? Email { get; set; }


        [MaxLength(50)]
        public string? Phone { get; set; }


        [MaxLength(300)]
        public string? Street { get; set; }


        [MaxLength(20)]
        public string? PostalCode { get; set; }

        [MaxLength(100)]
        public string? City { get; set; }

        [MaxLength(100)]
        public string? Country { get; set; }

        [MaxLength(50)]
        public string? VatNumber { get; set; }

        [MaxLength(500)]
        public string? Note { get; set; }

        public bool IsActive { get; set; }
    }

}