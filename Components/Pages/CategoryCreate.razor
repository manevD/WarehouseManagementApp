@page "/categories/create"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using WarehouseManagement.Data
@using WarehouseManagement.Localization
@using WarehouseManagement.Models

@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["NewCategory"]</PageTitle>

<div class="product-form-page">

    <div class="page-header">

        <div>
            <h1>@L["NewCategory"]</h1>

            <p>
                @L["CreateNewProductCategory"]
            </p>
        </div>

        <a href="/categories"
           class="btn-secondary">

            ← @L["Back"]

        </a>

    </div>


    <div class="form-card">

        <EditForm Model="@Model"
                  OnValidSubmit="@SaveCategory"
                  FormName="CategoryCreateForm">

            <DataAnnotationsValidator />


            <div class="form-section">

                <div class="form-section-title">

                    <h2>@L["CategoryInformation"]</h2>

                    <p>
                        @L["BasicCategoryInformation"]
                    </p>

                </div>


                <div class="form-grid">

                    <!-- NAME -->
                    <div class="form-group">

                        <label>
                            @L["Name"] <span>*</span>
                        </label>

                        <InputText @bind-Value="Model.Name"
                                   class="form-control"
                                   placeholder="@L["CategoryNamePlaceholder"]" />

                        <ValidationMessage For="@(() => Model.Name)" />

                    </div>


                    <!-- ACTIVE -->
                    <div class="form-group checkbox-group">

                        <label class="checkbox-label">

                            <InputCheckbox @bind-Value="Model.IsActive" />

                            <span>
                                @L["CategoryIsActive"]
                            </span>

                        </label>

                    </div>

                </div>

            </div>


            <!-- DESCRIPTION -->

            <div class="form-section">

                <div class="form-section-title">

                    <h2>@L["Description"]</h2>

                    <p>
                        @L["OptionalCategoryDescription"]
                    </p>

                </div>


                <div class="form-group">

                    <InputTextArea @bind-Value="Model.Description"
                                   class="form-control textarea"
                                   placeholder="@L["DescriptionPlaceholder"]"
                                   rows="5" />

                    <ValidationMessage For="@(() => Model.Description)" />

                </div>

            </div>


            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="form-error">
                    @ErrorMessage
                </div>
            }


            <div class="form-actions">

                <a href="/categories"
                   class="btn-secondary">

                    @L["Cancel"]

                </a>

                <button type="submit"
                        class="btn-primary"
                        disabled="@IsSaving">

                    @(IsSaving
                        ? L["Saving"]
                        : L["SaveCategory"])

                </button>

            </div>

        </EditForm>

    </div>

</div>


@code {

    private CategoryModel Model = new();

    private bool IsSaving;

    private string? ErrorMessage;


    private async Task SaveCategory()
    {
        if (IsSaving)
            return;

        IsSaving = true;
        ErrorMessage = null;

        try
        {
            var name = Model.Name.Trim();


            var exists = await Db.Categories
                .AnyAsync(x =>
                    x.Name.ToLower() == name.ToLower());

            if (exists)
            {
                ErrorMessage =
                    L["CategoryAlreadyExists"];

                return;
            }


            var category = new Category
            {
                Name = name,

                Description =
                    string.IsNullOrWhiteSpace(Model.Description)
                        ? null
                        : Model.Description.Trim(),

                IsActive = Model.IsActive
            };


            Db.Categories.Add(category);

            await Db.SaveChangesAsync();

            Navigation.NavigateTo("/categories");
        }
        catch (Exception ex)
        {
            ErrorMessage =
                L["ErrorSaving", ex.Message];
        }
        finally
        {
            IsSaving = false;
        }
    }


    private class CategoryModel
    {
        [Required(
            ErrorMessageResourceType =
                typeof(SharedResource),
            ErrorMessageResourceName =
                "NameRequired")]

        [MaxLength(100)]

        public string Name { get; set; }
            = string.Empty;


        [MaxLength(500)]

        public string? Description { get; set; }


        public bool IsActive { get; set; }
            = true;
    }
}