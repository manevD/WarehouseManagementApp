@page "/purchase-orders/create"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using WarehouseManagement.Data
@using WarehouseManagement.Localization
@using WarehouseManagement.Models

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["CreatePurchaseOrder"]</PageTitle>

<div class="product-form-page">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="page-header">

        <div>

            <h1>
                @L["CreatePurchaseOrder"]
            </h1>

            <p>
                @L["CreatePurchaseOrderDescription"]
            </p>

        </div>

        <a href="/purchase-orders"
           class="btn-secondary">

            ← @L["Back"]

        </a>

    </div>


    <div class="form-card">

        <EditForm Model="@Model"
                  OnValidSubmit="@CreatePurchaseOrder"
                  FormName="PurchaseOrderCreateForm">

            <DataAnnotationsValidator />


            <!-- =====================================================
                 BESTELLUNG
                 ===================================================== -->

            <div class="form-section">

                <div class="form-section-title">

                    <h2>
                        @L["PurchaseOrder"]
                    </h2>

                    <p>
                        @L["SupplierAndOrderData"]
                    </p>

                </div>


                <div class="form-grid">


                    <!-- =================================================
                         LIEFERANT
                         ================================================= -->

                    <div class="form-group">

                        <label>
                            @L["Supplier"]
                            <span>*</span>
                        </label>

                       <SearchableSelect TItem="Supplier"
                  TValue="int"
                  Items="Suppliers"
                  Value="Model.SupplierId"
                  ValueChanged="OnSupplierChanged"
                  ValueSelector="@(x => x.Id)"
                  TextSelector="@(x => string.IsNullOrWhiteSpace(x.SupplierNumber)
                      ? x.CompanyName
                      : $"{x.CompanyName} ({x.SupplierNumber})")"
                  Placeholder="@L["SelectSupplier"]"
                  NoResultsText="@L["NoResultsFound"]"
                  ShowAllOption="false"
                  AllValue="0" />


                        @if (Model.SupplierId <= 0 &&
                             SupplierTouched)
                        {
                            <div class="form-error">

                                @L["SupplierSelectionRequired"]

                            </div>
                        }

                    </div>


                    <!-- =================================================
                         BESTELLNUMMER
                         ================================================= -->

                    <div class="form-group">

                        <label>
                            @L["OrderNumber"]
                            <span>*</span>
                        </label>

                        <InputText @bind-Value="Model.OrderNumber"
                                   class="form-control"
                                   placeholder="PO-2026-0001" />

                        <ValidationMessage For="@(() => Model.OrderNumber)" />

                    </div>


                    <!-- =================================================
                         BESTELLDATUM
                         ================================================= -->

                    <div class="form-group">

                        <label>
                            @L["OrderDate"]
                            <span>*</span>
                        </label>

                        <InputDate @bind-Value="Model.OrderDate"
                                   class="form-control" />

                        <ValidationMessage For="@(() => Model.OrderDate)" />

                    </div>


                    <!-- =================================================
                         REFERENZ
                         ================================================= -->

                    <div class="form-group">

                        <label>
                            @L["ReferenceNumber"]
                        </label>

                        <InputText @bind-Value="Model.ReferenceNumber"
                                   class="form-control"
                                   placeholder="@L["PurchaseOrderReferencePlaceholder"]" />

                        <ValidationMessage For="@(() => Model.ReferenceNumber)" />

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 POSITIONEN
                 ===================================================== -->

            <div class="form-section">

                <div class="form-section-title">

                    <div class="section-title-row">

                        <div>

                            <h2>
                                @L["OrderItems"]
                            </h2>

                            <p>
                                @L["AddProductsAndQuantities"]
                            </p>

                        </div>


                        <button type="button"
                                class="btn-primary"
                                @onclick="AddItem">

                            + @L["AddProduct"]

                        </button>

                    </div>

                </div>


                @if (Model.Items.Count == 0)
                {
                    <div class="empty-products">

                        <div class="empty-products-icon">
                            📦
                        </div>

                        <h3>
                            @L["NoPurchaseOrderItems"]
                        </h3>

                        <p>
                            @L["AddAtLeastOneProduct"]
                        </p>

                        <button type="button"
                                class="btn-primary"
                                @onclick="AddItem">

                            + @L["AddProduct"]

                        </button>

                    </div>
                }
                else
                {
                    <div class="order-items-table-wrapper">

                        <table class="products-table">

                            <thead>

                                <tr>

                                    <th>
                                        @L["Product"]
                                    </th>

                                    <th>
                                        @L["Quantity"]
                                    </th>

                                    <th>
                                        @L["UnitPrice"]
                                    </th>

                                    <th>
                                        @L["Total"]
                                    </th>

                                    <th>
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @for (int i = 0;
                                      i < Model.Items.Count;
                                      i++)
                                {
                                    var item =
                                        Model.Items[i];

                                    <tr>

                                        <!-- =================================
                                             PRODUCT
                                             ================================= -->

                                        <td>

                                            <SearchableSelect TItem="Product"
                  TValue="int"
                  Items="GetAvailableProducts(item)"
                  Value="item.ProductId"
                  ValueChanged="@(value => ProductChanged(item, value))"
                  ValueSelector="@(x => x.Id)"
                  TextSelector="@(x => $"{x.SKU} - {x.Name}")"
                  Placeholder="@L["SelectProduct"]"
                  NoResultsText="@L["NoResultsFound"]"
                  ShowAllOption="false"
                  AllValue="0" />


                                            @if (item.ProductId <= 0 &&
                                                 item.ProductTouched)
                                            {
                                                <div class="form-error">

                                                    @L["ProductSelectionRequired"]

                                                </div>
                                            }

                                        </td>


                                        <!-- =================================
                                             QUANTITY
                                             ================================= -->

                                        <td>

                                            <InputNumber @bind-Value="item.Quantity"
                                                         class="form-control"
                                                         step="0.01"
                                                         min="0.01" />


                                            @if (item.ProductId > 0 &&
                                                 item.Quantity <= 0)
                                            {
                                                <div class="form-error">

                                                    @L["QuantityMustBeGreaterThanZero"]

                                                </div>
                                            }

                                        </td>


                                        <!-- =================================
                                             UNIT PRICE
                                             ================================= -->

                                        <td>

                                            <InputNumber @bind-Value="item.UnitPrice"
                                                         class="form-control"
                                                         step="0.01"
                                                         min="0" />


                                            @if (item.ProductId > 0 &&
                                                 item.UnitPrice < 0)
                                            {
                                                <div class="form-error">

                                                    @L["UnitPriceCannotBeNegative"]

                                                </div>
                                            }

                                        </td>


                                        <!-- =================================
                                             TOTAL
                                             ================================= -->

                                        <td>

                                            <strong>

                                                @(
                                                    (
                                                        item.Quantity *
                                                        item.UnitPrice
                                                    )
                                                    .ToString("N2")
                                                )

                                                €

                                            </strong>

                                        </td>


                                        <!-- =================================
                                             DELETE
                                             ================================= -->

                                        <td>

                                            <button type="button"
                                                    class="action-button delete-button"
                                                    title="@L["RemoveItem"]"
                                                    @onclick="() => RemoveItem(item)">

                                                🗑

                                            </button>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>


            <!-- =====================================================
                 TOTAL
                 ===================================================== -->

            <div class="form-section">

                <div class="order-total-box">

                    <span>
                        @L["GrandTotal"]
                    </span>

                    <strong>

                        @CalculateTotal().ToString("N2") €

                    </strong>

                </div>

            </div>


            <!-- =====================================================
                 NOTE
                 ===================================================== -->

            <div class="form-section">

                <div class="form-section-title">

                    <h2>
                        @L["Note"]
                    </h2>

                    <p>
                        @L["OptionalPurchaseOrderInformation"]
                    </p>

                </div>


                <div class="form-group">

                    <InputTextArea @bind-Value="Model.Note"
                                   class="form-control textarea"
                                   rows="5"
                                   placeholder="@L["NotePlaceholder"]" />

                    <ValidationMessage For="@(() => Model.Note)" />

                </div>

            </div>


            <!-- =====================================================
                 ERROR
                 ===================================================== -->
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="form-error">

                    @ErrorMessage

                </div>
            }


            <!-- =====================================================
                 ACTIONS
                 ===================================================== -->

            <div class="form-actions">

                <a href="/purchase-orders"
                   class="btn-secondary">

                    @L["Cancel"]

                </a>


                <button type="submit"
                        class="btn-primary"
                        disabled="@IsSaving">

                    @(IsSaving
                        ? L["Saving"]
                        : L["CreatePurchaseOrder"])

                </button>

            </div>

        </EditForm>

    </div>

</div>


@code {

    // =========================================================
    // DATA
    // =========================================================

    private PurchaseOrderCreateModel Model = new();

    private List<Supplier> Suppliers = new();

    private List<Product> Products = new();


    // =========================================================
    // STATE
    // =========================================================

    private bool IsSaving;

    private bool SupplierTouched;

    private string? ErrorMessage;


    // =========================================================
    // INITIALIZATION
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        await using var db =
            await DbFactory.CreateDbContextAsync();


        // =====================================================
        // SUPPLIERS
        // =====================================================

        Suppliers =
            await db.Suppliers

                .AsNoTracking()

                .Where(x =>
                    x.IsActive)

                .OrderBy(x =>
                    x.CompanyName)

                .ToListAsync();


        // =====================================================
        // PRODUCTS
        // =====================================================

        Products =
            await db.Products

                .AsNoTracking()

                .Where(x =>
                    x.IsActive)

                .OrderBy(x =>
                    x.Name)

                .ToListAsync();


        // =====================================================
        // DEFAULT ORDER NUMBER
        // =====================================================

        Model.OrderNumber =
            await GenerateOrderNumber();


        // =====================================================
        // DEFAULT DATE
        // =====================================================

        Model.OrderDate =
            DateTime.Today;
    }


    // =========================================================
    // GENERATE ORDER NUMBER
    // =========================================================

    private async Task<string> GenerateOrderNumber()
    {
        await using var db =
            await DbFactory.CreateDbContextAsync();


        var year =
            DateTime.UtcNow.Year;


        var prefix =
            $"PO-{year}-";


        var existingNumbers =
            await db.PurchaseOrders

                .AsNoTracking()

                .Where(x =>
                    x.OrderNumber.StartsWith(prefix))

                .Select(x =>
                    x.OrderNumber)

                .ToListAsync();


        var maxNumber =
            0;


        foreach (var number in existingNumbers)
        {
            if (number.Length <= prefix.Length)
                continue;


            var part =
                number.Substring(prefix.Length);


            if (int.TryParse(
                part,
                out var value))
            {
                if (value > maxNumber)
                {
                    maxNumber =
                        value;
                }
            }
        }


        return
            $"{prefix}{maxNumber + 1:D4}";
    }


    // =========================================================
    // SUPPLIER CHANGED
    // =========================================================

   private Task OnSupplierChanged(int supplierId)
{
    SupplierTouched = true;

    Model.SupplierId = supplierId;

    ErrorMessage = null;

    return Task.CompletedTask;
}


    // =========================================================
    // ADD ITEM
    // =========================================================

    private void AddItem()
    {
        Model.Items.Add(
            new PurchaseOrderItemModel());
    }


    // =========================================================
    // AVAILABLE PRODUCTS
    // =========================================================

    private IEnumerable<Product> GetAvailableProducts(
        PurchaseOrderItemModel currentItem)
    {
        var selectedProductIds =
            Model.Items

                .Where(x =>
                    x != currentItem &&
                    x.ProductId > 0)

                .Select(x =>
                    x.ProductId)

                .ToHashSet();


        return Products.Where(x =>
            x.Id == currentItem.ProductId
            ||
            !selectedProductIds.Contains(x.Id));
    }


    // =========================================================
    // PRODUCT CHANGED
    // =========================================================

    private Task ProductChanged(
    PurchaseOrderItemModel item,
    int productId)
{
    item.ProductTouched = true;

    ErrorMessage = null;

    // ==============================================
    // DUPLICATE PROTECTION
    // ==============================================

    var alreadySelected =
        Model.Items.Any(x =>
            x != item &&
            x.ProductId == productId);

    if (productId > 0 && alreadySelected)
    {
        ErrorMessage = L["ProductAlreadyAdded"];

        return Task.CompletedTask;
    }

    item.ProductId = productId;

    // ==============================================
    // DEFAULT PURCHASE PRICE
    // ==============================================

    var product =
        Products.FirstOrDefault(x =>
            x.Id == productId);

    if (product != null)
    {
        // Only automatically set the price
        // when the item has no price yet.
        if (item.UnitPrice <= 0)
        {
            item.UnitPrice = product.PurchasePrice;
        }
    }
    else
    {
        item.Quantity = 0;
        item.UnitPrice = 0;
    }

    return Task.CompletedTask;
}


    // =========================================================
    // REMOVE ITEM
    // =========================================================

    private void RemoveItem(
        PurchaseOrderItemModel item)
    {
        Model.Items.Remove(item);

        ErrorMessage =
            null;
    }


    // =========================================================
    // CALCULATE TOTAL
    // =========================================================

    private decimal CalculateTotal()
    {
        return Model.Items.Sum(x =>
            x.Quantity *
            x.UnitPrice);
    }


    // =========================================================
    // CREATE PURCHASE ORDER
    // =========================================================

    private async Task CreatePurchaseOrder()
    {
        if (IsSaving)
            return;


        IsSaving =
            true;

        ErrorMessage =
            null;


        try
        {
            // =================================================
            // SUPPLIER
            // =================================================

            if (Model.SupplierId <= 0)
            {
                SupplierTouched =
                    true;

                ErrorMessage =
                    L["SupplierSelectionRequired"];

                return;
            }


            // =================================================
            // ORDER NUMBER
            // =================================================

            var orderNumber =
                Model.OrderNumber?.Trim();


            if (string.IsNullOrWhiteSpace(
                orderNumber))
            {
                ErrorMessage =
                    L["OrderNumberRequired"];

                return;
            }


            if (orderNumber.Length > 50)
            {
                ErrorMessage =
                    L["OrderNumberMaxLength"];

                return;
            }


            // =================================================
            // ITEMS
            // =================================================

            if (Model.Items.Count == 0)
            {
                ErrorMessage =
                    L["AtLeastOneProductRequired"];

                return;
            }


            // =================================================
            // PRODUCT VALIDATION
            // =================================================

            var selectedProductIds =
                new HashSet<int>();


            foreach (var item in Model.Items)
            {
                // =============================================
                // PRODUCT
                // =============================================

                if (item.ProductId <= 0)
                {
                    item.ProductTouched =
                        true;

                    ErrorMessage =
                        L["ProductRequiredForEveryItem"];

                    return;
                }


                // =============================================
                // DUPLICATE PRODUCT
                // =============================================

                if (!selectedProductIds.Add(
                    item.ProductId))
                {
                    ErrorMessage =
                        L["ProductCanOnlyBeAddedOnce"];

                    return;
                }


                // =============================================
                // QUANTITY
                // =============================================

                if (item.Quantity <= 0)
                {
                    ErrorMessage =
                        L["QuantityMustBeGreaterThanZero"];

                    return;
                }


                // =============================================
                // UNIT PRICE
                // =============================================

                if (item.UnitPrice < 0)
                {
                    ErrorMessage =
                        L["UnitPriceCannotBeNegative"];

                    return;
                }
            }


            // =================================================
            // DATABASE
            // =================================================

            await using var db =
                await DbFactory.CreateDbContextAsync();


            // =================================================
            // SUPPLIER EXISTS
            // =================================================

            var supplierExists =
                await db.Suppliers

                    .AnyAsync(x =>

                        x.Id ==
                            Model.SupplierId

                        &&

                        x.IsActive
                    );


            if (!supplierExists)
            {
                ErrorMessage =
                    L["SelectedSupplierNotFoundOrInactive"];

                return;
            }


            // =================================================
            // ORDER NUMBER UNIQUE
            // =================================================

            var orderNumberExists =
                await db.PurchaseOrders

                    .AnyAsync(x =>
                        x.OrderNumber ==
                        orderNumber);


            if (orderNumberExists)
            {
                ErrorMessage =
                    L["OrderNumberAlreadyExists"];

                return;
            }


            // =================================================
            // PRODUCTS EXIST
            // =================================================

            var products =
                await db.Products

                    .Where(x =>
                        selectedProductIds.Contains(
                            x.Id)

                        &&

                        x.IsActive)

                    .ToDictionaryAsync(
                        x => x.Id);


            if (products.Count !=
                selectedProductIds.Count)
            {
                ErrorMessage =
                    L["SelectedProductsNotFoundOrInactive"];

                return;
            }


            // =================================================
            // CREATE ORDER
            // =================================================

            var purchaseOrder =
                new PurchaseOrder
                {
                    OrderNumber =
                        orderNumber,

                    SupplierId =
                        Model.SupplierId,

                    OrderDate =
                        Model.OrderDate,

                    Status =
                        PurchaseOrderStatus.Entwurf,

                    ReferenceNumber =
                        string.IsNullOrWhiteSpace(
                            Model.ReferenceNumber)

                            ? null

                            : Model.ReferenceNumber.Trim(),

                    Note =
                        string.IsNullOrWhiteSpace(
                            Model.Note)

                            ? null

                            : Model.Note.Trim(),

                    Total =
                        CalculateTotal(),

                    CreatedAt =
                        DateTime.UtcNow
                };


            db.PurchaseOrders.Add(
                purchaseOrder);


            // =================================================
            // CREATE ITEMS
            // =================================================

            foreach (var item in Model.Items)
            {
                var orderItem =
                    new PurchaseOrderItem
                    {
                        PurchaseOrder =
                            purchaseOrder,

                        ProductId =
                            item.ProductId,

                        Quantity =
                            item.Quantity,

                        UnitPrice =
                            item.UnitPrice,

                        DeliveredQuantity =
                            0
                    };


                purchaseOrder.Items.Add(
                    orderItem);
            }


            // =================================================
            // SAVE
            // =================================================

            await db.SaveChangesAsync();


            // =================================================
            // DETAILS
            // =================================================

            Navigation.NavigateTo(
                $"/purchase-orders/details/{purchaseOrder.Id}");
        }
        catch (DbUpdateException)
        {
            ErrorMessage =
                L["PurchaseOrderSaveError"];
        }
        catch (Exception ex)
        {
            ErrorMessage =
                L["PurchaseOrderCreateError", ex.Message];
        }
        finally
        {
            IsSaving =
                false;
        }
    }


    // =========================================================
    // CREATE MODEL
    // =========================================================

    private class PurchaseOrderCreateModel
    {
        public int SupplierId { get; set; }

        public string OrderNumber { get; set; }
            = string.Empty;

        public DateTime OrderDate { get; set; }
            = DateTime.Today;

        public string? ReferenceNumber { get; set; }

        public string? Note { get; set; }

        public List<PurchaseOrderItemModel> Items { get; set; }
            = new();
    }


    // =========================================================
    // ITEM MODEL
    // =========================================================

    private class PurchaseOrderItemModel
    {
        public int ProductId { get; set; }

        public decimal Quantity { get; set; }

        public decimal UnitPrice { get; set; }

        public bool ProductTouched { get; set; }
    }

}