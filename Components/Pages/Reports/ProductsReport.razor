@page "/reports/products"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using WarehouseManagement.Data
@using WarehouseManagement.Models
@using Microsoft.JSInterop
@using WarehouseManagement.Services

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ExcelExportService ExcelExport
@inject IJSRuntime JS

<PageTitle>Produktbericht</PageTitle>

<div class="stock-page">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="page-header">

        <div>
            <h1>Produktbericht</h1>

            <p>
                Bestände und Bewegungen einzelner Produkte analysieren.
            </p>
        </div>

        <div class="page-header-actions">

            <button type="button"
                    class="btn-secondary"
                    @onclick="ExportExcel"
                    disabled="@(PagedProducts.Count == 0)">
                📊 Excel exportieren
            </button>

            <a href="/reports"
               class="btn-secondary">

                ← Berichte


            </a>

        </div>

    </div>


    <!-- =========================================================
         FILTER
         ========================================================= -->

    <div class="filter-card">

        <div class="filter-main-row">

            <div class="search-box">

                <span class="search-icon">
                    <i class="bi bi-search"></i>
                </span>

                <input type="text"
                       placeholder="Produkt, SKU oder Barcode suchen..."
                       @bind="SearchTerm"
                       @bind:event="oninput" />

            </div>

            <select class="filter-select"
                    @bind="SelectedWarehouseId">

                <option value="0">Alle Lager</option>

                @foreach (var warehouse in Warehouses)
                {
                    <option value="@warehouse.Id">
                        @warehouse.Name
                    </option>
                }

            </select>

            <select class="filter-select"
                    @bind="SelectedCategoryId">

                <option value="0">Alle Kategorien</option>

                @foreach (var category in Categories)
                {
                    <option value="@category.Id">
                        @category.Name
                    </option>
                }

            </select>

        </div>

    </div>


    <!-- =========================================================
         SUMMARY
         ========================================================= -->

    <div class="stock-summary-grid">

        <div class="stock-summary-card">

            <span>
                Produkte
            </span>

            <strong>
                @FilteredProducts.Count
            </strong>

            <small>
                Gefilterte Produkte
            </small>

        </div>


        <div class="stock-summary-card">

            <span>
                Gesamtbestand
            </span>

            <strong>
                @(TotalQuantity.ToString("N2"))
            </strong>

            <small>
                Aktuelle Menge
            </small>

        </div>


        <div class="stock-summary-card">

            <span>
                Wareneingänge
            </span>

            <strong>
                @IncomingMovementCount
            </strong>

            <small>
                Eingänge
            </small>

        </div>


        <div class="stock-summary-card">

            <span>
                Warenausgänge
            </span>

            <strong>
                @OutgoingMovementCount
            </strong>

            <small>
                Ausgänge
            </small>

        </div>


        <div class="stock-summary-card">

            <span>
                Bewegungen
            </span>

            <strong>
                @MovementCount
            </strong>

            <small>
                Gesamtbewegungen
            </small>

        </div>

    </div>


    <!-- =========================================================
         TABLE
         ========================================================= -->

    <div class="products-card">

        <div class="products-card-header">

            <div>

                <strong>
                    Produktbericht
                </strong>

                <span>
                    @FilteredProducts.Count Einträge
                </span>

            </div>

        </div>


        @if (IsLoading)
        {
            <div class="loading-state">
                Produktdaten werden geladen...
            </div>
        }
        else if (PagedProducts.Count == 0)
        {
            <div class="empty-products">

                <div class="empty-products-icon">
                    <i class="bi bi-box-seam"></i>
                </div>

                <h3>
                    Keine Produkte gefunden
                </h3>

                <p>
                    Für die gewählten Filter wurden keine Produkte gefunden.
                </p>

            </div>
        }
        else
        {
            <div class="products-table-wrapper">

                <table class="products-table">

                    <thead>

                        <tr>

                            <th>
                                Produkt
                            </th>

                            <th>
                                SKU
                            </th>

                            <th>
                                Kategorie
                            </th>

                            <th>
                                Bestand
                            </th>

                            <th>
                                Reserviert
                            </th>

                            <th>
                                Verfügbar
                            </th>

                            <th>
                                Lagerwert
                            </th>

                            <th>
                                Bewegungen
                            </th>

                            <th>
                                Letzte Bewegung
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var product in PagedProducts)
                        {
                            var stockQuantity =
                                Stocks
                                    .Where(x => x.ProductId == product.Id)
                                    .Sum(x => x.Quantity);

                            var reservedQuantity =
                                Stocks
                                    .Where(x => x.ProductId == product.Id)
                                    .Sum(x => x.ReservedQuantity);

                            var availableQuantity =
                                stockQuantity - reservedQuantity;

                            var purchaseValue =
                                stockQuantity * product.PurchasePrice;

                            var productMovements =
                                Movements
                                    .Where(x => x.ProductId == product.Id)
                                    .ToList();

                            var lastMovement =
                                productMovements
                                    .OrderByDescending(x => x.CreatedAt)
                                    .FirstOrDefault();

                            <tr>

                                <!-- PRODUCT -->

                                <td>

                                    <div class="product-name">

                                        <div class="product-avatar">
                                            @GetInitials(product.Name)
                                        </div>

                                        <div>

                                            <strong>
                                                @product.Name
                                            </strong>

                                            @if (!string.IsNullOrWhiteSpace(product.Barcode))
                                            {
                                                <small>
                                                    @product.Barcode
                                                </small>
                                            }

                                        </div>

                                    </div>

                                </td>


                                <!-- SKU -->

                                <td>
                                    @product.SKU
                                </td>


                                <!-- CATEGORY -->

                                <td>

                                    @if (product.Category != null)
                                    {
                                        @product.Category.Name
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- QUANTITY -->

                                <td>
                                    @(stockQuantity.ToString("N2"))
                                </td>


                                <!-- RESERVED -->

                                <td>
                                    @(reservedQuantity.ToString("N2"))
                                </td>


                                <!-- AVAILABLE -->

                                <td>

                                    <strong>
                                        @(availableQuantity.ToString("N2"))
                                    </strong>

                                </td>


                                <!-- VALUE -->

                                <td>

                                    <strong>
                                        @(purchaseValue.ToString("N2")) €
                                    </strong>

                                </td>


                                <!-- MOVEMENTS -->

                                <td>
                                    @productMovements.Count
                                </td>


                                <!-- LAST MOVEMENT -->

                                <td>

                                    @if (lastMovement != null)
                                    {
                                        <div class="movement-location">

                                            <strong>
                                                @GetMovementTypeName(lastMovement.Type)
                                            </strong>

                                            <small>
                                                @lastMovement.CreatedAt
                                                .ToLocalTime()
                                                .ToString("dd.MM.yyyy HH:mm")
                                            </small>

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- =====================================================
                 PAGINATION
                 ===================================================== -->
            @if (TotalPages > 1)
            {
                <div class="pagination">

                    <button type="button"
                            class="pagination-button"
                            disabled="@(CurrentPage <= 1)"
                            @onclick="PreviousPage">
                        ‹
                    </button>

                    <div class="pagination-pages">

                        @foreach (var pageNumber in GetPageNumbers())
                        {
                            <button type="button"
                                    class="pagination-button @(pageNumber == CurrentPage ? "active" : "")"
                                    @onclick="() => GoToPage(pageNumber)">
                                @pageNumber
                            </button>
                        }

                    </div>

                    <button type="button"
                            class="pagination-button"
                            disabled="@(CurrentPage >= TotalPages)"
                            @onclick="NextPage">
                        ›
                    </button>

                </div>
            }

            <div class="pagination-info">

                Seite @CurrentPage von @TotalPages
                · @PagedProducts.Count von @FilteredProducts.Count Produkte

            </div>

        }

    </div>

</div>


@code {

    // =========================================================
    // DATA
    // =========================================================

    private List<Product> Products = new();

    private List<Models.Stock> Stocks = new();

    private List<StockMovement> Movements = new();

    private List<Warehouse> Warehouses = new();

    private List<Category> Categories = new();


    // =========================================================
    // FILTER
    // =========================================================

    private string _searchTerm = string.Empty;

    private string SearchTerm
    {
        get => _searchTerm;

        set
        {
            if (_searchTerm == value)
                return;

            _searchTerm = value;
            CurrentPage = 1;
        }
    }


    private int _selectedWarehouseId;

    private int SelectedWarehouseId
    {
        get => _selectedWarehouseId;

        set
        {
            if (_selectedWarehouseId == value)
                return;

            _selectedWarehouseId = value;
            CurrentPage = 1;
        }
    }


    private int _selectedCategoryId;

    private int SelectedCategoryId
    {
        get => _selectedCategoryId;

        set
        {
            if (_selectedCategoryId == value)
                return;

            _selectedCategoryId = value;
            CurrentPage = 1;
        }
    }


    // =========================================================
    // PAGINATION
    // =========================================================

    private const int PageSize = 10;

    private int CurrentPage = 1;


    private List<Product> PagedProducts =>
        FilteredProducts
            .Skip(
                (CurrentPage - 1) *
                PageSize)
            .Take(PageSize)
            .ToList();


    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                FilteredProducts.Count /
                (double)PageSize));


    private List<int> GetPageNumbers()
    {
        var pages = new List<int>();

        var start =
            Math.Max(
                1,
                CurrentPage - 2);

        var end =
            Math.Min(
                TotalPages,
                CurrentPage + 2);

        for (var i = start; i <= end; i++)
        {
            pages.Add(i);
        }

        return pages;
    }


    // =========================================================
    // STATE
    // =========================================================

    private bool IsLoading = true;


    // =========================================================
    // FILTERED PRODUCTS
    // =========================================================

    private List<Product> FilteredProducts
    {
        get
        {
            var query = Products.AsEnumerable();


            // SEARCH

            if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                var search = SearchTerm.Trim();

                query = query.Where(x =>
                    x.Name.Contains(
                        search,
                        StringComparison.OrdinalIgnoreCase)

                    ||

                    x.SKU.Contains(
                        search,
                        StringComparison.OrdinalIgnoreCase)

                    ||

                    (
                        !string.IsNullOrWhiteSpace(x.Barcode)

                        &&

                        x.Barcode.Contains(
                            search,
                            StringComparison.OrdinalIgnoreCase)
                    )
                );
            }


            // WAREHOUSE

            if (SelectedWarehouseId > 0)
            {
                var productIds =
                    Stocks
                        .Where(x =>
                            x.WarehouseLocation != null
                            &&
                            x.WarehouseLocation.WarehouseId ==
                                SelectedWarehouseId)
                        .Select(x => x.ProductId)
                        .Distinct()
                        .ToHashSet();

                query = query.Where(x =>
                    productIds.Contains(x.Id));
            }


            // CATEGORY

            if (SelectedCategoryId > 0)
            {
                query = query.Where(x =>
                    x.CategoryId == SelectedCategoryId);
            }


            return query
                .OrderBy(x => x.Name)
                .ToList();
        }
    }


    // =========================================================
    // SUMMARY
    // =========================================================

    private decimal TotalQuantity =>
        FilteredProducts.Sum(product =>
            Stocks
                .Where(x => x.ProductId == product.Id)
                .Sum(x => x.Quantity));


    private int MovementCount =>
        FilteredProducts.Sum(product =>
            Movements.Count(x =>
                x.ProductId == product.Id));


    private int IncomingMovementCount =>
        FilteredProducts.Sum(product =>
            Movements.Count(x =>
                x.ProductId == product.Id
                &&
                x.Type ==
                    StockMovementType.Wareneingang));


    private int OutgoingMovementCount =>
        FilteredProducts.Sum(product =>
            Movements.Count(x =>
                x.ProductId == product.Id
                &&
                x.Type ==
                    StockMovementType.Warenausgang));


    // =========================================================
    // LOAD
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }


    private async Task LoadData()
    {
        IsLoading = true;

        try
        {
            await using var context =
                await DbFactory.CreateDbContextAsync();


            // =====================================================
            // PRODUCTS
            // =====================================================

            Products =
                await context.Products
                    .AsNoTracking()
                    .Include(x => x.Category)
                    .Where(x => x.IsActive)
                    .OrderBy(x => x.Name)
                    .ToListAsync();


            // =====================================================
            // WAREHOUSES
            // =====================================================

            Warehouses =
                await context.Warehouses
                    .AsNoTracking()
                    .Where(x => x.IsActive)
                    .OrderBy(x => x.Name)
                    .ToListAsync();


            // =====================================================
            // CATEGORIES
            // =====================================================

            Categories =
                await context.Categories
                    .AsNoTracking()
                    .OrderBy(x => x.Name)
                    .ToListAsync();


            // =====================================================
            // STOCK
            // =====================================================

            Stocks =
                await context.Stocks
                    .AsNoTracking()
                    .Include(x => x.WarehouseLocation)
                    .ToListAsync();


            // =====================================================
            // MOVEMENTS
            // =====================================================

            Movements =
                await context.StockMovements
                    .AsNoTracking()
                    .ToListAsync();
        }
        finally
        {
            IsLoading = false;
        }
    }


    // =========================================================
    // PAGINATION
    // =========================================================

    private void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
        }
    }


    private void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
        }
    }


    private void GoToPage(int page)
    {
        if (page < 1)
            page = 1;

        if (page > TotalPages)
            page = TotalPages;

        CurrentPage = page;
    }


    // =========================================================
    // EXCEL EXPORT
    // =========================================================

    private async Task ExportExcel()
    {
        try
        {
            var data =
                PagedProducts.ToList();

            if (data.Count == 0)
                return;


            var bytes =
                ExcelExport.Export(
                    data,
                    "Produkte",
                    $"Produktbericht – Seite {CurrentPage}",

                    (
                        "Produkt",
                        x => x.Name
                    ),

                    (
                        "SKU",
                        x => x.SKU
                    ),

                    (
                        "Barcode",
                        x => x.Barcode ?? ""
                    ),

                    (
                        "Kategorie",
                        x => x.Category?.Name ?? ""
                    ),

                    (
                        "Bestand",
                        x => Stocks
                            .Where(s =>
                                s.ProductId == x.Id)
                            .Sum(s =>
                                s.Quantity)
                    ),

                    (
                        "Reserviert",
                        x => Stocks
                            .Where(s =>
                                s.ProductId == x.Id)
                            .Sum(s =>
                                s.ReservedQuantity)
                    ),

                    (
                        "Verfügbar",
                        x =>
                            Stocks
                                .Where(s =>
                                    s.ProductId == x.Id)
                                .Sum(s =>
                                    s.Quantity -
                                    s.ReservedQuantity)
                    ),

                    (
                        "Einkaufspreis",
                        x => x.PurchasePrice
                    ),

                    (
                        "Lagerwert",
                        x =>
                            Stocks
                                .Where(s =>
                                    s.ProductId == x.Id)
                                .Sum(s =>
                                    s.Quantity)
                            *
                            x.PurchasePrice
                    ),

                    (
                        "Verkaufspreis",
                        x => x.SalePrice
                    ),

                    (
                        "Bewegungen",
                        x => Movements
                            .Count(m =>
                                m.ProductId == x.Id)
                    ),

                    (
                        "Wareneingänge",
                        x => Movements
                            .Count(m =>
                                m.ProductId == x.Id
                                &&
                                m.Type ==
                                    StockMovementType.Wareneingang)
                    ),

                    (
                        "Warenausgänge",
                        x => Movements
                            .Count(m =>
                                m.ProductId == x.Id
                                &&
                                m.Type ==
                                    StockMovementType.Warenausgang)
                    ),

                    (
                        "Letzte Bewegung",
                        x =>
                            Movements
                                .Where(m =>
                                    m.ProductId == x.Id)
                                .OrderByDescending(m =>
                                    m.CreatedAt)
                                .Select(m =>
                                    m.CreatedAt)
                                .FirstOrDefault()
                    )
                );


            var base64 =
                Convert.ToBase64String(bytes);


            await JS.InvokeVoidAsync(
                "downloadFile",
                $"Produktbericht_Seite_{CurrentPage}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                base64);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Fehler beim Excel-Export: {ex}");
        }
    }


    // =========================================================
    // HELPERS
    // =========================================================

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";

        var words =
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);

        if (words.Length == 1)
        {
            return words[0]
                .Substring(
                    0,
                    Math.Min(
                        2,
                        words[0].Length))
                .ToUpper();
        }

        return
            $"{words[0][0]}{words[1][0]}"
                .ToUpper();
    }


    private string GetMovementTypeName(
        StockMovementType type)
    {
        return type switch
        {
            StockMovementType.Wareneingang =>
                "Wareneingang",

            StockMovementType.Warenausgang =>
                "Warenausgang",

            StockMovementType.Umlagerung =>
                "Umlagerung",

            StockMovementType.Inventur =>
                "Inventur",

            StockMovementType.Korrektur =>
                "Korrektur",

            _ =>
                type.ToString()
        };
    }

}