@page "/reports"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using WarehouseManagement.Localization
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Reports"]</PageTitle>

<div class="product-form-page">

    <!-- HEADER -->
    <div class="page-header">

        <div>
            <h1>@L["Reports"]</h1>

            <p>
                @L["ReportsOverviewDescription"]
            </p>
        </div>

    </div>


    <!-- REPORTS -->
    <div class="form-card">

        <div class="form-section">

            <div class="form-section-title">

                <h2>@L["AvailableReports"]</h2>

                <p>
                    @L["AvailableReportsDescription"]
                </p>

            </div>


            <div class="reports-grid">


                <!-- BESTAND -->

                <a href="/reports/stock"
                   class="report-card">

                    <div class="report-icon">
                        📦
                    </div>

                    <div class="report-content">

                        <h3>@L["StockReport"]</h3>

                        <p>
                            @L["StockReportDescription"]
                        </p>

                    </div>

                    <div class="report-arrow">
                        →
                    </div>

                </a>


                <!-- INVENTUR -->

                <a href="/reports/inventory"
                   class="report-card">

                    <div class="report-icon">
                        📋
                    </div>

                    <div class="report-content">

                        <h3>@L["InventoryReport"]</h3>

                        <p>
                            @L["InventoryReportDescription"]
                        </p>

                    </div>

                    <div class="report-arrow">
                        →
                    </div>

                </a>


                <!-- BEWEGUNGEN -->

                <a href="/reports/movements"
                   class="report-card">

                    <div class="report-icon">
                        🔄
                    </div>

                    <div class="report-content">

                        <h3>@L["StockMovementsReport"]</h3>

                        <p>
                            @L["StockMovementsReportDescription"]
                        </p>

                    </div>

                    <div class="report-arrow">
                        →
                    </div>

                </a>


                <!-- LIEFERANTEN -->

                <a href="/reports/suppliers"
                   class="report-card">

                    <div class="report-icon">
                        🚚
                    </div>

                    <div class="report-content">

                        <h3>@L["SupplierReport"]</h3>

                        <p>
                            @L["SupplierReportDescription"]
                        </p>

                    </div>

                    <div class="report-arrow">
                        →
                    </div>

                </a>


                <!-- NIEDRIGBESTAND -->

                <a href="/reports/low-stock"
                   class="report-card">

                    <div class="report-icon">
                        ⚠️
                    </div>

                    <div class="report-content">

                        <h3>@L["LowStockReport"]</h3>

                        <p>
                            @L["LowStockReportDescription"]
                        </p>

                    </div>

                    <div class="report-arrow">
                        →
                    </div>

                </a>


                <!-- LAGERWERT -->

                <a href="/reports/value"
                   class="report-card">

                    <div class="report-icon">
                        💰
                    </div>

                    <div class="report-content">

                        <h3>@L["StockValueReport"]</h3>

                        <p>
                            @L["StockValueReportDescription"]
                        </p>

                    </div>

                    <div class="report-arrow">
                        →
                    </div>

                </a>


                <!-- PRODUKT -->

                <a href="/reports/products"
                   class="report-card">

                    <div class="report-icon">
                        📊
                    </div>

                    <div class="report-content">

                        <h3>@L["ProductReport"]</h3>

                        <p>
                            @L["ProductReportDescription"]
                        </p>

                    </div>

                    <div class="report-arrow">
                        →
                    </div>

                </a>


            </div>

        </div>

    </div>

</div>