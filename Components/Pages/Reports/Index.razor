@page "/reports"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
<PageTitle>Berichte</PageTitle>

<div class="product-form-page">

    <!-- HEADER -->
    <div class="page-header">

        <div>
            <h1>Berichte</h1>

            <p>
                Übersicht und Auswertungen Ihrer Lagerverwaltung
            </p>
        </div>

    </div>


    <!-- REPORTS -->
    <div class="form-card">

        <div class="form-section">

            <div class="form-section-title">

                <h2>Verfügbare Berichte</h2>

                <p>
                    Wählen Sie einen Bericht aus, um die entsprechenden
                    Lagerdaten auszuwerten.
                </p>

            </div>


            <div class="reports-grid">


                <!-- BESTAND -->

                <a href="/reports/stock"
                   class="report-card">

                    <div class="report-icon">
                        📦
                    </div>

                    <div class="report-content">

                        <h3>Bestandsbericht</h3>

                        <p>
                            Aktuellen Lagerbestand nach Produkt,
                            Lager und Lagerplatz anzeigen.
                        </p>

                    </div>

                    <div class="report-arrow">
                        →
                    </div>

                </a>


                <!-- INVENTUR -->

                <a href="/reports/inventory"
                   class="report-card">

                    <div class="report-icon">
                        📋
                    </div>

                    <div class="report-content">

                        <h3>Inventurbericht</h3>

                        <p>
                            Inventuren, gezählte Mengen und
                            Bestandsabweichungen auswerten.
                        </p>

                    </div>

                    <div class="report-arrow">
                        →
                    </div>

                </a>


                <!-- BEWEGUNGEN -->

                <a href="/reports/movements"
                   class="report-card">

                    <div class="report-icon">
                        🔄
                    </div>

                    <div class="report-content">

                        <h3>Warenbewegungen</h3>

                        <p>
                            Wareneingänge, Warenausgänge und
                            Umlagerungen analysieren.
                        </p>

                    </div>

                    <div class="report-arrow">
                        →
                    </div>

                </a>


                <!-- LIEFERANTEN -->

                <a href="/reports/suppliers"
                   class="report-card">

                    <div class="report-icon">
                        🚚
                    </div>

                    <div class="report-content">

                        <h3>Lieferantenbericht</h3>

                        <p>
                            Lieferanten, Wareneingänge und
                            Warenbewegungen nach Lieferant auswerten.
                        </p>

                    </div>

                    <div class="report-arrow">
                        →
                    </div>

                </a>


                <!-- NIEDRIGBESTAND -->

                <a href="/reports/low-stock"
                   class="report-card">

                    <div class="report-icon">
                        ⚠️
                    </div>

                    <div class="report-content">

                        <h3>Niedrigbestand</h3>

                        <p>
                            Produkte mit niedrigem oder kritischem
                            Lagerbestand anzeigen.
                        </p>

                    </div>

                    <div class="report-arrow">
                        →
                    </div>

                </a>


                <!-- LAGERWERT -->

                <a href="/reports/value"
                   class="report-card">

                    <div class="report-icon">
                        💰
                    </div>

                    <div class="report-content">

                        <h3>Lagerwert</h3>

                        <p>
                            Gesamtwert des aktuellen Lagerbestands
                            auswerten.
                        </p>

                    </div>

                    <div class="report-arrow">
                        →
                    </div>

                </a>


                <!-- PRODUKT -->

                <a href="/reports/products"
                   class="report-card">

                    <div class="report-icon">
                        📊
                    </div>

                    <div class="report-content">

                        <h3>Produktbericht</h3>

                        <p>
                            Bestände und Bewegungen einzelner
                            Produkte analysieren.
                        </p>

                    </div>

                    <div class="report-arrow">
                        →
                    </div>

                </a>


            </div>

        </div>

    </div>

</div>