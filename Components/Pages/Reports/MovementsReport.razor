@page "/reports/movements"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using WarehouseManagement.Data
@using WarehouseManagement.Models
@using Microsoft.JSInterop
@using WarehouseManagement.Services
@using Microsoft.Extensions.Localization
@using WarehouseManagement.Localization
@using WarehouseManagement.Components

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ExcelExportService ExcelExport
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["StockMovementsReport"]</PageTitle>

<div class="stock-page">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="page-header">

        <div>

            <h1>
                @L["StockMovementsReport"]
            </h1>

            <p>
                @L["StockMovementsReportDescription"]
            </p>

        </div>

        <div class="page-header-actions">

            <button type="button"
                    class="btn-secondary"
                    @onclick="ExportExcel"
                    disabled="@(PagedMovements.Count == 0)">

                📊 @L["ExportExcel"]

            </button>

            <a href="/reports"
               class="btn-secondary">

                ← @L["Reports"]

            </a>

        </div>

    </div>


    <!-- =========================================================
         FILTER
         ========================================================= -->

    <div class="filter-card">

        <div class="filter-main-row">

            <div class="search-box">

                <span class="search-icon">
                    <i class="bi bi-search"></i>
                </span>

                <input type="text"
                       placeholder="@L["SearchProductSkuBarcodeSupplierReferencePlaceholder"]"
                       @bind="SearchTerm"
                       @bind:event="oninput" />

            </div>


            <SearchableSelect TItem="MovementTypeOption"
                              TValue="int"
                              Items="MovementTypeOptions"
                              Value="SelectedType"
                              ValueChanged="OnTypeChanged"
                              ValueSelector="@(x => x.Value)"
                              TextSelector="@(x => x.Text)"
                              Placeholder="@L["AllMovements"]"
                              NoResultsText="@L["NoResultsFound"]"
                              ShowAllOption="true"
                              AllOptionText="@L["AllMovements"]"
                              AllValue="0" />


            <SearchableSelect TItem="Warehouse"
                              TValue="int"
                              Items="Warehouses"
                              Value="SelectedWarehouseId"
                              ValueChanged="OnWarehouseChanged"
                              ValueSelector="@(x => x.Id)"
                              TextSelector="@(x => x.Name)"
                              Placeholder="@L["AllWarehouses"]"
                              NoResultsText="@L["NoResultsFound"]"
                              ShowAllOption="true"
                              AllOptionText="@L["AllWarehouses"]"
                              AllValue="0" />


            <SearchableSelect TItem="WarehouseLocation"
                              TValue="int"
                              Items="Locations"
                              Value="SelectedLocationId"
                              ValueChanged="OnLocationChanged"
                              ValueSelector="@(x => x.Id)"
                              TextSelector="@(x => string.IsNullOrWhiteSpace(x.Name)
                                  ? x.Code
                                  : $"{x.Code} - {x.Name}")"
                              Placeholder="@L["AllLocations"]"
                              NoResultsText="@L["NoResultsFound"]"
                              ShowAllOption="true"
                              AllOptionText="@L["AllLocations"]"
                              AllValue="0" />

        </div>


        <!-- =====================================================
             DATE FILTER
             ===================================================== -->

        <div class="filter-date-row">

            <div class="filter-date-group">

                <label>
                    @L["From"]
                </label>

                <input type="date"
                       class="filter-date-input"
                       @bind="FromDate" />

            </div>


            <div class="filter-date-group">

                <label>
                    @L["To"]
                </label>

                <input type="date"
                       class="filter-date-input"
                       @bind="ToDate" />

            </div>


            @if (HasActiveFilters)
            {
                <button type="button"
                        class="btn-secondary filter-reset"
                        @onclick="ResetFilters">

                    <i class="bi bi-arrow-counterclockwise me-1"></i>

                    @L["ResetFilters"]

                </button>
            }

        </div>

    </div>


    <!-- =========================================================
         CONTENT
         ========================================================= -->
    @if (IsLoading)
    {
        <div class="loading-state">

            @L["LoadingMovements"]

        </div>
    }
    else
    {

        <!-- =====================================================
             SUMMARY
             ===================================================== -->

        <div class="stock-summary-grid">

            <div class="stock-summary-card">

                <span>
                    @L["Movements"]
                </span>

                <strong>
                    @FilteredMovements.Count
                </strong>

            </div>


            <div class="stock-summary-card">

                <span>
                    @L["IncomingGoods"]
                </span>

                <strong>
                    @IncomingCount
                </strong>

            </div>


            <div class="stock-summary-card">

                <span>
                    @L["OutgoingGoods"]
                </span>

                <strong>
                    @OutgoingCount
                </strong>

            </div>


            <div class="stock-summary-card">

                <span>
                    @L["Transfers"]
                </span>

                <strong>
                    @TransferCount
                </strong>

            </div>


            <div class="stock-summary-card">

                <span>
                    @L["Inventory"]
                </span>

                <strong>
                    @InventoryCount
                </strong>

            </div>

        </div>


        <!-- =====================================================
             TABLE
             ===================================================== -->

        <div class="products-card">

            @if (FilteredMovements.Count == 0)
            {
                <div class="empty-products">

                    <div class="empty-products-icon">

                        <i class="bi bi-arrow-left-right"></i>

                    </div>

                    <h3>
                        @L["NoMovementsFound"]
                    </h3>

                    <p>
                        @L["NoMovementsForFilters"]
                    </p>

                </div>
            }
            else
            {

                <div class="products-table-wrapper">

                    <table class="products-table">

                        <thead>

                            <tr>

                                <th>
                                    @L["Date"]
                                </th>

                                <th>
                                    @L["Product"]
                                </th>

                                <th>
                                    @L["Type"]
                                </th>

                                <th>
                                    @L["Quantity"]
                                </th>

                                <th>
                                    @L["From"]
                                </th>

                                <th>
                                    @L["To"]
                                </th>

                                <th>
                                    @L["Supplier"]
                                </th>

                                <th>
                                    @L["Reference"]
                                </th>

                                <th>
                                    @L["Note"]
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var movement in PagedMovements)
                            {
                                <tr>

                                    <td>

                                        <div class="movement-date">

                                            <strong>
                                                @(movement.CreatedAt
                                                    .ToLocalTime()
                                                    .ToString("dd.MM.yyyy"))
                                            </strong>

                                            <small>
                                                @(movement.CreatedAt
                                                    .ToLocalTime()
                                                    .ToString("HH:mm"))
                                            </small>

                                        </div>

                                    </td>


                                    <td>

                                        <div class="product-name">

                                            <div class="product-avatar">

                                                @GetInitials(
                                                    movement.Product?.Name)

                                            </div>

                                            <div>

                                                <strong>
                                                    @(movement.Product?.Name ?? "-")
                                                </strong>

                                                <small>
                                                    @(movement.Product?.SKU ?? "-")
                                                </small>

                                            </div>

                                        </div>

                                    </td>


                                    <td>

                                        @switch (movement.Type)
                                        {
                                            case StockMovementType.Wareneingang:

                                                <span class="movement-badge movement-in">

                                                    <i class="bi bi-arrow-down-circle me-1"></i>

                                                    @L["IncomingGoods"]

                                                </span>

                                                break;


                                            case StockMovementType.Warenausgang:

                                                <span class="movement-badge movement-out">

                                                    <i class="bi bi-arrow-up-circle me-1"></i>

                                                    @L["OutgoingGoods"]

                                                </span>

                                                break;


                                            case StockMovementType.Umlagerung:

                                                <span class="movement-badge movement-transfer">

                                                    <i class="bi bi-arrow-left-right me-1"></i>

                                                    @L["Transfer"]

                                                </span>

                                                break;


                                            case StockMovementType.Inventur:

                                                <span class="movement-badge movement-inventory">

                                                    <i class="bi bi-clipboard-check me-1"></i>

                                                    @L["Inventory"]

                                                </span>

                                                break;


                                            case StockMovementType.Korrektur:

                                                <span class="movement-badge movement-correction">

                                                    <i class="bi bi-pencil-square me-1"></i>

                                                    @L["Correction"]

                                                </span>

                                                break;


                                            default:

                                                <span class="movement-badge">

                                                    @movement.Type

                                                </span>

                                                break;
                                        }

                                    </td>


                                    <td>

                                        <strong>

                                            @if (movement.Type ==
                                                StockMovementType.Warenausgang)
                                            {
                                                <span>
                                                    −@movement.Quantity.ToString("N2")
                                                </span>
                                            }
                                            else if (movement.Type ==
                                                     StockMovementType.Wareneingang)
                                            {
                                                <span>
                                                    +@movement.Quantity.ToString("N2")
                                                </span>
                                            }
                                            else
                                            {
                                                <span>
                                                    @movement.Quantity.ToString("N2")
                                                </span>
                                            }

                                        </strong>

                                    </td>


                                    <td>

                                        @if (movement.FromWarehouseLocation != null)
                                        {
                                            <div class="movement-location">

                                                <strong>
                                                    @movement.FromWarehouseLocation.Code
                                                </strong>

                                                @if (movement.FromWarehouseLocation.Warehouse != null)
                                                {
                                                    <small>
                                                        @movement.FromWarehouseLocation.Warehouse.Name
                                                    </small>
                                                }

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        @if (movement.ToWarehouseLocation != null)
                                        {
                                            <div class="movement-location">

                                                <strong>
                                                    @movement.ToWarehouseLocation.Code
                                                </strong>

                                                @if (movement.ToWarehouseLocation.Warehouse != null)
                                                {
                                                    <small>
                                                        @movement.ToWarehouseLocation.Warehouse.Name
                                                    </small>
                                                }

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        @if (movement.Supplier != null)
                                        {
                                            <div class="movement-location">

                                                <strong>
                                                    @movement.Supplier.CompanyName
                                                </strong>

                                                @if (!string.IsNullOrWhiteSpace(
                                                    movement.Supplier.SupplierNumber))
                                                {
                                                    <small>
                                                        @movement.Supplier.SupplierNumber
                                                    </small>
                                                }

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(
                                            movement.ReferenceNumber))
                                        {
                                            <span>
                                                @movement.ReferenceNumber
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(
                                            movement.Note))
                                        {
                                            <span class="movement-note">
                                                @movement.Note
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>


                <!-- =================================================
                     PAGINATION
                     ================================================= -->
                @if (TotalPages > 1)
                {
                    <div class="pagination">

                        <button type="button"
                                class="pagination-button"
                                disabled="@(CurrentPage <= 1)"
                                @onclick="PreviousPage">

                            ‹

                        </button>


                        <div class="pagination-pages">

                            @foreach (var pageNumber in GetPageNumbers())
                            {
                                <button type="button"
                                        class="pagination-button @(pageNumber == CurrentPage ? "active" : "")"
                                        @onclick="() => GoToPage(pageNumber)">

                                    @pageNumber

                                </button>
                            }

                        </div>


                        <button type="button"
                                class="pagination-button"
                                disabled="@(CurrentPage >= TotalPages)"
                                @onclick="NextPage">

                            ›

                        </button>

                    </div>
                }


                <div class="pagination-info">

                    @L["PageOf", CurrentPage, TotalPages]

                    ·

                    @L["PaginationMovements",
                        PagedMovements.Count,
                        FilteredMovements.Count]

                </div>

            }

        </div>

    }

</div>


@code {

    // =========================================================
    // DATA
    // =========================================================

    private List<StockMovement> Movements = new();

    private List<Warehouse> Warehouses = new();

    private List<WarehouseLocation> Locations = new();


    // =========================================================
    // FILTER
    // =========================================================

    private string _searchTerm = string.Empty;

    private string SearchTerm
    {
        get => _searchTerm;

        set
        {
            if (_searchTerm == value)
                return;

            _searchTerm = value;

            CurrentPage = 1;
        }
    }


    private string _tableSearchTerm = string.Empty;

    private string TableSearchTerm
    {
        get => _tableSearchTerm;

        set
        {
            if (_tableSearchTerm == value)
                return;

            _tableSearchTerm = value;

            CurrentPage = 1;
        }
    }


    private int _selectedType;

    private int SelectedType
    {
        get => _selectedType;

        set
        {
            if (_selectedType == value)
                return;

            _selectedType = value;

            CurrentPage = 1;
        }
    }


    private class MovementTypeOption
    {
        public int Value { get; set; }

        public string Text { get; set; } = string.Empty;
    }

    private List<MovementTypeOption> MovementTypeOptions = new();


    private int _selectedWarehouseId;

    private int SelectedWarehouseId
    {
        get => _selectedWarehouseId;

        set
        {
            if (_selectedWarehouseId == value)
                return;

            _selectedWarehouseId = value;

            CurrentPage = 1;
        }
    }


    private int _selectedLocationId;

    private int SelectedLocationId
    {
        get => _selectedLocationId;

        set
        {
            if (_selectedLocationId == value)
                return;

            _selectedLocationId = value;

            CurrentPage = 1;
        }
    }


    private DateTime? _fromDate;

    private DateTime? FromDate
    {
        get => _fromDate;

        set
        {
            if (_fromDate == value)
                return;

            _fromDate = value;

            CurrentPage = 1;
        }
    }


    private DateTime? _toDate;

    private DateTime? ToDate
    {
        get => _toDate;

        set
        {
            if (_toDate == value)
                return;

            _toDate = value;

            CurrentPage = 1;
        }
    }


    // =========================================================
    // PAGINATION
    // =========================================================

    private const int PageSize = 10;

    private int CurrentPage = 1;


    private List<StockMovement> PagedMovements =>
        FilteredMovements
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();


    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                FilteredMovements.Count /
                (double)PageSize));


    private List<int> GetPageNumbers()
    {
        var pages = new List<int>();

        var start =
            Math.Max(
                1,
                CurrentPage - 2);

        var end =
            Math.Min(
                TotalPages,
                CurrentPage + 2);

        for (var i = start; i <= end; i++)
        {
            pages.Add(i);
        }

        return pages;
    }


    // =========================================================
    // STATE
    // =========================================================

    private bool IsLoading = true;


    // =========================================================
    // FILTERED MOVEMENTS
    // =========================================================

    private List<StockMovement> FilteredMovements =>
        Movements
            .Where(MatchesSearch)
            .Where(MatchesTableSearch)
            .Where(MatchesType)
            .Where(MatchesWarehouse)
            .Where(MatchesLocation)
            .Where(MatchesDate)
            .OrderByDescending(x => x.CreatedAt)
            .ToList();


    // =========================================================
    // SUMMARY
    // =========================================================

    private int IncomingCount =>
        FilteredMovements.Count(x =>
            x.Type == StockMovementType.Wareneingang);


    private int OutgoingCount =>
        FilteredMovements.Count(x =>
            x.Type == StockMovementType.Warenausgang);


    private int TransferCount =>
        FilteredMovements.Count(x =>
            x.Type == StockMovementType.Umlagerung);


    private int InventoryCount =>
        FilteredMovements.Count(x =>
            x.Type == StockMovementType.Inventur);


    // =========================================================
    // ACTIVE FILTERS
    // =========================================================

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(SearchTerm)
        ||
        !string.IsNullOrWhiteSpace(TableSearchTerm)
        ||
        SelectedType > 0
        ||
        SelectedWarehouseId > 0
        ||
        SelectedLocationId > 0
        ||
        FromDate.HasValue
        ||
        ToDate.HasValue;


    // =========================================================
    // MAIN SEARCH
    // =========================================================

    private bool MatchesSearch(StockMovement movement)
    {
        if (string.IsNullOrWhiteSpace(SearchTerm))
            return true;

        var search = SearchTerm.Trim();

        return
            (
                movement.Product != null
                &&
                movement.Product.Name.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
            )
            ||
            (
                movement.Product != null
                &&
                movement.Product.SKU.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
            )
            ||
            (
                movement.Product != null
                &&
                !string.IsNullOrWhiteSpace(
                    movement.Product.Barcode)
                &&
                movement.Product.Barcode.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
            )
            ||
            (
                movement.Supplier != null
                &&
                movement.Supplier.CompanyName.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
            )
            ||
            (
                movement.Supplier != null
                &&
                !string.IsNullOrWhiteSpace(
                    movement.Supplier.SupplierNumber)
                &&
                movement.Supplier.SupplierNumber.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
            )
            ||
            (
                !string.IsNullOrWhiteSpace(
                    movement.ReferenceNumber)
                &&
                movement.ReferenceNumber.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
            )
            ||
            (
                !string.IsNullOrWhiteSpace(
                    movement.Note)
                &&
                movement.Note.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
            );
    }


    // =========================================================
    // TABLE SEARCH
    // =========================================================

    private bool MatchesTableSearch(StockMovement movement)
    {
        if (string.IsNullOrWhiteSpace(TableSearchTerm))
            return true;

        var search = TableSearchTerm.Trim();

        return
            (
                movement.Product != null
                &&
                movement.Product.Name.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
            )
            ||
            (
                movement.Product != null
                &&
                movement.Product.SKU.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
            )
            ||
            (
                movement.Product != null
                &&
                !string.IsNullOrWhiteSpace(
                    movement.Product.Barcode)
                &&
                movement.Product.Barcode.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
            )
            ||
            (
                movement.Supplier != null
                &&
                movement.Supplier.CompanyName.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
            )
            ||
            (
                !string.IsNullOrWhiteSpace(
                    movement.ReferenceNumber)
                &&
                movement.ReferenceNumber.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
            )
            ||
            (
                !string.IsNullOrWhiteSpace(
                    movement.Note)
                &&
                movement.Note.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
            )
            ||
            movement.Quantity
                .ToString("N2")
                .Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
            ||
            movement.Type
                .ToString()
                .Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase);
    }


    // =========================================================
    // TYPE
    // =========================================================

    private bool MatchesType(StockMovement movement)
    {
        if (SelectedType == 0)
            return true;

        return movement.Type ==
            (StockMovementType)SelectedType;
    }


    // =========================================================
    // WAREHOUSE
    // =========================================================

    private bool MatchesWarehouse(StockMovement movement)
    {
        if (SelectedWarehouseId == 0)
            return true;

        return
            (
                movement.FromWarehouseLocation != null
                &&
                movement.FromWarehouseLocation.WarehouseId ==
                    SelectedWarehouseId
            )
            ||
            (
                movement.ToWarehouseLocation != null
                &&
                movement.ToWarehouseLocation.WarehouseId ==
                    SelectedWarehouseId
            );
    }


    // =========================================================
    // LOCATION
    // =========================================================

    private bool MatchesLocation(StockMovement movement)
    {
        if (SelectedLocationId == 0)
            return true;

        return
            (
                movement.FromWarehouseLocation != null
                &&
                movement.FromWarehouseLocation.Id ==
                    SelectedLocationId
            )
            ||
            (
                movement.ToWarehouseLocation != null
                &&
                movement.ToWarehouseLocation.Id ==
                    SelectedLocationId
            );
    }


    // =========================================================
    // DATE
    // =========================================================

    private bool MatchesDate(StockMovement movement)
    {
        var date =
            movement.CreatedAt.ToLocalTime().Date;

        if (FromDate.HasValue &&
            date < FromDate.Value.Date)
        {
            return false;
        }

        if (ToDate.HasValue &&
            date > ToDate.Value.Date)
        {
            return false;
        }

        return true;
    }


    // =========================================================
    // LOAD
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        MovementTypeOptions = new List<MovementTypeOption>
        {
            new()
            {
                Value = (int)StockMovementType.Wareneingang,
                Text = L["IncomingGoods"].Value
            },
            new()
            {
                Value = (int)StockMovementType.Warenausgang,
                Text = L["OutgoingGoods"].Value
            },
            new()
            {
                Value = (int)StockMovementType.Umlagerung,
                Text = L["Transfer"].Value
            },
            new()
            {
                Value = (int)StockMovementType.Inventur,
                Text = L["Inventory"].Value
            },
            new()
            {
                Value = (int)StockMovementType.Korrektur,
                Text = L["Correction"].Value
            }
        };

        await LoadData();
    }


    private async Task LoadData()
    {
        IsLoading = true;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            Warehouses =
                await db.Warehouses
                    .AsNoTracking()
                    .Where(x => x.IsActive)
                    .OrderBy(x => x.Name)
                    .ToListAsync();


            Locations =
                await db.WarehouseLocations
                    .AsNoTracking()
                    .Include(x => x.Warehouse)
                    .Where(x => x.IsActive)
                    .OrderBy(x => x.Code)
                    .ToListAsync();


            Movements =
                await db.StockMovements
                    .AsNoTracking()

                    .Include(x =>
                        x.Product)

                    .Include(x =>
                        x.Supplier)

                    .Include(x =>
                        x.FromWarehouseLocation)
                        .ThenInclude(x =>
                            x.Warehouse)

                    .Include(x =>
                        x.ToWarehouseLocation)
                        .ThenInclude(x =>
                            x.Warehouse)

                    .OrderByDescending(x =>
                        x.CreatedAt)

                    .ToListAsync();
        }
        finally
        {
            IsLoading = false;
        }
    }


    // =========================================================
    // FILTER CALLBACKS
    // =========================================================

    private Task OnTypeChanged(int value)
    {
        SelectedType = value;
        CurrentPage = 1;

        return InvokeAsync(StateHasChanged);
    }

    private Task OnWarehouseChanged(int value)
    {
        SelectedWarehouseId = value;
        SelectedLocationId = 0;
        CurrentPage = 1;

        return InvokeAsync(StateHasChanged);
    }

    private Task OnLocationChanged(int value)
    {
        SelectedLocationId = value;
        CurrentPage = 1;

        return InvokeAsync(StateHasChanged);
    }


    // =========================================================
    // RESET
    // =========================================================

    private void ResetFilters()
    {
        SearchTerm = string.Empty;

        TableSearchTerm = string.Empty;

        SelectedType = 0;

        SelectedWarehouseId = 0;

        SelectedLocationId = 0;

        FromDate = null;

        ToDate = null;

        CurrentPage = 1;

        InvokeAsync(StateHasChanged);
    }


    // =========================================================
    // PAGINATION
    // =========================================================

    private void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
        }
    }


    private void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
        }
    }


    private void GoToPage(int page)
    {
        if (page < 1)
            page = 1;

        if (page > TotalPages)
            page = TotalPages;

        CurrentPage = page;
    }


    // =========================================================
    // EXCEL EXPORT
    // =========================================================

    private async Task ExportExcel()
    {
        try
        {
            var data =
                PagedMovements.ToList();

            if (data.Count == 0)
                return;


            var bytes =
                ExcelExport.Export(
                    data,

                    L["StockMovementsReport"].Value,

                    $"{L["StockMovementsReport"].Value} – {L["Page"].Value} {CurrentPage}",

                    (
                        L["Date"].Value,
                        x => x.CreatedAt
                    ),

                    (
                        L["SKU"].Value,
                        x => x.Product?.SKU ?? ""
                    ),

                    (
                        L["Product"].Value,
                        x => x.Product?.Name ?? ""
                    ),

                    (
                        L["Type"].Value,
                        x => GetMovementTypeText(x.Type)
                    ),

                    (
                        L["Quantity"].Value,
                        x => x.Quantity
                    ),

                    (
                        L["From"].Value,
                        x => x.FromWarehouseLocation == null
                            ? ""
                            : $"{x.FromWarehouseLocation.Code} - {x.FromWarehouseLocation.Warehouse?.Name ?? ""}"
                    ),

                    (
                        L["To"].Value,
                        x => x.ToWarehouseLocation == null
                            ? ""
                            : $"{x.ToWarehouseLocation.Code} - {x.ToWarehouseLocation.Warehouse?.Name ?? ""}"
                    ),

                    (
                        L["Supplier"].Value,
                        x => x.Supplier?.CompanyName ?? ""
                    ),

                    (
                        L["Reference"].Value,
                        x => x.ReferenceNumber ?? ""
                    ),

                    (
                        L["Note"].Value,
                        x => x.Note ?? ""
                    )
                );


            var base64 =
                Convert.ToBase64String(bytes);


            await JS.InvokeVoidAsync(
                "downloadFile",

                $"{L["StockMovementsReport"].Value}_{L["Page"].Value}_{CurrentPage}.xlsx",

                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",

                base64);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Fehler beim Excel-Export: {ex}");
        }
    }


    // =========================================================
    // MOVEMENT TYPE TEXT
    // =========================================================

    private string GetMovementTypeText(
        StockMovementType type)
    {
        return type switch
        {
            StockMovementType.Wareneingang =>
                L["IncomingGoods"].Value,

            StockMovementType.Warenausgang =>
                L["OutgoingGoods"].Value,

            StockMovementType.Umlagerung =>
                L["Transfer"].Value,

            StockMovementType.Inventur =>
                L["Inventory"].Value,

            StockMovementType.Korrektur =>
                L["Correction"].Value,

            _ =>
                type.ToString()
        };
    }


    // =========================================================
    // INITIALS
    // =========================================================

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";


        var words =
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);


        if (words.Length == 1)
        {
            return words[0]
                .Substring(
                    0,
                    Math.Min(
                        2,
                        words[0].Length))
                .ToUpper();
        }


        return
            $"{words[0][0]}{words[1][0]}"
                .ToUpper();
    }

