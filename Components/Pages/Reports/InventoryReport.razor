@page "/reports/inventory"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using Microsoft.Extensions.Localization
@using WarehouseManagement.Data
@using WarehouseManagement.Models
@using WarehouseManagement.Services
@using WarehouseManagement.Localization

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ExcelExportService ExcelExport
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["InventoryReport"]</PageTitle>

<style>

    /* =========================================================
               INVENTORY REPORT FILTER
               ========================================================= */

    .inventory-report-filter {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .inventory-report-filter-row {
        display: grid;
        grid-template-columns: minmax(320px, 2fr) minmax(180px, 1fr) minmax(180px, 1fr) auto;
        gap: 10px;
        width: 100%;
        align-items: center;
    }

        .inventory-report-filter-row > * {
            min-width: 0;
        }

        .inventory-report-filter-row .search-box {
            width: 100%;
            max-width: none;
        }

        .inventory-report-filter-row .filter-select {
            width: 100%;
        }

    .inventory-report-reset {
        height: 40px;
        white-space: nowrap;
    }

    /* =========================================================
               RESPONSIVE
               ========================================================= */

    @@media (max-width: 1000px) {

        .inventory-report-filter-row {
            grid-template-columns: minmax(280px, 2fr) minmax(170px, 1fr);
        }

        .inventory-report-reset {
            width: fit-content;
        }
    }

    @@media (max-width: 600px) {

        .inventory-report-filter-row {
            grid-template-columns: 1fr;
        }

        .inventory-report-reset {
            width: 100%;
        }
    }

</style>


<div class="stock-page">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="page-header">

        <div>

            <h1>
                @L["InventoryReport"]
            </h1>

            <p>
                @L["InventoryReportDescription"]
            </p>

        </div>

        <div class="page-header-actions">

            <button type="button"
                    class="btn-secondary"
                    @onclick="ExportExcel"
                    disabled="@(PagedInventories.Count == 0)">

                📊 @L["ExportExcel"]

            </button>

            <a href="/reports"
               class="btn-secondary">

                ← @L["Reports"]

            </a>

        </div>

    </div>


    @if (IsLoading)
    {
        <div class="loading-state">

            @L["LoadingInventories"]

        </div>
    }
    else
    {

        <!-- =====================================================
             FILTER
             ===================================================== -->

        <div class="filter-card inventory-report-filter">

            <div class="inventory-report-filter-row">

                <!-- SEARCH -->

                <div class="search-box">

                    <span class="search-icon">
                        ⌕
                    </span>

                    <input type="text"
                           placeholder="@L["SearchWarehouseOrNotePlaceholder"]"
                           @bind="SearchTerm"
                           @bind:event="oninput"
                           @bind:after="SearchChanged" />

                </div>


                <!-- WAREHOUSE -->

                <select class="filter-select"
                        @bind="SelectedWarehouseId"
                        @bind:after="FilterChanged">

                    <option value="0">
                        @L["AllWarehouses"]
                    </option>

                    @foreach (var warehouse in Warehouses)
                    {
                        <option value="@warehouse.Id">
                            @warehouse.Name
                        </option>
                    }

                </select>


                <!-- STATUS -->

                <select class="filter-select"
                        @bind="SelectedStatus"
                        @bind:after="FilterChanged">

                    <option value="all">
                        @L["AllStatuses"]
                    </option>

                    @foreach (var status in StatusOptions)
                    {
                        <option value="@status">
                            @GetStatusText(status)
                        </option>
                    }

                </select>


                <!-- RESET -->

                <button type="button"
                        class="btn-secondary inventory-report-reset"
                        @onclick="ResetFilters">

                    @L["ResetFilters"]

                </button>

            </div>

        </div>


        <!-- =====================================================
             ACTIVE FILTER INFO
             ===================================================== -->
        @if (HasActiveFilters)
        {
            <div class="filter-info">

                <span>
                    @L["FilterActive"]
                </span>

                <strong>
                    @FilteredInventories.Count @L["Inventories"]
                </strong>

            </div>
        }


        <!-- =====================================================
             SUMMARY
             ===================================================== -->

        <div class="stock-summary-grid">

            <div class="stock-summary-card">

                <span>
                    @L["Inventories"]
                </span>

                <strong>
                    @FilteredInventories.Count
                </strong>

            </div>


            <div class="stock-summary-card">

                <span>
                    @L["Completed"]
                </span>

                <strong>
                    @CompletedCount
                </strong>

            </div>


            <div class="stock-summary-card">

                <span>
                    @L["Positions"]
                </span>

                <strong>
                    @TotalItems
                </strong>

            </div>


            <div class="stock-summary-card">

                <span>
                    @L["DifferentPositions"]
                </span>

                <strong>
                    @DifferenceCount
                </strong>

            </div>


            <div class="stock-summary-card">

                <span>
                    @L["TotalDifference"]
                </span>

                <strong>
                    @TotalDifference.ToString("N2")
                </strong>

            </div>

        </div>


        <!-- =====================================================
             TABLE
             ===================================================== -->

        <div class="products-card">

            <div class="products-card-header">

                <div>

                    <strong>
                        @L["InventoryHistory"]
                    </strong>

                    <span>
                        @FilteredInventories.Count @L["Entries"]
                    </span>

                </div>

            </div>


            @if (FilteredInventories.Count == 0)
            {
                <div class="empty-products">

                    <div class="empty-products-icon">

                        <i class="bi bi-clipboard-x"></i>

                    </div>

                    <h3>
                        @L["NoInventoriesFound"]
                    </h3>

                    <p>
                        @L["NoInventoriesMatchFilters"]
                    </p>

                </div>
            }
            else
            {

                <div class="products-table-wrapper">

                    <table class="products-table">

                        <thead>

                            <tr>

                                <th>
                                    @L["Inventory"]
                                </th>

                                <th>
                                    @L["Warehouse"]
                                </th>

                                <th>
                                    @L["Status"]
                                </th>

                                <th>
                                    @L["Positions"]
                                </th>

                                <th>
                                    @L["SystemStock"]
                                </th>

                                <th>
                                    @L["Counted"]
                                </th>

                                <th>
                                    @L["Difference"]
                                </th>

                                <th>
                                    @L["CreatedAt"]
                                </th>

                                <th>
                                    @L["CompletedAt"]
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var inventory in PagedInventories)
                            {
                                var systemQuantity =
                                    inventory.Items?.Sum(
                                        x => x.SystemQuantity) ?? 0;

                                var countedQuantity =
                                    inventory.Items?
                                        .Where(x =>
                                            x.CountedQuantity.HasValue)
                                        .Sum(x =>
                                            x.CountedQuantity!.Value) ?? 0;

                                var difference =
                                    inventory.Items?.Sum(
                                        x => x.Difference) ?? 0;


                                <tr>

                                    <!-- =================================
                                         INVENTORY
                                         ================================= -->

                                    <td>

                                        <div class="product-name">

                                            <div class="product-avatar">

                                                @GetInitials(
                                                    inventory.Warehouse?.Name)

                                            </div>

                                            <div>

                                                <strong>
                                                    @L["Inventory"] #@inventory.Id
                                                </strong>

                                                @if (!string.IsNullOrWhiteSpace(
                                                    inventory.Note))
                                                {
                                                    <small>
                                                        @inventory.Note
                                                    </small>
                                                }

                                            </div>

                                        </div>

                                    </td>


                                    <!-- =================================
                                         WAREHOUSE
                                         ================================= -->

                                    <td>

                                        @(inventory.Warehouse?.Name ?? "-")

                                    </td>


                                    <!-- =================================
                                         STATUS
                                         ================================= -->

                                    <td>

                                        @if (inventory.Status ==
                                             InventoryStatus.Entwurf)
                                        {
                                            <span class="status-badge status-draft">

                                                <i class="bi bi-pencil me-1"></i>

                                                @L["Draft"]

                                            </span>
                                        }
                                        else if (inventory.Status ==
                                                 InventoryStatus.InBearbeitung)
                                        {
                                            <span class="status-badge status-warning">

                                                <i class="bi bi-arrow-repeat me-1"></i>

                                                @L["InProgress"]

                                            </span>
                                        }
                                        else if (inventory.Status ==
                                                 InventoryStatus.Abgeschlossen)
                                        {
                                            <span class="status-badge status-active">

                                                <i class="bi bi-check-circle me-1"></i>

                                                @L["Completed"]

                                            </span>
                                        }

                                    </td>


                                    <!-- =================================
                                         ITEMS
                                         ================================= -->

                                    <td>

                                        @(inventory.Items?.Count ?? 0)

                                    </td>


                                    <!-- =================================
                                         SYSTEM
                                         ================================= -->

                                    <td>

                                        <strong>
                                            @systemQuantity.ToString("N2")
                                        </strong>

                                    </td>


                                    <!-- =================================
                                         COUNTED
                                         ================================= -->

                                    <td>

                                        <strong>
                                            @countedQuantity.ToString("N2")
                                        </strong>

                                    </td>


                                    <!-- =================================
                                         DIFFERENCE
                                         ================================= -->

                                    <td>

                                        @if (difference > 0)
                                        {
                                            <span class="status-badge status-active">

                                                +@difference.ToString("N2")

                                            </span>
                                        }
                                        else if (difference < 0)
                                        {
                                            <span class="status-badge status-low">

                                                @difference.ToString("N2")

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge">

                                                0,00

                                            </span>
                                        }

                                    </td>


                                    <!-- =================================
                                         CREATED
                                         ================================= -->

                                    <td>

                                        <div class="movement-date">

                                            <strong>
                                                @(inventory.CreatedAt
                                                    .ToLocalTime()
                                                    .ToString("dd.MM.yyyy"))
                                            </strong>

                                            <small>
                                                @(inventory.CreatedAt
                                                    .ToLocalTime()
                                                    .ToString("HH:mm"))
                                            </small>

                                        </div>

                                    </td>


                                    <!-- =================================
                                         COMPLETED
                                         ================================= -->

                                    <td>

                                        @if (inventory.CompletedAt.HasValue)
                                        {
                                            <div class="movement-date">

                                                <strong>
                                                    @(inventory.CompletedAt.Value
                                                        .ToLocalTime()
                                                        .ToString("dd.MM.yyyy"))
                                                </strong>

                                                <small>
                                                    @(inventory.CompletedAt.Value
                                                        .ToLocalTime()
                                                        .ToString("HH:mm"))
                                                </small>

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>


                <!-- =================================================
                     PAGINATION
                     ================================================= -->
                @if (TotalPages > 1)
                {
                    <div class="pagination">

                        <button type="button"
                                class="pagination-button"
                                disabled="@(CurrentPage <= 1)"
                                @onclick="PreviousPage">

                            ‹

                        </button>


                        <div class="pagination-pages">

                            @foreach (var pageNumber in GetPageNumbers())
                            {
                                <button type="button"
                                        class="pagination-button @(pageNumber == CurrentPage ? "active" : "")"
                                        @onclick="() => GoToPage(pageNumber)">

                                    @pageNumber

                                </button>
                            }

                        </div>


                        <button type="button"
                                class="pagination-button"
                                disabled="@(CurrentPage >= TotalPages)"
                                @onclick="NextPage">

                            ›

                        </button>

                    </div>
                }


                <div class="pagination-info">

                    @L["PageOf", CurrentPage, TotalPages]
                    ·
                    @L["PaginationInventories",
                        PagedInventories.Count,
                        FilteredInventories.Count]

                </div>

            }

        </div>

    }

</div>


@code {

    // =========================================================
    // DATA
    // =========================================================

    private List<WarehouseManagement.Models.Inventory> Inventories = new();

    private List<Warehouse> Warehouses = new();


    // =========================================================
    // STATUS OPTIONS
    // =========================================================

    private readonly string[] StatusOptions =
    {
        "Entwurf",
        "InBearbeitung",
        "Abgeschlossen"
    };


    private string GetStatusText(string status)
    {
        return status switch
        {
            "Entwurf" =>
                L["Draft"].Value,

            "InBearbeitung" =>
                L["InProgress"].Value,

            "Abgeschlossen" =>
                L["Completed"].Value,

            _ =>
                status
        };
    }


    // =========================================================
    // FILTER - SEARCH
    // =========================================================

    private string _searchTerm = string.Empty;

    private string SearchTerm
    {
        get => _searchTerm;

        set
        {
            if (_searchTerm == value)
                return;

            _searchTerm = value;

            CurrentPage = 1;
        }
    }


    // =========================================================
    // FILTER - WAREHOUSE
    // =========================================================

    private int _selectedWarehouseId;

    private int SelectedWarehouseId
    {
        get => _selectedWarehouseId;

        set
        {
            if (_selectedWarehouseId == value)
                return;

            _selectedWarehouseId = value;

            CurrentPage = 1;
        }
    }


    // =========================================================
    // FILTER - STATUS
    // =========================================================

    private string _selectedStatus = "all";

    private string SelectedStatus
    {
        get => _selectedStatus;

        set
        {
            if (_selectedStatus == value)
                return;

            _selectedStatus = value;

            CurrentPage = 1;
        }
    }


    // =========================================================
    // PAGINATION
    // =========================================================

    private const int PageSize = 10;

    private int CurrentPage = 1;


    private List<WarehouseManagement.Models.Inventory> PagedInventories =>
        FilteredInventories
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();


    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                FilteredInventories.Count /
                (double)PageSize));


    private List<int> GetPageNumbers()
    {
        var pages = new List<int>();

        var start =
            Math.Max(
                1,
                CurrentPage - 2);

        var end =
            Math.Min(
                TotalPages,
                CurrentPage + 2);

        for (var i = start; i <= end; i++)
        {
            pages.Add(i);
        }

        return pages;
    }


    // =========================================================
    // STATE
    // =========================================================

    private bool IsLoading = true;


    // =========================================================
    // FILTERED INVENTORIES
    // =========================================================

    private List<WarehouseManagement.Models.Inventory> FilteredInventories =>
        Inventories

            .Where(x =>
                SelectedWarehouseId == 0
                ||
                x.WarehouseId == SelectedWarehouseId)

            .Where(x =>
                SelectedStatus == "all"

                ||

                (
                    SelectedStatus == "Entwurf"
                    &&
                    x.Status == InventoryStatus.Entwurf
                )

                ||

                (
                    SelectedStatus == "InBearbeitung"
                    &&
                    x.Status == InventoryStatus.InBearbeitung
                )

                ||

                (
                    SelectedStatus == "Abgeschlossen"
                    &&
                    x.Status == InventoryStatus.Abgeschlossen
                ))

            .Where(x =>
                string.IsNullOrWhiteSpace(SearchTerm)

                ||

                (
                    x.Warehouse != null
                    &&
                    x.Warehouse.Name.Contains(
                        SearchTerm,
                        StringComparison.OrdinalIgnoreCase)
                )

                ||

                (
                    !string.IsNullOrWhiteSpace(x.Note)
                    &&
                    x.Note.Contains(
                        SearchTerm,
                        StringComparison.OrdinalIgnoreCase)
                ))

            .OrderByDescending(x =>
                x.CreatedAt)

            .ToList();


    // =========================================================
    // SUMMARY
    // =========================================================

    private int CompletedCount =>
        FilteredInventories.Count(x =>
            x.Status == InventoryStatus.Abgeschlossen);


    private int TotalItems =>
        FilteredInventories.Sum(x =>
            x.Items?.Count ?? 0);


    private int DifferenceCount =>
        FilteredInventories

            .SelectMany(x =>
                x.Items ?? new List<InventoryItem>())

            .Count(x =>
                x.CountedQuantity.HasValue
                &&
                x.Difference != 0);


    private decimal TotalDifference =>
        FilteredInventories

            .SelectMany(x =>
                x.Items ?? new List<InventoryItem>())

            .Where(x =>
                x.CountedQuantity.HasValue)

            .Sum(x =>
                x.Difference);


    // =========================================================
    // ACTIVE FILTERS
    // =========================================================

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(SearchTerm)
        ||
        SelectedWarehouseId > 0
        ||
        SelectedStatus != "all";


    // =========================================================
    // INITIALIZATION
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }


    // =========================================================
    // LOAD DATA
    // =========================================================

    private async Task LoadData()
    {
        IsLoading = true;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            // =====================================================
            // WAREHOUSES
            // =====================================================

            Warehouses =
                await db.Warehouses

                    .AsNoTracking()

                    .Where(x =>
                        x.IsActive)

                    .OrderBy(x =>
                        x.Name)

                    .ToListAsync();


            // =====================================================
            // INVENTORIES
            // =====================================================

            Inventories =
                await db.Inventories

                    .AsNoTracking()

                    .Include(x =>
                        x.Warehouse)

                    .Include(x =>
                        x.Items)

                    .ToListAsync();


            CurrentPage = 1;
        }
        finally
        {
            IsLoading = false;
        }
    }


    // =========================================================
    // SEARCH CHANGED
    // =========================================================

    private Task SearchChanged()
    {
        CurrentPage = 1;

        return Task.CompletedTask;
    }


    // =========================================================
    // FILTER CHANGED
    // =========================================================

    private Task FilterChanged()
    {
        CurrentPage = 1;

        return Task.CompletedTask;
    }


    // =========================================================
    // RESET FILTERS
    // =========================================================

    private void ResetFilters()
    {
        SearchTerm = string.Empty;

        SelectedWarehouseId = 0;

        SelectedStatus = "all";

        CurrentPage = 1;
    }


    // =========================================================
    // PAGINATION
    // =========================================================

    private void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
        }
    }


    private void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
        }
    }


    private void GoToPage(int page)
    {
        if (page < 1)
            page = 1;

        if (page > TotalPages)
            page = TotalPages;

        CurrentPage = page;
    }


    // =========================================================
    // EXCEL EXPORT
    // =========================================================

    private async Task ExportExcel()
    {
        try
        {
            var data = PagedInventories;

            if (data.Count == 0)
                return;


            var bytes =
                ExcelExport.Export(
                    data,
                    L["InventoryReport"].Value,
                    $"{L["InventoryReport"].Value} – {L["Page"].Value} {CurrentPage}",

                    (
                        L["Inventory"].Value,
                        x => $"{L["Inventory"].Value} #{x.Id}"
                    ),

                    (
                        L["Warehouse"].Value,
                        x => x.Warehouse?.Name ?? ""
                    ),

                    (
                        L["Status"].Value,
                        x => GetStatusText(
                            x.Status.ToString())
                    ),

                    (
                        L["Positions"].Value,
                        x => x.Items?.Count ?? 0
                    ),

                    (
                        L["SystemStock"].Value,
                        x => x.Items?
                            .Sum(i =>
                                i.SystemQuantity) ?? 0
                    ),

                    (
                        L["Counted"].Value,
                        x => x.Items?
                            .Where(i =>
                                i.CountedQuantity.HasValue)
                            .Sum(i =>
                                i.CountedQuantity!.Value) ?? 0
                    ),

                    (
                        L["Difference"].Value,
                        x => x.Items?
                            .Sum(i =>
                                i.Difference) ?? 0
                    ),

                    (
                        L["CreatedAt"].Value,
                        x => x.CreatedAt
                    ),

                    (
                        L["CompletedAt"].Value,
                        x => x.CompletedAt
                    ),

                    (
                        L["Note"].Value,
                        x => x.Note ?? ""
                    )
                );


            var base64 =
                Convert.ToBase64String(bytes);


            await JS.InvokeVoidAsync(
                "downloadFile",
                $"{L["InventoryReport"].Value}_{L["Page"].Value}_{CurrentPage}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                base64);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Fehler beim Excel-Export: {ex}");
        }
    }


    // =========================================================
    // DIFFERENCE
    // =========================================================

    private string FormatDifference(decimal difference)
    {
        if (difference > 0)
            return $"+{difference:N2}";

        return difference.ToString("N2");
    }


    // =========================================================
    // INITIALS
    // =========================================================

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";


        var words =
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);


        if (words.Length == 1)
        {
            return words[0]
                .Substring(
                    0,
                    Math.Min(
                        2,
                        words[0].Length))
                .ToUpper();
        }


        return
            $"{words[0][0]}{words[1][0]}"
                .ToUpper();
    }

}