@page "/reports/inventory"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using WarehouseManagement.Data
@using WarehouseManagement.Models

@inject IDbContextFactory<ApplicationDbContext> DbFactory
<style>
    .stock-page .filter-card {
        display: grid;
        grid-template-columns: minmax(320px, 2fr) minmax(180px, 1fr) minmax(180px, 1fr) auto;
        gap: 10px;
        align-items: center;
    }

        .stock-page .filter-card > * {
            min-width: 0;
        }

        .stock-page .filter-card .search-box {
            width: 100%;
            max-width: none;
        }

        .stock-page .filter-card .filter-select {
            width: 100%;
        }

    @@media (max-width: 950px) {
        .stock-page .filter-card {
            grid-template-columns: minmax(280px, 2fr) minmax(180px, 1fr);
        }
    }

    @@media (max-width: 650px) {
        .stock-page .filter-card {
            grid-template-columns: 1fr;
        }
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 18px;
    }

    .summary-card {
        min-width: 0;
    }

    
    @@media (max-width: 1100px) {
        .summary-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    
    @@media (max-width: 750px) {
        .summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    
    @@media (max-width: 500px) {
        .summary-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
<PageTitle>Inventurbericht</PageTitle>

<div class="stock-page">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="page-header">

        <div>

            <h1>Inventurbericht</h1>

            <p>
                Übersicht über durchgeführte Inventuren und
                Bestandsabweichungen.
            </p>

        </div>

        <div class="page-header-actions">

            <a href="/reports"
               class="btn-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                Berichte

            </a>

        </div>

    </div>


    @if (IsLoading)
    {
        <div class="loading-state">
            Inventuren werden geladen...
        </div>
    }
    else
    {

        <!-- =====================================================
             FILTER
             ===================================================== -->

        <div class="filter-card">

            <div class="search-box">

                <span class="search-icon">⌕</span>

                <input type="text"
                       placeholder="Lager oder Notiz suchen..."
                       @bind="SearchTerm"
                       @bind:event="oninput"
                       @bind:after="SearchChanged" />

            </div>


            <select class="filter-select"
                    @bind="SelectedWarehouseId"
                    @bind:after="FilterChanged">

                <option value="0">
                    Alle Lager
                </option>

                @foreach (var warehouse in Warehouses)
                {
                    <option value="@warehouse.Id">
                        @warehouse.Name
                    </option>
                }

            </select>


            <select class="filter-select"
                    @bind="SelectedStatus"
                    @bind:after="FilterChanged">

                <option value="all">
                    Alle Status
                </option>

                @foreach (var status in StatusOptions)
                {
                    <option value="@status">
                        @GetStatusText(status)
                    </option>
                }

            </select>


            <button type="button"
                    class="btn-secondary"
                    @onclick="ResetFilters">

                Zurücksetzen

            </button>

        </div>


        <!-- =====================================================
             SUMMARY
             ===================================================== -->

        <div class="summary-grid">

            <div class="summary-card">

                <span class="summary-label">
                    Inventuren
                </span>

                <strong>
                    @FilteredInventories.Count
                </strong>

            </div>


            <div class="summary-card">

                <span class="summary-label">
                    Abgeschlossen
                </span>

                <strong>
                    @CompletedCount
                </strong>

            </div>


            <div class="summary-card">

                <span class="summary-label">
                    Positionen
                </span>

                <strong>
                    @TotalItems
                </strong>

            </div>


            <div class="summary-card">

                <span class="summary-label">
                    Abweichende Positionen
                </span>

                <strong>
                    @DifferenceCount
                </strong>

            </div>


            <div class="summary-card">

                <span class="summary-label">
                    Gesamtdifferenz
                </span>

                <strong>
                    @TotalDifference.ToString("N2")
                </strong>

            </div>

        </div>


        <!-- =====================================================
             TABLE
             ===================================================== -->

        <div class="stock-table-card">

            @if (FilteredInventories.Count == 0)
            {
                <div class="empty-products">

                    <div class="empty-products-icon">
                        <i class="bi bi-clipboard-x"></i>
                    </div>

                    <h3>
                        Keine Inventuren gefunden
                    </h3>

                    <p>
                        Für die aktuellen Filter wurden keine
                        Inventuren gefunden.
                    </p>

                </div>
            }
            else
            {

                <div class="products-table-wrapper">

                    <table class="products-table">

                        <thead>

                            <tr>

                                <th>
                                    Inventur
                                </th>

                                <th>
                                    Lager
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Positionen
                                </th>

                                <th>
                                    Systembestand
                                </th>

                                <th>
                                    Gezählt
                                </th>

                                <th>
                                    Differenz
                                </th>

                                <th>
                                    Erstellt am
                                </th>

                                <th>
                                    Abgeschlossen am
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var inventory in PagedInventories)
                            {
                                var systemQuantity =
                                    inventory.Items?.Sum(
                                        x => x.SystemQuantity) ?? 0;

                                var countedQuantity =
                                    inventory.Items?
                                        .Where(x => x.CountedQuantity.HasValue)
                                        .Sum(x => x.CountedQuantity!.Value) ?? 0;

                                var difference =
                                    inventory.Items?.Sum(
                                        x => x.Difference) ?? 0;


                                <tr>

                                    <!-- INVENTORY -->

                                    <td>

                                        <div class="product-name">

                                            <div class="product-avatar">
                                                @GetInitials(
                                                    inventory.Warehouse?.Name)
                                            </div>

                                            <div>

                                                <strong>
                                                    Inventur #@inventory.Id
                                                </strong>

                                                @if (!string.IsNullOrWhiteSpace(
                                                    inventory.Note))
                                                {
                                                    <small>
                                                        @inventory.Note
                                                    </small>
                                                }

                                            </div>

                                        </div>

                                    </td>


                                    <!-- WAREHOUSE -->

                                    <td>
                                        @(inventory.Warehouse?.Name ?? "-")
                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        @if (inventory.Status ==
                                            InventoryStatus.Entwurf)
                                        {
                                            <span class="status-badge status-draft">

                                                <i class="bi bi-pencil me-1"></i>
                                                Entwurf

                                            </span>
                                        }
                                        else if (inventory.Status ==
                                                 InventoryStatus.InBearbeitung)
                                        {
                                            <span class="status-badge status-warning">

                                                <i class="bi bi-arrow-repeat me-1"></i>
                                                In Bearbeitung

                                            </span>
                                        }
                                        else if (inventory.Status ==
                                                 InventoryStatus.Abgeschlossen)
                                        {
                                            <span class="status-badge status-active">

                                                <i class="bi bi-check-circle me-1"></i>
                                                Abgeschlossen

                                            </span>
                                        }

                                    </td>


                                    <!-- ITEMS -->

                                    <td>
                                        @(inventory.Items?.Count ?? 0)
                                    </td>


                                    <!-- SYSTEM -->

                                    <td>

                                        <strong>
                                            @systemQuantity.ToString("N2")
                                        </strong>

                                    </td>


                                    <!-- COUNTED -->

                                    <td>

                                        <strong>
                                            @countedQuantity.ToString("N2")
                                        </strong>

                                    </td>


                                    <!-- DIFFERENCE -->

                                    <td>

                                        @if (difference > 0)
                                        {
                                            <span class="status-badge status-active">
                                                +@difference.ToString("N2")
                                            </span>
                                        }
                                        else if (difference < 0)
                                        {
                                            <span class="status-badge status-low">
                                                @difference.ToString("N2")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge">
                                                0,00
                                            </span>
                                        }

                                    </td>


                                    <!-- CREATED -->

                                    <td>

                                        <div class="movement-date">

                                            <strong>
                                                @(inventory.CreatedAt
                                                    .ToLocalTime()
                                                    .ToString("dd.MM.yyyy"))
                                            </strong>

                                            <small>
                                                @(inventory.CreatedAt
                                                    .ToLocalTime()
                                                    .ToString("HH:mm"))
                                            </small>

                                        </div>

                                    </td>


                                    <!-- COMPLETED -->

                                    <td>

                                        @if (inventory.CompletedAt.HasValue)
                                        {
                                            <div class="movement-date">

                                                <strong>
                                                    @(inventory.CompletedAt.Value
                                                        .ToLocalTime()
                                                        .ToString("dd.MM.yyyy"))
                                                </strong>

                                                <small>
                                                    @(inventory.CompletedAt.Value
                                                        .ToLocalTime()
                                                        .ToString("HH:mm"))
                                                </small>

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>


                <!-- =================================================
                     PAGINATION
                     ================================================= -->
                @if (TotalPages > 1)
                {
                    <div class="pagination-container">

                        <div class="pagination-info">

                            Zeige
                            <strong>@PaginationStart</strong>
                            -
                            <strong>@PaginationEnd</strong>
                            von
                            <strong>@FilteredInventories.Count</strong>

                        </div>


                        <div class="pagination-buttons">

                            <button type="button"
                                    class="btn-secondary"
                                    disabled="@(CurrentPage == 1)"
                                    @onclick="PreviousPage">

                                &lt;

                            </button>


                            @for (int page = 1; page <= TotalPages; page++)
                            {
                                var pageNumber = page;

                                <button type="button"
                                        class="pagination-page @(CurrentPage == pageNumber ? "active" : "")"
                                        @onclick="() => GoToPage(pageNumber)">

                                    @pageNumber

                                </button>
                            }


                            <button type="button"
                                    class="btn-secondary"
                                    disabled="@(CurrentPage == TotalPages)"
                                    @onclick="NextPage">

                                &gt;

                            </button>

                        </div>

                    </div>
                }

            }

        </div>

    }

</div>


@code {

    // =========================================================
    // DATA
    // =========================================================

    private List<WarehouseManagement.Models.Inventory> Inventories = new();

    private List<Warehouse> Warehouses = new();


    // =========================================================
    // STATUS OPTIONS
    // =========================================================

    private readonly string[] StatusOptions =
    {
        "Entwurf",
        "InBearbeitung",
        "Abgeschlossen"
    };


    private string GetStatusText(string status)
    {
        return status switch
        {
            "Entwurf" => "Entwurf",
            "InBearbeitung" => "In Bearbeitung",
            "Abgeschlossen" => "Abgeschlossen",
            _ => status
        };
    }


    // =========================================================
    // FILTER
    // =========================================================

    private string _searchTerm = string.Empty;

    private string SearchTerm
    {
        get => _searchTerm;

        set
        {
            if (_searchTerm == value)
                return;

            _searchTerm = value;
            CurrentPage = 1;
        }
    }


    private int _selectedWarehouseId;

    private int SelectedWarehouseId
    {
        get => _selectedWarehouseId;

        set
        {
            if (_selectedWarehouseId == value)
                return;

            _selectedWarehouseId = value;
            CurrentPage = 1;
        }
    }


    private string _selectedStatus = "all";

    private string SelectedStatus
    {
        get => _selectedStatus;

        set
        {
            if (_selectedStatus == value)
                return;

            _selectedStatus = value;
            CurrentPage = 1;
        }
    }


    // =========================================================
    // PAGINATION
    // =========================================================

    private const int PageSize = 10;

    private int CurrentPage = 1;


    private List<WarehouseManagement.Models.Inventory> PagedInventories =>
        FilteredInventories
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();


    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                FilteredInventories.Count /
                (double)PageSize));


    private int PaginationStart =>
        FilteredInventories.Count == 0
            ? 0
            : ((CurrentPage - 1) * PageSize) + 1;


    private int PaginationEnd =>
        Math.Min(
            CurrentPage * PageSize,
            FilteredInventories.Count);


    // =========================================================
    // STATE
    // =========================================================

    private bool IsLoading = true;


    // =========================================================
    // FILTERED INVENTORIES
    // =========================================================

    private List<WarehouseManagement.Models.Inventory> FilteredInventories =>
        Inventories

            .Where(x =>
                SelectedWarehouseId == 0
                ||
                x.WarehouseId == SelectedWarehouseId)

            .Where(x =>
                SelectedStatus == "all"

                ||

                (
                    SelectedStatus == "Entwurf"
                    &&
                    x.Status == InventoryStatus.Entwurf
                )

                ||

                (
                    SelectedStatus == "InBearbeitung"
                    &&
                    x.Status == InventoryStatus.InBearbeitung
                )

                ||

                (
                    SelectedStatus == "Abgeschlossen"
                    &&
                    x.Status == InventoryStatus.Abgeschlossen
                ))

            .Where(x =>
                string.IsNullOrWhiteSpace(SearchTerm)

                ||

                (
                    x.Warehouse != null
                    &&
                    x.Warehouse.Name.Contains(
                        SearchTerm,
                        StringComparison.OrdinalIgnoreCase)
                )

                ||

                (
                    !string.IsNullOrWhiteSpace(x.Note)
                    &&
                    x.Note.Contains(
                        SearchTerm,
                        StringComparison.OrdinalIgnoreCase)
                ))

            .OrderByDescending(x => x.CreatedAt)

            .ToList();


    // =========================================================
    // SUMMARY
    // =========================================================

    private int CompletedCount =>
        FilteredInventories.Count(x =>
            x.Status == InventoryStatus.Abgeschlossen);


    private int TotalItems =>
        FilteredInventories.Sum(x =>
            x.Items?.Count ?? 0);


    private int DifferenceCount =>
        FilteredInventories

            .SelectMany(x =>
                x.Items ?? new List<InventoryItem>())

            .Count(x =>
                x.CountedQuantity.HasValue
                &&
                x.Difference != 0);


    private decimal TotalDifference =>
        FilteredInventories

            .SelectMany(x =>
                x.Items ?? new List<InventoryItem>())

            .Where(x =>
                x.CountedQuantity.HasValue)

            .Sum(x =>
                x.Difference);


    // =========================================================
    // ACTIVE FILTERS
    // =========================================================

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(SearchTerm)
        ||
        SelectedWarehouseId > 0
        ||
        SelectedStatus != "all";


    // =========================================================
    // INITIALIZATION
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }


    // =========================================================
    // LOAD
    // =========================================================

    private async Task LoadData()
    {
        IsLoading = true;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            // =====================================================
            // WAREHOUSES
            // =====================================================

            Warehouses =
                await db.Warehouses
                    .AsNoTracking()
                    .Where(x =>
                        x.IsActive)
                    .OrderBy(x =>
                        x.Name)
                    .ToListAsync();


            // =====================================================
            // INVENTORIES
            // =====================================================

            Inventories =
                await db.Inventories
                    .AsNoTracking()
                    .Include(x =>
                        x.Warehouse)
                    .Include(x =>
                        x.Items)
                    .ToListAsync();
        }
        finally
        {
            IsLoading = false;
        }
    }


    // =========================================================
    // SEARCH
    // =========================================================

    private Task SearchChanged()
    {
        CurrentPage = 1;

        return Task.CompletedTask;
    }


    // =========================================================
    // FILTER
    // =========================================================

    private Task FilterChanged()
    {
        CurrentPage = 1;

        return Task.CompletedTask;
    }


    // =========================================================
    // RESET
    // =========================================================

    private void ResetFilters()
    {
        SearchTerm = string.Empty;

        SelectedWarehouseId = 0;

        SelectedStatus = "all";

        CurrentPage = 1;
    }


    // =========================================================
    // PAGINATION
    // =========================================================

    private void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
        }
    }


    private void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
        }
    }


    private void GoToPage(int page)
    {
        if (page < 1)
            page = 1;

        if (page > TotalPages)
            page = TotalPages;

        CurrentPage = page;
    }


    // =========================================================
    // DIFFERENCE
    // =========================================================

    private string FormatDifference(decimal difference)
    {
        if (difference > 0)
            return $"+{difference:N2}";

        return difference.ToString("N2");
    }


    // =========================================================
    // INITIALS
    // =========================================================

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";

        var words =
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);

        if (words.Length == 1)
        {
            return words[0]
                .Substring(
                    0,
                    Math.Min(
                        2,
                        words[0].Length))
                .ToUpper();
        }

        return
            $"{words[0][0]}{words[1][0]}"
                .ToUpper();
    }

}