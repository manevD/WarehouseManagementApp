@page "/reports/value"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@using WarehouseManagement.Data
@using WarehouseManagement.Models
@using WarehouseManagement.Services
@using WarehouseManagement.Localization
@using WarehouseManagement.Components

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ExcelExportService ExcelExport
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["StockValueReport"]</PageTitle>

<div class="stock-page">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="page-header">

        <div>

            <h1>
                @L["StockValueReport"]
            </h1>

            <p>
                @L["StockValueReportDescription"]
            </p>

        </div>

        <div class="page-header-actions">

            <button type="button"
                    class="btn-secondary"
                    @onclick="ExportExcel"
                    disabled="@(PagedStocks.Count == 0)">

                📊 @L["ExportExcel"]

            </button>

            <a href="/reports"
               class="btn-secondary">

                ← @L["Reports"]

            </a>

        </div>

    </div>


    <!-- =========================================================
         FILTER
         ========================================================= -->

    <div class="filter-card">

        <div class="filter-main-row">

            <div class="search-box">

                <span class="search-icon">
                    <i class="bi bi-search"></i>
                </span>

                <input type="text"
                       placeholder="@L["SearchProductSkuBarcodePlaceholder"]"
                       @bind="SearchTerm"
                       @bind:event="oninput" />

            </div>


            <SearchableSelect TItem="Warehouse"
                              TValue="int"
                              Items="Warehouses"
                              Value="SelectedWarehouseId"
                              ValueChanged="OnWarehouseChanged"
                              ValueSelector="@(x => x.Id)"
                              TextSelector="@(x => x.Name)"
                              Placeholder="@L["AllWarehouses"]"
                              NoResultsText="@L["NoResultsFound"]"
                              ShowAllOption="true"
                              AllOptionText="@L["AllWarehouses"]"
                              AllValue="0" />


            <SearchableSelect TItem="WarehouseLocation"
                              TValue="int"
                              Items="FilteredLocations"
                              Value="SelectedLocationId"
                              ValueChanged="OnLocationChanged"
                              ValueSelector="@(x => x.Id)"
                              TextSelector="@(x => string.IsNullOrWhiteSpace(x.Name)
                                  ? x.Code
                                  : $"{x.Code} - {x.Name}")"
                              Placeholder="@L["AllLocations"]"
                              NoResultsText="@L["NoResultsFound"]"
                              ShowAllOption="true"
                              AllOptionText="@L["AllLocations"]"
                              AllValue="0" />

            <button type="button"
                    class="btn-secondary filter-reset-button"
                    @onclick="ResetFilters">
                    @L["ResetFilters"]
            </button>

        </div>

    </div>


    <!-- =========================================================
         SUMMARY
         ========================================================= -->

    <div class="stock-summary-grid">

        <!-- LAGERWERT -->

        <div class="stock-summary-card">

            <span>
                @L["StockValue"]
            </span>

            <strong>
                @TotalPurchaseValue.ToString("N2") €
            </strong>

            <small>
                @L["AtPurchasePrice"]
            </small>

        </div>


        <!-- VERKAUFSWERT -->

        <div class="stock-summary-card">

            <span>
                @L["SaleValue"]
            </span>

            <strong>
                @TotalSaleValue.ToString("N2") €
            </strong>

            <small>
                @L["AtSalePrice"]
            </small>

        </div>


        <!-- BESTAND -->

        <div class="stock-summary-card">

            <span>
                @L["TotalStock"]
            </span>

            <strong>
                @TotalQuantity.ToString("N2")
            </strong>

            <small>
                @L["CurrentQuantity"]
            </small>

        </div>


        <!-- POSITIONEN -->

        <div class="stock-summary-card">

            <span>
                @L["Positions"]
            </span>

            <strong>
                @FilteredStocks.Count
            </strong>

            <small>
                @L["StockPositions"]
            </small>

        </div>

    </div>


    <!-- =========================================================
         TABLE
         ========================================================= -->

    <div class="products-card">

        <div class="products-card-header">

            <div>

                <strong>
                    @L["StockValueOverview"]
                </strong>

                <span>
                    @L["PaginationEntries", FilteredStocks.Count]
                </span>

            </div>

        </div>


        @if (IsLoading)
        {
            <div class="loading-state">

                @L["LoadingStockValues"]

            </div>
        }
        else if (PagedStocks.Count == 0)
        {
            <div class="empty-products">

                <div class="empty-products-icon">
                    <i class="bi bi-box-seam"></i>
                </div>

                <h3>
                    @L["NoStockBalances"]
                </h3>

                <p>
                    @L["NoStockBalancesForFilters"]
                </p>

            </div>
        }
        else
        {

            <div class="products-table-wrapper">

                <table class="products-table">

                    <thead>

                        <tr>

                            <th>
                                @L["Product"]
                            </th>

                            <th>
                                @L["SKU"]
                            </th>

                            <th>
                                @L["Warehouse"]
                            </th>

                            <th>
                                @L["StorageLocation"]
                            </th>

                            <th>
                                @L["Stock"]
                            </th>

                            <th>
                                @L["PurchasePrice"]
                            </th>

                            <th>
                                @L["StockValue"]
                            </th>

                            <th>
                                @L["SalePrice"]
                            </th>

                            <th>
                                @L["SaleValue"]
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var stock in PagedStocks)
                        {
                            var product = stock.Product;

                            var location =
                                stock.WarehouseLocation;

                            var purchaseValue =
                                stock.Quantity *
                                product!.PurchasePrice;

                            var saleValue =
                                stock.Quantity *
                                product.SalePrice;


                            <tr>

                                <!-- PRODUCT -->

                                <td>

                                    <div class="product-name">

                                        <div class="product-avatar">
                                            @GetInitials(product.Name)
                                        </div>

                                        <div>

                                            <strong>
                                                @product.Name
                                            </strong>

                                            @if (!string.IsNullOrWhiteSpace(
                                                product.Barcode))
                                            {
                                                <small>
                                                    @product.Barcode
                                                </small>
                                            }

                                        </div>

                                    </div>

                                </td>


                                <!-- SKU -->

                                <td>
                                    @product.SKU
                                </td>


                                <!-- WAREHOUSE -->

                                <td>

                                    @if (location?.Warehouse != null)
                                    {
                                        @location.Warehouse.Name
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- LOCATION -->

                                <td>

                                    @if (location != null)
                                    {
                                        <div class="movement-location">

                                            <strong>
                                                @location.Code
                                            </strong>

                                            @if (!string.IsNullOrWhiteSpace(
                                                location.Name))
                                            {
                                                <small>
                                                    @location.Name
                                                </small>
                                            }

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- QUANTITY -->

                                <td>

                                    <strong>
                                        @stock.Quantity.ToString("N2")
                                    </strong>

                                </td>


                                <!-- PURCHASE PRICE -->

                                <td>
                                    @product.PurchasePrice.ToString("N2") €
                                </td>


                                <!-- PURCHASE VALUE -->

                                <td>

                                    <strong>
                                        @purchaseValue.ToString("N2") €
                                    </strong>

                                </td>


                                <!-- SALE PRICE -->

                                <td>
                                    @product.SalePrice.ToString("N2") €
                                </td>


                                <!-- SALE VALUE -->

                                <td>

                                    <strong>
                                        @saleValue.ToString("N2") €
                                    </strong>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- =====================================================
                 PAGINATION
                 ===================================================== -->
            @if (TotalPages > 1)
            {
                <div class="pagination">

                    <button type="button"
                            class="pagination-button"
                            disabled="@(CurrentPage <= 1)"
                            @onclick="PreviousPage">

                        ‹

                    </button>


                    <div class="pagination-pages">

                        @foreach (var pageNumber in GetPageNumbers())
                        {
                            <button type="button"
                                    class="pagination-button @(pageNumber == CurrentPage ? "active" : "")"
                                    @onclick="() => GoToPage(pageNumber)">

                                @pageNumber

                            </button>
                        }

                    </div>


                    <button type="button"
                            class="pagination-button"
                            disabled="@(CurrentPage >= TotalPages)"
                            @onclick="NextPage">

                        ›

                    </button>

                </div>
            }


            <div class="pagination-info">

                @L["PageOf", CurrentPage, TotalPages]

                ·

                @L[
                    "PaginationEntries",
                    PagedStocks.Count
                ]

                /

                @FilteredStocks.Count

            </div>

        }

    </div>

</div>


<style>
    .stock-page .filter-main-row {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 100%;
        flex-wrap: nowrap;
    }

    .stock-page .filter-main-row .search-box {
        flex: 1 1 450px;
        width: 450px;
        max-width: 450px;
        min-width: 280px;
    }

    .stock-page .filter-main-row > .searchable-select {
        flex: 0 0 250px;
        width: 250px;
        max-width: 250px;
        min-width: 250px;
    }

    .stock-page .filter-reset-button {
        flex: 0 0 auto;
        white-space: nowrap;
    }

    @@media (max-width: 950px) {
        .stock-page .filter-main-row {
            flex-wrap: wrap;
        }

        .stock-page .filter-main-row .search-box,
        .stock-page .filter-main-row > .searchable-select,
        .stock-page .filter-main-row .filter-reset-button {
            flex: 1 1 100%;
            width: 100%;
            max-width: none;
            min-width: 0;
        }
    }
</style>


@code {

    // =========================================================
    // DATA
    // =========================================================

    private List<Models.Stock> Stocks = new();

    private List<Warehouse> Warehouses = new();

    private List<WarehouseLocation> Locations = new();


    // =========================================================
    // FILTER
    // =========================================================

    private string _searchTerm = string.Empty;

    private string SearchTerm
    {
        get => _searchTerm;

        set
        {
            if (_searchTerm == value)
                return;

            _searchTerm = value;

            CurrentPage = 1;
        }
    }


    private int _selectedWarehouseId;

    private int SelectedWarehouseId
    {
        get => _selectedWarehouseId;

        set
        {
            if (_selectedWarehouseId == value)
                return;

            _selectedWarehouseId = value;

            SelectedLocationId = 0;

            CurrentPage = 1;
        }
    }


    private int _selectedLocationId;

    private int SelectedLocationId
    {
        get => _selectedLocationId;

        set
        {
            if (_selectedLocationId == value)
                return;

            _selectedLocationId = value;

            CurrentPage = 1;
        }
    }


    // =========================================================
    // RESET FILTERS
    // =========================================================

    private Task ResetFilters()
    {
        _searchTerm = string.Empty;
        _selectedWarehouseId = 0;
        _selectedLocationId = 0;
        CurrentPage = 1;

        return InvokeAsync(StateHasChanged);
    }


    // =========================================================
    // FILTER CALLBACKS
    // =========================================================

    private Task OnWarehouseChanged(int value)
    {
        SelectedWarehouseId = value;
        SelectedLocationId = 0;
        CurrentPage = 1;

        return InvokeAsync(StateHasChanged);
    }

    private Task OnLocationChanged(int value)
    {
        SelectedLocationId = value;
        CurrentPage = 1;

        return InvokeAsync(StateHasChanged);
    }


    // =========================================================
    // PAGINATION
    // =========================================================

    private const int PageSize = 10;

    private int CurrentPage = 1;


    // =========================================================
    // STATE
    // =========================================================

    private bool IsLoading = true;


    // =========================================================
    // FILTERED LOCATIONS
    // =========================================================

    private IEnumerable<WarehouseLocation> FilteredLocations
    {
        get
        {
            if (SelectedWarehouseId == 0)
                return Locations;

            return Locations.Where(x =>
                x.WarehouseId ==
                SelectedWarehouseId);
        }
    }


    // =========================================================
    // FILTERED STOCK
    // =========================================================

    private List<Models.Stock> FilteredStocks
    {
        get
        {
            var query =
                Stocks
                    .Where(x =>
                        x.Product != null);


            // =====================================================
            // SEARCH
            // =====================================================

            if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                var search =
                    SearchTerm.Trim();

                query =
                    query.Where(x =>
                        x.Product != null
                        &&
                        (
                            x.Product.Name.Contains(
                                search,
                                StringComparison.OrdinalIgnoreCase)

                            ||

                            x.Product.SKU.Contains(
                                search,
                                StringComparison.OrdinalIgnoreCase)

                            ||

                            (
                                !string.IsNullOrWhiteSpace(
                                    x.Product.Barcode)

                                &&

                                x.Product.Barcode.Contains(
                                    search,
                                    StringComparison.OrdinalIgnoreCase)
                            )
                        )
                    );
            }


            // =====================================================
            // WAREHOUSE
            // =====================================================

            if (SelectedWarehouseId > 0)
            {
                query =
                    query.Where(x =>
                        x.WarehouseLocation != null
                        &&
                        x.WarehouseLocation.WarehouseId ==
                            SelectedWarehouseId);
            }


            // =====================================================
            // LOCATION
            // =====================================================

            if (SelectedLocationId > 0)
            {
                query =
                    query.Where(x =>
                        x.WarehouseLocationId ==
                        SelectedLocationId);
            }


            return query
                .OrderBy(x =>
                    x.Product!.Name)

                .ThenBy(x =>
                    x.WarehouseLocation!.Code)

                .ToList();
        }
    }


    // =========================================================
    // PAGED STOCK
    // =========================================================

    private List<Models.Stock> PagedStocks =>
        FilteredStocks
            .Skip(
                (CurrentPage - 1) *
                PageSize)

            .Take(PageSize)

            .ToList();


    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                FilteredStocks.Count /
                (double)PageSize));


    private List<int> GetPageNumbers()
    {
        var pages =
            new List<int>();

        var start =
            Math.Max(
                1,
                CurrentPage - 2);

        var end =
            Math.Min(
                TotalPages,
                CurrentPage + 2);

        for (var i = start;
             i <= end;
             i++)
        {
            pages.Add(i);
        }

        return pages;
    }


    // =========================================================
    // SUMMARY
    // =========================================================

    private decimal TotalQuantity =>
        FilteredStocks.Sum(x =>
            x.Quantity);


    private decimal TotalPurchaseValue =>
        FilteredStocks.Sum(x =>
            x.Quantity *
            x.Product!.PurchasePrice);


    private decimal TotalSaleValue =>
        FilteredStocks.Sum(x =>
            x.Quantity *
            x.Product!.SalePrice);


    // =========================================================
    // LOAD
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }


    private async Task LoadData()
    {
        IsLoading = true;

        try
        {
            await using var context =
                await DbFactory.CreateDbContextAsync();


            // =====================================================
            // WAREHOUSES
            // =====================================================

            Warehouses =
                await context.Warehouses

                    .AsNoTracking()

                    .Where(x =>
                        x.IsActive)

                    .OrderBy(x =>
                        x.Name)

                    .ToListAsync();


            // =====================================================
            // LOCATIONS
            // =====================================================

            Locations =
                await context.WarehouseLocations

                    .AsNoTracking()

                    .Include(x =>
                        x.Warehouse)

                    .Where(x =>
                        x.IsActive)

                    .OrderBy(x =>
                        x.Code)

                    .ToListAsync();


            // =====================================================
            // STOCK
            // =====================================================

            Stocks =
                await context.Stocks

                    .AsNoTracking()

                    .Include(x =>
                        x.Product)

                    .Include(x =>
                        x.WarehouseLocation)

                        .ThenInclude(x =>
                            x.Warehouse)

                    .Where(x =>
                        x.Product != null)

                    .OrderBy(x =>
                        x.Product!.Name)

                    .ThenBy(x =>
                        x.WarehouseLocation!.Code)

                    .ToListAsync();
        }
        finally
        {
            IsLoading = false;
        }
    }


    // =========================================================
    // PAGINATION
    // =========================================================

    private void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
        }
    }


    private void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
        }
    }


    private void GoToPage(int page)
    {
        if (page < 1)
            page = 1;

        if (page > TotalPages)
            page = TotalPages;

        CurrentPage = page;
    }


    // =========================================================
    // EXCEL EXPORT
    // =========================================================

    private async Task ExportExcel()
    {
        try
        {
            var data =
                PagedStocks.ToList();

            if (data.Count == 0)
                return;


            var bytes =
                ExcelExport.Export(
                    data,

                    L["StockValueReport"].Value,

                    $"{L["StockValueReport"].Value} – {L["Page"]} {CurrentPage}",

                    (
                        L["Product"].Value,
                        x => x.Product?.Name ?? ""
                    ),

                    (
                        L["SKU"].Value,
                        x => x.Product?.SKU ?? ""
                    ),

                    (
                        L["Barcode"].Value,
                        x => x.Product?.Barcode ?? ""
                    ),

                    (
                        L["Warehouse"].Value,
                        x =>
                            x.WarehouseLocation?
                                .Warehouse?
                                .Name ?? ""
                    ),

                    (
                        L["StorageLocation"].Value,
                        x =>
                            x.WarehouseLocation?.Code ?? ""
                    ),

                    (
                        L["Stock"].Value,
                        x => x.Quantity
                    ),

                    (
                        L["PurchasePrice"].Value,
                        x =>
                            x.Product?.PurchasePrice ?? 0
                    ),

                    (
                        L["StockValue"].Value,
                        x =>
                            x.Quantity *
                            (x.Product?.PurchasePrice ?? 0)
                    ),

                    (
                        L["SalePrice"].Value,
                        x =>
                            x.Product?.SalePrice ?? 0
                    ),

                    (
                        L["SaleValue"].Value,
                        x =>
                            x.Quantity *
                            (x.Product?.SalePrice ?? 0)
                    )
                );


            var base64 =
                Convert.ToBase64String(bytes);


            await JS.InvokeVoidAsync(
                "downloadFile",

                $"{L["StockValueReport"].Value}_Seite_{CurrentPage}.xlsx",

                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",

                base64);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Fehler beim Excel-Export: {ex}");
        }
    }


    // =========================================================
    // INITIALS
    // =========================================================

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";


        var words =
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);


        if (words.Length == 1)
        {
            return words[0]
                .Substring(
                    0,
                    Math.Min(
                        2,
                        words[0].Length))
                .ToUpper();
        }


        return
            $"{words[0][0]}{words[1][0]}"
                .ToUpper();
    }

}