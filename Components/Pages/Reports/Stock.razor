@page "/reports/stock"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using Microsoft.Extensions.Localization
@using WarehouseManagement.Data
@using WarehouseManagement.Models
@using WarehouseManagement.Services
@using WarehouseManagement.Localization
@using WarehouseManagement.Components

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ExcelExportService ExcelExport
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["StockReport"]</PageTitle>

<div class="stock-page">

    <div class="page-header">

        <div>
            <h1>@L["StockReport"]</h1>

            <p>
                @L["StockReportDescription"]
            </p>
        </div>

        <div class="page-header-actions">

            <button type="button"
                    class="btn-secondary"
                    @onclick="ExportExcel"
                    disabled="@(PagedStocks.Count == 0)">

                📊 @L["ExportExcel"]

            </button>

            <a href="/reports"
               class="btn-secondary">

                ← @L["Reports"]

            </a>

        </div>

    </div>


    @if (IsLoading)
    {
        <div class="loading-state">
            @L["LoadingStock"]
        </div>
    }
    else
    {

        <!-- FILTER -->

        <div class="filter-card">

            <div class="filter-main-row">

                <div class="search-box">

                    <span class="search-icon">
                        ⌕
                    </span>

                    <input type="text"
                           placeholder="@L["SearchProductSkuBarcodePlaceholder"]"
                           @bind="SearchTerm"
                           @bind:event="oninput"
                           @bind:after="SearchChanged" />

                </div>


                <SearchableSelect TItem="Warehouse"
                                  TValue="int"
                                  Items="Warehouses"
                                  Value="SelectedWarehouseId"
                                  ValueChanged="OnWarehouseChanged"
                                  ValueSelector="@(x => x.Id)"
                                  TextSelector="@(x => x.Name)"
                                  Placeholder="@L["AllWarehouses"]"
                                  NoResultsText="@L["NoResultsFound"]"
                                  ShowAllOption="true"
                                  AllOptionText="@L["AllWarehouses"]"
                                  AllValue="0" />


                <SearchableSelect TItem="WarehouseLocation"
                                  TValue="int"
                                  Items="FilteredLocations.ToList()"
                                  Value="SelectedLocationId"
                                  ValueChanged="OnLocationChanged"
                                  ValueSelector="@(x => x.Id)"
                                  TextSelector="@(x => string.IsNullOrWhiteSpace(x.Name)
                                      ? x.Code
                                      : $"{x.Code} - {x.Name}")"
                                  Placeholder="@L["AllLocations"]"
                                  NoResultsText="@L["NoResultsFound"]"
                                  ShowAllOption="true"
                                  AllOptionText="@L["AllLocations"]"
                                  AllValue="0" />


                <SearchableSelect TItem="StockStatusOption"
                                  TValue="string"
                                  Items="StockStatusOptions"
                                  Value="SelectedStatus"
                                  ValueChanged="OnStatusChanged"
                                  ValueSelector="@(x => x.Value)"
                                  TextSelector="@(x => x.Text)"
                                  Placeholder="@L["AllStock"]"
                                  NoResultsText="@L["NoResultsFound"]"
                                  ShowAllOption="true"
                                  AllOptionText="@L["AllStock"]"
                                  AllValue="@("all")" />


                @if (HasActiveFilters)
                {
                    <button type="button"
                            class="btn-secondary filter-reset"
                            @onclick="ResetFilters">

                        @L["ResetFilters"]

                    </button>
                }

            </div>

        </div>


        <!-- SUMMARY -->

        <div class="stock-summary-grid">

            <div class="stock-summary-card">

                <span>
                    @L["Positions"]
                </span>

                <strong>
                    @FilteredStocks.Count
                </strong>

            </div>


            <div class="stock-summary-card">

                <span>
                    @L["TotalStock"]
                </span>

                <strong>
                    @TotalQuantity.ToString("N2")
                </strong>

            </div>


            <div class="stock-summary-card">

                <span>
                    @L["Reserved"]
                </span>

                <strong>
                    @TotalReserved.ToString("N2")
                </strong>

            </div>


            <div class="stock-summary-card">

                <span>
                    @L["Available"]
                </span>

                <strong>
                    @TotalAvailable.ToString("N2")
                </strong>

            </div>


            <div class="stock-summary-card">

                <span>
                    @L["LowStock"]
                </span>

                <strong>
                    @LowStockCount
                </strong>

            </div>

        </div>


        <!-- TABLE -->

        <div class="stock-table-card">

            @if (FilteredStocks.Count == 0)
            {
                <div class="empty-products">

                    <div class="empty-products-icon">
                        📦
                    </div>

                    <h3>
                        @L["NoStockFound"]
                    </h3>

                    <p>
                        @L["NoStockForFilters"]
                    </p>

                </div>
            }
            else
            {

                <div class="products-table-wrapper">

                    <table class="products-table">

                        <thead>

                            <tr>

                                <th>@L["Product"]</th>
                                <th>@L["SKU"]</th>
                                <th>@L["Warehouse"]</th>
                                <th>@L["StorageLocation"]</th>
                                <th>@L["Stock"]</th>
                                <th>@L["Reserved"]</th>
                                <th>@L["Available"]</th>
                                <th>@L["Status"]</th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var stock in PagedStocks)
                            {
                                <tr>

                                    <td>

                                        <div class="product-name">

                                            <div class="product-avatar">

                                                @GetInitials(
                                                    stock.ProductName)

                                            </div>

                                            <div>

                                                <strong>
                                                    @stock.ProductName
                                                </strong>

                                                @if (!string.IsNullOrWhiteSpace(
                                                    stock.Barcode))
                                                {
                                                    <small>
                                                        @stock.Barcode
                                                    </small>
                                                }

                                            </div>

                                        </div>

                                    </td>


                                    <td>
                                        @stock.SKU
                                    </td>


                                    <td>
                                        @stock.WarehouseName
                                    </td>


                                    <td>

                                        <div class="movement-location">

                                            <strong>
                                                @stock.LocationCode
                                            </strong>

                                            @if (!string.IsNullOrWhiteSpace(
                                                stock.LocationName))
                                            {
                                                <small>
                                                    @stock.LocationName
                                                </small>
                                            }

                                        </div>

                                    </td>


                                    <td>

                                        <strong>
                                            @stock.Quantity.ToString("N2")
                                        </strong>

                                    </td>


                                    <td>

                                        @if (stock.ReservedQuantity > 0)
                                        {
                                            <span class="stock-reserved">
                                                @stock.ReservedQuantity.ToString("N2")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                0,00
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        <strong>
                                            @stock.AvailableQuantity.ToString("N2")
                                        </strong>

                                    </td>


                                    <td>

                                        @if (stock.Quantity <= 0)
                                        {
                                            <span class="status-badge status-low">
                                                @L["NoStock"]
                                            </span>
                                        }
                                        else if (stock.Quantity <
                                                 stock.MinimumStock)
                                        {
                                            <span class="status-badge status-warning">
                                                @L["Low"]
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-active">
                                                @L["Ok"]
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>


                <!-- PAGINATION -->
                @if (TotalPages > 1)
                {
                    <div class="pagination">

                        <button type="button"
                                class="pagination-button"
                                disabled="@(CurrentPage <= 1)"
                                @onclick="PreviousPage">

                            ‹

                        </button>


                        <div class="pagination-pages">

                            @foreach (var pageNumber in GetPageNumbers())
                            {
                                <button type="button"
                                        class="pagination-button @(pageNumber == CurrentPage ? "active" : "")"
                                        @onclick="() => GoToPage(pageNumber)">

                                    @pageNumber

                                </button>
                            }

                        </div>


                        <button type="button"
                                class="pagination-button"
                                disabled="@(CurrentPage >= TotalPages)"
                                @onclick="NextPage">

                            ›

                        </button>

                    </div>
                }


                <div class="pagination-info">

                    @L["PageOf", CurrentPage, TotalPages]
                    · @L["PaginationStock", PagedStocks.Count, FilteredStocks.Count]

                </div>

            }

        </div>

    }

</div>


@code {

    private List<StockRow> Stocks = new();

    private List<Warehouse> Warehouses = new();

    private List<WarehouseLocation> Locations = new();


    // =========================================================
    // FILTER
    // =========================================================

    private string _searchTerm = string.Empty;

    private string SearchTerm
    {
        get => _searchTerm;

        set
        {
            if (_searchTerm == value)
                return;

            _searchTerm = value;

            CurrentPage = 1;
        }
    }


    private int _selectedWarehouseId;

    private int SelectedWarehouseId
    {
        get => _selectedWarehouseId;

        set
        {
            if (_selectedWarehouseId == value)
                return;

            _selectedWarehouseId = value;

            CurrentPage = 1;
        }
    }


    private int _selectedLocationId;

    private int SelectedLocationId
    {
        get => _selectedLocationId;

        set
        {
            if (_selectedLocationId == value)
                return;

            _selectedLocationId = value;

            CurrentPage = 1;
        }
    }


    private string _selectedStatus = "all";

    private string SelectedStatus
    {
        get => _selectedStatus;

        set
        {
            if (_selectedStatus == value)
                return;

            _selectedStatus = value;

            CurrentPage = 1;
        }
    }

    private class StockStatusOption
    {
        public string Value { get; set; } = string.Empty;
        public string Text { get; set; } = string.Empty;
    }

    private List<StockStatusOption> StockStatusOptions = new();


    // =========================================================
    // PAGINATION
    // =========================================================

    private const int PageSize = 10;

    private int CurrentPage = 1;


    private List<StockRow> PagedStocks =>
        FilteredStocks
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();


    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                FilteredStocks.Count /
                (double)PageSize));


    private List<int> GetPageNumbers()
    {
        var pages = new List<int>();

        var start =
            Math.Max(
                1,
                CurrentPage - 2);

        var end =
            Math.Min(
                TotalPages,
                CurrentPage + 2);

        for (var i = start; i <= end; i++)
        {
            pages.Add(i);
        }

        return pages;
    }


    // =========================================================
    // STATE
    // =========================================================

    private bool IsLoading = true;


    // =========================================================
    // FILTERED LOCATIONS
    // =========================================================

    private IEnumerable<WarehouseLocation> FilteredLocations =>
        SelectedWarehouseId == 0
            ? Locations
            : Locations.Where(x =>
                x.WarehouseId == SelectedWarehouseId);


    // =========================================================
    // FILTERED STOCK
    // =========================================================

    private List<StockRow> FilteredStocks =>
        Stocks

            .Where(x =>
                SelectedWarehouseId == 0
                ||
                x.WarehouseId == SelectedWarehouseId)

            .Where(x =>
                SelectedLocationId == 0
                ||
                x.WarehouseLocationId == SelectedLocationId)

            .Where(x =>
                string.IsNullOrWhiteSpace(SearchTerm)
                ||
                x.ProductName.Contains(
                    SearchTerm,
                    StringComparison.OrdinalIgnoreCase)
                ||
                x.SKU.Contains(
                    SearchTerm,
                    StringComparison.OrdinalIgnoreCase)
                ||
                (
                    !string.IsNullOrWhiteSpace(x.Barcode)
                    &&
                    x.Barcode.Contains(
                        SearchTerm,
                        StringComparison.OrdinalIgnoreCase)
                ))

            .Where(x =>
                SelectedStatus == "all"

                ||

                (
                    SelectedStatus == "ok"
                    &&
                    x.Quantity >= x.MinimumStock
                    &&
                    x.Quantity > 0
                )

                ||

                (
                    SelectedStatus == "low"
                    &&
                    x.Quantity > 0
                    &&
                    x.Quantity < x.MinimumStock
                )

                ||

                (
                    SelectedStatus == "empty"
                    &&
                    x.Quantity <= 0
                ))

            .OrderBy(x => x.WarehouseName)
            .ThenBy(x => x.LocationCode)
            .ThenBy(x => x.ProductName)
            .ToList();


    // =========================================================
    // SUMMARY
    // =========================================================

    private decimal TotalQuantity =>
        FilteredStocks.Sum(x =>
            x.Quantity);


    private decimal TotalReserved =>
        FilteredStocks.Sum(x =>
            x.ReservedQuantity);


    private decimal TotalAvailable =>
        FilteredStocks.Sum(x =>
            x.AvailableQuantity);


    private int LowStockCount =>
        FilteredStocks.Count(x =>
            x.Quantity > 0 &&
            x.Quantity < x.MinimumStock);


    // =========================================================
    // ACTIVE FILTERS
    // =========================================================

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(SearchTerm)
        ||
        SelectedWarehouseId > 0
        ||
        SelectedLocationId > 0
        ||
        SelectedStatus != "all";


    // =========================================================
    // INITIALIZATION
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        SelectedWarehouseId = 0;
        SelectedLocationId = 0;
        SelectedStatus = "all";

        StockStatusOptions = new List<StockStatusOption>
        {
            new() { Value = "ok", Text = L["StockOk"].Value },
            new() { Value = "low", Text = L["LowStock"].Value },
            new() { Value = "empty", Text = L["NoStock"].Value }
        };

        await LoadData();
    }


    // =========================================================
    // LOAD DATA
    // =========================================================

    private async Task LoadData()
    {
        IsLoading = true;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            Warehouses =
                await db.Warehouses
                    .AsNoTracking()
                    .Where(x => x.IsActive)
                    .OrderBy(x => x.Name)
                    .ToListAsync();


            Locations =
                await db.WarehouseLocations
                    .AsNoTracking()
                    .Where(x => x.IsActive)
                    .OrderBy(x => x.Code)
                    .ToListAsync();


            Stocks =
                await db.Stocks
                    .AsNoTracking()

                    .Include(x =>
                        x.Product)

                    .Include(x =>
                        x.WarehouseLocation)
                        .ThenInclude(x =>
                            x.Warehouse)

                    .Select(x => new StockRow
                    {
                        Id = x.Id,

                        ProductId =
                            x.ProductId,

                        WarehouseLocationId =
                            x.WarehouseLocationId,

                        WarehouseId =
                            x.WarehouseLocation != null
                                ? x.WarehouseLocation.WarehouseId
                                : 0,

                        ProductName =
                            x.Product != null
                                ? x.Product.Name
                                : "-",

                        SKU =
                            x.Product != null
                                ? x.Product.SKU
                                : "-",

                        Barcode =
                            x.Product != null
                                ? x.Product.Barcode
                                : null,

                        MinimumStock =
                            x.Product != null
                                ? x.Product.MinimumStock
                                : 0,

                        WarehouseName =
                            x.WarehouseLocation != null &&
                            x.WarehouseLocation.Warehouse != null
                                ? x.WarehouseLocation.Warehouse.Name
                                : "-",

                        LocationCode =
                            x.WarehouseLocation != null
                                ? x.WarehouseLocation.Code
                                : "-",

                        LocationName =
                            x.WarehouseLocation != null
                                ? x.WarehouseLocation.Name
                                : null,

                        Quantity =
                            x.Quantity,

                        ReservedQuantity =
                            x.ReservedQuantity,

                        AvailableQuantity =
                            x.AvailableQuantity
                    })

                    .ToListAsync();
        }
        finally
        {
            IsLoading = false;
        }
    }


    // =========================================================
    // SEARCH
    // =========================================================

    private Task SearchChanged()
    {
        CurrentPage = 1;

        return Task.CompletedTask;
    }


    // =========================================================
    // FILTER
    // =========================================================

    private async Task OnWarehouseChanged(int warehouseId)
    {
        SelectedWarehouseId = warehouseId;

        if (SelectedLocationId > 0)
        {
            var location =
                Locations.FirstOrDefault(x =>
                    x.Id == SelectedLocationId);

            if (location != null &&
                location.WarehouseId != SelectedWarehouseId)
            {
                SelectedLocationId = 0;
            }
        }

        CurrentPage = 1;

        await InvokeAsync(StateHasChanged);
    }


    private async Task OnLocationChanged(int locationId)
    {
        SelectedLocationId = locationId;
        CurrentPage = 1;

        await InvokeAsync(StateHasChanged);
    }


    private async Task OnStatusChanged(string value)
    {
        SelectedStatus = string.IsNullOrWhiteSpace(value)
            ? "all"
            : value;

        CurrentPage = 1;

        await InvokeAsync(StateHasChanged);
    }


    // =========================================================
    // RESET
    // =========================================================

    private async Task ResetFilters()
    {
        SearchTerm = string.Empty;

        SelectedWarehouseId = 0;

        SelectedLocationId = 0;

        SelectedStatus = "all";

        CurrentPage = 1;

        await InvokeAsync(StateHasChanged);
    }


    // =========================================================
    // PAGINATION
    // =========================================================

    private void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
        }
    }


    private void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
        }
    }


    private void GoToPage(int page)
    {
        if (page < 1)
            page = 1;

        if (page > TotalPages)
            page = TotalPages;

        CurrentPage = page;
    }


    // =========================================================
    // EXCEL EXPORT
    // =========================================================

    private async Task ExportExcel()
    {
        try
        {
            var data =
                PagedStocks.ToList();

            if (data.Count == 0)
                return;


            var bytes =
                ExcelExport.Export(
                    data,
                    L["StockReport"].Value,
                    $"{L["StockReport"].Value} – {L["Page"]} {CurrentPage}",

                    (
                        L["Product"].Value,
                        x => x.ProductName
                    ),

                    (
                        L["SKU"].Value,
                        x => x.SKU
                    ),

                    (
                        L["Barcode"].Value,
                        x => x.Barcode ?? ""
                    ),

                    (
                        L["Warehouse"].Value,
                        x => x.WarehouseName
                    ),

                    (
                        L["StorageLocation"].Value,
                        x =>
                            string.IsNullOrWhiteSpace(
                                x.LocationName)

                                ? x.LocationCode

                                : $"{x.LocationCode} - {x.LocationName}"
                    ),

                    (
                        L["Stock"].Value,
                        x => x.Quantity
                    ),

                    (
                        L["Reserved"].Value,
                        x => x.ReservedQuantity
                    ),

                    (
                        L["Available"].Value,
                        x => x.AvailableQuantity
                    ),

                    (
                        L["MinimumStock"].Value,
                        x => x.MinimumStock
                    ),

                    (
                        L["Status"].Value,
                        x => GetStockStatus(x)
                    )
                );


            var base64 =
                Convert.ToBase64String(bytes);


            await JS.InvokeVoidAsync(
                "downloadFile",
                $"{L["StockReport"].Value}_Seite_{CurrentPage}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                base64);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Fehler beim Excel-Export: {ex}");
        }
    }


    private string GetStockStatus(StockRow stock)
    {
        if (stock.Quantity <= 0)
            return L["NoStock"].Value;

        if (stock.Quantity < stock.MinimumStock)
            return L["Low"].Value;

        return L["Ok"].Value;
    }


    // =========================================================
    // INITIALS
    // =========================================================

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";


        var words =
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);


        if (words.Length == 1)
        {
            return words[0]
                .Substring(
                    0,
                    Math.Min(
                        2,
                        words[0].Length))
                .ToUpper();
        }


        return
            $"{words[0][0]}{words[1][0]}"
                .ToUpper();
    }


    // =========================================================
    // VIEW MODEL
    // =========================================================

    private class StockRow
    {
        public int Id { get; set; }

        public int ProductId { get; set; }

        public int WarehouseId { get; set; }

        public int WarehouseLocationId { get; set; }


        public string ProductName { get; set; }
            = string.Empty;

        public string SKU { get; set; }
            = string.Empty;

        public string? Barcode { get; set; }


        public string WarehouseName { get; set; }
            = string.Empty;

        public string LocationCode { get; set; }
            = string.Empty;

        public string? LocationName { get; set; }


        public decimal Quantity { get; set; }

        public decimal ReservedQuantity { get; set; }

        public decimal AvailableQuantity { get; set; }

        public decimal MinimumStock { get; set; }
    }

}