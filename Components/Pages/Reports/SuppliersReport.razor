@page "/reports/suppliers"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using Microsoft.Extensions.Localization
@using WarehouseManagement.Data
@using WarehouseManagement.Models
@using WarehouseManagement.Services
@using WarehouseManagement.Localization

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ExcelExportService ExcelExport
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["SupplierReport"]</PageTitle>

<div class="product-form-page">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="page-header">

        <div>

            <h1>
                @L["Suppliers"]
            </h1>

            <p>
                @L["SupplierReportDescription"]
            </p>

        </div>

        <div class="page-header-actions">

            <button type="button"
                    class="btn-secondary"
                    @onclick="ExportExcel"
                    disabled="@(PagedSuppliers.Count == 0)">

                📊 @L["ExportExcel"]

            </button>

            <a href="/suppliers/create"
               class="btn-primary">

                @L["NewSupplier"]

            </a>

        </div>

    </div>


    <!-- =========================================================
         FILTER
         ========================================================= -->

    <div class="filter-card">

        <div class="filter-main-row">

            <div class="search-box">

                <span class="search-icon">

                    <i class="bi bi-search"></i>

                </span>

                <input type="text"
                       placeholder="@L["SearchSupplierPlaceholder"]"
                       @bind="SearchTerm"
                       @bind:event="oninput" />

            </div>


            <select class="filter-select"
                    @bind="StatusFilter">

                <option value="Alle">
                    @L["AllSuppliers"]
                </option>

                <option value="Aktiv">
                    @L["ActiveSuppliers"]
                </option>

                <option value="Inaktiv">
                    @L["InactiveSuppliers"]
                </option>

            </select>

        </div>

    </div>


    <!-- =========================================================
         SUMMARY
         ========================================================= -->

    <div class="stock-summary-grid">

        <div class="stock-summary-card">

            <span>
                @L["Suppliers"]
            </span>

            <strong>
                @FilteredSuppliers.Count
            </strong>

            <small>
                @L["FilteredSuppliers"]
            </small>

        </div>


        <div class="stock-summary-card">

            <span>
                @L["Active"]
            </span>

            <strong>
                @ActiveCount
            </strong>

            <small>
                @L["ActiveSuppliers"]
            </small>

        </div>


        <div class="stock-summary-card">

            <span>
                @L["IncomingGoods"]
            </span>

            <strong>
                @IncomingCount
            </strong>

            <small>
                @L["Movements"]
            </small>

        </div>


        <div class="stock-summary-card">

            <span>
                @L["ReceivedQuantity"]
            </span>

            <strong>
                @IncomingQuantity.ToString("N2")
            </strong>

            <small>
                @L["TotalQuantity"]
            </small>

        </div>


        <div class="stock-summary-card">

            <span>
                @L["PurchaseOrders"]
            </span>

            <strong>
                @PurchaseOrderCount
            </strong>

            <small>
                @L["AssignedPurchaseOrders"]
            </small>

        </div>

    </div>


    <!-- =========================================================
         TABLE
         ========================================================= -->

    <div class="products-card">

        <div class="products-card-header">

            <div>

                <strong>
                    @L["SuppliersOverview"]
                </strong>

                <span>
                    @L["PaginationEntries", FilteredSuppliers.Count]
                </span>

            </div>

        </div>


        @if (IsLoading)
        {
            <div class="loading-state">

                @L["LoadingSuppliers"]

            </div>
        }
        else if (PagedSuppliers.Count == 0)
        {
            <div class="empty-products">

                <div class="empty-products-icon">

                    <i class="bi bi-truck"></i>

                </div>

                <h3>
                    @L["NoSuppliersFound"]
                </h3>

                <p>
                    @L["NoSuppliersForSearch"]
                </p>

            </div>
        }
        else
        {

            <div class="products-table-wrapper">

                <table class="products-table">

                    <thead>

                        <tr>

                            <th>
                                @L["Supplier"]
                            </th>

                            <th>
                                @L["SupplierNumber"]
                            </th>

                            <th>
                                @L["ContactPerson"]
                            </th>

                            <th>
                                @L["Contact"]
                            </th>

                            <th>
                                @L["Address"]
                            </th>

                            <th>
                                @L["IncomingGoods"]
                            </th>

                            <th>
                                @L["Quantity"]
                            </th>

                            <th>
                                @L["PurchaseOrders"]
                            </th>

                            <th>
                                @L["LastMovement"]
                            </th>

                            <th>
                                @L["Status"]
                            </th>

                            <th>
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var supplier in PagedSuppliers)
                        {
                            var supplierMovements =
                                Movements
                                    .Where(x =>
                                        x.SupplierId == supplier.Id)
                                    .ToList();

                            var incomingMovements =
                                supplierMovements
                                    .Where(x =>
                                        x.Type ==
                                        StockMovementType.Wareneingang)
                                    .ToList();

                            var purchaseOrders =
                                supplierMovements
                                    .Where(x =>
                                        x.PurchaseOrderId.HasValue)
                                    .Select(x =>
                                        x.PurchaseOrderId)
                                    .Distinct()
                                    .Count();

                            var lastMovement =
                                supplierMovements
                                    .OrderByDescending(x =>
                                        x.CreatedAt)
                                    .FirstOrDefault();


                            <tr>

                                <!-- SUPPLIER -->

                                <td>

                                    <div class="product-name">

                                        <div class="product-avatar">

                                            @GetInitials(
                                                supplier.CompanyName)

                                        </div>

                                        <div>

                                            <strong>
                                                @supplier.CompanyName
                                            </strong>

                                            @if (!string.IsNullOrWhiteSpace(
                                                supplier.VatNumber))
                                            {
                                                <small>
                                                    @supplier.VatNumber
                                                </small>
                                            }

                                        </div>

                                    </div>

                                </td>


                                <!-- SUPPLIER NUMBER -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        supplier.SupplierNumber))
                                    {
                                        @supplier.SupplierNumber
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- CONTACT PERSON -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        supplier.ContactPerson))
                                    {
                                        @supplier.ContactPerson
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- CONTACT -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        supplier.Email))
                                    {
                                        <div>
                                            @supplier.Email
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(
                                        supplier.Phone))
                                    {
                                        <small class="text-muted">
                                            @supplier.Phone
                                        </small>
                                    }

                                    @if (string.IsNullOrWhiteSpace(
                                        supplier.Email)
                                        &&
                                        string.IsNullOrWhiteSpace(
                                            supplier.Phone))
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- ADDRESS -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        supplier.Street))
                                    {
                                        <div>
                                            @supplier.Street
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(
                                        supplier.PostalCode)
                                        ||
                                        !string.IsNullOrWhiteSpace(
                                            supplier.City))
                                    {
                                        <div>
                                            @supplier.PostalCode
                                            @supplier.City
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(
                                        supplier.Country))
                                    {
                                        <small class="text-muted">
                                            @supplier.Country
                                        </small>
                                    }

                                    @if (string.IsNullOrWhiteSpace(
                                        supplier.Street)
                                        &&
                                        string.IsNullOrWhiteSpace(
                                            supplier.PostalCode)
                                        &&
                                        string.IsNullOrWhiteSpace(
                                            supplier.City)
                                        &&
                                        string.IsNullOrWhiteSpace(
                                            supplier.Country))
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- INCOMING -->

                                <td>

                                    <strong>
                                        @incomingMovements.Count
                                    </strong>

                                </td>


                                <!-- QUANTITY -->

                                <td>

                                    <strong>
                                        @incomingMovements
                                        .Sum(x => x.Quantity)
                                        .ToString("N2")
                                    </strong>

                                </td>


                                <!-- PURCHASE ORDERS -->

                                <td>

                                    @purchaseOrders

                                </td>


                                <!-- LAST MOVEMENT -->

                                <td>

                                    @if (lastMovement != null)
                                    {
                                        <div class="movement-date">

                                            <strong>
                                                @(lastMovement.CreatedAt
                                                    .ToLocalTime()
                                                    .ToString("dd.MM.yyyy"))
                                            </strong>

                                            <small>
                                                @GetMovementTypeName(
                                                    lastMovement.Type)
                                            </small>

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- STATUS -->

                                <td>

                                    @if (supplier.IsActive)
                                    {
                                        <span class="status-badge status-active">
                                            @L["Active"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">
                                            @L["Inactive"]
                                        </span>
                                    }

                                </td>


                                <!-- EDIT -->

                                <td>

                                    <a href="@($"/suppliers/edit/{supplier.Id}")"
                                       class="btn-secondary">

                                        <i class="bi bi-pencil me-1"></i>

                                        @L["Edit"]

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- =================================================
                 PAGINATION
                 ================================================= -->
            @if (TotalPages > 1)
            {
                <div class="pagination">

                    <button type="button"
                            class="pagination-button"
                            disabled="@(CurrentPage <= 1)"
                            @onclick="PreviousPage">

                        ‹

                    </button>


                    <div class="pagination-pages">

                        @foreach (var pageNumber in GetPageNumbers())
                        {
                            <button type="button"
                                    class="pagination-button @(pageNumber == CurrentPage ? "active" : "")"
                                    @onclick="() => GoToPage(pageNumber)">

                                @pageNumber

                            </button>
                        }

                    </div>


                    <button type="button"
                            class="pagination-button"
                            disabled="@(CurrentPage >= TotalPages)"
                            @onclick="NextPage">

                        ›

                    </button>

                </div>
            }


            <div class="pagination-info">

                @L["PageOf", CurrentPage, TotalPages]
                · @L["PaginationSuppliers", PagedSuppliers.Count, FilteredSuppliers.Count]

            </div>

        }

    </div>

</div>


@code {

    // =========================================================
    // DATA
    // =========================================================

    private List<Supplier> Suppliers = new();

    private List<StockMovement> Movements = new();


    // =========================================================
    // FILTER
    // =========================================================

    private string _searchTerm = string.Empty;

    private string SearchTerm
    {
        get => _searchTerm;

        set
        {
            if (_searchTerm == value)
                return;

            _searchTerm = value;

            CurrentPage = 1;
        }
    }


    private string _statusFilter = "Alle";

    private string StatusFilter
    {
        get => _statusFilter;

        set
        {
            if (_statusFilter == value)
                return;

            _statusFilter = value;

            CurrentPage = 1;
        }
    }


    // =========================================================
    // PAGINATION
    // =========================================================

    private const int PageSize = 10;

    private int CurrentPage = 1;


    private List<Supplier> PagedSuppliers =>
        FilteredSuppliers
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();


    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                FilteredSuppliers.Count /
                (double)PageSize));


    private List<int> GetPageNumbers()
    {
        var pages = new List<int>();

        var start =
            Math.Max(
                1,
                CurrentPage - 2);

        var end =
            Math.Min(
                TotalPages,
                CurrentPage + 2);

        for (var i = start; i <= end; i++)
        {
            pages.Add(i);
        }

        return pages;
    }


    // =========================================================
    // STATE
    // =========================================================

    private bool IsLoading = true;


    // =========================================================
    // FILTERED SUPPLIERS
    // =========================================================

    private List<Supplier> FilteredSuppliers
    {
        get
        {
            var query =
                Suppliers.AsEnumerable();


            if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                var search =
                    SearchTerm.Trim();

                query =
                    query.Where(s =>
                        s.CompanyName.Contains(
                            search,
                            StringComparison.OrdinalIgnoreCase)

                        ||

                        (
                            !string.IsNullOrWhiteSpace(
                                s.SupplierNumber)

                            &&

                            s.SupplierNumber.Contains(
                                search,
                                StringComparison.OrdinalIgnoreCase)
                        )

                        ||

                        (
                            !string.IsNullOrWhiteSpace(
                                s.ContactPerson)

                            &&

                            s.ContactPerson.Contains(
                                search,
                                StringComparison.OrdinalIgnoreCase)
                        )

                        ||

                        (
                            !string.IsNullOrWhiteSpace(
                                s.Email)

                            &&

                            s.Email.Contains(
                                search,
                                StringComparison.OrdinalIgnoreCase)
                        )

                        ||

                        (
                            !string.IsNullOrWhiteSpace(
                                s.Phone)

                            &&

                            s.Phone.Contains(
                                search,
                                StringComparison.OrdinalIgnoreCase)
                        )

                        ||

                        (
                            !string.IsNullOrWhiteSpace(
                                s.City)

                            &&

                            s.City.Contains(
                                search,
                                StringComparison.OrdinalIgnoreCase)
                        )

                        ||

                        (
                            !string.IsNullOrWhiteSpace(
                                s.VatNumber)

                            &&

                            s.VatNumber.Contains(
                                search,
                                StringComparison.OrdinalIgnoreCase)
                        )
                    );
            }


            query =
                query.Where(s =>
                    StatusFilter == "Alle"

                    ||

                    (
                        StatusFilter == "Aktiv"
                        &&
                        s.IsActive
                    )

                    ||

                    (
                        StatusFilter == "Inaktiv"
                        &&
                        !s.IsActive
                    )
                );


            return query
                .OrderBy(s => s.CompanyName)
                .ToList();
        }
    }


    // =========================================================
    // SUMMARY
    // =========================================================

    private int ActiveCount =>
        FilteredSuppliers.Count(x =>
            x.IsActive);


    private int IncomingCount =>
        FilteredMovements.Count(x =>
            x.Type ==
            StockMovementType.Wareneingang);


    private decimal IncomingQuantity =>
        FilteredMovements
            .Where(x =>
                x.Type ==
                StockMovementType.Wareneingang)
            .Sum(x =>
                x.Quantity);


    private int PurchaseOrderCount =>
        FilteredMovements
            .Where(x =>
                x.PurchaseOrderId.HasValue)
            .Select(x =>
                x.PurchaseOrderId)
            .Distinct()
            .Count();


    private IEnumerable<StockMovement> FilteredMovements =>
        Movements.Where(x =>
            FilteredSuppliers.Any(s =>
                s.Id == x.SupplierId));


    // =========================================================
    // LOAD
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }


    private async Task LoadData()
    {
        IsLoading = true;

        try
        {
            await using var context =
                await DbFactory.CreateDbContextAsync();


            Suppliers =
                await context.Suppliers
                    .AsNoTracking()
                    .OrderBy(x =>
                        x.CompanyName)
                    .ToListAsync();


            Movements =
                await context.StockMovements
                    .AsNoTracking()
                    .Where(x =>
                        x.SupplierId.HasValue)
                    .ToListAsync();
        }
        finally
        {
            IsLoading = false;
        }
    }


    // =========================================================
    // PAGINATION
    // =========================================================

    private void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
        }
    }


    private void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
        }
    }


    private void GoToPage(int page)
    {
        if (page < 1)
            page = 1;

        if (page > TotalPages)
            page = TotalPages;

        CurrentPage = page;
    }


    // =========================================================
    // EXCEL EXPORT
    // =========================================================

    private async Task ExportExcel()
    {
        try
        {
            var data =
                PagedSuppliers.ToList();

            if (data.Count == 0)
                return;


            var bytes =
                ExcelExport.Export(
                    data,
                    L["Suppliers"].Value,
                    $"{L["SupplierReport"].Value} – {L["Page"]} {CurrentPage}",

                    (
                        L["Supplier"].Value,
                        x => x.CompanyName
                    ),

                    (
                        L["SupplierNumber"].Value,
                        x => x.SupplierNumber ?? ""
                    ),

                    (
                        L["ContactPerson"].Value,
                        x => x.ContactPerson ?? ""
                    ),

                    (
                        L["Email"].Value,
                        x => x.Email ?? ""
                    ),

                    (
                        L["Phone"].Value,
                        x => x.Phone ?? ""
                    ),

                    (
                        L["Street"].Value,
                        x => x.Street ?? ""
                    ),

                    (
                        L["PostalCode"].Value,
                        x => x.PostalCode ?? ""
                    ),

                    (
                        L["City"].Value,
                        x => x.City ?? ""
                    ),

                    (
                        L["Country"].Value,
                        x => x.Country ?? ""
                    ),

                    (
                        L["VatNumber"].Value,
                        x => x.VatNumber ?? ""
                    ),

                    (
                        L["IncomingGoods"].Value,
                        x => Movements
                            .Count(m =>
                                m.SupplierId == x.Id
                                &&
                                m.Type ==
                                StockMovementType.Wareneingang)
                    ),

                    (
                        L["ReceivedQuantity"].Value,
                        x => Movements
                            .Where(m =>
                                m.SupplierId == x.Id
                                &&
                                m.Type ==
                                StockMovementType.Wareneingang)
                            .Sum(m =>
                                m.Quantity)
                    ),

                    (
                        L["PurchaseOrders"].Value,
                        x => Movements
                            .Where(m =>
                                m.SupplierId == x.Id
                                &&
                                m.PurchaseOrderId.HasValue)
                            .Select(m =>
                                m.PurchaseOrderId)
                            .Distinct()
                            .Count()
                    ),

                    (
                        L["Status"].Value,
                        x => x.IsActive
                            ? L["Active"].Value
                            : L["Inactive"].Value
                    ),

                    (
                        L["CreatedAt"].Value,
                        x => x.CreatedAt
                    ),

                    (
                        L["Note"].Value,
                        x => x.Note ?? ""
                    )
                );


            var base64 =
                Convert.ToBase64String(bytes);


            await JS.InvokeVoidAsync(
                "downloadFile",
                $"{L["SupplierReport"].Value}_Seite_{CurrentPage}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                base64);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Fehler beim Excel-Export: {ex}");
        }
    }


    // =========================================================
    // MOVEMENT TYPE
    // =========================================================

    private string GetMovementTypeName(
        StockMovementType type)
    {
        return type switch
        {
            StockMovementType.Wareneingang =>
                L["IncomingGoods"].Value,

            StockMovementType.Warenausgang =>
                L["OutgoingGoods"].Value,

            StockMovementType.Umlagerung =>
                L["Transfer"].Value,

            StockMovementType.Inventur =>
                L["Inventory"].Value,

            StockMovementType.Korrektur =>
                L["Correction"].Value,

            _ =>
                type.ToString()
        };
    }


    // =========================================================
    // INITIALS
    // =========================================================

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";


        var words =
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);


        if (words.Length == 1)
        {
            return words[0]
                .Substring(
                    0,
                    Math.Min(
                        2,
                        words[0].Length))
                .ToUpper();
        }


        return
            $"{words[0][0]}{words[1][0]}"
                .ToUpper();
    }

}