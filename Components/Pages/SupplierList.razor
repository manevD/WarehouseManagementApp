@page "/suppliers"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@using WarehouseManagement.Data
@using WarehouseManagement.Localization
@using WarehouseManagement.Models
@using WarehouseManagement.Services

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@inject ExcelExportService ExcelExport
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Suppliers"]</PageTitle>

<div class="product-list-page">

    <!-- HEADER -->

    <div class="page-header">

        <div>

            <h1>@L["Suppliers"]</h1>

            <p>
                @L["ManageSuppliersDescription"]
            </p>

        </div>

        <div>

            <button type="button"
                    class="btn-secondary"
                    @onclick="ExportExcel"
                    disabled="@(PagedSuppliers.Count == 0)">

                📊 @L["ExportExcel"]

            </button>

            <a href="/suppliers/create"
               class="btn-primary">

                + @L["NewSupplier"]

            </a>

        </div>

    </div>


    <!-- SEARCH / FILTER -->

    <div class="filter-card">

        <div class="search-box">

            <span class="search-icon">
                ⌕
            </span>

            <input type="text"
                   class="search-input"
                   placeholder="@L["SearchSupplierPlaceholder"]"
                   @bind="SearchTerm"
                   @bind:event="oninput"
                   @bind:after="SearchChanged" />

        </div>


        <select class="filter-select"
                @bind="SelectedStatus"
                @bind:after="FilterChanged">

            <option value="all">
                @L["AllSuppliers"]
            </option>

            <option value="active">
                @L["ActiveOnly"]
            </option>

            <option value="inactive">
                @L["InactiveOnly"]
            </option>

        </select>

    </div>


    <!-- SUMMARY -->

    <div class="stock-summary-grid">

        <div class="stock-summary-card">

            <span>
                @L["Suppliers"]
            </span>

            <strong>
                @Suppliers.Count
            </strong>

        </div>


        <div class="stock-summary-card">

            <span>
                @L["Active"]
            </span>

            <strong>
                @ActiveCount
            </strong>

        </div>


        <div class="stock-summary-card">

            <span>
                @L["Inactive"]
            </span>

            <strong>
                @InactiveCount
            </strong>

        </div>

    </div>


    <!-- TABLE -->

    <div class="products-card">

        <div class="products-card-header">

            <div>

                <strong>
                    @L["SupplierList"]
                </strong>

                <span>
                    @L["EntriesCount", Suppliers.Count]
                </span>

            </div>

        </div>


        @if (IsLoading)
        {
            <div class="loading-state">

                @L["SuppliersLoading"]

            </div>
        }
        else if (Suppliers.Count == 0)
        {
            <div class="empty-products">

                <div class="empty-products-icon">
                    🏢
                </div>

                <h3>
                    @L["NoSuppliersFound"]
                </h3>

                <p>
                    @L["NoSuppliersForSearch"]
                </p>

            </div>
        }
        else
        {
            <div class="products-table-wrapper">

                <table class="products-table">

                    <thead>

                        <tr>

                            <th>
                                @L["Number"]
                            </th>

                            <th>
                                @L["Company"]
                            </th>

                            <th>
                                @L["ContactPerson"]
                            </th>

                            <th>
                                @L["Email"]
                            </th>

                            <th>
                                @L["Phone"]
                            </th>

                            <th>
                                @L["City"]
                            </th>

                            <th>
                                @L["VatNumber"]
                            </th>

                            <th>
                                @L["Status"]
                            </th>

                            <th>
                                @L["Actions"]
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var supplier in PagedSuppliers)
                        {
                            <tr>

                                <!-- NUMBER -->

                                <td>

                                    <span class="product-sku">

                                        @(string.IsNullOrWhiteSpace(
                                            supplier.SupplierNumber)
                                            ? $"#{supplier.Id}"
                                            : supplier.SupplierNumber)

                                    </span>

                                </td>


                                <!-- COMPANY -->

                                <td>

                                    <div class="product-name">

                                        <div class="product-avatar">

                                            @GetInitials(
                                                supplier.CompanyName)

                                        </div>

                                        <div>

                                            <strong>
                                                @supplier.CompanyName
                                            </strong>

                                            @if (!string.IsNullOrWhiteSpace(
                                                supplier.Street))
                                            {
                                                <small>
                                                    @supplier.Street
                                                </small>
                                            }

                                        </div>

                                    </div>

                                </td>


                                <!-- CONTACT PERSON -->

                                <td>

                                    @(string.IsNullOrWhiteSpace(
                                        supplier.ContactPerson)
                                        ? "-"
                                        : supplier.ContactPerson)

                                </td>


                                <!-- EMAIL -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        supplier.Email))
                                    {
                                        <a href="mailto:@supplier.Email">
                                            @supplier.Email
                                        </a>
                                    }
                                    else
                                    {
                                        <span>
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- PHONE -->

                                <td>

                                    @(string.IsNullOrWhiteSpace(
                                        supplier.Phone)
                                        ? "-"
                                        : supplier.Phone)

                                </td>


                                <!-- CITY -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        supplier.PostalCode) ||
                                        !string.IsNullOrWhiteSpace(
                                            supplier.City))
                                    {
                                        @($"{supplier.PostalCode} {supplier.City}")
                                    }
                                    else
                                    {
                                        <span>
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- VAT -->

                                <td>

                                    @(string.IsNullOrWhiteSpace(
                                        supplier.VatNumber)
                                        ? "-"
                                        : supplier.VatNumber)

                                </td>


                                <!-- STATUS -->

                                <td>

                                    @if (supplier.IsActive)
                                    {
                                        <span class="status-badge status-active">
                                            @L["Active"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-low">
                                            @L["Inactive"]
                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->

                                <td>

                                    <div class="product-actions">

                                        <a href="/suppliers/edit/@supplier.Id"
                                           class="action-button"
                                           title="@L["Edit"]">

                                            ✎

                                        </a>


                                        <button type="button"
                                                class="action-button delete-button"
                                                title="@L["Delete"]"
                                                @onclick="() => DeleteSupplier(supplier)">

                                            🗑

                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- PAGINATION -->
            @if (TotalPages > 1)
            {
                <div class="pagination">

                    <button type="button"
                            class="pagination-button"
                            disabled="@(CurrentPage <= 1)"
                            @onclick="PreviousPage">

                        ‹

                    </button>


                    <div class="pagination-pages">

                        @for (int page = 1; page <= TotalPages; page++)
                        {
                            var pageNumber = page;

                            <button type="button"
                                    class="pagination-button @(CurrentPage == pageNumber ? "active" : "")"
                                    @onclick="() => GoToPage(pageNumber)">

                                @pageNumber

                            </button>
                        }

                    </div>


                    <button type="button"
                            class="pagination-button"
                            disabled="@(CurrentPage >= TotalPages)"
                            @onclick="NextPage">

                        ›

                    </button>

                </div>
            }


            <div class="pagination-info">

                @L[
                    "PaginationInfoSuppliers",
                    CurrentPage,
                    TotalPages,
                    PagedSuppliers.Count,
                    Suppliers.Count
                ]

            </div>
        }

    </div>

</div>


@code {

    // =========================================================
    // SETTINGS
    // =========================================================

    private const int PageSize = 10;


    // =========================================================
    // STATE
    // =========================================================

    private int CurrentPage = 1;

    private List<Supplier> Suppliers = new();

    private string SearchTerm = string.Empty;

    private string SelectedStatus = "all";

    private bool IsLoading = true;


    // =========================================================
    // SUMMARY
    // =========================================================

    private int ActiveCount =>
        Suppliers.Count(x =>
            x.IsActive);


    private int InactiveCount =>
        Suppliers.Count(x =>
            !x.IsActive);


    // =========================================================
    // PAGINATION
    // =========================================================

    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                Suppliers.Count /
                (double)PageSize));


    private List<Supplier> PagedSuppliers =>
        Suppliers
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();


    // =========================================================
    // INITIALIZATION
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadSuppliers();
    }


    // =========================================================
    // LOAD SUPPLIERS
    // =========================================================

    private async Task LoadSuppliers()
    {
        IsLoading = true;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            var query =
                db.Suppliers
                    .AsQueryable();


            // =================================================
            // SEARCH
            // =================================================

            if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                var search =
                    SearchTerm.Trim();


                query =
                    query.Where(x =>

                        x.CompanyName.Contains(search)

                        ||

                        (
                            x.ContactPerson != null
                            &&
                            x.ContactPerson.Contains(search)
                        )

                        ||

                        (
                            x.Email != null
                            &&
                            x.Email.Contains(search)
                        )

                        ||

                        (
                            x.Phone != null
                            &&
                            x.Phone.Contains(search)
                        )

                        ||

                        (
                            x.City != null
                            &&
                            x.City.Contains(search)
                        )

                        ||

                        (
                            x.SupplierNumber != null
                            &&
                            x.SupplierNumber.Contains(search)
                        )

                        ||

                        (
                            x.VatNumber != null
                            &&
                            x.VatNumber.Contains(search)
                        )

                    );
            }


            // =================================================
            // STATUS
            // =================================================

            if (SelectedStatus == "active")
            {
                query =
                    query.Where(x =>
                        x.IsActive);
            }
            else if (SelectedStatus == "inactive")
            {
                query =
                    query.Where(x =>
                        !x.IsActive);
            }


            // =================================================
            // LOAD
            // =================================================

            Suppliers =
                await query
                    .OrderBy(x =>
                        x.CompanyName)
                    .ToListAsync();


            CurrentPage = 1;
        }
        finally
        {
            IsLoading = false;
        }
    }


    // =========================================================
    // SEARCH CHANGED
    // =========================================================

    private async Task SearchChanged()
    {
        CurrentPage = 1;

        await LoadSuppliers();
    }


    // =========================================================
    // FILTER CHANGED
    // =========================================================

    private async Task FilterChanged()
    {
        CurrentPage = 1;

        await LoadSuppliers();
    }


    // =========================================================
    // PAGINATION
    // =========================================================

    private void GoToPage(int page)
    {
        if (page < 1 ||
            page > TotalPages)
        {
            return;
        }

        CurrentPage = page;
    }


    private void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
        }
    }


    private void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
        }
    }


    // =========================================================
    // EXCEL EXPORT
    // =========================================================

    private async Task ExportExcel()
    {
        var data =
            PagedSuppliers
                .Where(x => x != null)
                .ToList();


        if (data.Count == 0)
            return;


        var fileBytes =
            ExcelExport.Export(
                data,
                "Lieferanten",
                $"{L["Suppliers"]} – {L["Page"]} {CurrentPage}",

                ("Nr.", x =>
                    string.IsNullOrWhiteSpace(
                        x.SupplierNumber)
                        ? $"#{x.Id}"
                        : x.SupplierNumber),

                ("Firma", x =>
                    x.CompanyName ?? ""),

                ("Ansprechpartner", x =>
                    x.ContactPerson ?? ""),

                ("E-Mail", x =>
                    x.Email ?? ""),

                ("Telefon", x =>
                    x.Phone ?? ""),

                ("Straße", x =>
                    x.Street ?? ""),

                ("PLZ", x =>
                    x.PostalCode ?? ""),

                ("Ort", x =>
                    x.City ?? ""),

                ("Land", x =>
                    x.Country ?? ""),

                ("USt-IdNr.", x =>
                    x.VatNumber ?? ""),

                ("Status", x =>
                    x.IsActive
                        ? L["Active"].Value
                        : L["Inactive"].Value),

                ("Notiz", x =>
                    x.Note ?? "")
            );


        var base64 =
            Convert.ToBase64String(fileBytes);


        await JS.InvokeVoidAsync(
            "downloadFile",
            $"{L["Suppliers"]}_{L["Page"]}_{CurrentPage}.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            base64);
    }


    // =========================================================
    // DELETE / DEACTIVATE SUPPLIER
    // =========================================================

    private async Task DeleteSupplier(
        Supplier supplier)
    {
        // Soft delete.
        // The existing page currently does not show
        // a confirmation dialog.

        await using var db =
            await DbFactory.CreateDbContextAsync();


        var entity =
            await db.Suppliers
                .FirstOrDefaultAsync(
                    x =>
                        x.Id == supplier.Id);


        if (entity == null)
            return;


        entity.IsActive =
            false;


        await db.SaveChangesAsync();


        await LoadSuppliers();
    }


    // =========================================================
    // INITIALS
    // =========================================================

    private string GetInitials(
        string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";


        var words =
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);


        if (words.Length == 1)
        {
            return words[0]
                .Substring(
                    0,
                    Math.Min(
                        2,
                        words[0].Length))
                .ToUpper();
        }


        return
            $"{words[0][0]}{words[1][0]}"
                .ToUpper();
    }

}