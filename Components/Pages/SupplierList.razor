@page "/suppliers"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using WarehouseManagement.Data
@using WarehouseManagement.Models
@using WarehouseManagement.Services

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@inject ExcelExportService ExcelExport
@inject IJSRuntime JS

<PageTitle>Lieferanten</PageTitle>

<div class="product-list-page">

    <!-- HEADER -->

    <div class="page-header">

        <div>
            <h1>Lieferanten</h1>
            <p>Verwalten Sie Ihre Lieferanten.</p>
        </div>

        <div>
        <button type="button"
                    class="btn-secondary"
                    @onclick="ExportExcel" disabled="@(PagedSuppliers.Count == 0)">

                📊 Excel exportieren

            </button>

            <a href="/suppliers/create"
               class="btn-primary">
                + Neuer Lieferant
            </a>
        </div>

    </div>


    <!-- SEARCH / FILTER -->

    <div class="filter-card">

        <div class="search-box">

            <span class="search-icon">⌕</span>

            <input type="text"
                   class="search-input"
                   placeholder="Lieferant, Ansprechpartner, E-Mail oder Telefonnummer suchen..."
                   @bind="SearchTerm"
                   @bind:event="oninput"
                   @bind:after="SearchChanged" />

        </div>


        <select class="filter-select"
                @bind="SelectedStatus"
                @bind:after="FilterChanged">

            <option value="all">
                Alle Lieferanten
            </option>

            <option value="active">
                Nur aktive
            </option>

            <option value="inactive">
                Nur inaktive
            </option>

        </select>

    </div>


    <!-- SUMMARY -->

    <div class="stock-summary-grid">

        <div class="stock-summary-card">

            <span>Lieferanten</span>

            <strong>
                @Suppliers.Count
            </strong>

        </div>


        <div class="stock-summary-card">

            <span>Aktiv</span>

            <strong>
                @ActiveCount
            </strong>

        </div>


        <div class="stock-summary-card">

            <span>Inaktiv</span>

            <strong>
                @InactiveCount
            </strong>

        </div>

    </div>


    <!-- TABLE -->

    <div class="products-card">

        <div class="products-card-header">

            <div>

                <strong>
                    Lieferantenliste
                </strong>

                <span>
                    @Suppliers.Count Einträge
                </span>

            </div>

        </div>


        @if (IsLoading)
        {
            <div class="loading-state">
                Lieferanten werden geladen...
            </div>
        }
        else if (Suppliers.Count == 0)
        {
            <div class="empty-products">

                <div class="empty-products-icon">
                    🏢
                </div>

                <h3>
                    Keine Lieferanten gefunden
                </h3>

                <p>
                    Für die aktuelle Suche wurden keine Lieferanten gefunden.
                </p>

            </div>
        }
        else
        {
            <div class="products-table-wrapper">

                <table class="products-table">

                    <thead>

                        <tr>

                            <th>Nr.</th>

                            <th>Firma</th>

                            <th>Ansprechpartner</th>

                            <th>E-Mail</th>

                            <th>Telefon</th>

                            <th>Ort</th>

                            <th>USt-IdNr.</th>

                            <th>Status</th>

                            <th>Aktionen</th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var supplier in PagedSuppliers)
                        {
                            <tr>

                                <!-- NUMMER -->

                                <td>

                                    <span class="product-sku">
                                        @(string.IsNullOrWhiteSpace(
                                            supplier.SupplierNumber)
                                            ? $"#{supplier.Id}"
                                            : supplier.SupplierNumber)
                                    </span>

                                </td>


                                <!-- FIRMA -->

                                <td>

                                    <div class="product-name">

                                        <div class="product-avatar">
                                            @GetInitials(
                                                supplier.CompanyName)
                                        </div>

                                        <div>

                                            <strong>
                                                @supplier.CompanyName
                                            </strong>

                                            @if (!string.IsNullOrWhiteSpace(
                                                supplier.Street))
                                            {
                                                <small>
                                                    @supplier.Street
                                                </small>
                                            }

                                        </div>

                                    </div>

                                </td>


                                <!-- ANSPRECHPARTNER -->

                                <td>

                                    @(string.IsNullOrWhiteSpace(
                                        supplier.ContactPerson)
                                        ? "-"
                                        : supplier.ContactPerson)

                                </td>


                                <!-- EMAIL -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        supplier.Email))
                                    {
                                        <a href="mailto:@supplier.Email">
                                            @supplier.Email
                                        </a>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }

                                </td>


                                <!-- TELEFON -->

                                <td>

                                    @(string.IsNullOrWhiteSpace(
                                        supplier.Phone)
                                        ? "-"
                                        : supplier.Phone)

                                </td>


                                <!-- ORT -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        supplier.PostalCode) ||
                                        !string.IsNullOrWhiteSpace(
                                            supplier.City))
                                    {
                                        @($"{supplier.PostalCode} {supplier.City}")
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }

                                </td>


                                <!-- VAT -->

                                <td>

                                    @(string.IsNullOrWhiteSpace(
                                        supplier.VatNumber)
                                        ? "-"
                                        : supplier.VatNumber)

                                </td>


                                <!-- STATUS -->

                                <td>

                                    @if (supplier.IsActive)
                                    {
                                        <span class="status-badge status-active">
                                            Aktiv
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-low">
                                            Inaktiv
                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->

                                <td>

                                    <div class="product-actions">

                                        <a href="/suppliers/edit/@supplier.Id"
                                           class="action-button"
                                           title="Bearbeiten">

                                            ✎

                                        </a>


                                        <button type="button"
                                                class="action-button delete-button"
                                                title="Löschen"
                                                @onclick="() => DeleteSupplier(supplier)">

                                            🗑

                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- PAGINATION -->
            @if (TotalPages > 1)
            {
                <div class="pagination">

                    <button type="button"
                            class="pagination-button"
                            disabled="@(CurrentPage <= 1)"
                            @onclick="PreviousPage">

                        ‹

                    </button>


                    <div class="pagination-pages">

                        @for (int page = 1; page <= TotalPages; page++)
                        {
                            var pageNumber = page;

                            <button type="button"
                                    class="pagination-button @(CurrentPage == pageNumber ? "active" : "")"
                                    @onclick="() => GoToPage(pageNumber)">

                                @pageNumber

                            </button>
                        }

                    </div>


                    <button type="button"
                            class="pagination-button"
                            disabled="@(CurrentPage >= TotalPages)"
                            @onclick="NextPage">

                        ›

                    </button>

                </div>
            }


            <div class="pagination-info">

                Seite @CurrentPage von @TotalPages
                · @PagedSuppliers.Count von @Suppliers.Count Lieferanten

            </div>
        }

    </div>

</div>


@code {

    private const int PageSize = 10;

    private int CurrentPage = 1;

    private List<Supplier> Suppliers = new();

    private string SearchTerm = string.Empty;

    private string SelectedStatus = "all";

    private bool IsLoading = true;


    private int ActiveCount =>
        Suppliers.Count(x => x.IsActive);


    private int InactiveCount =>
        Suppliers.Count(x => !x.IsActive);


    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                Suppliers.Count /
                (double)PageSize));


    private List<Supplier> PagedSuppliers =>
        Suppliers
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();


    protected override async Task OnInitializedAsync()
    {
        await LoadSuppliers();
    }


    private async Task LoadSuppliers()
    {
        IsLoading = true;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            var query =
                db.Suppliers.AsQueryable();


            // SEARCH

            if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                var search =
                    SearchTerm.Trim();

                query =
                    query.Where(x =>

                        x.CompanyName.Contains(search)

                        ||

                        (
                            x.ContactPerson != null &&
                            x.ContactPerson.Contains(search)
                        )

                        ||

                        (
                            x.Email != null &&
                            x.Email.Contains(search)
                        )

                        ||

                        (
                            x.Phone != null &&
                            x.Phone.Contains(search)
                        )

                        ||

                        (
                            x.City != null &&
                            x.City.Contains(search)
                        )

                        ||

                        (
                            x.SupplierNumber != null &&
                            x.SupplierNumber.Contains(search)
                        )

                        ||

                        (
                            x.VatNumber != null &&
                            x.VatNumber.Contains(search)
                        )
                    );
            }


            // STATUS

            if (SelectedStatus == "active")
            {
                query =
                    query.Where(x => x.IsActive);
            }
            else if (SelectedStatus == "inactive")
            {
                query =
                    query.Where(x => !x.IsActive);
            }


            Suppliers =
                await query
                    .OrderBy(x => x.CompanyName)
                    .ToListAsync();


            CurrentPage = 1;
        }
        finally
        {
            IsLoading = false;
        }
    }


    private async Task SearchChanged()
    {
        CurrentPage = 1;

        await LoadSuppliers();
    }


    private async Task FilterChanged()
    {
        CurrentPage = 1;

        await LoadSuppliers();
    }


    private void GoToPage(int page)
    {
        if (page < 1 || page > TotalPages)
            return;

        CurrentPage = page;
    }


    private void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
        }
    }


    private void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
        }
    }


    private async Task ExportExcel()
    {
        var data = PagedSuppliers
            .Where(x => x != null)
            .ToList();

        if (data.Count == 0)
            return;


        var fileBytes = ExcelExport.Export(
            data,
            "Lieferanten",
            $"Lieferanten – Seite {CurrentPage}",

            ("Nr.", x =>
                string.IsNullOrWhiteSpace(x.SupplierNumber)
                    ? $"#{x.Id}"
                    : x.SupplierNumber),

            ("Firma", x =>
                x.CompanyName ?? ""),

            ("Ansprechpartner", x =>
                x.ContactPerson ?? ""),

            ("E-Mail", x =>
                x.Email ?? ""),

            ("Telefon", x =>
                x.Phone ?? ""),

            ("Straße", x =>
                x.Street ?? ""),

            ("PLZ", x =>
                x.PostalCode ?? ""),

            ("Ort", x =>
                x.City ?? ""),

            ("Land", x =>
                x.Country ?? ""),

            ("USt-IdNr.", x =>
                x.VatNumber ?? ""),

            ("Status", x =>
                x.IsActive
                    ? "Aktiv"
                    : "Inaktiv"),

            ("Notiz", x =>
                x.Note ?? "")
        );


        var base64 =
            Convert.ToBase64String(fileBytes);


        await JS.InvokeVoidAsync(
            "downloadFile",
            $"Lieferanten_Seite_{CurrentPage}.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            base64);
    }


    private async Task DeleteSupplier(Supplier supplier)
    {
        var confirmed =
            await Task.FromResult(true);

        if (!confirmed)
            return;


        await using var db =
            await DbFactory.CreateDbContextAsync();


        var entity =
            await db.Suppliers
                .FirstOrDefaultAsync(
                    x => x.Id == supplier.Id);


        if (entity == null)
            return;


        // Soft delete

        entity.IsActive = false;


        await db.SaveChangesAsync();


        await LoadSuppliers();
    }


    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";


        var words =
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);


        if (words.Length == 1)
        {
            return words[0]
                .Substring(
                    0,
                    Math.Min(
                        2,
                        words[0].Length))
                .ToUpper();
        }


        return
            $"{words[0][0]}{words[1][0]}"
            .ToUpper();
    }

}