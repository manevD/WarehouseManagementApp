@page "/products/create"
@rendermode InteractiveServer
@attribute [Authorize]

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using WarehouseManagement.Data
@using WarehouseManagement.Localization
@using WarehouseManagement.Models

@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["NewProduct"]</PageTitle>

<div class="product-form-page">

    <div class="page-header">

        <div>
            <h1>@L["NewProduct"]</h1>

            <p>
                @L["CreateNewProduct"]
            </p>
        </div>

        <a href="/products"
           class="btn-secondary">

            ← @L["Back"]

        </a>

    </div>


    <div class="form-card">

        <EditForm Model="@Model"
                  OnValidSubmit="@SaveProduct"
                  FormName="ProductCreateForm">

            <DataAnnotationsValidator />


            <div class="form-section">

                <div class="form-section-title">

                    <h2>@L["ProductInformation"]</h2>

                    <p>
                        @L["BasicProductInformation"]
                    </p>

                </div>


                <div class="form-grid">

                    <!-- SKU -->

                    <div class="form-group">

                        <label>
                            @L["SKU"] <span>*</span>
                        </label>

                        <InputText @bind-Value="Model.SKU"
                                   class="form-control"
                                   placeholder="@L["SkuPlaceholder"]" />

                        <ValidationMessage For="@(() => Model.SKU)" />

                    </div>


                    <!-- NAME -->

                    <div class="form-group">

                        <label>
                            @L["ProductName"] <span>*</span>
                        </label>

                        <InputText @bind-Value="Model.Name"
                                   class="form-control"
                                   placeholder="@L["ProductNamePlaceholder"]" />

                        <ValidationMessage For="@(() => Model.Name)" />

                    </div>


                    <!-- CATEGORY -->

                    <div class="form-group">

                        <label>
                            @L["Category"]
                        </label>

                        <SearchableSelect TItem="Category"
                                          TValue="int?"
                                          Items="Categories"
                                          @bind-Value="Model.CategoryId"
                                          ValueSelector="@(x => (int?)x.Id)"
                                          TextSelector="@(x => x.Name)"
                                          Placeholder="@L["SelectCategory"]"
                                          NoResultsText="@L["NoResultsFound"]" />

                    </div>


                    <!-- BARCODE -->

                    <div class="form-group">

                        <label>
                            @L["Barcode"]
                        </label>

                        <InputText @bind-Value="Model.Barcode"
                                   class="form-control"
                                   placeholder="@L["BarcodePlaceholder"]" />

                    </div>


                    <!-- PURCHASE PRICE -->

                    <div class="form-group">

                        <label>
                            @L["PurchasePrice"]
                        </label>

                        <div class="input-with-suffix">

                            <InputNumber @bind-Value="Model.PurchasePrice"
                                         class="form-control"
                                         step="0.01" />

                            <span>€</span>

                        </div>

                    </div>


                    <!-- SALE PRICE -->

                    <div class="form-group">

                        <label>
                            @L["SalePrice"]
                        </label>

                        <div class="input-with-suffix">

                            <InputNumber @bind-Value="Model.SalePrice"
                                         class="form-control"
                                         step="0.01" />

                            <span>€</span>

                        </div>

                    </div>


                    <!-- MINIMUM STOCK -->

                    <div class="form-group">

                        <label>
                            @L["MinimumStock"]
                        </label>

                        <InputNumber @bind-Value="Model.MinimumStock"
                                     class="form-control"
                                     step="1" />

                        <small>
                            @L["MinimumStockWarning"]
                        </small>

                    </div>


                    <!-- ACTIVE -->

                    <div class="form-group checkbox-group">

                        <label class="checkbox-label">

                            <InputCheckbox @bind-Value="Model.IsActive" />

                            <span>
                                @L["ProductIsActive"]
                            </span>

                        </label>

                    </div>

                </div>

            </div>


            <!-- DESCRIPTION -->

            <div class="form-section">

                <div class="form-section-title">

                    <h2>
                        @L["Description"]
                    </h2>

                    <p>
                        @L["OptionalProductDescription"]
                    </p>

                </div>


                <div class="form-group">

                    <InputTextArea @bind-Value="Model.Description"
                                   class="form-control textarea"
                                   placeholder="@L["ProductDescriptionPlaceholder"]"
                                   rows="5" />

                </div>

            </div>


            <!-- VALIDATION SUMMARY -->

            <ValidationSummary />


            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="form-error">
                    @ErrorMessage
                </div>
            }


            <!-- ACTIONS -->

            <div class="form-actions">

                <a href="/products"
                   class="btn-secondary">

                    @L["Cancel"]

                </a>


                <button type="submit"
                        class="btn-primary"
                        disabled="@IsSaving">

                    @(IsSaving
                        ? L["Saving"]
                        : L["SaveProduct"])

                </button>

            </div>

        </EditForm>

    </div>

</div>


@code {

    private ProductModel Model { get; set; } = new();

    private List<Category> Categories { get; set; } = new();

    private bool IsSaving;

    private string? ErrorMessage;


    protected override async Task OnInitializedAsync()
    {
        Categories = await Db.Categories
            .Where(x => x.IsActive)
            .OrderBy(x => x.Name)
            .ToListAsync();
    }


    private async Task SaveProduct()
    {
        if (IsSaving)
            return;

        IsSaving = true;

        ErrorMessage = null;

        try
        {
            var sku = Model.SKU.Trim();

            var name = Model.Name.Trim();


            var skuExists = await Db.Products
                .AnyAsync(x => x.SKU == sku);

            if (skuExists)
            {
                ErrorMessage =
                    L["SkuAlreadyExists"];

                return;
            }


            if (!string.IsNullOrWhiteSpace(Model.Barcode))
            {
                var barcode = Model.Barcode.Trim();

                var barcodeExists = await Db.Products
                    .AnyAsync(x => x.Barcode == barcode);

                if (barcodeExists)
                {
                    ErrorMessage =
                        L["BarcodeAlreadyExists"];

                    return;
                }
            }


            var product = new Product
            {
                SKU = sku,

                Name = name,

                Description =
                    string.IsNullOrWhiteSpace(Model.Description)
                        ? null
                        : Model.Description.Trim(),

                Barcode =
                    string.IsNullOrWhiteSpace(Model.Barcode)
                        ? null
                        : Model.Barcode.Trim(),

                CategoryId = Model.CategoryId,

                PurchasePrice =
                    Model.PurchasePrice,

                SalePrice =
                    Model.SalePrice,

                MinimumStock =
                    Model.MinimumStock,

                IsActive =
                    Model.IsActive,

                CreatedAt =
                    DateTime.UtcNow
            };


            Db.Products.Add(product);

            await Db.SaveChangesAsync();

            Navigation.NavigateTo("/products");
        }
        catch (Exception ex)
        {
            ErrorMessage =
                L[
                    "ErrorSaving",
                    ex.InnerException?.Message ?? ex.Message
                ];
        }
        finally
        {
            IsSaving = false;
        }
    }


    private class ProductModel
    {
        [Required(
            ErrorMessageResourceType =
                typeof(SharedResource),
            ErrorMessageResourceName =
                "SkuRequired")]

        [MaxLength(50)]
        public string SKU { get; set; } = string.Empty;


        [Required(
            ErrorMessageResourceType =
                typeof(SharedResource),
            ErrorMessageResourceName =
                "ProductNameRequired")]

        [MaxLength(200)]
        public string Name { get; set; } = string.Empty;


        public int? CategoryId { get; set; }


        [MaxLength(100)]
        public string? Barcode { get; set; }


        [Range(
            0,
            double.MaxValue,
            ErrorMessageResourceType =
                typeof(SharedResource),
            ErrorMessageResourceName =
                "PriceMustBePositive")]

        public decimal PurchasePrice { get; set; }


        [Range(
            0,
            double.MaxValue,
            ErrorMessageResourceType =
                typeof(SharedResource),
            ErrorMessageResourceName =
                "PriceMustBePositive")]

        public decimal SalePrice { get; set; }


        [Range(
            0,
            double.MaxValue,
            ErrorMessageResourceType =
                typeof(SharedResource),
            ErrorMessageResourceName =
                "MinimumStockMustBePositive")]

        public decimal MinimumStock { get; set; }


        [MaxLength(500)]
        public string? Description { get; set; }


        public bool IsActive { get; set; } = true;
    }
}