@page "/categories/edit/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using WarehouseManagement.Data
@using WarehouseManagement.Localization
@using WarehouseManagement.Models

@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["EditCategory"]</PageTitle>

@if (IsLoading)
{
    <div class="loading-state">
        @L["CategoryLoading"]
    </div>
}
else if (Category == null)
{
    <div class="empty-products">

        <div class="empty-products-icon">
            ⚠
        </div>

        <h3>@L["CategoryNotFound"]</h3>

        <a href="/categories"
           class="btn-primary">

            @L["BackToCategories"]

        </a>

    </div>
}
else
{
    <div class="product-form-page">

        <div class="page-header">

            <div>

                <h1>@L["EditCategory"]</h1>

                <p>
                    @Category.Name
                </p>

            </div>

            <a href="/categories"
               class="btn-secondary">

                ← @L["Back"]

            </a>

        </div>


        <div class="form-card">

            <EditForm Model="@Model"
                      OnValidSubmit="@UpdateCategory"
                      FormName="CategoryEditForm">

                <DataAnnotationsValidator />


                <div class="form-section">

                    <div class="form-section-title">

                        <h2>@L["CategoryInformation"]</h2>

                        <p>
                            @L["EditCategoryData"]
                        </p>

                    </div>


                    <div class="form-grid">

                        <!-- NAME -->

                        <div class="form-group">

                            <label>
                                @L["Name"] <span>*</span>
                            </label>

                            <InputText @bind-Value="Model.Name"
                                       class="form-control" />

                            <ValidationMessage For="@(() => Model.Name)" />

                        </div>


                        <!-- ACTIVE -->

                        <div class="form-group checkbox-group">

                            <label class="checkbox-label">

                                <InputCheckbox @bind-Value="Model.IsActive" />

                                <span>
                                    @L["CategoryIsActive"]
                                </span>

                            </label>

                        </div>

                    </div>

                </div>


                <!-- DESCRIPTION -->

                <div class="form-section">

                    <div class="form-section-title">

                        <h2>@L["Description"]</h2>

                        <p>
                            @L["CategoryDescription"]
                        </p>

                    </div>


                    <div class="form-group">

                        <InputTextArea @bind-Value="Model.Description"
                                       class="form-control textarea"
                                       rows="5" />

                    </div>

                </div>


                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="form-error">
                        @ErrorMessage
                    </div>
                }


                <div class="form-actions">

                    <a href="/categories"
                       class="btn-secondary">

                        @L["Cancel"]

                    </a>

                    <button type="submit"
                            class="btn-primary"
                            disabled="@IsSaving">

                        @(IsSaving
                            ? L["Saving"]
                            : L["SaveChanges"])

                    </button>

                </div>

            </EditForm>

        </div>

    </div>
}


@code {

    [Parameter]
    public int Id { get; set; }


    private Category? Category;

    private CategoryModel Model = new();

    private bool IsLoading = true;

    private bool IsSaving;

    private string? ErrorMessage;


    protected override async Task OnInitializedAsync()
    {
        Category = await Db.Categories
            .FirstOrDefaultAsync(x => x.Id == Id);


        if (Category != null)
        {
            Model = new CategoryModel
            {
                Name = Category.Name,

                Description = Category.Description,

                IsActive = Category.IsActive
            };
        }


        IsLoading = false;
    }


    private async Task UpdateCategory()
    {
        if (Category == null || IsSaving)
            return;

        IsSaving = true;
        ErrorMessage = null;


        try
        {
            var name = Model.Name.Trim();


            var exists = await Db.Categories
                .AnyAsync(x =>
                    x.Id != Id &&
                    x.Name.ToLower() == name.ToLower());


            if (exists)
            {
                ErrorMessage =
                    L["CategoryAlreadyExists"];

                return;
            }


            Category.Name = name;

            Category.Description =
                string.IsNullOrWhiteSpace(Model.Description)
                    ? null
                    : Model.Description.Trim();

            Category.IsActive =
                Model.IsActive;


            await Db.SaveChangesAsync();

            Navigation.NavigateTo("/categories");
        }
        catch (Exception ex)
        {
            ErrorMessage =
                L["ErrorSaving", ex.Message];
        }
        finally
        {
            IsSaving = false;
        }
    }


    private class CategoryModel
    {
        [Required(
            ErrorMessageResourceType =
                typeof(SharedResource),
            ErrorMessageResourceName =
                "NameRequired")]

        [MaxLength(100)]

        public string Name { get; set; }
            = string.Empty;


        [MaxLength(500)]

        public string? Description { get; set; }


        public bool IsActive { get; set; }
            = true;
    }
}