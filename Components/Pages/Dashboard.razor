@page "/dashboard"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using WarehouseManagement.Data
@using WarehouseManagement.Localization
@using WarehouseManagement.Models

@inject IStringLocalizer<SharedResource> L
@inject IDbContextFactory<ApplicationDbContext> DbFactory


<PageTitle>@L["Dashboard"]</PageTitle>


<div class="dashboard-page">

    <!-- HEADER -->

    <div class="page-header">

        <div>

            <h1>
                @L["Dashboard"]
            </h1>

            <p>
                @L["DashboardOverviewDescription"]
            </p>

        </div>


        <div class="dashboard-actions">

            <a href="/stock/incoming"
               class="btn-primary">

                + @L["IncomingGoods"]

            </a>

        </div>

    </div>


    @if (IsLoading)
    {
        <div class="loading-state">
            @L["DashboardLoading"]
        </div>
    }
    else
    {

        <!-- =================================================
             STATISTICS
             ================================================= -->

        <div class="dashboard-stats">


            <div class="dashboard-stat-card">

                <div class="dashboard-stat-icon">
                    📦
                </div>

                <div>

                    <span>
                        @L["Products"]
                    </span>

                    <strong>
                        @ProductCount
                    </strong>

                </div>

            </div>


            <div class="dashboard-stat-card">

                <div class="dashboard-stat-icon">
                    📊
                </div>

                <div>

                    <span>
                        @L["TotalStock"]
                    </span>

                    <strong>
                        @TotalStock.ToString("N2")
                    </strong>

                </div>

            </div>


            <div class="dashboard-stat-card">

                <div class="dashboard-stat-icon">
                    ⚠
                </div>

                <div>

                    <span>
                        @L["LowStock"]
                    </span>

                    <strong>
                        @LowStockCount
                    </strong>

                </div>

            </div>


            <div class="dashboard-stat-card">

                <div class="dashboard-stat-icon">
                    📍
                </div>

                <div>

                    <span>
                        @L["Locations"]
                    </span>

                    <strong>
                        @LocationCount
                    </strong>

                </div>

            </div>

        </div>


        <!-- =================================================
             QUICK ACTIONS
             ================================================= -->

        <div class="dashboard-section">

            <div class="dashboard-section-header">

                <div>

                    <h2>
                        @L["QuickActions"]
                    </h2>

                    <p>
                        @L["FrequentlyUsedWarehouseActions"]
                    </p>

                </div>

            </div>


            <div class="quick-actions">


                <a href="/stock/incoming"
                   class="quick-action">

                    <div class="quick-action-icon">
                        📥
                    </div>

                    <div>

                        <strong>
                            @L["IncomingGoods"]
                        </strong>

                        <span>
                            @L["BookGoodsIntoStock"]
                        </span>

                    </div>

                </a>


                <a href="/stock/outgoing"
                   class="quick-action">

                    <div class="quick-action-icon">
                        📤
                    </div>

                    <div>

                        <strong>
                            @L["OutgoingGoods"]
                        </strong>

                        <span>
                            @L["BookGoodsOutOfStock"]
                        </span>

                    </div>

                </a>


                <a href="/stock/transfer"
                   class="quick-action">

                    <div class="quick-action-icon">
                        ↔
                    </div>

                    <div>

                        <strong>
                            @L["Transfers"]
                        </strong>

                        <span>
                            @L["MoveStock"]
                        </span>

                    </div>

                </a>


                <a href="/stock"
                   class="quick-action">

                    <div class="quick-action-icon">
                        📊
                    </div>

                    <div>

                        <strong>
                            @L["Stock"]
                        </strong>

                        <span>
                            @L["ShowCurrentStock"]
                        </span>

                    </div>

                </a>


            </div>

        </div>


        <!-- =================================================
             CONTENT GRID
             ================================================= -->

        <div class="dashboard-content-grid">


            <!-- LOW STOCK -->

            <div class="dashboard-panel">

                <div class="dashboard-panel-header">

                    <div>

                        <h2>
                            @L["LowStock"]
                        </h2>

                        <p>
                            @L["ProductsBelowMinimumStock"]
                        </p>

                    </div>

                    <a href="/stock">
                        @L["ShowAll"] →
                    </a>

                </div>


                @if (LowStockProducts.Count == 0)
                {
                    <div class="dashboard-empty">

                        <div>
                            ✓
                        </div>

                        <strong>
                            @L["EverythingOK"]
                        </strong>

                        <span>
                            @L["NoProductsBelowMinimumStock"]
                        </span>

                    </div>
                }
                else
                {
                    <div class="dashboard-list">

                        @foreach (var item in LowStockProducts)
                        {
                            <div class="dashboard-list-row">

                                <div class="product-name">

                                    <div class="product-avatar">
                                        @GetInitials(item.ProductName)
                                    </div>

                                    <div>

                                        <strong>
                                            @item.ProductName
                                        </strong>

                                        <small>
                                            @item.SKU
                                        </small>

                                    </div>

                                </div>


                                <div class="stock-warning-value">

                                    <strong>
                                        @item.Quantity.ToString("N2")
                                    </strong>

                                    <small>
                                        @L["MinimumStockShort"]
                                        @item.MinimumStock.ToString("N2")
                                    </small>

                                </div>

                            </div>
                        }

                    </div>
                }

            </div>


            <!-- RECENT MOVEMENTS -->

            <div class="dashboard-panel">

                <div class="dashboard-panel-header">

                    <div>

                        <h2>
                            @L["RecentMovements"]
                        </h2>

                        <p>
                            @L["RecentWarehouseMovements"]
                        </p>

                    </div>

                    <a href="/stock/movements">
                        @L["ShowAll"] →
                    </a>

                </div>


                @if (RecentMovements.Count == 0)
                {
                    <div class="dashboard-empty">

                        <div>
                            ↔
                        </div>

                        <strong>
                            @L["NoMovements"]
                        </strong>

                        <span>
                            @L["NoWarehouseMovementsYet"]
                        </span>

                    </div>
                }
                else
                {
                    <div class="dashboard-list">

                        @foreach (var movement in RecentMovements)
                        {
                            <div class="dashboard-list-row">


                                <div class="movement-summary">

                                    <div class="movement-summary-icon">
                                        @GetMovementIcon(movement.Type)
                                    </div>

                                    <div>

                                        <strong>
                                            @movement.Product?.Name
                                        </strong>

                                        <small>

                                            @GetMovementName(
                                                movement.Type)

                                            @movement.CreatedAt
                                            .Date
                                            .ToString("dd.MM.yyyy")

                                        </small>

                                    </div>

                                </div>


                                <strong class="@GetMovementClass(movement.Type)">

                                    @GetMovementPrefix(movement.Type)

                                    @movement.Quantity.ToString("N2")

                                </strong>

                            </div>
                        }

                    </div>
                }

            </div>

        </div>


        <!-- =================================================
             OVERVIEW
             ================================================= -->

        <div class="dashboard-section">

            <div class="dashboard-section-header">

                <div>

                    <h2>
                        @L["Overview"]
                    </h2>

                    <p>
                        @L["CurrentSystemOverview"]
                    </p>

                </div>

            </div>


            <div class="dashboard-overview-grid">


                <a href="/products"
                   class="dashboard-overview-card">

                    <span class="overview-icon">
                        📦
                    </span>

                    <div>

                        <strong>
                            @L["Products"]
                        </strong>

                        <small>
                            @L[
                                "ActiveProductsCount",
                                ProductCount
                            ]
                        </small>

                    </div>

                    <span class="overview-arrow">
                        →
                    </span>

                </a>


                <a href="/categories"
                   class="dashboard-overview-card">

                    <span class="overview-icon">
                        📁
                    </span>

                    <div>

                        <strong>
                            @L["Categories"]
                        </strong>

                        <small>
                            @L[
                                "ActiveCategoriesCount",
                                CategoryCount
                            ]
                        </small>

                    </div>

                    <span class="overview-arrow">
                        →
                    </span>

                </a>


                <a href="/warehouses"
                   class="dashboard-overview-card">

                    <span class="overview-icon">
                        🏢
                    </span>

                    <div>

                        <strong>
                            @L["Warehouse"]
                        </strong>

                        <small>
                            @L[
                                "ActiveWarehousesCount",
                                WarehouseCount
                            ]
                        </small>

                    </div>

                    <span class="overview-arrow">
                        →
                    </span>

                </a>


                <a href="/locations"
                   class="dashboard-overview-card">

                    <span class="overview-icon">
                        📍
                    </span>

                    <div>

                        <strong>
                            @L["Locations"]
                        </strong>

                        <small>
                            @L[
                                "ActiveLocationsCount",
                                LocationCount
                            ]
                        </small>

                    </div>

                    <span class="overview-arrow">
                        →
                    </span>

                </a>


            </div>

        </div>

    }

</div>


@code {

    private bool IsLoading = true;


    private int ProductCount;

    private int CategoryCount;

    private int WarehouseCount;

    private int LocationCount;

    private int LowStockCount;


    private decimal TotalStock;


    private List<LowStockItem> LowStockProducts = new();

    private List<StockMovement> RecentMovements = new();


    protected override async Task OnInitializedAsync()
    {
        await LoadDashboard();
    }


    private async Task LoadDashboard()
    {
        IsLoading = true;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            // =================================================
            // COUNTS
            // =================================================

            ProductCount =
                await db.Products
                    .CountAsync(x => x.IsActive);


            CategoryCount =
                await db.Categories
                    .CountAsync(x => x.IsActive);


            WarehouseCount =
                await db.Warehouses
                    .CountAsync(x => x.IsActive);


            LocationCount =
                await db.WarehouseLocations
                    .CountAsync(x => x.IsActive);


            // =================================================
            // TOTAL STOCK
            // =================================================

            TotalStock =
                await db.Stocks
                    .SumAsync(x => x.Quantity);


            // =================================================
            // LOW STOCK
            // =================================================

            var stockData =
                await db.Stocks
                    .Include(x => x.Product)
                    .Where(x =>
                        x.Product != null &&
                        x.Product.IsActive)
                    .ToListAsync();


            LowStockProducts =
                stockData
                    .Where(x =>
                        x.Quantity <
                        (x.Product?.MinimumStock ?? 0))
                    .GroupBy(x =>
                        x.ProductId)
                    .Select(g =>
                    {
                        var first = g.First();

                        return new LowStockItem
                        {
                            ProductName =
                                first.Product?.Name
                                ?? L["Unknown"].Value,

                            SKU =
                                first.Product?.SKU
                                ?? "",

                            Quantity =
                                g.Sum(x => x.Quantity),

                            MinimumStock =
                                first.Product?.MinimumStock
                                ?? 0
                        };
                    })
                    .OrderBy(x =>
                        x.Quantity)
                    .Take(6)
                    .ToList();


            LowStockCount =
                LowStockProducts.Count;


            // =================================================
            // RECENT MOVEMENTS
            // =================================================

            RecentMovements =
                await db.StockMovements
                    .Include(x => x.Product)
                    .OrderByDescending(x =>
                        x.CreatedAt)
                    .Take(6)
                    .ToListAsync();

        }
        finally
        {
            IsLoading = false;
        }
    }


    private string GetInitials(
        string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";


        var words =
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);


        if (words.Length == 1)
        {
            return words[0]
                .Substring(
                    0,
                    Math.Min(
                        2,
                        words[0].Length))
                .ToUpper();
        }


        return
            $"{words[0][0]}{words[1][0]}"
                .ToUpper();
    }


    private string GetMovementName(
        StockMovementType type)
    {
        return type switch
        {
            StockMovementType.Wareneingang
                => L["IncomingGoods"],

            StockMovementType.Warenausgang
                => L["OutgoingGoods"],

            StockMovementType.Umlagerung
                => L["Transfers"],

            StockMovementType.Inventur
                => L["Inventory"],

            StockMovementType.Korrektur
                => L["Correction"],

            _ => L["Movement"]
        };
    }


    private string GetMovementIcon(
        StockMovementType type)
    {
        return type switch
        {
            StockMovementType.Wareneingang
                => "↓",

            StockMovementType.Warenausgang
                => "↑",

            StockMovementType.Umlagerung
                => "↔",

            StockMovementType.Inventur
                => "✓",

            StockMovementType.Korrektur
                => "✎",

            _ => "•"
        };
    }


    private string GetMovementPrefix(
        StockMovementType type)
    {
        return type switch
        {
            StockMovementType.Wareneingang
                => "+",

            StockMovementType.Warenausgang
                => "-",

            _ => ""
        };
    }


    private string GetMovementClass(
        StockMovementType type)
    {
        return type switch
        {
            StockMovementType.Wareneingang
                => "movement-positive",

            StockMovementType.Warenausgang
                => "movement-negative",

            _ => "movement-neutral"
        };
    }


    private class LowStockItem
    {
        public string ProductName { get; set; }
            = string.Empty;

        public string SKU { get; set; }
            = string.Empty;

        public decimal Quantity { get; set; }

        public decimal MinimumStock { get; set; }
    }

}