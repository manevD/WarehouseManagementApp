@page "/orders/edit/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using WarehouseManagement.Data
@using WarehouseManagement.Localization
@using WarehouseManagement.Models

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["EditOrder"]</PageTitle>

<div class="product-form-page">

    <div class="page-header">

        <div>

            <h1>@L["EditOrder"]</h1>

            @if (Order != null)
            {
                <p>
                    @Order.OrderNumber
                </p>
            }

        </div>

        <a href="/orders"
           class="btn-secondary">

            ← @L["Back"]

        </a>

    </div>


    @if (IsLoading)
    {
        <div class="loading-state">
            @L["OrderLoading"]
        </div>
    }
    else if (Order == null)
    {
        <div class="empty-products">

            <div class="empty-products-icon">
                ☷
            </div>

            <h3>
                @L["OrderNotFound"]
            </h3>

            <a href="/orders"
               class="btn-secondary">

                @L["BackToOrders"]

            </a>

        </div>
    }
    else
    {
        <div class="form-card">

            <EditForm Model="@Model"
                      OnValidSubmit="@UpdateOrder"
                      FormName="OrderEditForm">

                <DataAnnotationsValidator />


                <!-- =====================================================
                     ORDER INFORMATION
                     ===================================================== -->

                <div class="form-section">

                    <div class="form-section-title">

                        <h2>
                            @L["OrderInformation"]
                        </h2>

                    </div>


                    <div class="form-grid">


                        <!-- ORDER NUMBER -->

                        <div class="form-group">

                            <label>
                                @L["OrderNumber"]
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@Model.OrderNumber"
                                   readonly />

                        </div>


                        <!-- CUSTOMER -->

                        <div class="form-group">

                            <label>
                                @L["Customer"] <span>*</span>
                            </label>

                            <InputSelect @bind-Value="Model.CustomerId"
                                         class="form-control"
                                         @bind:after="CustomerChanged">

                                <option value="0">
                                    @L["SelectCustomer"]
                                </option>

                                @foreach (var customer in Customers)
                                {
                                    <option value="@customer.Id">

                                        @customer.CustomerNumber -
                                        @customer.CompanyName

                                    </option>
                                }

                            </InputSelect>

                            <ValidationMessage For="@(() => Model.CustomerId)" />

                        </div>


                        <!-- DATE -->

                        <div class="form-group">

                            <label>
                                @L["OrderDate"]
                            </label>

                            <InputDate @bind-Value="Model.OrderDate"
                                       class="form-control" />

                        </div>


                        <!-- STATUS -->

                        <div class="form-group">

                            <label>
                                @L["Status"]
                            </label>

                            <InputSelect @bind-Value="Model.Status"
                                         class="form-control">

                                <option value="@OrderStatus.Entwurf">
                                    @L["OrderStatusDraft"]
                                </option>

                                <option value="@OrderStatus.Bestätigt">
                                    @L["OrderStatusConfirmed"]
                                </option>

                                <option value="@OrderStatus.InBearbeitung">
                                    @L["OrderStatusInProgress"]
                                </option>

                                <option value="@OrderStatus.TeilweiseGeliefert">
                                    @L["OrderStatusPartiallyDelivered"]
                                </option>

                                <option value="@OrderStatus.Versendet">
                                    @L["OrderStatusShipped"]
                                </option>

                                <option value="@OrderStatus.Abgeschlossen">
                                    @L["OrderStatusCompleted"]
                                </option>

                                <option value="@OrderStatus.Storniert">
                                    @L["OrderStatusCancelled"]
                                </option>

                            </InputSelect>

                        </div>


                        <!-- REFERENCE -->

                        <div class="form-group">

                            <label>
                                @L["ReferenceNumber"]
                            </label>

                            <InputText @bind-Value="Model.ReferenceNumber"
                                       class="form-control" />

                        </div>

                    </div>

                </div>


                <!-- =====================================================
                     DELIVERY ADDRESS
                     ===================================================== -->

                <div class="form-section">

                    <div class="form-section-title">

                        <h2>
                            @L["DeliveryAddress"]
                        </h2>

                    </div>


                    <div class="form-grid">


                        <div class="form-group">

                            <label>
                                @L["Street"]
                            </label>

                            <InputText @bind-Value="Model.DeliveryStreet"
                                       class="form-control" />

                        </div>


                        <div class="form-group">

                            <label>
                                @L["PostalCode"]
                            </label>

                            <InputText @bind-Value="Model.DeliveryPostalCode"
                                       class="form-control" />

                        </div>


                        <div class="form-group">

                            <label>
                                @L["City"]
                            </label>

                            <InputText @bind-Value="Model.DeliveryCity"
                                       class="form-control" />

                        </div>


                        <div class="form-group">

                            <label>
                                @L["Country"]
                            </label>

                            <InputText @bind-Value="Model.DeliveryCountry"
                                       class="form-control" />

                        </div>

                    </div>

                </div>


                <!-- =====================================================
                     ORDER ITEMS
                     ===================================================== -->

                <div class="form-section">

                    <div class="form-section-title">

                        <h2>
                            @L["OrderItems"]
                        </h2>

                        <p>
                            @L["EditProductsAndQuantities"]
                        </p>


                        @if (Order.Status == OrderStatus.Bestätigt)
                        {
                            <div class="form-info"
                                 style="margin-top:10px;">

                                @L["ConfirmedOrderInfo"]

                            </div>
                        }

                    </div>


                    <!-- ADD ITEM -->

                    <div class="order-add-item">

                        <div class="form-grid">

                            <div class="form-group">

                                <label>
                                    @L["Product"]
                                </label>

                                <select class="form-control"
                                        value="@NewItem.ProductId"
                                        @onchange="OnProductChanged"
                                        disabled="@(Order.Status == OrderStatus.Bestätigt)">

                                    <option value="0">
                                        @L["SelectProduct"]
                                    </option>

                                    @foreach (var product in Products)
                                    {
                                        <option value="@product.Id">

                                            @product.SKU -
                                            @product.Name

                                        </option>
                                    }

                                </select>

                            </div>


                            <div class="form-group">

                                <label>
                                    &nbsp;
                                </label>

                                <button type="button"
                                        class="btn-primary"
                                        @onclick="AddItem"
                                        disabled="@(NewItem.ProductId <= 0 ||
                                                                                       Order.Status == OrderStatus.Bestätigt)">

                                    + @L["AddProduct"]

                                </button>

                            </div>

                        </div>


                        @if (!string.IsNullOrWhiteSpace(ItemError))
                        {
                            <div class="form-error">
                                @ItemError
                            </div>
                        }

                    </div>


                    <!-- ITEMS -->
                    @if (Items.Count == 0)
                    {
                        <div class="empty-products">

                            <h3>
                                @L["NoOrderItems"]
                            </h3>

                        </div>
                    }
                    else
                    {
                        <div class="products-table-wrapper">

                            <table class="products-table">

                                <thead>

                                    <tr>

                                        <th>@L["Product"]</th>

                                        <th>@L["SKU"]</th>

                                        <th>@L["Quantity"]</th>

                                        <th>@L["UnitPrice"]</th>

                                        <th>@L["Total"]</th>

                                        <th></th>

                                    </tr>

                                </thead>


                                <tbody>

                                    @foreach (var item in Items)
                                    {
                                        <tr>

                                            <td>

                                                <strong>
                                                    @item.ProductName
                                                </strong>

                                            </td>


                                            <td>

                                                <span class="product-sku">
                                                    @item.SKU
                                                </span>

                                            </td>


                                            <td>

                                                <input type="number"
                                                       class="form-control"
                                                       min="0.01"
                                                       step="0.01"
                                                       value="@item.Quantity"
                                                       @onchange="(e) => ChangeQuantity(item, e)" />

                                            </td>


                                            <td>

                                                <input type="number"
                                                       class="form-control"
                                                       min="0"
                                                       step="0.01"
                                                       value="@item.UnitPrice"
                                                       @onchange="(e) => ChangePrice(item, e)" />

                                            </td>


                                            <td>

                                                <strong>
                                                    @item.Total.ToString("N2") €
                                                </strong>

                                            </td>


                                            <td>

                                                <button type="button"
                                                        class="action-button delete-button"
                                                        title="@L["RemoveItem"]"
                                                        @onclick="() => RemoveItem(item)">

                                                    🗑

                                                </button>

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }


                    <!-- TOTAL -->

                    <div class="order-total-box">

                        <span>
                            @L["Total"]
                        </span>

                        <strong>
                            @GrandTotal.ToString("N2") €
                        </strong>

                    </div>

                </div>


                <!-- =====================================================
                     NOTE
                     ===================================================== -->

                <div class="form-section">

                    <div class="form-section-title">

                        <h2>
                            @L["Note"]
                        </h2>

                    </div>

                    <div class="form-group">

                        <InputTextArea @bind-Value="Model.Note"
                                       class="form-control textarea"
                                       rows="5" />

                    </div>

                </div>


                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="form-error">
                        @ErrorMessage
                    </div>
                }


                <div class="form-actions">

                    <a href="/orders"
                       class="btn-secondary">

                        @L["Cancel"]

                    </a>


                    <button type="submit"
                            class="btn-primary"
                            disabled="@IsSaving">

                        @(IsSaving
                            ? L["Saving"]
                            : L["SaveChanges"])

                    </button>

                </div>

            </EditForm>

        </div>
    }

</div>


@code {

    [Parameter]
    public int Id { get; set; }


    private Order? Order;

    private OrderEditModel Model = new();

    private List<Customer> Customers = new();

    private List<Product> Products = new();

    private List<OrderItemModel> Items = new();

    private OrderItemModel NewItem = new();

    private bool IsLoading = true;

    private bool IsSaving;

    private string? ErrorMessage;

    private string? ItemError;


    private decimal GrandTotal =>
        Items.Sum(x => x.Total);


    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }


    private async Task LoadData()
    {
        IsLoading = true;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            Customers =
                await db.Customers
                    .Where(x => x.IsActive)
                    .OrderBy(x => x.CompanyName)
                    .ToListAsync();


            Products =
                await db.Products
                    .Where(x => x.IsActive)
                    .OrderBy(x => x.Name)
                    .ToListAsync();


            Order =
                await db.Orders
                    .Include(x => x.Customer)
                    .Include(x => x.Items)
                        .ThenInclude(x => x.Product)
                    .FirstOrDefaultAsync(x => x.Id == Id);


            if (Order == null)
                return;


            Model =
                new OrderEditModel
                {
                    OrderNumber =
                        Order.OrderNumber,

                    CustomerId =
                        Order.CustomerId,

                    OrderDate =
                        Order.OrderDate,

                    Status =
                        Order.Status,

                    ReferenceNumber =
                        Order.ReferenceNumber,

                    DeliveryStreet =
                        Order.DeliveryStreet,

                    DeliveryPostalCode =
                        Order.DeliveryPostalCode,

                    DeliveryCity =
                        Order.DeliveryCity,

                    DeliveryCountry =
                        Order.DeliveryCountry,

                    Note =
                        Order.Note
                };


            Items =
                Order.Items
                    .Select(x =>
                        new OrderItemModel
                        {
                            Id = x.Id,

                            ProductId =
                                x.ProductId,

                            ProductName =
                                x.Product?.Name ?? "-",

                            SKU =
                                x.Product?.SKU ?? "-",

                            Quantity =
                                x.Quantity,

                            UnitPrice =
                                x.UnitPrice,

                            WarehouseLocationId =
                                x.WarehouseLocationId
                        })
                    .ToList();
        }
        finally
        {
            IsLoading = false;
        }
    }


    private async Task CustomerChanged()
    {
        var customer =
            Customers.FirstOrDefault(
                x => x.Id == Model.CustomerId);


        if (customer == null)
            return;


        Model.DeliveryStreet =
            customer.Street;

        Model.DeliveryPostalCode =
            customer.PostalCode;

        Model.DeliveryCity =
            customer.City;

        Model.DeliveryCountry =
            customer.Country;


        await Task.CompletedTask;
    }


    private void OnProductChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(
                e.Value?.ToString(),
                out var productId))
        {
            productId = 0;
        }


        NewItem.ProductId =
            productId;

        NewItem.UnitPrice =
            0;


        var product =
            Products.FirstOrDefault(
                x => x.Id == productId);


        if (product != null)
        {
            NewItem.UnitPrice =
                product.SalePrice;
        }
    }


    private void AddItem()
    {
        ItemError = null;


        if (NewItem.ProductId <= 0)
        {
            ItemError =
                L["ProductSelectionRequired"];

            return;
        }


        if (Order?.Status == OrderStatus.Bestätigt)
        {
            ItemError =
                L["ConfirmedOrderCannotAddItems"];

            return;
        }


        var product =
            Products.FirstOrDefault(
                x => x.Id == NewItem.ProductId);


        if (product == null)
        {
            ItemError =
                L["SelectedProductNotFound"];

            return;
        }


        var existing =
            Items.FirstOrDefault(
                x => x.ProductId == NewItem.ProductId);


        if (existing != null)
        {
            existing.Quantity += 1;
        }
        else
        {
            Items.Add(
                new OrderItemModel
                {
                    Id = 0,

                    ProductId =
                        product.Id,

                    ProductName =
                        product.Name,

                    SKU =
                        product.SKU,

                    Quantity =
                        1,

                    UnitPrice =
                        product.SalePrice,

                    WarehouseLocationId =
                        null
                });
        }


        NewItem =
            new OrderItemModel();


        StateHasChanged();
    }


    private void RemoveItem(
        OrderItemModel item)
    {
        Items.Remove(item);

        StateHasChanged();
    }


    private void ChangeQuantity(
        OrderItemModel item,
        ChangeEventArgs e)
    {
        if (decimal.TryParse(
            e.Value?.ToString(),
            out var quantity))
        {
            if (quantity > 0)
            {
                item.Quantity =
                    quantity;
            }
        }

        StateHasChanged();
    }


    private void ChangePrice(
        OrderItemModel item,
        ChangeEventArgs e)
    {
        if (decimal.TryParse(
            e.Value?.ToString(),
            out var price))
        {
            if (price >= 0)
            {
                item.UnitPrice =
                    price;
            }
        }

        StateHasChanged();
    }


    // =========================================================
    // UPDATE ORDER
    // =========================================================

    private async Task UpdateOrder()
    {
        if (IsSaving)
            return;


        IsSaving = true;

        ErrorMessage = null;


        try
        {
            if (Model.CustomerId <= 0)
            {
                ErrorMessage =
                    L["CustomerSelectionRequired"];

                return;
            }


            if (Items.Count == 0)
            {
                ErrorMessage =
                    L["OrderMustHaveItems"];

                return;
            }


            await using var db =
                await DbFactory.CreateDbContextAsync();


            var entity =
                await db.Orders

                    .Include(x => x.Items)

                    .FirstOrDefaultAsync(
                        x => x.Id == Id);


            if (entity == null)
            {
                ErrorMessage =
                    L["OrderNotFound"];

                return;
            }


            var customer =
                await db.Customers

                    .FirstOrDefaultAsync(x =>
                        x.Id ==
                            Model.CustomerId &&

                        x.IsActive);


            if (customer == null)
            {
                ErrorMessage =
                    L["SelectedCustomerNotFound"];

                return;
            }


            // =====================================================
            // CONFIRMED ORDER
            // =====================================================

            if (entity.Status ==
                OrderStatus.Bestätigt)
            {
                if (Model.Status !=
                    OrderStatus.Bestätigt)
                {
                    ErrorMessage =
                        L["ConfirmedOrderStatusChangeNotAllowed"];

                    return;
                }


                // -------------------------------------------------
                // EXISTING + DELETED ITEMS
                // -------------------------------------------------

                foreach (var existingItem in
                    entity.Items.ToList())
                {
                    var editedItem =
                        Items.FirstOrDefault(
                            x => x.Id ==
                                existingItem.Id);


                    // =============================================
                    // ITEM DELETED
                    // =============================================

                    if (editedItem == null)
                    {
                        if (existingItem
                            .WarehouseLocationId
                            .HasValue)
                        {
                            var stock =
                                await db.Stocks

                                    .FirstOrDefaultAsync(x =>
                                        x.ProductId ==
                                            existingItem.ProductId &&

                                        x.WarehouseLocationId ==
                                            existingItem
                                                .WarehouseLocationId
                                                .Value);


                            if (stock != null)
                            {
                                stock.ReservedQuantity =
                                    Math.Max(
                                        0,
                                        stock.ReservedQuantity -
                                        existingItem.Quantity);

                                stock.UpdatedAt =
                                    DateTime.UtcNow;
                            }
                        }


                        db.OrderItems.Remove(
                            existingItem);

                        continue;
                    }


                    // =============================================
                    // PRODUCT CHANGE NOT ALLOWED
                    // =============================================

                    if (existingItem.ProductId !=
                        editedItem.ProductId)
                    {
                        ErrorMessage =
                            L[
                                "ProductChangeNotAllowedConfirmedOrder",
                                editedItem.ProductName
                            ];

                        return;
                    }


                    // =============================================
                    // LOCATION REQUIRED
                    // =============================================

                    if (!existingItem
                        .WarehouseLocationId
                        .HasValue)
                    {
                        ErrorMessage =
                            L[
                                "ReservationLocationRequired",
                                editedItem.ProductName
                            ];

                        return;
                    }


                    var stockForItem =
                        await db.Stocks

                            .FirstOrDefaultAsync(x =>
                                x.ProductId ==
                                    existingItem.ProductId &&

                                x.WarehouseLocationId ==
                                    existingItem
                                        .WarehouseLocationId
                                        .Value);


                    if (stockForItem == null)
                    {
                        ErrorMessage =
                            L[
                                "ReservedStockNotFound",
                                editedItem.ProductName
                            ];

                        return;
                    }


                    // =============================================
                    // QUANTITY DIFFERENCE
                    // =============================================

                    var difference =
                        editedItem.Quantity -
                        existingItem.Quantity;


                    // ---------------------------------------------
                    // QUANTITY INCREASED
                    // ---------------------------------------------

                    if (difference > 0)
                    {
                        var availableForIncrease =
                            stockForItem.Quantity -
                            stockForItem.ReservedQuantity;


                        if (availableForIncrease <
                            difference)
                        {
                            ErrorMessage =
                                L[
                                    "InsufficientStockForIncrease",
                                    editedItem.ProductName,
                                    difference.ToString("N2"),
                                    availableForIncrease.ToString("N2")
                                ];

                            return;
                        }


                        stockForItem.ReservedQuantity +=
                            difference;
                    }


                    // ---------------------------------------------
                    // QUANTITY REDUCED
                    // ---------------------------------------------

                    else if (difference < 0)
                    {
                        stockForItem.ReservedQuantity =
                            Math.Max(
                                0,
                                stockForItem.ReservedQuantity +
                                difference);
                    }


                    stockForItem.UpdatedAt =
                        DateTime.UtcNow;


                    existingItem.Quantity =
                        editedItem.Quantity;

                    existingItem.UnitPrice =
                        editedItem.UnitPrice;
                }


                // =============================================
                // NO NEW ITEMS
                // =============================================

                if (Items.Any(x => x.Id == 0))
                {
                    ErrorMessage =
                        L["ConfirmedOrderCannotAddNewItems"];

                    return;
                }
            }
            else
            {
                // =================================================
                // UNCONFIRMED ORDER
                // =================================================

                foreach (var existingItem in
                    entity.Items.ToList())
                {
                    var editedItem =
                        Items.FirstOrDefault(
                            x => x.Id ==
                                existingItem.Id);


                    if (editedItem == null)
                    {
                        db.OrderItems.Remove(
                            existingItem);

                        continue;
                    }


                    existingItem.ProductId =
                        editedItem.ProductId;

                    existingItem.Quantity =
                        editedItem.Quantity;

                    existingItem.UnitPrice =
                        editedItem.UnitPrice;
                }


                // -------------------------------------------------
                // NEW ITEMS
                // -------------------------------------------------

                foreach (var editedItem in
                    Items.Where(x => x.Id == 0))
                {
                    var productExists =
                        await db.Products

                            .AnyAsync(x =>
                                x.Id ==
                                    editedItem.ProductId &&

                                x.IsActive);


                    if (!productExists)
                    {
                        ErrorMessage =
                            L[
                                "ProductNotFoundWithName",
                                editedItem.ProductName
                            ];

                        return;
                    }


                    db.OrderItems.Add(
                        new OrderItem
                        {
                            OrderId =
                                entity.Id,

                            ProductId =
                                editedItem.ProductId,

                            Quantity =
                                editedItem.Quantity,

                            UnitPrice =
                                editedItem.UnitPrice,

                            WarehouseLocationId =
                                null
                        });
                }
            }


            // =====================================================
            // ORDER DATA
            // =====================================================

            entity.CustomerId =
                Model.CustomerId;

            entity.OrderDate =
                Model.OrderDate;

            entity.Status =
                Model.Status;

            entity.ReferenceNumber =
                string.IsNullOrWhiteSpace(
                    Model.ReferenceNumber)

                    ? null

                    : Model.ReferenceNumber.Trim();


            entity.DeliveryStreet =
                string.IsNullOrWhiteSpace(
                    Model.DeliveryStreet)

                    ? null

                    : Model.DeliveryStreet.Trim();


            entity.DeliveryPostalCode =
                string.IsNullOrWhiteSpace(
                    Model.DeliveryPostalCode)

                    ? null

                    : Model.DeliveryPostalCode.Trim();


            entity.DeliveryCity =
                string.IsNullOrWhiteSpace(
                    Model.DeliveryCity)

                    ? null

                    : Model.DeliveryCity.Trim();


            entity.DeliveryCountry =
                string.IsNullOrWhiteSpace(
                    Model.DeliveryCountry)

                    ? null

                    : Model.DeliveryCountry.Trim();


            entity.Note =
                string.IsNullOrWhiteSpace(
                    Model.Note)

                    ? null

                    : Model.Note.Trim();


            entity.Total =
                GrandTotal;


            entity.UpdatedAt =
                DateTime.UtcNow;


            await db.SaveChangesAsync();


            Navigation.NavigateTo(
                "/orders");
        }
        catch (Exception ex)
        {
            ErrorMessage =
                L["ErrorSaving", ex.Message];
        }
        finally
        {
            IsSaving = false;
        }
    }


    // =========================================================
    // MODELS
    // =========================================================

    private class OrderEditModel
    {
        public string OrderNumber { get; set; }
            = string.Empty;


        [Range(
            1,
            int.MaxValue,
            ErrorMessageResourceType =
                typeof(SharedResource),
            ErrorMessageResourceName =
                "CustomerSelectionRequired")]
        public int CustomerId { get; set; }


        public DateTime OrderDate { get; set; }


        public OrderStatus Status { get; set; }


        [MaxLength(100)]
        public string? ReferenceNumber { get; set; }


        [MaxLength(300)]
        public string? DeliveryStreet { get; set; }


        [MaxLength(20)]
        public string? DeliveryPostalCode { get; set; }


        [MaxLength(100)]
        public string? DeliveryCity { get; set; }


        [MaxLength(100)]
        public string? DeliveryCountry { get; set; }


        [MaxLength(500)]
        public string? Note { get; set; }
    }


    private class OrderItemModel
    {
        public int Id { get; set; }


        public int ProductId { get; set; }


        public string ProductName { get; set; }
            = string.Empty;


        public string SKU { get; set; }
            = string.Empty;


        public decimal Quantity { get; set; }


        public decimal UnitPrice { get; set; }


        public int? WarehouseLocationId { get; set; }


        public decimal Total =>
            Quantity * UnitPrice;
    }

}