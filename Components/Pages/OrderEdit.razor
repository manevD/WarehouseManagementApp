@page "/orders/edit/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using WarehouseManagement.Components
@using WarehouseManagement.Data
@using WarehouseManagement.Localization
@using WarehouseManagement.Models

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["EditOrder"]</PageTitle>

<div class="product-form-page">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="page-header">

        <div>

            <h1>
                @L["EditOrder"]
            </h1>

            @if (Order != null)
            {
                <p>
                    @Order.OrderNumber
                </p>
            }

        </div>

        <a href="/orders"
           class="btn-secondary">

            ← @L["Back"]

        </a>

    </div>


    <!-- =========================================================
         LOADING
         ========================================================= -->

    @if (IsLoading)
    {
        <div class="loading-state">

            @L["OrderLoading"]

        </div>
    }
    else if (Order == null)
    {
        <div class="empty-products">

            <div class="empty-products-icon">
                ☷
            </div>

            <h3>
                @L["OrderNotFound"]
            </h3>

            <a href="/orders"
               class="btn-secondary">

                @L["BackToOrders"]

            </a>

        </div>
    }
    else
    {
        <div class="form-card">

            <EditForm Model="@Model"
                      OnValidSubmit="@UpdateOrder"
                      FormName="OrderEditForm">

                <DataAnnotationsValidator />


                <!-- =====================================================
                     ORDER INFORMATION
                     ===================================================== -->

                <div class="form-section">

                    <div class="form-section-title">

                        <h2>
                            @L["OrderInformation"]
                        </h2>

                    </div>


                    <div class="form-grid">


                        <!-- =================================================
                             ORDER NUMBER
                             ================================================= -->

                        <div class="form-group">

                            <label>
                                @L["OrderNumber"]
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@Model.OrderNumber"
                                   readonly />

                        </div>


                        <!-- =================================================
                             CUSTOMER
                             ================================================= -->

                        <div class="form-group">

                            <label>
                                @L["Customer"] <span>*</span>
                            </label>

                            <SearchableSelect TItem="Customer"
                                              TValue="int"
                                              Items="Customers"
                                              Value="Model.CustomerId"
                                              ValueChanged="OnCustomerChanged"
                                              ValueSelector="@(x => x.Id)"
                                              TextSelector="@(x => $"{x.CustomerNumber} - {x.CompanyName}")"
                                              Placeholder="@L["SelectCustomer"]"
                                              NoResultsText="@L["NoResultsFound"]"
                                              ShowAllOption="false"
                                              AllValue="0" />

                            <ValidationMessage For="@(() => Model.CustomerId)" />

                        </div>


                        <!-- =================================================
                             DATE
                             ================================================= -->

                        <div class="form-group">

                            <label>
                                @L["OrderDate"]
                            </label>

                            <InputDate @bind-Value="Model.OrderDate"
                                       class="form-control" />

                        </div>


                        <!-- =================================================
                             STATUS
                             ================================================= -->

                        <div class="form-group">

                            <label>
                                @L["Status"]
                            </label>

                            <SearchableSelect TItem="OrderStatusOption"
                                              TValue="OrderStatus"
                                              Items="OrderStatusOptions"
                                              Value="Model.Status"
                                              ValueChanged="OnStatusChanged"
                                              ValueSelector="@(x => x.Value)"
                                              TextSelector="@(x => x.Text)"
                                              Placeholder="@L["Status"]"
                                              NoResultsText="@L["NoResultsFound"]"
                                              ShowAllOption="false"
                                              AllValue="default" />

                        </div>


                        <!-- =================================================
                             REFERENCE
                             ================================================= -->

                        <div class="form-group">

                            <label>
                                @L["ReferenceNumber"]
                            </label>

                            <InputText @bind-Value="Model.ReferenceNumber"
                                       class="form-control" />

                        </div>

                    </div>

                </div>


                <!-- =====================================================
                     DELIVERY ADDRESS
                     ===================================================== -->

                <div class="form-section">

                    <div class="form-section-title">

                        <h2>
                            @L["DeliveryAddress"]
                        </h2>

                    </div>


                    <div class="form-grid">


                        <!-- STREET -->

                        <div class="form-group">

                            <label>
                                @L["Street"]
                            </label>

                            <InputText @bind-Value="Model.DeliveryStreet"
                                       class="form-control" />

                        </div>


                        <!-- POSTAL CODE -->

                        <div class="form-group">

                            <label>
                                @L["PostalCode"]
                            </label>

                            <InputText @bind-Value="Model.DeliveryPostalCode"
                                       class="form-control" />

                        </div>


                        <!-- CITY -->

                        <div class="form-group">

                            <label>
                                @L["City"]
                            </label>

                            <InputText @bind-Value="Model.DeliveryCity"
                                       class="form-control" />

                        </div>


                        <!-- COUNTRY -->

                        <div class="form-group">

                            <label>
                                @L["Country"]
                            </label>

                            <InputText @bind-Value="Model.DeliveryCountry"
                                       class="form-control" />

                        </div>

                    </div>

                </div>


                <!-- =====================================================
                     ORDER ITEMS
                     ===================================================== -->

                <div class="form-section">

                    <div class="form-section-title">

                        <div>

                            <h2>
                                @L["OrderItems"]
                            </h2>

                            <p>
                                @L["EditProductsAndQuantities"]
                            </p>


                            @if (Order.Status == OrderStatus.Bestätigt)
                            {
                                <div class="form-info"
                                     style="margin-top:10px;">

                                    @L["ConfirmedOrderInfo"]

                                </div>
                            }

                        </div>

                    </div>


                    <!-- =================================================
                         ADD ITEM
                         ================================================= -->

                    <div class="order-add-item">

                        <div class="form-grid">


                            <!-- PRODUCT -->

                            <div class="form-group">

                                <label>
                                    @L["Product"]
                                </label>

                                <SearchableSelect TItem="Product"
                                                  TValue="int"
                                                  Items="Products"
                                                  Value="NewItem.ProductId"
                                                  ValueChanged="OnProductSelected"
                                                  ValueSelector="@(x => x.Id)"
                                                  TextSelector="@(x => $"{x.SKU} - {x.Name}")"
                                                  Placeholder="@L["SelectProduct"]"
                                                  NoResultsText="@L["NoResultsFound"]"
                                                  ShowAllOption="false"
                                                  AllValue="0" />

                            </div>


                            <!-- ADD -->

                            <div class="form-group">

                                <label>
                                    &nbsp;
                                </label>

                                <button type="button"
                                        class="btn-primary"
                                        @onclick="AddItem"
                                        disabled="@(NewItem.ProductId <= 0 ||
                                                   Order.Status == OrderStatus.Bestätigt)">

                                    + @L["AddProduct"]

                                </button>

                            </div>

                        </div>


                        @if (!string.IsNullOrWhiteSpace(ItemError))
                        {
                            <div class="form-error">

                                @ItemError

                            </div>
                        }

                    </div>


                    <!-- =================================================
                         ITEMS
                         ================================================= -->

                    @if (Items.Count == 0)
                    {
                        <div class="empty-products">

                            <h3>
                                @L["NoOrderItems"]
                            </h3>

                        </div>
                    }
                    else
                    {
                        <div class="products-table-wrapper">

                            <table class="products-table">

                                <thead>

                                    <tr>

                                        <th>
                                            @L["Product"]
                                        </th>

                                        <th>
                                            @L["SKU"]
                                        </th>

                                        <th>
                                            @L["Quantity"]
                                        </th>

                                        <th>
                                            @L["UnitPrice"]
                                        </th>

                                        <th>
                                            @L["Total"]
                                        </th>

                                        <th></th>

                                    </tr>

                                </thead>


                                <tbody>

                                    @foreach (var item in Items)
                                    {
                                        <tr>

                                            <!-- PRODUCT -->

                                            <td>

                                                <strong>
                                                    @item.ProductName
                                                </strong>

                                            </td>


                                            <!-- SKU -->

                                            <td>

                                                <span class="product-sku">
                                                    @item.SKU
                                                </span>

                                            </td>


                                            <!-- QUANTITY -->

                                            <td>

                                                <input type="number"
                                                       class="form-control"
                                                       min="0.01"
                                                       step="0.01"
                                                       value="@item.Quantity"
                                                       @onchange="(e) => ChangeQuantity(item, e)" />

                                            </td>


                                            <!-- PRICE -->

                                            <td>

                                                <input type="number"
                                                       class="form-control"
                                                       min="0"
                                                       step="0.01"
                                                       value="@item.UnitPrice"
                                                       @onchange="(e) => ChangePrice(item, e)" />

                                            </td>


                                            <!-- TOTAL -->

                                            <td>

                                                <strong>
                                                    @item.Total.ToString("N2") €
                                                </strong>

                                            </td>


                                            <!-- DELETE -->

                                            <td>

                                                <button type="button"
                                                        class="action-button delete-button"
                                                        title="@L["RemoveItem"]"
                                                        @onclick="() => RemoveItem(item)">

                                                    🗑

                                                </button>

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }


                    <!-- =================================================
                         TOTAL
                         ================================================= -->

                    <div class="order-total-box">

                        <span>
                            @L["Total"]
                        </span>

                        <strong>
                            @GrandTotal.ToString("N2") €
                        </strong>

                    </div>

                </div>


                <!-- =====================================================
                     NOTE
                     ===================================================== -->

                <div class="form-section">

                    <div class="form-section-title">

                        <h2>
                            @L["Note"]
                        </h2>

                    </div>

                    <div class="form-group">

                        <InputTextArea @bind-Value="Model.Note"
                                       class="form-control textarea"
                                       rows="5" />

                    </div>

                </div>


                <!-- =====================================================
                     ERROR
                     ===================================================== -->

                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="form-error">

                        @ErrorMessage

                    </div>
                }


                <!-- =====================================================
                     ACTIONS
                     ===================================================== -->

                <div class="form-actions">

                    <a href="/orders"
                       class="btn-secondary">

                        @L["Cancel"]

                    </a>


                    <button type="submit"
                            class="btn-primary"
                            disabled="@IsSaving">

                        @(IsSaving
                            ? L["Saving"]
                            : L["SaveChanges"])

                    </button>

                </div>

            </EditForm>

        </div>
    }

</div>


@code {

    // =========================================================
    // PARAMETERS
    // =========================================================

    [Parameter]
    public int Id { get; set; }


    // =========================================================
    // DATA
    // =========================================================

    private Order? Order;

    private OrderEditModel Model = new();

    private List<Customer> Customers = new();

    private List<Product> Products = new();

    private List<OrderItemModel> Items = new();

    private OrderItemModel NewItem = new();


    // =========================================================
    // STATUS OPTIONS
    // =========================================================

    private class OrderStatusOption
    {
        public OrderStatus Value { get; set; }

        public string Text { get; set; } = string.Empty;
    }


    private List<OrderStatusOption> OrderStatusOptions = new();


    // =========================================================
    // STATE
    // =========================================================

    private bool IsLoading = true;

    private bool IsSaving;

    private string? ErrorMessage;

    private string? ItemError;


    // =========================================================
    // TOTAL
    // =========================================================

    private decimal GrandTotal =>
        Items.Sum(x => x.Total);


    // =========================================================
    // INIT
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        OrderStatusOptions =
            new List<OrderStatusOption>
            {
                new()
                {
                    Value = OrderStatus.Entwurf,
                    Text = L["OrderStatusDraft"].Value
                },

                new()
                {
                    Value = OrderStatus.Bestätigt,
                    Text = L["OrderStatusConfirmed"].Value
                },

                new()
                {
                    Value = OrderStatus.InBearbeitung,
                    Text = L["OrderStatusInProgress"].Value
                },

                new()
                {
                    Value = OrderStatus.TeilweiseGeliefert,
                    Text = L["OrderStatusPartiallyDelivered"].Value
                },

                new()
                {
                    Value = OrderStatus.Versendet,
                    Text = L["OrderStatusShipped"].Value
                },

                new()
                {
                    Value = OrderStatus.Abgeschlossen,
                    Text = L["OrderStatusCompleted"].Value
                },

                new()
                {
                    Value = OrderStatus.Storniert,
                    Text = L["OrderStatusCancelled"].Value
                }
            };


        await LoadData();
    }


    // =========================================================
    // LOAD DATA
    // =========================================================

    private async Task LoadData()
    {
        IsLoading = true;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            // =====================================================
            // CUSTOMERS
            // =====================================================

            Customers =
                await db.Customers

                    .Where(x =>
                        x.IsActive)

                    .OrderBy(x =>
                        x.CompanyName)

                    .ToListAsync();


            // =====================================================
            // PRODUCTS
            // =====================================================

            Products =
                await db.Products

                    .Where(x =>
                        x.IsActive)

                    .OrderBy(x =>
                        x.Name)

                    .ToListAsync();


            // =====================================================
            // ORDER
            // =====================================================

            Order =
                await db.Orders

                    .Include(x =>
                        x.Customer)

                    .Include(x =>
                        x.Items)

                        .ThenInclude(x =>
                            x.Product)

                    .FirstOrDefaultAsync(
                        x =>
                            x.Id ==
                            Id);


            if (Order == null)
                return;


            // =====================================================
            // MODEL
            // =====================================================

            Model =
                new OrderEditModel
                {
                    OrderNumber =
                        Order.OrderNumber,

                    CustomerId =
                        Order.CustomerId,

                    OrderDate =
                        Order.OrderDate,

                    Status =
                        Order.Status,

                    ReferenceNumber =
                        Order.ReferenceNumber,

                    DeliveryStreet =
                        Order.DeliveryStreet,

                    DeliveryPostalCode =
                        Order.DeliveryPostalCode,

                    DeliveryCity =
                        Order.DeliveryCity,

                    DeliveryCountry =
                        Order.DeliveryCountry,

                    Note =
                        Order.Note
                };


            // =====================================================
            // ITEMS
            // =====================================================

            Items =
                Order.Items

                    .Select(x =>
                        new OrderItemModel
                        {
                            Id =
                                x.Id,

                            ProductId =
                                x.ProductId,

                            ProductName =
                                x.Product?.Name
                                ?? "-",

                            SKU =
                                x.Product?.SKU
                                ?? "-",

                            Quantity =
                                x.Quantity,

                            UnitPrice =
                                x.UnitPrice,

                            WarehouseLocationId =
                                x.WarehouseLocationId
                        })

                    .ToList();
        }
        finally
        {
            IsLoading = false;
        }
    }


    // =========================================================
    // CUSTOMER CHANGED
    // =========================================================

    private async Task OnCustomerChanged(
        int customerId)
    {
        // Set new value first.

        Model.CustomerId =
            customerId;


        var customer =
            Customers.FirstOrDefault(
                x =>
                    x.Id ==
                    customerId);


        if (customer == null)
            return;


        // =====================================================
        // COPY ADDRESS
        // =====================================================

        Model.DeliveryStreet =
            customer.Street;

        Model.DeliveryPostalCode =
            customer.PostalCode;

        Model.DeliveryCity =
            customer.City;

        Model.DeliveryCountry =
            customer.Country;


        await Task.CompletedTask;
    }


    // =========================================================
    // STATUS CHANGED
    // =========================================================

    private Task OnStatusChanged(
        OrderStatus value)
    {
        // Set the new status.

        Model.Status =
            value;

        return Task.CompletedTask;
    }


    // =========================================================
    // PRODUCT SELECTED
    // =========================================================

    private void OnProductSelected(
        int productId)
    {
        // Set new value first.

        NewItem.ProductId =
            productId;


        // Reset price.

        NewItem.UnitPrice =
            0;


        if (productId <= 0)
            return;


        var product =
            Products.FirstOrDefault(
                x =>
                    x.Id ==
                    productId);


        if (product != null)
        {
            NewItem.UnitPrice =
                product.SalePrice;
        }
    }


    // =========================================================
    // ADD ITEM
    // =========================================================

    private void AddItem()
    {
        ItemError = null;


        // =====================================================
        // PRODUCT
        // =====================================================

        if (NewItem.ProductId <= 0)
        {
            ItemError =
                L["ProductSelectionRequired"];

            return;
        }


        // =====================================================
        // CONFIRMED ORDER
        // =====================================================

        if (Order?.Status ==
            OrderStatus.Bestätigt)
        {
            ItemError =
                L["ConfirmedOrderCannotAddItems"];

            return;
        }


        // =====================================================
        // PRODUCT
        // =====================================================

        var product =
            Products.FirstOrDefault(
                x =>
                    x.Id ==
                    NewItem.ProductId);


        if (product == null)
        {
            ItemError =
                L["SelectedProductNotFound"];

            return;
        }


        // =====================================================
        // EXISTING ITEM
        // =====================================================

        var existing =
            Items.FirstOrDefault(
                x =>
                    x.ProductId ==
                    NewItem.ProductId);


        if (existing != null)
        {
            existing.Quantity += 1;
        }
        else
        {
            Items.Add(
                new OrderItemModel
                {
                    Id = 0,

                    ProductId =
                        product.Id,

                    ProductName =
                        product.Name,

                    SKU =
                        product.SKU,

                    Quantity =
                        1,

                    UnitPrice =
                        product.SalePrice,

                    WarehouseLocationId =
                        null
                });
        }


        // =====================================================
        // RESET
        // =====================================================

        NewItem =
            new OrderItemModel();


        StateHasChanged();
    }


    // =========================================================
    // REMOVE ITEM
    // =========================================================

    private void RemoveItem(
        OrderItemModel item)
    {
        Items.Remove(item);

        StateHasChanged();
    }


    // =========================================================
    // CHANGE QUANTITY
    // =========================================================

    private void ChangeQuantity(
        OrderItemModel item,
        ChangeEventArgs e)
    {
        if (decimal.TryParse(
            e.Value?.ToString(),
            out var quantity))
        {
            if (quantity > 0)
            {
                item.Quantity =
                    quantity;
            }
        }

        StateHasChanged();
    }


    // =========================================================
    // CHANGE PRICE
    // =========================================================

    private void ChangePrice(
        OrderItemModel item,
        ChangeEventArgs e)
    {
        if (decimal.TryParse(
            e.Value?.ToString(),
            out var price))
        {
            if (price >= 0)
            {
                item.UnitPrice =
                    price;
            }
        }

        StateHasChanged();
    }


    // =========================================================
    // UPDATE ORDER
    // =========================================================

    private async Task UpdateOrder()
    {
        if (IsSaving)
            return;


        IsSaving = true;

        ErrorMessage = null;


        try
        {
            // =================================================
            // CUSTOMER
            // =================================================

            if (Model.CustomerId <= 0)
            {
                ErrorMessage =
                    L["CustomerSelectionRequired"];

                return;
            }


            // =================================================
            // ITEMS
            // =================================================

            if (Items.Count == 0)
            {
                ErrorMessage =
                    L["OrderMustHaveItems"];

                return;
            }


            await using var db =
                await DbFactory.CreateDbContextAsync();


            // =================================================
            // ORDER
            // =================================================

            var entity =
                await db.Orders

                    .Include(x =>
                        x.Items)

                    .FirstOrDefaultAsync(
                        x =>
                            x.Id ==
                            Id);


            if (entity == null)
            {
                ErrorMessage =
                    L["OrderNotFound"];

                return;
            }


            // =================================================
            // CUSTOMER
            // =================================================

            var customer =
                await db.Customers

                    .FirstOrDefaultAsync(
                        x =>
                            x.Id ==
                            Model.CustomerId
                            &&
                            x.IsActive);


            if (customer == null)
            {
                ErrorMessage =
                    L["SelectedCustomerNotFound"];

                return;
            }


            // =====================================================
            // CONFIRMED ORDER
            // =====================================================

            if (entity.Status ==
                OrderStatus.Bestätigt)
            {
                // Confirmed order cannot be changed
                // to another status.

                if (Model.Status !=
                    OrderStatus.Bestätigt)
                {
                    ErrorMessage =
                        L["ConfirmedOrderStatusChangeNotAllowed"];

                    return;
                }


                // =================================================
                // EXISTING + DELETED ITEMS
                // =================================================

                foreach (var existingItem in
                    entity.Items.ToList())
                {
                    var editedItem =
                        Items.FirstOrDefault(
                            x =>
                                x.Id ==
                                existingItem.Id);


                    // =================================================
                    // ITEM DELETED
                    // =================================================

                    if (editedItem == null)
                    {
                        if (existingItem
                            .WarehouseLocationId
                            .HasValue)
                        {
                            var stock =
                                await db.Stocks

                                    .FirstOrDefaultAsync(
                                        x =>
                                            x.ProductId ==
                                            existingItem.ProductId
                                            &&
                                            x.WarehouseLocationId ==
                                            existingItem
                                                .WarehouseLocationId
                                                .Value);


                            if (stock != null)
                            {
                                stock.ReservedQuantity =
                                    Math.Max(
                                        0,
                                        stock.ReservedQuantity -
                                        existingItem.Quantity);

                                stock.UpdatedAt =
                                    DateTime.UtcNow;
                            }
                        }


                        db.OrderItems.Remove(
                            existingItem);

                        continue;
                    }


                    // =================================================
                    // PRODUCT CHANGE NOT ALLOWED
                    // =================================================

                    if (existingItem.ProductId !=
                        editedItem.ProductId)
                    {
                        ErrorMessage =
                            L[
                                "ProductChangeNotAllowedConfirmedOrder",
                                editedItem.ProductName
                            ];

                        return;
                    }


                    // =================================================
                    // LOCATION REQUIRED
                    // =================================================

                    if (!existingItem
                        .WarehouseLocationId
                        .HasValue)
                    {
                        ErrorMessage =
                            L[
                                "ReservationLocationRequired",
                                editedItem.ProductName
                            ];

                        return;
                    }


                    // =================================================
                    // STOCK
                    // =================================================

                    var stockForItem =
                        await db.Stocks

                            .FirstOrDefaultAsync(
                                x =>
                                    x.ProductId ==
                                    existingItem.ProductId
                                    &&
                                    x.WarehouseLocationId ==
                                    existingItem
                                        .WarehouseLocationId
                                        .Value);


                    if (stockForItem == null)
                    {
                        ErrorMessage =
                            L[
                                "ReservedStockNotFound",
                                editedItem.ProductName
                            ];

                        return;
                    }


                    // =================================================
                    // QUANTITY DIFFERENCE
                    // =================================================

                    var difference =
                        editedItem.Quantity -
                        existingItem.Quantity;


                    // =================================================
                    // INCREASE
                    // =================================================

                    if (difference > 0)
                    {
                        var availableForIncrease =
                            stockForItem.Quantity -
                            stockForItem.ReservedQuantity;


                        if (availableForIncrease <
                            difference)
                        {
                            ErrorMessage =
                                L[
                                    "InsufficientStockForIncrease",
                                    editedItem.ProductName,
                                    difference.ToString("N2"),
                                    availableForIncrease.ToString("N2")
                                ];

                            return;
                        }


                        stockForItem.ReservedQuantity +=
                            difference;
                    }


                    // =================================================
                    // REDUCE
                    // =================================================

                    else if (difference < 0)
                    {
                        stockForItem.ReservedQuantity =
                            Math.Max(
                                0,
                                stockForItem.ReservedQuantity +
                                difference);
                    }


                    stockForItem.UpdatedAt =
                        DateTime.UtcNow;


                    existingItem.Quantity =
                        editedItem.Quantity;

                    existingItem.UnitPrice =
                        editedItem.UnitPrice;
                }


                // =================================================
                // NO NEW ITEMS
                // =================================================

                if (Items.Any(x => x.Id == 0))
                {
                    ErrorMessage =
                        L["ConfirmedOrderCannotAddNewItems"];

                    return;
                }
            }
            else
            {
                // =================================================
                // UNCONFIRMED ORDER
                // =================================================

                foreach (var existingItem in
                    entity.Items.ToList())
                {
                    var editedItem =
                        Items.FirstOrDefault(
                            x =>
                                x.Id ==
                                existingItem.Id);


                    // =================================================
                    // DELETE
                    // =================================================

                    if (editedItem == null)
                    {
                        db.OrderItems.Remove(
                            existingItem);

                        continue;
                    }


                    // =================================================
                    // UPDATE
                    // =================================================

                    existingItem.ProductId =
                        editedItem.ProductId;

                    existingItem.Quantity =
                        editedItem.Quantity;

                    existingItem.UnitPrice =
                        editedItem.UnitPrice;
                }


                // =================================================
                // NEW ITEMS
                // =================================================

                foreach (var editedItem in
                    Items.Where(x => x.Id == 0))
                {
                    var productExists =
                        await db.Products

                            .AnyAsync(
                                x =>
                                    x.Id ==
                                    editedItem.ProductId
                                    &&
                                    x.IsActive);


                    if (!productExists)
                    {
                        ErrorMessage =
                            L[
                                "ProductNotFoundWithName",
                                editedItem.ProductName
                            ];

                        return;
                    }


                    db.OrderItems.Add(
                        new OrderItem
                        {
                            OrderId =
                                entity.Id,

                            ProductId =
                                editedItem.ProductId,

                            Quantity =
                                editedItem.Quantity,

                            UnitPrice =
                                editedItem.UnitPrice,

                            WarehouseLocationId =
                                null
                        });
                }
            }


            // =====================================================
            // ORDER DATA
            // =====================================================

            entity.CustomerId =
                Model.CustomerId;


            entity.OrderDate =
                Model.OrderDate;


            entity.Status =
                Model.Status;


            entity.ReferenceNumber =
                string.IsNullOrWhiteSpace(
                    Model.ReferenceNumber)

                    ? null

                    : Model.ReferenceNumber.Trim();


            entity.DeliveryStreet =
                string.IsNullOrWhiteSpace(
                    Model.DeliveryStreet)

                    ? null

                    : Model.DeliveryStreet.Trim();


            entity.DeliveryPostalCode =
                string.IsNullOrWhiteSpace(
                    Model.DeliveryPostalCode)

                    ? null

                    : Model.DeliveryPostalCode.Trim();


            entity.DeliveryCity =
                string.IsNullOrWhiteSpace(
                    Model.DeliveryCity)

                    ? null

                    : Model.DeliveryCity.Trim();


            entity.DeliveryCountry =
                string.IsNullOrWhiteSpace(
                    Model.DeliveryCountry)

                    ? null

                    : Model.DeliveryCountry.Trim();


            entity.Note =
                string.IsNullOrWhiteSpace(
                    Model.Note)

                    ? null

                    : Model.Note.Trim();


            entity.Total =
                GrandTotal;


            entity.UpdatedAt =
                DateTime.UtcNow;


            // =====================================================
            // SAVE
            // =====================================================

            await db.SaveChangesAsync();


            // =====================================================
            // REDIRECT
            // =====================================================

            Navigation.NavigateTo(
                "/orders");
        }
        catch (Exception ex)
        {
            ErrorMessage =
                L["ErrorSaving", ex.Message];
        }
        finally
        {
            IsSaving = false;
        }
    }


    // =========================================================
    // EDIT MODEL
