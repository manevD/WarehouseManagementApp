@page "/warehouses"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using Microsoft.Extensions.Localization
@using WarehouseManagement.Data
@using WarehouseManagement.Models
@using WarehouseManagement.Services
@using WarehouseManagement.Localization

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ExcelExportService ExcelExport
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Warehouses"]</PageTitle>

<div class="categories-page">

    <!-- HEADER -->

    <div class="page-header">

        <div>

            <h1>
                @L["Warehouses"]
            </h1>

            <p>
                @L["WarehousesOverviewDescription"]
            </p>

        </div>

        <div>

            <button type="button"
                    class="btn-secondary"
                    @onclick="ExportExcel"
                    disabled="@(PagedWarehouses.Count == 0)">

                📊 @L["ExportExcel"]

            </button>


            <a href="/warehouses/create"
               class="btn-primary">

                <span>+</span>

                @L["NewWarehouse"]

            </a>

        </div>

    </div>


    <!-- FILTER -->

    <div class="filter-card">

        <div class="search-box">

            <span class="search-icon">
                ⌕
            </span>

            <input type="text"
                   placeholder="@L["SearchWarehousePlaceholder"]"
                   @bind="SearchTerm"
                   @bind:event="oninput"
                   @bind:after="SearchChanged" />

        </div>


        <select class="filter-select"
                @bind="SelectedStatus"
                @bind:after="FilterChanged">

            <option value="all">
                @L["AllStatuses"]
            </option>

            <option value="active">
                @L["Active"]
            </option>

            <option value="inactive">
                @L["Inactive"]
            </option>

        </select>

    </div>


    <!-- TABLE -->

    <div class="products-card">

        <div class="products-card-header">

            <div>

                <strong>
                    @L["WarehouseList"]
                </strong>

                <span>
                    @L["PaginationWarehouses", Warehouses.Count]
                </span>

            </div>

        </div>


        @if (IsLoading)
        {
            <div class="loading-state">

                @L["LoadingWarehouses"]

            </div>
        }
        else if (Warehouses.Count == 0)
        {
            <div class="empty-products">

                <div class="empty-products-icon">
                    🏢
                </div>

                <h3>
                    @L["NoWarehousesFound"]
                </h3>

                <p>
                    @L["NoWarehousesForFilters"]
                </p>

                <a href="/warehouses/create"
                   class="btn-primary">

                    + @L["NewWarehouse"]

                </a>

            </div>
        }
        else
        {

            <div class="products-table-wrapper">

                <table class="products-table">

                    <thead>

                        <tr>

                            <th>
                                @L["Name"]
                            </th>

                            <th>
                                @L["Description"]
                            </th>

                            <th>
                                @L["StorageLocations"]
                            </th>

                            <th>
                                @L["Status"]
                            </th>

                            <th>
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var warehouse in PagedWarehouses)
                        {
                            <tr>

                                <!-- NAME -->

                                <td>

                                    <div class="product-name">

                                        <div class="product-avatar">

                                            @GetInitials(
                                                warehouse.Name)

                                        </div>

                                        <div>

                                            <strong>
                                                @(warehouse.Name ?? "-")
                                            </strong>

                                        </div>

                                    </div>

                                </td>


                                <!-- DESCRIPTION -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        warehouse.Description))
                                    {
                                        @warehouse.Description
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- LOCATIONS -->

                                <td>

                                    <span class="category-count">

                                        @(warehouse.Locations?.Count ?? 0)

                                    </span>

                                </td>


                                <!-- STATUS -->

                                <td>

                                    @if (warehouse.IsActive)
                                    {
                                        <span class="status-badge status-active">

                                            @L["Active"]

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">

                                            @L["Inactive"]

                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->

                                <td>

                                    <div class="product-actions">

                                        <a href="/warehouses/edit/@warehouse.Id"
                                           class="action-button"
                                           title="@L["Edit"]">

                                            ✎

                                        </a>


                                        <button class="action-button delete-button"
                                                title="@L["Deactivate"]"
                                                @onclick="() => ConfirmDelete(warehouse)">

                                            🗑

                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- PAGINATION -->
            @if (TotalPages > 1)
            {
                <div class="pagination">

                    <!-- PREVIOUS -->

                    <button type="button"
                            class="pagination-button"
                            disabled="@(CurrentPage <= 1)"
                            @onclick="PreviousPage">

                        ‹

                    </button>


                    <!-- PAGE NUMBERS -->

                    <div class="pagination-pages">

                        @foreach (var pageNumber in GetPageNumbers())
                        {
                            <button type="button"
                                    class="pagination-button @(pageNumber == CurrentPage ? "active" : "")"
                                    @onclick="() => GoToPage(pageNumber)">

                                @pageNumber

                            </button>
                        }

                    </div>


                    <!-- NEXT -->

                    <button type="button"
                            class="pagination-button"
                            disabled="@(CurrentPage >= TotalPages)"
                            @onclick="NextPage">

                        ›

                    </button>

                </div>
            }


            <!-- PAGINATION INFO -->

            <div class="pagination-info">

                @L["PageOf", CurrentPage, TotalPages]

                ·

                @L[
                    "PaginationWarehouses",
                    PagedWarehouses.Count
                ]

                /

                @Warehouses.Count

            </div>

        }

    </div>


    <!-- DELETE MODAL -->
    @if (ShowDeleteModal && WarehouseToDelete != null)
    {
        <div class="delete-modal-backdrop">

            <div class="delete-modal">

                <div class="delete-modal-icon">
                    🗑
                </div>

                <h3>
                    @L["DeactivateWarehouseQuestion"]
                </h3>

                <p>

                    @L["DeactivateWarehouseText"]

                    <strong>
                        @(WarehouseToDelete.Name ?? "-")
                    </strong>

                    @L["DeactivateWarehouseConfirm"]

                </p>

                <small>

                    @L["WarehouseWillNotBeDeleted"]

                </small>


                @if (WarehouseToDelete.Locations?.Any() == true)
                {
                    <div class="form-error">

                        @L[
                            "WarehouseContainsLocations",
                            WarehouseToDelete.Locations?.Count ?? 0
                        ]

                        @L["LocationsWillRemain"]

                    </div>
                }


                <div class="delete-modal-actions">

                    <button class="btn-secondary"
                            @onclick="CancelDelete">

                        @L["Cancel"]

                    </button>


                    <button class="btn-danger"
                            @onclick="DeleteConfirmed">

                        @L["Deactivate"]

                    </button>

                </div>

            </div>

        </div>
    }

</div>


@code {

    // =========================================================
    // DATA
    // =========================================================

    private List<Warehouse> Warehouses = new();


    // =========================================================
    // PAGINATION
    // =========================================================

    private const int PageSize = 10;

    private int CurrentPage = 1;


    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                Warehouses.Count /
                (double)PageSize));


    private List<Warehouse> PagedWarehouses =>
        Warehouses
            .Skip(
                (CurrentPage - 1) *
                PageSize)
            .Take(PageSize)
            .ToList();


    private List<int> GetPageNumbers()
    {
        var pages = new List<int>();

        var start =
            Math.Max(
                1,
                CurrentPage - 2);

        var end =
            Math.Min(
                TotalPages,
                CurrentPage + 2);

        for (var i = start; i <= end; i++)
        {
            pages.Add(i);
        }

        return pages;
    }


    private void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
        }
    }


    private void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
        }
    }


    private void GoToPage(int page)
    {
        if (page < 1)
        {
            page = 1;
        }

        if (page > TotalPages)
        {
            page = TotalPages;
        }

        CurrentPage = page;
    }


    // =========================================================
    // FILTER
    // =========================================================

    private string SearchTerm =
        string.Empty;


    private string SelectedStatus =
        "all";


    // =========================================================
    // STATE
    // =========================================================

    private bool IsLoading = true;

    private Warehouse? WarehouseToDelete;

    private bool ShowDeleteModal;


    // =========================================================
    // INITIALIZATION
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadWarehouses();
    }


    // =========================================================
    // LOAD WAREHOUSES
    // =========================================================

    private async Task LoadWarehouses()
    {
        IsLoading = true;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            var query =
                db.Warehouses
                    .Include(x => x.Locations)
                    .AsQueryable();


            // SEARCH

            if (!string.IsNullOrWhiteSpace(
                SearchTerm))
            {
                var search =
                    SearchTerm.Trim();

                query =
                    query.Where(x =>
                        x.Name.Contains(search) ||
                        (x.Description != null &&
                         x.Description.Contains(search)));
            }


            // STATUS

            if (SelectedStatus == "active")
            {
                query =
                    query.Where(x =>
                        x.IsActive);
            }
            else if (SelectedStatus == "inactive")
            {
                query =
                    query.Where(x =>
                        !x.IsActive);
            }


            // LOAD

            Warehouses =
                await query
                    .OrderBy(x => x.Name)
                    .ToListAsync();


            // RESET TO PAGE 1

            CurrentPage = 1;
        }
        finally
        {
            IsLoading = false;
        }
    }


    // =========================================================
    // SEARCH
    // =========================================================

    private async Task SearchChanged()
    {
        CurrentPage = 1;

        await LoadWarehouses();
    }


    // =========================================================
    // FILTER
    // =========================================================

    private async Task FilterChanged()
    {
        CurrentPage = 1;

        await LoadWarehouses();
    }


    // =========================================================
    // EXCEL EXPORT
    // =========================================================

    private async Task ExportExcel()
    {
        var data =
            PagedWarehouses
                .Where(x => x != null)
                .ToList();

        if (data.Count == 0)
        {
            return;
        }


        var fileBytes =
            ExcelExport.Export(
                data,

                L["Warehouses"].Value,

                $"{L["Warehouses"].Value} – {L["Page"]} {CurrentPage}",

                (
                    L["Name"].Value,
                    x => x.Name ?? ""
                ),

                (
                    L["Description"].Value,
                    x => x.Description ?? ""
                ),

                (
                    L["StorageLocations"].Value,
                    x => x.Locations?.Count ?? 0
                ),

                (
                    L["Status"].Value,
                    x => x.IsActive
                        ? L["Active"].Value
                        : L["Inactive"].Value
                ),

                (
                    L["Address"].Value,
                    x => x.Address ?? ""
                ),

                (
                    L["PostalCode"].Value,
                    x => x.PostalCode ?? ""
                ),

                (
                    L["City"].Value,
                    x => x.City ?? ""
                ),

                (
                    L["Country"].Value,
                    x => x.Country ?? ""
                )
            );


        var base64 =
            Convert.ToBase64String(
                fileBytes);


        await JS.InvokeVoidAsync(
            "downloadFile",

            $"{L["Warehouses"].Value}_Seite_{CurrentPage}.xlsx",

            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",

            base64);
    }


    // =========================================================
    // DELETE
    // =========================================================

    private void ConfirmDelete(
        Warehouse warehouse)
    {
        WarehouseToDelete =
            warehouse;

        ShowDeleteModal = true;
    }


    private void CancelDelete()
    {
        WarehouseToDelete = null;

        ShowDeleteModal = false;
    }


    private async Task DeleteConfirmed()
    {
        if (WarehouseToDelete == null)
        {
            return;
        }


        await using var db =
            await DbFactory.CreateDbContextAsync();


        var warehouse =
            await db.Warehouses
                .FirstOrDefaultAsync(
                    x =>
                        x.Id ==
                        WarehouseToDelete.Id);


        if (warehouse != null)
        {
            warehouse.IsActive = false;


            var locations =
                await db.WarehouseLocations
                    .Where(x =>
                        x.WarehouseId ==
                        warehouse.Id)
                    .ToListAsync();


            foreach (var location in locations)
            {
                location.IsActive = false;
            }


            await db.SaveChangesAsync();
        }


        WarehouseToDelete = null;

        ShowDeleteModal = false;


        await LoadWarehouses();
    }


    // =========================================================
    // INITIALS
    // =========================================================

    private string GetInitials(
        string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }


        var words =
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);


        if (words.Length == 1)
        {
            return words[0]
                .Substring(
                    0,
                    Math.Min(
                        2,
                        words[0].Length))
                .ToUpper();
        }


        return
            $"{words[0][0]}{words[1][0]}"
            .ToUpper();
    }

}