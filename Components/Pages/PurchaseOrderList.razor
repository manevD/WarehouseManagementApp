@page "/purchase-orders"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using Microsoft.Extensions.Localization
@using WarehouseManagement.Data
@using WarehouseManagement.Localization
@using WarehouseManagement.Models
@using WarehouseManagement.Services

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@inject ExcelExportService ExcelExport
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<style>
    .filter-date-group {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 8px;
        min-width: 190px;
    }

        .filter-date-group label {
            margin: 0;
            padding: 0;
            height: auto;
            color: #374151;
            font-size: 13px;
            line-height: 40px;
            white-space: nowrap;
        }

    .filter-date {
        width: 145px;
        height: 40px;
        box-sizing: border-box;
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0 10px;
        background: #ffffff;
        color: #374151;
        font-size: 13px;
        outline: none;
    }

        .filter-date:hover {
            border-color: #cbd5e1;
        }

        .filter-date:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.10);
        }
</style>


<PageTitle>@L["PurchaseOrders"]</PageTitle>


<div class="stock-page">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="page-header">

        <div>

            <h1>
                @L["PurchaseOrders"]
            </h1>

            <p>
                @L["ManagePurchaseOrdersDescription"]
            </p>

        </div>


        <div>

            <button type="button"
                    class="btn-secondary"
                    @onclick="ExportExcel"
                    disabled="@(PagedOrders.Count == 0)">

                📊 @L["ExportExcel"]

            </button>


            <a href="/purchase-orders/create"
               class="btn-primary">

                + @L["CreatePurchaseOrder"]

            </a>

        </div>

    </div>


    <!-- =========================================================
         FILTER
         ========================================================= -->

    <div class="filter-card">

        <div class="filter-main-row">

            <!-- SEARCH -->

            <div class="search-box">

                <span class="search-icon">
                    ⌕
                </span>

                <input type="text"
                       class="search-input"
                       placeholder="@L["SearchPurchaseOrderPlaceholder"]"
                       value="@SearchTerm"
                       @oninput="OnSearchInput" />

            </div>


            <!-- STATUS -->

            <select class="filter-select"
                    @bind="SelectedStatus"
                    @bind:after="FilterChanged">

                <option value="0">
                    @L["AllStatuses"]
                </option>

                <option value="@((int)PurchaseOrderStatus.Entwurf)">
                    @L["PurchaseOrderStatusDraft"]
                </option>

                <option value="@((int)PurchaseOrderStatus.Bestellt)">
                    @L["PurchaseOrderStatusOrdered"]
                </option>

                <option value="@((int)PurchaseOrderStatus.TeilweiseGeliefert)">
                    @L["PurchaseOrderStatusPartiallyDelivered"]
                </option>

                <option value="@((int)PurchaseOrderStatus.Geliefert)">
                    @L["PurchaseOrderStatusDelivered"]
                </option>

                <option value="@((int)PurchaseOrderStatus.Storniert)">
                    @L["PurchaseOrderStatusCancelled"]
                </option>

            </select>


            <!-- SUPPLIER -->

            <select class="filter-select"
                    @bind="SelectedSupplierId"
                    @bind:after="FilterChanged">

                <option value="0">
                    @L["AllSuppliers"]
                </option>

                @foreach (var supplier in Suppliers)
                {
                    <option value="@supplier.Id">

                        @supplier.CompanyName

                        @if (!string.IsNullOrWhiteSpace(
                            supplier.SupplierNumber))
                        {
                            @($" ({supplier.SupplierNumber})")
                        }

                    </option>
                }

            </select>


            <!-- FROM -->

            <div class="filter-date-group">

                <label>
                    @L["From"]
                </label>

                <input type="date"
                       class="filter-date"
                       @bind="FromDate"
                       @bind:after="FilterChanged" />

            </div>


            <!-- TO -->

            <div class="filter-date-group">

                <label>
                    @L["To"]
                </label>

                <input type="date"
                       class="filter-date"
                       @bind="ToDate"
                       @bind:after="FilterChanged" />

            </div>


            <!-- RESET -->

            <button type="button"
                    class="btn-secondary"
                    @onclick="ResetFilters">

                @L["ResetFilters"]

            </button>

        </div>

    </div>


    <!-- =========================================================
         SUMMARY
         ========================================================= -->

    <div class="stock-summary-grid">

        <div class="stock-summary-card">

            <span>
                @L["PurchaseOrders"]
            </span>

            <strong>
                @Orders.Count
            </strong>

        </div>


        <div class="stock-summary-card">

            <span>
                @L["Drafts"]
            </span>

            <strong>
                @DraftCount
            </strong>

        </div>


        <div class="stock-summary-card">

            <span>
                @L["Ordered"]
            </span>

            <strong>
                @OrderedCount
            </strong>

        </div>


        <div class="stock-summary-card">

            <span>
                @L["PartiallyDelivered"]
            </span>

            <strong>
                @PartialCount
            </strong>

        </div>


        <div class="stock-summary-card">

            <span>
                @L["TotalValue"]
            </span>

            <strong>
                @TotalValue.ToString("N2") €
            </strong>

        </div>

    </div>


    <!-- =========================================================
         TABLE
         ========================================================= -->

    <div class="products-card">

        <div class="products-card-header">

            <div>

                <strong>
                    @L["SupplierPurchaseOrders"]
                </strong>

                <span>
                    @Orders.Count @L["EntriesCount"]
                </span>

            </div>

        </div>


        @if (IsLoading)
        {
            <div class="loading-state">

                @L["PurchaseOrdersLoading"]

            </div>
        }
        else if (Orders.Count == 0)
        {
            <div class="empty-products">

                <div class="empty-products-icon">
                    📋
                </div>

                <h3>
                    @L["NoPurchaseOrdersFound"]
                </h3>

                <p>
                    @L["NoPurchaseOrdersForFilters"]
                </p>

                <a href="/purchase-orders/create"
                   class="btn-primary">

                    + @L["CreateFirstPurchaseOrder"]

                </a>

            </div>
        }
        else
        {
            <div class="products-table-wrapper">

                <table class="products-table">

                    <thead>

                        <tr>

                            <th>
                                @L["OrderNumber"]
                            </th>

                            <th>
                                @L["Supplier"]
                            </th>

                            <th>
                                @L["OrderDate"]
                            </th>

                            <th>
                                @L["Positions"]
                            </th>

                            <th>
                                @L["Total"]
                            </th>

                            <th>
                                @L["Status"]
                            </th>

                            <th>
                                @L["Reference"]
                            </th>

                            <th>
                                @L["Actions"]
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var order in PagedOrders)
                        {
                            <tr>

                                <!-- ORDER NUMBER -->

                                <td>

                                    <a href="/purchase-orders/details/@order.Id"
                                       class="order-number-link">

                                        @order.OrderNumber

                                    </a>

                                </td>


                                <!-- SUPPLIER -->

                                <td>

                                    @if (order.Supplier != null)
                                    {
                                        <div class="product-name">

                                            <div class="product-avatar">

                                                @GetInitials(
                                                    order.Supplier.CompanyName)

                                            </div>

                                            <div>

                                                <strong>
                                                    @order.Supplier.CompanyName
                                                </strong>

                                                @if (!string.IsNullOrWhiteSpace(
                                                    order.Supplier.SupplierNumber))
                                                {
                                                    <small>
                                                        @order.Supplier.SupplierNumber
                                                    </small>
                                                }

                                            </div>

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- DATE -->

                                <td>

                                    @order.OrderDate.ToString("dd.MM.yyyy")

                                </td>


                                <!-- ITEMS -->

                                <td>

                                    @order.Items.Count

                                </td>


                                <!-- TOTAL -->

                                <td>

                                    <strong>
                                        @order.Total.ToString("N2") €
                                    </strong>

                                </td>


                                <!-- STATUS -->

                                <td>

                                    @switch (order.Status)
                                    {
                                        case PurchaseOrderStatus.Entwurf:

                                            <span class="status-badge status-draft">
                                                @L["PurchaseOrderStatusDraft"]
                                            </span>

                                            break;


                                        case PurchaseOrderStatus.Bestellt:

                                            <span class="status-badge status-warning">
                                                @L["PurchaseOrderStatusOrdered"]
                                            </span>

                                            break;


                                        case PurchaseOrderStatus.TeilweiseGeliefert:

                                            <span class="status-badge status-warning">
                                                @L["PurchaseOrderStatusPartiallyDelivered"]
                                            </span>

                                            break;


                                        case PurchaseOrderStatus.Geliefert:

                                            <span class="status-badge status-active">
                                                @L["PurchaseOrderStatusDelivered"]
                                            </span>

                                            break;


                                        case PurchaseOrderStatus.Storniert:

                                            <span class="status-badge status-low">
                                                @L["PurchaseOrderStatusCancelled"]
                                            </span>

                                            break;


                                        default:

                                            <span class="status-badge">
                                                @GetStatusText(order.Status)
                                            </span>

                                            break;
                                    }

                                </td>


                                <!-- REFERENCE -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        order.ReferenceNumber))
                                    {
                                        @order.ReferenceNumber
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->

                                <td>

                                    <div class="product-actions">

                                        <a href="/purchase-orders/details/@order.Id"
                                           class="action-button"
                                           title="@L["Details"]">

                                            👁

                                        </a>


                                        @if (order.Status ==
                                             PurchaseOrderStatus.Entwurf)
                                        {
                                            <a href="/purchase-orders/edit/@order.Id"
                                               class="action-button"
                                               title="@L["Edit"]">

                                                ✎

                                            </a>


                                            <a href="/purchase-orders/confirm/@order.Id"
                                               class="action-button"
                                               title="@L["Confirm"]">

                                                ✓

                                            </a>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- =====================================================
                 PAGINATION
                 ===================================================== -->
            @if (TotalPages > 1)
            {
                <div class="pagination">

                    <button type="button"
                            class="pagination-button"
                            disabled="@(CurrentPage <= 1)"
                            @onclick="PreviousPage">

                        ‹

                    </button>


                    <div class="pagination-pages">

                        @for (int page = 1;
                              page <= TotalPages;
                              page++)
                        {
                            var pageNumber = page;

                            <button type="button"
                                    class="pagination-button @(CurrentPage == pageNumber ? "active" : "")"
                                    @onclick="() => GoToPage(pageNumber)">

                                @pageNumber

                            </button>
                        }

                    </div>


                    <button type="button"
                            class="pagination-button"
                            disabled="@(CurrentPage >= TotalPages)"
                            @onclick="NextPage">

                        ›

                    </button>

                </div>
            }


            <div class="pagination-info">

                @L["PageInfo",
                    CurrentPage,
                    TotalPages]

                ·

                @L["EntriesInfo",
                    PagedOrders.Count,
                    Orders.Count]

            </div>
        }

    </div>

</div>


@code {

    // =========================================================
    // DATA
    // =========================================================

    private List<PurchaseOrder> Orders = new();

    private List<Supplier> Suppliers = new();


    // =========================================================
    // FILTER
    // =========================================================

    private string SearchTerm =
        string.Empty;

    private int SelectedStatus;

    private int SelectedSupplierId;

    private DateTime? FromDate;

    private DateTime? ToDate;


    // =========================================================
    // PAGINATION
    // =========================================================

    private const int PageSize = 10;

    private int CurrentPage = 1;

    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                Orders.Count /
                (double)PageSize));


    private List<PurchaseOrder> PagedOrders =>
        Orders
            .Skip(
                (CurrentPage - 1) *
                PageSize)
            .Take(PageSize)
            .ToList();


    // =========================================================
    // STATE
    // =========================================================

    private bool IsLoading = true;


    // =========================================================
    // SUMMARY
    // =========================================================

    private int DraftCount =>
        Orders.Count(x =>
            x.Status ==
            PurchaseOrderStatus.Entwurf);


    private int OrderedCount =>
        Orders.Count(x =>
            x.Status ==
            PurchaseOrderStatus.Bestellt);


    private int PartialCount =>
        Orders.Count(x =>
            x.Status ==
            PurchaseOrderStatus.TeilweiseGeliefert);


    private decimal TotalValue =>
        Orders.Sum(x =>
            x.Total);


    // =========================================================
    // INITIALIZATION
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadSuppliers();

        await LoadOrders();
    }


    // =========================================================
    // LOAD SUPPLIERS
    // =========================================================

    private async Task LoadSuppliers()
    {
        await using var db =
            await DbFactory.CreateDbContextAsync();


        Suppliers =
            await db.Suppliers

                .AsNoTracking()

                .Where(x =>
                    x.IsActive)

                .OrderBy(x =>
                    x.CompanyName)

                .ToListAsync();
    }


    // =========================================================
    // LOAD ORDERS
    // =========================================================

    private async Task LoadOrders()
    {
        IsLoading = true;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            var query =
                db.PurchaseOrders

                    .AsNoTracking()

                    .Include(x =>
                        x.Supplier)

                    .Include(x =>
                        x.Items)

                        .ThenInclude(x =>
                            x.Product)

                    .AsQueryable();


            // =================================================
            // SEARCH
            // =================================================

            if (!string.IsNullOrWhiteSpace(
                SearchTerm))
            {
                var search =
                    SearchTerm.Trim();


                query =
                    query.Where(x =>

                        x.OrderNumber.Contains(
                            search)

                        ||

                        (
                            x.ReferenceNumber != null
                            &&
                            x.ReferenceNumber.Contains(
                                search)
                        )

                        ||

                        (
                            x.Supplier != null
                            &&
                            x.Supplier.CompanyName.Contains(
                                search)
                        )

                        ||

                        (
                            x.Supplier != null
                            &&
                            x.Supplier.SupplierNumber != null
                            &&
                            x.Supplier.SupplierNumber.Contains(
                                search)
                        )

                    );
            }


            // =================================================
            // STATUS
            // =================================================

            if (SelectedStatus > 0)
            {
                var status =
                    (PurchaseOrderStatus)
                        SelectedStatus;


                query =
                    query.Where(x =>
                        x.Status == status);
            }


            // =================================================
            // SUPPLIER
            // =================================================

            if (SelectedSupplierId > 0)
            {
                query =
                    query.Where(x =>
                        x.SupplierId ==
                        SelectedSupplierId);
            }


            // =================================================
            // FROM DATE
            // =================================================

            if (FromDate.HasValue)
            {
                var from =
                    FromDate.Value.Date;


                query =
                    query.Where(x =>
                        x.OrderDate >= from);
            }


            // =================================================
            // TO DATE
            // =================================================

            if (ToDate.HasValue)
            {
                var to =
                    ToDate.Value.Date.AddDays(1);


                query =
                    query.Where(x =>
                        x.OrderDate < to);
            }


            // =================================================
            // LOAD
            // =================================================

            Orders =
                await query

                    .OrderByDescending(x =>
                        x.OrderDate)

                    .ThenByDescending(x =>
                        x.Id)

                    .ToListAsync();


            CurrentPage = 1;
        }
        finally
        {
            IsLoading = false;
        }
    }


    // =========================================================
    // SEARCH INPUT
    // =========================================================

    private async Task OnSearchInput(
        ChangeEventArgs args)
    {
        SearchTerm =
            args.Value?.ToString()
            ?? string.Empty;


        CurrentPage = 1;

        await LoadOrders();
    }


    // =========================================================
    // FILTER
    // =========================================================

    private async Task FilterChanged()
    {
        CurrentPage = 1;

        await LoadOrders();
    }


    // =========================================================
    // RESET FILTERS
    // =========================================================

    private async Task ResetFilters()
    {
        SearchTerm =
            string.Empty;

        SelectedStatus =
            0;

        SelectedSupplierId =
            0;

        FromDate =
            null;

        ToDate =
            null;

        CurrentPage =
            1;

        await LoadOrders();
    }


    // =========================================================
    // PAGINATION
    // =========================================================

    private void GoToPage(
        int page)
    {
        if (page < 1 ||
            page > TotalPages)
        {
            return;
        }


        CurrentPage =
            page;
    }


    private void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
        }
    }


    private void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
        }
    }


    // =========================================================
    // EXCEL EXPORT
    // =========================================================

    private async Task ExportExcel()
    {
        try
        {
            var data =
                PagedOrders;


            var bytes =
                ExcelExport.Export(
                    data,

                    L["PurchaseOrders"],

                    $"{L["SupplierPurchaseOrders"]} – {L["Page"]} {CurrentPage}",

                    (
                        L["OrderNumber"],
                        x => x.OrderNumber
                    ),

                    (
                        L["Supplier"],
                        x => x.Supplier?.CompanyName ?? ""
                    ),

                    (
                        L["SupplierNumber"],
                        x => x.Supplier?.SupplierNumber ?? ""
                    ),

                    (
                        L["OrderDate"],
                        x => x.OrderDate
                    ),

                    (
                        L["Positions"],
                        x => x.Items.Count
                    ),

                    (
                        L["Total"],
                        x => x.Total
                    ),

                    (
                        L["Status"],
                        x => GetStatusText(x.Status)
                    ),

                    (
                        L["Reference"],
                        x => x.ReferenceNumber ?? ""
                    )
                );


            var base64 =
                Convert.ToBase64String(
                    bytes);


            await JS.InvokeVoidAsync(
                "downloadFile",

                $"{L["PurchaseOrdersFileName"]}_Seite_{CurrentPage}.xlsx",

                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",

                base64);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"{L["ExcelExportError"]}: {ex}");
        }
    }


    // =========================================================
    // STATUS TEXT
    // =========================================================

    private string GetStatusText(
        PurchaseOrderStatus status)
    {
        return status switch
        {
            PurchaseOrderStatus.Entwurf =>
                L["PurchaseOrderStatusDraft"],

            PurchaseOrderStatus.Bestellt =>
                L["PurchaseOrderStatusOrdered"],

            PurchaseOrderStatus.TeilweiseGeliefert =>
                L["PurchaseOrderStatusPartiallyDelivered"],

            PurchaseOrderStatus.Geliefert =>
                L["PurchaseOrderStatusDelivered"],

            PurchaseOrderStatus.Storniert =>
                L["PurchaseOrderStatusCancelled"],

            _ =>
                status.ToString()
        };
    }


    // =========================================================
    // INITIALS
    // =========================================================

    private string GetInitials(
        string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";


        var words =
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);


        if (words.Length == 1)
        {
            return words[0]
                .Substring(
                    0,
                    Math.Min(
                        2,
                        words[0].Length))
                .ToUpper();
        }


        return
            $"{words[0][0]}{words[1][0]}"
                .ToUpper();
    }

}