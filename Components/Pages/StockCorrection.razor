@page "/stock/correction"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using WarehouseManagement.Data
@using WarehouseManagement.Localization
@using WarehouseManagement.Models

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["StockCorrection"]</PageTitle>

<div class="product-form-page">

    <div class="page-header">

        <div>
            <h1>@L["StockCorrection"]</h1>
            <p>@L["StockCorrectionDescription"]</p>
        </div>

        <a href="/stock"
           class="btn-secondary">
            ← @L["Back"]
        </a>

    </div>

    <div class="form-card">

        <EditForm Model="@Model"
                  OnValidSubmit="@SaveCorrection"
                  FormName="StockCorrectionForm">

            <DataAnnotationsValidator />

            <!-- =================================================
                 BESTAND
                 ================================================= -->

            <div class="form-section">

                <div class="form-section-title">

                    <h2>@L["CorrectStock"]</h2>

                    <p>
                        @L["SelectProductAndLocation"]
                    </p>

                </div>

                <div class="form-grid">

                    <!-- PRODUCT -->

                    <div class="form-group">

                        <label>
                            @L["Product"] <span>*</span>
                        </label>

                        <InputSelect @bind-Value="Model.ProductId"
                                     class="form-control"
                                     @bind:after="SelectionChanged">

                            <option value="0">
                                @L["SelectProduct"]
                            </option>

                            @foreach (var product in Products)
                            {
                                <option value="@product.Id">
                                    @product.SKU - @product.Name
                                </option>
                            }

                        </InputSelect>

                        <ValidationMessage For="@(() => Model.ProductId)" />

                    </div>

                    <!-- WAREHOUSE -->

                    <div class="form-group">

                        <label>
                            @L["Warehouse"] <span>*</span>
                        </label>

                        <InputSelect @bind-Value="Model.WarehouseId"
                                     class="form-control"
                                     @bind:after="WarehouseChanged">

                            <option value="0">
                                @L["SelectWarehouse"]
                            </option>

                            @foreach (var warehouse in Warehouses)
                            {
                                <option value="@warehouse.Id">
                                    @warehouse.Name
                                </option>
                            }

                        </InputSelect>

                        <ValidationMessage For="@(() => Model.WarehouseId)" />

                    </div>

                    <!-- LOCATION -->

                    <div class="form-group">

                        <label>
                            @L["Location"] <span>*</span>
                        </label>

                        <InputSelect @bind-Value="Model.WarehouseLocationId"
                                     class="form-control"
                                     @bind:after="SelectionChanged">

                            <option value="0">
                                @L["SelectLocation"]
                            </option>

                            @foreach (var location in Locations)
                            {
                                <option value="@location.Id">

                                    @location.Code

                                    @if (!string.IsNullOrWhiteSpace(location.Name))
                                    {
                                        @($" - {location.Name}")
                                    }

                                </option>
                            }

                        </InputSelect>

                        <ValidationMessage For="@(() =>
                                                    Model.WarehouseLocationId)" />

                    </div>

                    <!-- CURRENT STOCK -->

                    <div class="form-group">

                        <label>
                            @L["CurrentStock"]
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@CurrentQuantity.ToString("N2")"
                               readonly />

                    </div>

                    <!-- NEW STOCK -->

                    <div class="form-group">

                        <label>
                            @L["NewStock"] <span>*</span>
                        </label>

                        <InputNumber @bind-Value="Model.NewQuantity"
                                     class="form-control"
                                     step="0.01"
                                     min="0" />

                        <ValidationMessage For="@(() => Model.NewQuantity)" />

                    </div>

                    <!-- DIFFERENCE -->

                    <div class="form-group">

                        <label>
                            @L["Difference"]
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@DifferenceText"
                               readonly />

                    </div>

                </div>

            </div>

            <!-- =================================================
                 REFERENCE
                 ================================================= -->

            <div class="form-section">

                <div class="form-section-title">

                    <h2>@L["Reference"]</h2>

                    <p>
                        @L["CorrectionReasonAndReference"]
                    </p>

                </div>

                <div class="form-grid">

                    <div class="form-group">

                        <label>
                            @L["Reason"] <span>*</span>
                        </label>

                        <InputSelect @bind-Value="Model.Reason"
                                     class="form-control">

                            <option value="">
                                @L["SelectReason"]
                            </option>

                            <option value="Inventur">
                                @L["ReasonInventory"]
                            </option>

                            <option value="Beschädigung">
                                @L["ReasonDamage"]
                            </option>

                            <option value="Verlust">
                                @L["ReasonLoss"]
                            </option>

                            <option value="Fund">
                                @L["ReasonFound"]
                            </option>

                            <option value="Zählfehler">
                                @L["ReasonCountingError"]
                            </option>

                            <option value="Sonstiges">
                                @L["ReasonOther"]
                            </option>

                        </InputSelect>

                        <ValidationMessage For="@(() => Model.Reason)" />

                    </div>

                    <div class="form-group">

                        <label>
                            @L["ReferenceNumber"]
                        </label>

                        <InputText @bind-Value="Model.ReferenceNumber"
                                   class="form-control"
                                   placeholder="@L["ReferenceNumberPlaceholder"]" />

                    </div>

                </div>

                <div class="form-group">

                    <label>
                        @L["Note"]
                    </label>

                    <InputTextArea @bind-Value="Model.Note"
                                   class="form-control textarea"
                                   rows="4"
                                   placeholder="@L["OptionalNotePlaceholder"]" />

                </div>

            </div>

            <!-- MESSAGES -->
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="form-error">
                    @ErrorMessage
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(SuccessMessage))
            {
                <div class="form-success">
                    @SuccessMessage
                </div>
            }

            <!-- ACTIONS -->

            <div class="form-actions">

                <a href="/stock"
                   class="btn-secondary">
                    @L["Cancel"]
                </a>

                <button type="submit"
                        class="btn-primary"
                        disabled="@IsSaving">

                    @(IsSaving
                        ? L["Saving"]
                        : L["CorrectStock"])

                </button>

            </div>

        </EditForm>

    </div>

</div>

@code {

    private CorrectionModel Model = new();

    private List<Product> Products = new();
    private List<Warehouse> Warehouses = new();
    private List<WarehouseLocation> Locations = new();

    private decimal CurrentQuantity;

    private bool IsSaving;

    private string? ErrorMessage;
    private string? SuccessMessage;


    protected override async Task OnInitializedAsync()
    {
        await using var db =
            await DbFactory.CreateDbContextAsync();

        Products = await db.Products
            .Where(x => x.IsActive)
            .OrderBy(x => x.Name)
            .ToListAsync();

        Warehouses = await db.Warehouses
            .Where(x => x.IsActive)
            .OrderBy(x => x.Name)
            .ToListAsync();
    }


    private async Task WarehouseChanged()
    {
        Model.WarehouseLocationId = 0;

        Locations.Clear();

        CurrentQuantity = 0;

        if (Model.WarehouseId <= 0)
            return;

        await using var db =
            await DbFactory.CreateDbContextAsync();

        Locations = await db.WarehouseLocations
            .Where(x =>
                x.IsActive &&
                x.WarehouseId == Model.WarehouseId)
            .OrderBy(x => x.Code)
            .ToListAsync();
    }


    private async Task SelectionChanged()
    {
        CurrentQuantity = 0;

        if (Model.ProductId <= 0 ||
            Model.WarehouseLocationId <= 0)
        {
            return;
        }

        await using var db =
            await DbFactory.CreateDbContextAsync();

        var stock =
            await db.Stocks
                .FirstOrDefaultAsync(x =>
                    x.ProductId == Model.ProductId &&
                    x.WarehouseLocationId ==
                        Model.WarehouseLocationId);

        if (stock != null)
        {
            CurrentQuantity = stock.Quantity;
        }

        Model.NewQuantity = CurrentQuantity;
    }


    private string DifferenceText
    {
        get
        {
            var difference =
                Model.NewQuantity -
                CurrentQuantity;

            if (difference > 0)
                return $"+{difference:N2}";

            return difference.ToString("N2");
        }
    }


    private async Task SaveCorrection()
    {
        if (IsSaving)
            return;

        IsSaving = true;

        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

            // =================================================
            // PRODUCT
            // =================================================

            var product =
                await db.Products
                    .FirstOrDefaultAsync(x =>
                        x.Id == Model.ProductId &&
                        x.IsActive);

            if (product == null)
            {
                ErrorMessage =
                    L["SelectedProductNotFound"];

                return;
            }


            // =================================================
            // WAREHOUSE
            // =================================================

            var warehouse =
                await db.Warehouses
                    .FirstOrDefaultAsync(x =>
                        x.Id == Model.WarehouseId &&
                        x.IsActive);

            if (warehouse == null)
            {
                ErrorMessage =
                    L["SelectedWarehouseNotFound"];

                return;
            }


            // =================================================
            // LOCATION
            // =================================================

            var location =
                await db.WarehouseLocations
                    .FirstOrDefaultAsync(x =>
                        x.Id == Model.WarehouseLocationId &&
                        x.WarehouseId == Model.WarehouseId &&
                        x.IsActive);

            if (location == null)
            {
                ErrorMessage =
                    L["SelectedLocationNotFound"];

                return;
            }


            // =================================================
            // STOCK
            // =================================================

            var stock =
                await db.Stocks
                    .FirstOrDefaultAsync(x =>
                        x.ProductId == Model.ProductId &&
                        x.WarehouseLocationId ==
                            Model.WarehouseLocationId);

            var oldQuantity =
                stock?.Quantity ?? 0;

            var newQuantity =
                Model.NewQuantity;

            var difference =
                newQuantity - oldQuantity;


            // =================================================
            // NOTHING CHANGED
            // =================================================

            if (difference == 0)
            {
                ErrorMessage =
                    L["StockAlreadyHasQuantity"];

                return;
            }


            // =================================================
            // STOCK
            // =================================================

            if (stock == null)
            {
                stock = new Stock
                {
                    ProductId =
                        Model.ProductId,

                    WarehouseLocationId =
                        Model.WarehouseLocationId,

                    Quantity =
                        newQuantity,

                    ReservedQuantity = 0,

                    UpdatedAt =
                        DateTime.UtcNow
                };

                db.Stocks.Add(stock);
            }
            else
            {
                if (newQuantity <
                    stock.ReservedQuantity)
                {
                    ErrorMessage =
                        L["StockCannotBeBelowReserved"];

                    return;
                }

                stock.Quantity =
                    newQuantity;

                stock.UpdatedAt =
                    DateTime.UtcNow;
            }


            // =================================================
            // MOVEMENT
            // =================================================

            var movementQuantity =
                Math.Abs(difference);

            var movement = new StockMovement
            {
                ProductId =
                    Model.ProductId,

                Quantity =
                    movementQuantity,

                Type =
                    StockMovementType.Korrektur,

                FromWarehouseLocationId =
                    difference < 0
                        ? Model.WarehouseLocationId
                        : null,

                ToWarehouseLocationId =
                    difference > 0
                        ? Model.WarehouseLocationId
                        : null,

                Note =
                    BuildNote(),

                UserId = null,

                CreatedAt =
                    DateTime.UtcNow
            };

            db.StockMovements.Add(movement);


            // =================================================
            // SAVE
            // =================================================

            await db.SaveChangesAsync();

            SuccessMessage =
                L["StockCorrectionSuccess",
                    oldQuantity.ToString("N2"),
                    newQuantity.ToString("N2")];

            CurrentQuantity =
                newQuantity;

            Model.NewQuantity =
                newQuantity;
        }
        catch (Exception ex)
        {
            ErrorMessage =
                L["StockCorrectionError", ex.Message];
        }
        finally
        {
            IsSaving = false;
        }
    }


    private string BuildNote()
    {
        var parts =
            new List<string>();

        if (!string.IsNullOrWhiteSpace(
            Model.ReferenceNumber))
        {
            parts.Add(
                $"{L["ReferenceNumber"]}: " +
                Model.ReferenceNumber.Trim());
        }

        if (!string.IsNullOrWhiteSpace(
            Model.Reason))
        {
            parts.Add(
                $"{L["Reason"]}: " +
                Model.Reason.Trim());
        }

        if (!string.IsNullOrWhiteSpace(
            Model.Note))
        {
            parts.Add(
                Model.Note.Trim());
        }

        return string.Join(
            " | ",
            parts);
    }


    private class CorrectionModel
    {
        [Range(
            1,
            int.MaxValue,
            ErrorMessageResourceType =
                typeof(SharedResource),
            ErrorMessageResourceName =
                "ProductSelectionRequired")]
        public int ProductId { get; set; }


        [Range(
            1,
            int.MaxValue,
            ErrorMessageResourceType =
                typeof(SharedResource),
            ErrorMessageResourceName =
                "WarehouseSelectionRequired")]
        public int WarehouseId { get; set; }


        [Range(
            1,
            int.MaxValue,
            ErrorMessageResourceType =
                typeof(SharedResource),
            ErrorMessageResourceName =
                "LocationSelectionRequired")]
        public int WarehouseLocationId { get; set; }


        [Range(
            0,
            double.MaxValue,
            ErrorMessageResourceType =
                typeof(SharedResource),
            ErrorMessageResourceName =
                "StockCannotBeNegative")]
        public decimal NewQuantity { get; set; }


        [Required(
            ErrorMessageResourceType =
                typeof(SharedResource),
            ErrorMessageResourceName =
                "ReasonSelectionRequired")]
        public string Reason { get; set; } =
            string.Empty;


        [MaxLength(100)]
        public string? ReferenceNumber { get; set; }


        [MaxLength(500)]
        public string? Note { get; set; }
    }
}