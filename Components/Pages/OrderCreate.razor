@page "/orders/create"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using WarehouseManagement.Components
@using WarehouseManagement.Data
@using WarehouseManagement.Localization
@using WarehouseManagement.Models

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["NewOrder"]</PageTitle>

<div class="product-form-page">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="page-header">

        <div>

            <h1>
                @L["NewOrder"]
            </h1>

            <p>
                @L["CreateOrderDescription"]
            </p>

        </div>

        <a href="/orders"
           class="btn-secondary">

            ← @L["Back"]

        </a>

    </div>


    <!-- =========================================================
         FORM
         ========================================================= -->

    <div class="form-card">

        <EditForm Model="@Model"
                  OnValidSubmit="@SaveOrder"
                  FormName="OrderCreateForm">

            <DataAnnotationsValidator />


            <!-- =====================================================
                 ORDER INFORMATION
                 ===================================================== -->

            <div class="form-section">

                <div class="form-section-title">

                    <div>

                        <h2>
                            @L["OrderInformation"]
                        </h2>

                        <p>
                            @L["BasicOrderInformation"]
                        </p>

                    </div>

                </div>


                <div class="form-grid">


                    <!-- =================================================
                         ORDER NUMBER
                         ================================================= -->

                    <div class="form-group">

                        <label>
                            @L["OrderNumber"]
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@Model.OrderNumber"
                               readonly />

                    </div>


                    <!-- =================================================
                         CUSTOMER
                         ================================================= -->

                    <div class="form-group">

                        <label>
                            @L["Customer"] <span>*</span>
                        </label>

                        <SearchableSelect TItem="Customer"
                                          TValue="int"
                                          Items="Customers"
                                          Value="Model.CustomerId"
                                          ValueChanged="OnCustomerChanged"
                                          ValueSelector="@(x => x.Id)"
                                          TextSelector="@(x => $"{x.CustomerNumber} - {x.CompanyName}")"
                                          Placeholder="@L["SelectCustomer"]"
                                          NoResultsText="@L["NoResultsFound"]"
                                          ShowAllOption="false"
                                          AllValue="0" />

                        <ValidationMessage For="@(() => Model.CustomerId)" />

                    </div>


                    <!-- =================================================
                         DATE
                         ================================================= -->

                    <div class="form-group">

                        <label>
                            @L["OrderDate"] <span>*</span>
                        </label>

                        <InputDate @bind-Value="Model.OrderDate"
                                   class="form-control" />

                        <ValidationMessage For="@(() => Model.OrderDate)" />

                    </div>


                    <!-- =================================================
                         REFERENCE
                         ================================================= -->

                    <div class="form-group">

                        <label>
                            @L["ReferenceNumber"]
                        </label>

                        <InputText @bind-Value="Model.ReferenceNumber"
                                   class="form-control"
                                   placeholder="@L["CustomerOrderPlaceholder"]" />

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 CUSTOMER ADDRESS
                 ===================================================== -->
            @if (SelectedCustomer != null)
            {
                <div class="form-section">

                    <div class="form-section-title">

                        <div>

                            <h2>
                                @L["DeliveryAddress"]
                            </h2>

                            <p>
                                @L["SelectedCustomerDeliveryAddress"]
                            </p>

                        </div>

                    </div>


                    <div class="form-grid">


                        <!-- STREET -->

                        <div class="form-group">

                            <label>
                                @L["Street"]
                            </label>

                            <InputText @bind-Value="Model.DeliveryStreet"
                                       class="form-control" />

                        </div>


                        <!-- POSTAL CODE -->

                        <div class="form-group">

                            <label>
                                @L["PostalCode"]
                            </label>

                            <InputText @bind-Value="Model.DeliveryPostalCode"
                                       class="form-control" />

                        </div>


                        <!-- CITY -->

                        <div class="form-group">

                            <label>
                                @L["City"]
                            </label>

                            <InputText @bind-Value="Model.DeliveryCity"
                                       class="form-control" />

                        </div>


                        <!-- COUNTRY -->

                        <div class="form-group">

                            <label>
                                @L["Country"]
                            </label>

                            <InputText @bind-Value="Model.DeliveryCountry"
                                       class="form-control" />

                        </div>

                    </div>

                </div>
            }


            <!-- =====================================================
                 ORDER ITEMS
                 ===================================================== -->

            <div class="form-section">

                <div class="form-section-title">

                    <div>

                        <h2>
                            @L["OrderItems"]
                        </h2>

                        <p>
                            @L["AddProductsToOrder"]
                        </p>

                    </div>

                </div>


                <!-- =================================================
                     ADD ITEM
                     ================================================= -->

                <div class="order-add-item">

                    <div class="form-grid">


                        <!-- =================================================
                             PRODUCT
                             ================================================= -->

                        <div class="form-group">

                            <label>
                                @L["Product"]
                            </label>

                            <SearchableSelect TItem="Product"
                                              TValue="int"
                                              Items="Products"
                                              Value="NewItem.ProductId"
                                              ValueChanged="OnProductSelected"
                                              ValueSelector="@(x => x.Id)"
                                              TextSelector="@(x => $"{x.SKU} - {x.Name}")"
                                              Placeholder="@L["SelectProduct"]"
                                              NoResultsText="@L["NoResultsFound"]"
                                              ShowAllOption="false"
                                              AllValue="0" />

                        </div>


                        <!-- =================================================
                             QUANTITY
                             ================================================= -->

                        <div class="form-group">

                            <label>
                                @L["Quantity"]
                            </label>

                            <input type="number"
                                   class="form-control"
                                   min="0.01"
                                   step="0.01"
                                   @bind="NewItem.Quantity" />

                        </div>


                        <!-- =================================================
                             UNIT PRICE
                             ================================================= -->

                        <div class="form-group">

                            <label>
                                @L["UnitPrice"]
                            </label>

                            <input type="number"
                                   class="form-control"
                                   min="0"
                                   step="0.01"
                                   @bind="NewItem.UnitPrice" />

                        </div>


                        <!-- =================================================
                             ADD
                             ================================================= -->

                        <div class="form-group">

                            <label>
                                &nbsp;
                            </label>

                            <button type="button"
                                    class="btn-primary"
                                    @onclick="AddItem">

                                + @L["AddProduct"]

                            </button>

                        </div>

                    </div>


                    @if (!string.IsNullOrWhiteSpace(ItemError))
                    {
                        <div class="form-error">
                            @ItemError
                        </div>
                    }

                </div>


                <!-- =================================================
                     ITEMS TABLE
                     ================================================= -->
                @if (Items.Count == 0)
                {
                    <div class="empty-products">

                        <div class="empty-products-icon">
                            ☷
                        </div>

                        <h3>
                            @L["NoProductsYet"]
                        </h3>

                        <p>
                            @L["SelectProductAndAdd"]
                        </p>

                    </div>
                }
                else
                {
                    <div class="products-table-wrapper">

                        <table class="products-table">

                            <thead>

                                <tr>

                                    <th>
                                        @L["Product"]
                                    </th>

                                    <th>
                                        @L["SKU"]
                                    </th>

                                    <th>
                                        @L["Quantity"]
                                    </th>

                                    <th>
                                        @L["UnitPrice"]
                                    </th>

                                    <th>
                                        @L["Total"]
                                    </th>

                                    <th></th>

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var item in Items)
                                {
                                    <tr>

                                        <!-- PRODUCT -->

                                        <td>

                                            <strong>
                                                @item.ProductName
                                            </strong>

                                        </td>


                                        <!-- SKU -->

                                        <td>

                                            <span class="product-sku">
                                                @item.SKU
                                            </span>

                                        </td>


                                        <!-- QUANTITY -->

                                        <td>

                                            @item.Quantity.ToString("N2")

                                        </td>


                                        <!-- UNIT PRICE -->

                                        <td>

                                            @item.UnitPrice.ToString("N2") €

                                        </td>


                                        <!-- TOTAL -->

                                        <td>

                                            <strong>
                                                @item.Total.ToString("N2") €
                                            </strong>

                                        </td>


                                        <!-- DELETE -->

                                        <td>

                                            <button type="button"
                                                    class="action-button delete-button"
                                                    title="@L["RemoveItem"]"
                                                    @onclick="() => RemoveItem(item)">

                                                🗑

                                            </button>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }


                <!-- =================================================
                     GRAND TOTAL
                     ================================================= -->

                <div class="order-total-box">

                    <span>
                        @L["Total"]
                    </span>

                    <strong>
                        @GrandTotal.ToString("N2") €
                    </strong>

                </div>

            </div>


            <!-- =====================================================
                 NOTE
                 ===================================================== -->

            <div class="form-section">

                <div class="form-section-title">

                    <div>

                        <h2>
                            @L["Note"]
                        </h2>

                    </div>

                </div>


                <div class="form-group">

                    <InputTextArea @bind-Value="Model.Note"
                                   class="form-control textarea"
                                   rows="5"
                                   placeholder="@L["OptionalNotePlaceholder"]" />

                </div>

            </div>


            <!-- =====================================================
                 ERROR
                 ===================================================== -->
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="form-error">
                    @ErrorMessage
                </div>
            }


            <!-- =====================================================
                 ACTIONS
                 ===================================================== -->

            <div class="form-actions">

                <a href="/orders"
                   class="btn-secondary">

                    @L["Cancel"]

                </a>


                <button type="submit"
                        class="btn-primary"
                        disabled="@IsSaving">

                    @(IsSaving
                        ? L["Saving"]
                        : L["SaveOrder"])

                </button>

            </div>

        </EditForm>

    </div>

</div>


@code {

    // =========================================================
    // DATA
    // =========================================================

    private List<Customer> Customers = new();

    private List<Product> Products = new();

    private List<OrderItemModel> Items = new();


    // =========================================================
    // MODEL
    // =========================================================

    private OrderCreateModel Model = new();

    private OrderItemModel NewItem = new();


    // =========================================================
    // CUSTOMER
    // =========================================================

    private Customer? SelectedCustomer;


    // =========================================================
    // STATE
    // =========================================================

    private bool IsSaving;

    private string? ErrorMessage;

    private string? ItemError;


    // =========================================================
    // TOTAL
    // =========================================================

    private decimal GrandTotal =>
        Items.Sum(x => x.Total);


    // =========================================================
    // INIT
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        await using var db =
            await DbFactory.CreateDbContextAsync();


        // =====================================================
        // ACTIVE CUSTOMERS
        // =====================================================

        Customers =
            await db.Customers

                .Where(x =>
                    x.IsActive)

                .OrderBy(x =>
                    x.CompanyName)

                .ToListAsync();


        // =====================================================
        // ACTIVE PRODUCTS
        // =====================================================

        Products =
            await db.Products

                .Where(x =>
                    x.IsActive)

                .OrderBy(x =>
                    x.Name)

                .ToListAsync();


        // =====================================================
        // ORDER NUMBER
        // =====================================================

        Model.OrderNumber =
            await GenerateOrderNumber();


        // =====================================================
        // DATE
        // =====================================================

        Model.OrderDate =
            DateTime.Now;
    }


    // =========================================================
    // GENERATE ORDER NUMBER
    // =========================================================

    private async Task<string> GenerateOrderNumber()
    {
        await using var db =
            await DbFactory.CreateDbContextAsync();


        var prefix =
            $"ORD-{DateTime.Now:yyyy}-";


        var numbers =
            await db.Orders

                .Where(x =>
                    x.OrderNumber.StartsWith(prefix))

                .Select(x =>
                    x.OrderNumber)

                .ToListAsync();


        var maxNumber = 0;


        foreach (var number in numbers)
        {
            var part =
                number.Substring(
                    prefix.Length);


            if (int.TryParse(
                part,
                out var value))
            {
                if (value > maxNumber)
                    maxNumber = value;
            }
        }


        return
            $"{prefix}{maxNumber + 1:0000}";
    }


    // =========================================================
    // CUSTOMER CHANGED
    // =========================================================

    private async Task OnCustomerChanged(
        int customerId)
    {
        // Set the new value FIRST.

        Model.CustomerId =
            customerId;


        // Find selected customer.

        SelectedCustomer =
            Customers.FirstOrDefault(
                x =>
                    x.Id ==
                    customerId);


        // No customer selected.

        if (SelectedCustomer == null)
        {
            Model.DeliveryStreet = null;

            Model.DeliveryPostalCode = null;

            Model.DeliveryCity = null;

            Model.DeliveryCountry = null;

            return;
        }


        // =====================================================
        // COPY CUSTOMER ADDRESS
        // =====================================================

        Model.DeliveryStreet =
            SelectedCustomer.Street;


        Model.DeliveryPostalCode =
            SelectedCustomer.PostalCode;


        Model.DeliveryCity =
            SelectedCustomer.City;


        Model.DeliveryCountry =
            SelectedCustomer.Country;


        await Task.CompletedTask;
    }


    // =========================================================
    // PRODUCT SELECTED
    // =========================================================

    private void OnProductSelected(
        int productId)
    {
        // Set the new value FIRST.

        NewItem.ProductId =
            productId;


        // Reset price.

        NewItem.UnitPrice =
            0;


        if (productId <= 0)
            return;


        // Find product.

        var product =
            Products.FirstOrDefault(
                x =>
                    x.Id ==
                    productId);


        if (product == null)
            return;


        // Automatically use sale price.

        NewItem.UnitPrice =
            product.SalePrice;
    }


    // =========================================================
    // ADD ITEM
    // =========================================================

    private void AddItem()
    {
        ItemError = null;


        // =====================================================
        // PRODUCT VALIDATION
        // =====================================================

        if (NewItem.ProductId <= 0)
        {
            ItemError =
                L["ProductSelectionRequired"];

            return;
        }


        // =====================================================
        // QUANTITY VALIDATION
        // =====================================================

        if (NewItem.Quantity <= 0)
        {
            ItemError =
                L["QuantityMustBeGreaterThanZero"];

            return;
        }


        // =====================================================
        // PRICE VALIDATION
        // =====================================================

        if (NewItem.UnitPrice < 0)
        {
            ItemError =
                L["UnitPriceCannotBeNegative"];

            return;
        }


        // =====================================================
        // PRODUCT
        // =====================================================

        var product =
            Products.FirstOrDefault(
                x =>
                    x.Id ==
                    NewItem.ProductId);


        if (product == null)
        {
            ItemError =
                L["ProductNotFound"];

            return;
        }


        // =====================================================
        // CHECK IF ALREADY EXISTS
        // =====================================================

        var existing =
            Items.FirstOrDefault(
                x =>
                    x.ProductId ==
                    NewItem.ProductId);


        if (existing != null)
        {
            existing.Quantity +=
                NewItem.Quantity;


            existing.UnitPrice =
                NewItem.UnitPrice;
        }
        else
        {
            Items.Add(
                new OrderItemModel
                {
                    ProductId =
                        product.Id,

                    ProductName =
                        product.Name,

                    SKU =
                        product.SKU,

                    Quantity =
                        NewItem.Quantity,

                    UnitPrice =
                        NewItem.UnitPrice
                });
        }


        // =====================================================
        // RESET ITEM FORM
        // =====================================================

        NewItem =
            new OrderItemModel();


        StateHasChanged();
    }


    // =========================================================
    // REMOVE ITEM
    // =========================================================

    private void RemoveItem(
        OrderItemModel item)
    {
        Items.Remove(item);

        StateHasChanged();
    }


    // =========================================================
    // SAVE ORDER
    // =========================================================

    private async Task SaveOrder()
    {
        if (IsSaving)
            return;


        IsSaving = true;

        ErrorMessage = null;


        try
        {
            // =================================================
            // CUSTOMER
            // =================================================

            if (Model.CustomerId <= 0)
            {
                ErrorMessage =
                    L["CustomerSelectionRequired"];

                return;
            }


            // =================================================
            // ITEMS
            // =================================================

            if (Items.Count == 0)
            {
                ErrorMessage =
                    L["NoProductsInOrder"];

                return;
            }


            await using var db =
                await DbFactory.CreateDbContextAsync();


            // =================================================
            // CUSTOMER EXISTS
            // =================================================

            var customer =
                await db.Customers

                    .FirstOrDefaultAsync(
                        x =>
                            x.Id ==
                            Model.CustomerId
                            &&
                            x.IsActive);


            if (customer == null)
            {
                ErrorMessage =
                    L["SelectedCustomerNotFound"];

                return;
            }


            // =================================================
            // ORDER NUMBER
            // =================================================

            var orderNumberExists =
                await db.Orders.AnyAsync(
                    x =>
                        x.OrderNumber ==
                        Model.OrderNumber);


            if (orderNumberExists)
            {
                Model.OrderNumber =
                    await GenerateOrderNumber();
            }


            // =================================================
            // CREATE ORDER
            // =================================================

            var order =
                new Order
                {
                    OrderNumber =
                        Model.OrderNumber,

                    CustomerId =
                        Model.CustomerId,

                    OrderDate =
                        Model.OrderDate,

                    // New order is always draft.

                    Status =
                        OrderStatus.Entwurf,

                    ReferenceNumber =
                        string.IsNullOrWhiteSpace(
                            Model.ReferenceNumber)
                            ? null
                            : Model.ReferenceNumber.Trim(),

                    DeliveryStreet =
                        string.IsNullOrWhiteSpace(
                            Model.DeliveryStreet)
                            ? null
                            : Model.DeliveryStreet.Trim(),

                    DeliveryPostalCode =
                        string.IsNullOrWhiteSpace(
                            Model.DeliveryPostalCode)
                            ? null
                            : Model.DeliveryPostalCode.Trim(),

                    DeliveryCity =
                        string.IsNullOrWhiteSpace(
                            Model.DeliveryCity)
                            ? null
                            : Model.DeliveryCity.Trim(),

                    DeliveryCountry =
                        string.IsNullOrWhiteSpace(
                            Model.DeliveryCountry)
                            ? null
                            : Model.DeliveryCountry.Trim(),

                    Note =
                        string.IsNullOrWhiteSpace(
                            Model.Note)
                            ? null
                            : Model.Note.Trim(),

                    Total =
                        GrandTotal,

                    CreatedAt =
                        DateTime.UtcNow
                };


            // =================================================
            // CREATE ORDER ITEMS
            // =================================================

            foreach (var item in Items)
            {
                var product =
                    await db.Products

                        .FirstOrDefaultAsync(
                            x =>
                                x.Id ==
                                item.ProductId
                                &&
                                x.IsActive);


                if (product == null)
                {
                    ErrorMessage =
                        L[
                            "SelectedProductNotFoundWithName",
                            item.ProductName
                        ];

                    return;
                }


                order.Items.Add(
                    new OrderItem
                    {
                        ProductId =
                            item.ProductId,

                        Quantity =
                            item.Quantity,

                        UnitPrice =
                            item.UnitPrice
                    });
            }


            // =================================================
            // SAVE
            // =================================================

            db.Orders.Add(order);


            await db.SaveChangesAsync();


            // =================================================
            // REDIRECT
            // =================================================

            Navigation.NavigateTo(
                "/orders");
        }
        catch (Exception ex)
        {
            ErrorMessage =
                L["ErrorSaving", ex.Message];
        }
        finally
        {
            IsSaving = false;
        }
    }


    // =========================================================
    // ORDER CREATE MODEL
    // =========================================================

    private class OrderCreateModel
    {
        public string OrderNumber { get; set; }
            = string.Empty;


        [Range(
            1,
            int.MaxValue,
            ErrorMessageResourceType =
                typeof(SharedResource),
            ErrorMessageResourceName =
                "CustomerSelectionRequired")]
        public int CustomerId { get; set; }


        [Required]
        public DateTime OrderDate { get; set; }


        [MaxLength(100)]
        public string? ReferenceNumber { get; set; }


        [MaxLength(300)]
        public string? DeliveryStreet { get; set; }


        [MaxLength(20)]
        public string? DeliveryPostalCode { get; set; }


        [MaxLength(100)]
        public string? DeliveryCity { get; set; }


        [MaxLength(100)]
        public string? DeliveryCountry { get; set; }


        [MaxLength(500)]
        public string? Note { get; set; }
    }


    // =========================================================
    // ORDER ITEM MODEL
    // =========================================================

    private class OrderItemModel
    {
        public int ProductId { get; set; }


        public string ProductName { get; set; }
            = string.Empty;


        public string SKU { get; set; }
            = string.Empty;


        public decimal Quantity { get; set; }


        public decimal UnitPrice { get; set; }


        public decimal Total =>
            Quantity * UnitPrice;
    }

}