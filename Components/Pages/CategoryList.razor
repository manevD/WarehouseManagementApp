@page "/categories"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using WarehouseManagement.Data
@using WarehouseManagement.Models
@using Microsoft.JSInterop
@using WarehouseManagement.Services

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ExcelExportService ExcelExport
@inject IJSRuntime JS


<PageTitle>Kategorien</PageTitle>


<div class="categories-page">

    <!-- HEADER -->

    <div class="page-header">

        <div>
            <h1>Kategorien</h1>

            <p>
                Verwalten Sie Ihre Produktkategorien.
            </p>
        </div>


        <div>
            <button type="button"
                    class="btn-secondary"
                    @onclick="ExportExcel" disabled="@(PagedCategories.Count == 0)">

                📊 Excel exportieren

            </button>

            <a href="/categories/create"
               class="btn-primary">

                <span>+</span>

                Neue Kategorie

            </a>

        </div>

    </div>


    <!-- FILTER -->

    <div class="filter-card">

        <div class="search-box">

            <span class="search-icon">
                ⌕
            </span>

            <input type="text"
                   placeholder="Kategorie suchen..."
                   @bind="SearchTerm"
                   @bind:event="oninput"
                   @bind:after="SearchChanged" />

        </div>


        <select class="filter-select"
                @bind="SelectedStatus"
                @bind:after="SearchChanged">

            <option value="all">
                Alle Status
            </option>

            <option value="active">
                Aktiv
            </option>

            <option value="inactive">
                Inaktiv
            </option>

        </select>

    </div>


    <!-- TABLE CARD -->

    <div class="products-card">

        <div class="products-card-header">

            <div>

                <strong>
                    Kategorienliste
                </strong>

                <span>
                    @Categories.Count Kategorien
                </span>

            </div>

        </div>


        @if (IsLoading)
        {
            <div class="loading-state">
                Kategorien werden geladen...
            </div>
        }
        else if (Categories.Count == 0)
        {
            <div class="empty-products">

                <div class="empty-products-icon">
                    📁
                </div>

                <h3>
                    Keine Kategorien gefunden
                </h3>

                <p>
                    Es wurden noch keine Kategorien angelegt.
                </p>

                <a href="/categories/create"
                   class="btn-primary">

                    + Neue Kategorie

                </a>

            </div>
        }
        else
        {
            <div class="products-table-wrapper">

                <table class="products-table">

                    <thead>

                        <tr>

                            <th>
                                Name
                            </th>

                            <th>
                                Beschreibung
                            </th>

                            <th>
                                Produkte
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var category in PagedCategories)
                        {
                            <tr>

                                <!-- NAME -->

                                <td>

                                    <div class="product-name">

                                        <div class="product-avatar">

                                            @GetInitials(category.Name)

                                        </div>


                                        <div>

                                            <strong>
                                                @category.Name
                                            </strong>

                                        </div>

                                    </div>

                                </td>


                                <!-- DESCRIPTION -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        category.Description))
                                    {
                                        <span>
                                            @category.Description
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- PRODUCTS COUNT -->

                                <td>

                                    <span class="category-count">

                                        @(category.Products?.Count ?? 0)

                                    </span>

                                </td>


                                <!-- STATUS -->

                                <td>

                                    @if (category.IsActive)
                                    {
                                        <span class="status-badge status-active">
                                            Aktiv
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">
                                            Inaktiv
                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->

                                <td>

                                    <div class="product-actions">

                                        <a href="/categories/edit/@category.Id"
                                           class="action-button"
                                           title="Bearbeiten">

                                            ✎

                                        </a>


                                        @if (category.IsActive)
                                        {
                                            <button class="action-button delete-button"
                                                    title="Deaktivieren"
                                                    @onclick="() => ConfirmDelete(category)">

                                                🗑

                                            </button>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- PAGINATION -->
            @if (TotalPages > 1)
            {
                <div class="pagination">

                    <button type="button"
                            class="pagination-button"
                            disabled="@(CurrentPage <= 1)"
                            @onclick="PreviousPage">

                        ‹

                    </button>


                    <div class="pagination-pages">

                        @for (int page = 1; page <= TotalPages; page++)
                        {
                            var pageNumber = page;

                            <button type="button"
                                    class="pagination-button @(CurrentPage == pageNumber ? "active" : "")"
                                    @onclick="() => GoToPage(pageNumber)">

                                @pageNumber

                            </button>
                        }

                    </div>


                    <button type="button"
                            class="pagination-button"
                            disabled="@(CurrentPage >= TotalPages)"
                            @onclick="NextPage">

                        ›

                    </button>

                </div>
            }


            <div class="pagination-info">

                Seite @CurrentPage von @TotalPages
                ·
                @PagedCategories.Count von @Categories.Count Kategorien

            </div>
        }

    </div>


    <!-- DELETE MODAL -->
    @if (ShowDeleteModal && CategoryToDelete != null)
    {
        <div class="delete-modal-backdrop">

            <div class="delete-modal">

                <div class="delete-modal-icon">
                    🗑
                </div>


                <h3>
                    Kategorie deaktivieren?
                </h3>


                <p>

                    Möchten Sie

                    <strong>
                        @CategoryToDelete.Name
                    </strong>

                    wirklich deaktivieren?

                </p>


                <small>

                    Die Kategorie wird nicht gelöscht.
                    Sie wird nur als inaktiv markiert.

                </small>


                @if (CategoryToDelete.Products?.Any() == true)
                {
                    <div class="form-error">

                        Diese Kategorie enthält
                        @CategoryToDelete.Products.Count Produkt(e).

                        Die Kategorie kann trotzdem deaktiviert werden.

                    </div>
                }


                <div class="delete-modal-actions">

                    <button class="btn-secondary"
                            @onclick="CancelDelete">

                        Abbrechen

                    </button>


                    <button class="btn-danger"
                            @onclick="DeleteConfirmed">

                        Deaktivieren

                    </button>

                </div>

            </div>

        </div>
    }

</div>


@code {

    // =========================================================
    // PAGINATION
    // =========================================================

    private const int PageSize = 10;

    private int CurrentPage = 1;


    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                Categories.Count /
                (double)PageSize));


    private List<Category> PagedCategories =>
        Categories
            .Skip(
                (CurrentPage - 1) *
                PageSize)
            .Take(PageSize)
            .ToList();


    private void GoToPage(int page)
    {
        if (page < 1 ||
            page > TotalPages)
        {
            return;
        }

        CurrentPage = page;
    }


    private void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
        }
    }


    private void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
        }
    }


    // =========================================================
    // DATA
    // =========================================================

    private List<Category> Categories = new();

    private string SearchTerm = string.Empty;

    private string SelectedStatus = "all";

    private bool IsLoading = true;


    // =========================================================
    // DELETE
    // =========================================================

    private Category? CategoryToDelete;

    private bool ShowDeleteModal;


    // =========================================================
    // INITIALIZE
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
    }


    // =========================================================
    // LOAD CATEGORIES
    // =========================================================

    private async Task LoadCategories()
    {
        IsLoading = true;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            var query =
                db.Categories
                    .Include(x => x.Products)
                    .AsQueryable();


            // SEARCH

            if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                var search =
                    SearchTerm.Trim();


                query =
                    query.Where(x =>
                        x.Name.Contains(search) ||
                        (x.Description != null &&
                         x.Description.Contains(search)));
            }


            // STATUS

            if (SelectedStatus == "active")
            {
                query =
                    query.Where(x =>
                        x.IsActive);
            }
            else if (SelectedStatus == "inactive")
            {
                query =
                    query.Where(x =>
                        !x.IsActive);
            }


            // LOAD

            Categories =
                await query
                    .OrderBy(x => x.Name)
                    .ToListAsync();


            // RESET PAGINATION

            CurrentPage = 1;
        }
        finally
        {
            IsLoading = false;
        }
    }


    // =========================================================
    // SEARCH
    // =========================================================

    private async Task SearchChanged()
    {
        CurrentPage = 1;

        await LoadCategories();
    }


    // =========================================================
    // INITIALS
    // =========================================================

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }


        var words =
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);


        if (words.Length == 1)
        {
            return words[0]
                .Substring(
                    0,
                    Math.Min(
                        2,
                        words[0].Length))
                .ToUpper();
        }


        return
            $"{words[0][0]}{words[1][0]}"
            .ToUpper();
    }


    // =========================================================
    // DELETE
    // =========================================================

    private void ConfirmDelete(
        Category category)
    {
        CategoryToDelete =
            category;

        ShowDeleteModal = true;
    }


    private void CancelDelete()
    {
        CategoryToDelete = null;

        ShowDeleteModal = false;
    }


    private async Task DeleteConfirmed()
    {
        if (CategoryToDelete == null)
        {
            return;
        }


        await using var db =
            await DbFactory.CreateDbContextAsync();


        var category =
            await db.Categories
                .FirstOrDefaultAsync(
                    x =>
                        x.Id ==
                        CategoryToDelete.Id);


        if (category != null)
        {
            category.IsActive = false;

            await db.SaveChangesAsync();
        }


        CategoryToDelete = null;

        ShowDeleteModal = false;


        await LoadCategories();
    }


    // =========================================================
    // EXCEL EXPORT
    // =========================================================

    private async Task ExportExcel()
    {
        var data =
            PagedCategories
                .Where(x => x != null)
                .ToList();


        if (data.Count == 0)
        {
            return;
        }


        var fileBytes =
            ExcelExport.Export(
                data,

                "Kategorien",

                $"Kategorien – Seite {CurrentPage}",

                ("Name",
                    x => x.Name ?? ""),

                ("Beschreibung",
                    x => x.Description ?? ""),

                ("Produkte",
                    x => x.Products?.Count ?? 0),

                ("Status",
                    x => x.IsActive
                        ? "Aktiv"
                        : "Inaktiv")
            );


        var base64 =
            Convert.ToBase64String(
                fileBytes);


        await JS.InvokeVoidAsync(
            "downloadFile",

            $"Kategorien_Seite_{CurrentPage}.xlsx",

            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",

            base64);
    }

}