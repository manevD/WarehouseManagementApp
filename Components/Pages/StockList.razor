@page "/stock"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using WarehouseManagement.Data
@using WarehouseManagement.Localization
@using WarehouseManagement.Models
@using WarehouseManagement.Services
@using Microsoft.JSInterop

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@inject ExcelExportService ExcelExport
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Stock"]</PageTitle>

<div class="stock-page">

    <!-- HEADER -->

    <div class="page-header">

        <div>

            <h1>
                @L["Stock"]
            </h1>

            <p>
                @L["CurrentStockOverview"]
            </p>

        </div>


        <div class="page-header-actions">

            <button type="button"
                    class="btn-secondary"
                    @onclick="ExportExcel"
                    disabled="@(PagedStockRows.Count == 0)">

                📊 @L["ExportExcel"]

            </button>


            <a href="/stock/incoming"
               class="btn-primary">

                + @L["IncomingGoods"]

            </a>


            <a href="/stock/outgoing"
               class="btn-secondary">

                @L["OutgoingGoods"]

            </a>


            <a href="/stock/transfer"
               class="btn-secondary">

                @L["Transfers"]

            </a>

        </div>

    </div>


    <!-- FILTER -->

    <div class="filter-card">

        <div class="filter-main-row">

            <!-- SEARCH -->

            <div class="search-box">

                <span class="search-icon">
                    ⌕
                </span>

                <input type="text"
                       class="search-input"
                       placeholder="@L["SearchProductSkuBarcode"]"
                       value="@SearchTerm"
                       @oninput="SearchChanged" />

            </div>


            <!-- WAREHOUSE -->

            <select class="filter-select"
                    @bind="SelectedWarehouseId"
                    @bind:after="FilterChanged">

                <option value="0">
                    @L["AllWarehouses"]
                </option>

                @foreach (var warehouse in Warehouses)
                {
                    <option value="@warehouse.Id">
                        @warehouse.Name
                    </option>
                }

            </select>


            <!-- LOCATION -->

            <select class="filter-select"
                    @bind="SelectedLocationId"
                    @bind:after="FilterChanged">

                <option value="0">
                    @L["AllLocations"]
                </option>

                @foreach (var location in FilterLocations)
                {
                    <option value="@location.Id">

                        @location.Code

                        @if (!string.IsNullOrWhiteSpace(location.Name))
                        {
                            @($" - {location.Name}")
                        }

                    </option>
                }

            </select>


            <!-- STATUS -->

            <select class="filter-select"
                    @bind="SelectedStatus"
                    @bind:after="FilterChanged">

                <option value="all">
                    @L["AllStockStatuses"]
                </option>

                <option value="ok">
                    @L["StockOk"]
                </option>

                <option value="low">
                    @L["LowStock"]
                </option>

                <option value="available">
                    @L["AvailableStock"]
                </option>

                <option value="empty">
                    @L["NoStock"]
                </option>

            </select>

        </div>

    </div>


    <!-- SUMMARY -->

    <div class="stock-summary-grid">

        <div class="stock-summary-card">

            <span>
                @L["Items"]
            </span>

            <strong>
                @StockRows.Count
            </strong>

        </div>


        <div class="stock-summary-card">

            <span>
                @L["TotalStock"]
            </span>

            <strong>
                @TotalQuantity.ToString("N2")
            </strong>

        </div>


        <div class="stock-summary-card">

            <span>
                @L["Reserved"]
            </span>

            <strong>
                @TotalReserved.ToString("N2")
            </strong>

        </div>


        <div class="stock-summary-card">

            <span>
                @L["Available"]
            </span>

            <strong>
                @TotalAvailable.ToString("N2")
            </strong>

        </div>


        <div class="stock-summary-card stock-warning-card">

            <span>
                @L["LowStock"]
            </span>

            <strong>
                @LowStockCount
            </strong>

        </div>

    </div>


    <!-- TABLE -->

    <div class="products-card">

        <div class="products-card-header">

            <div>

                <strong>
                    @L["StockList"]
                </strong>

                <span>
                    @L["EntriesCount", StockRows.Count]
                </span>

            </div>

        </div>


        @if (IsLoading)
        {
            <div class="loading-state">

                @L["StockLoading"]

            </div>
        }
        else if (StockRows.Count == 0)
        {
            <div class="empty-products">

                <div class="empty-products-icon">
                    📦
                </div>

                <h3>
                    @L["NoStockFound"]
                </h3>

                <p>
                    @L["NoStockForCurrentFilters"]
                </p>

            </div>
        }
        else
        {
            <div class="products-table-wrapper">

                <table class="products-table">

                    <thead>

                        <tr>

                            <th>
                                @L["SKU"]
                            </th>

                            <th>
                                @L["Product"]
                            </th>

                            <th>
                                @L["Warehouse"]
                            </th>

                            <th>
                                @L["Location"]
                            </th>

                            <th>
                                @L["StockQuantity"]
                            </th>

                            <th>
                                @L["Reserved"]
                            </th>

                            <th>
                                @L["Available"]
                            </th>

                            <th>
                                @L["Status"]
                            </th>

                            <th>
                                @L["Actions"]
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var stock in PagedStockRows)
                        {
                            var minimumStock =
                                stock.Product?.MinimumStock ?? 0;

                            var isLow =
                                stock.Quantity < minimumStock;

                            var isEmpty =
                                stock.Quantity <= 0;

                            var isAvailable =
                                stock.AvailableQuantity > 0;


                            <tr>

                                <!-- SKU -->

                                <td>

                                    <span class="product-sku">

                                        @(stock.Product?.SKU ?? "-")

                                    </span>

                                </td>


                                <!-- PRODUCT -->

                                <td>

                                    <div class="product-name">

                                        <div class="product-avatar">

                                            @GetInitials(
                                                stock.Product?.Name)

                                        </div>


                                        <div>

                                            <strong>

                                                @(stock.Product?.Name ?? "-")

                                            </strong>


                                            @if (!string.IsNullOrWhiteSpace(
                                                stock.Product?.Barcode))
                                            {
                                                <small>

                                                    @stock.Product.Barcode

                                                </small>
                                            }

                                        </div>

                                    </div>

                                </td>


                                <!-- WAREHOUSE -->

                                <td>

                                    @(stock.WarehouseLocation?
                                        .Warehouse?
                                        .Name ?? "-")

                                </td>


                                <!-- LOCATION -->

                                <td>

                                    <span class="location-badge">

                                        @if (stock.WarehouseLocation == null)
                                        {
                                            <span>
                                                -
                                            </span>
                                        }
                                        else if (
                                            string.IsNullOrWhiteSpace(
                                                stock.WarehouseLocation.Name))
                                        {
                                            @stock.WarehouseLocation.Code
                                        }
                                        else
                                        {
                                            @($"{stock.WarehouseLocation.Code} - {stock.WarehouseLocation.Name}")
                                        }

                                    </span>

                                </td>


                                <!-- QUANTITY -->

                                <td>

                                    <strong>
                                        @stock.Quantity.ToString("N2")
                                    </strong>

                                </td>


                                <!-- RESERVED -->

                                <td>

                                    @stock.ReservedQuantity.ToString("N2")

                                </td>


                                <!-- AVAILABLE -->

                                <td>

                                    <strong>
                                        @stock.AvailableQuantity.ToString("N2")
                                    </strong>

                                </td>


                                <!-- STATUS -->

                                <td>

                                    @if (isEmpty)
                                    {
                                        <span class="status-badge status-low">

                                            @L["Empty"]

                                        </span>
                                    }
                                    else if (isLow)
                                    {
                                        <span class="status-badge status-low">

                                            @L["Low"]

                                        </span>
                                    }
                                    else if (!isAvailable)
                                    {
                                        <span class="status-badge status-warning">

                                            @L["Reserved"]

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-active">

                                            @L["Ok"]

                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->

                                <td>

                                    <div class="product-actions">

                                        <a href="/stock/edit/@stock.Id"
                                           class="action-button"
                                           title="@L["EditStock"]">

                                            ✎

                                        </a>


                                        <button class="action-button delete-button"
                                                title="@L["SetStockToZero"]"
                                                @onclick="() => ConfirmDelete(stock)">

                                            🗑

                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- PAGINATION -->
            @if (TotalPages > 1)
            {
                <div class="pagination">

                    <button type="button"
                            class="pagination-button"
                            disabled="@(CurrentPage <= 1)"
                            @onclick="PreviousPage">

                        ‹

                    </button>


                    <div class="pagination-pages">

                        @foreach (var pageNumber in GetPageNumbers())
                        {
                            <button type="button"
                                    class="pagination-button @(pageNumber == CurrentPage ? "active" : "")"
                                    @onclick="() => GoToPage(pageNumber)">

                                @pageNumber

                            </button>
                        }

                    </div>


                    <button type="button"
                            class="pagination-button"
                            disabled="@(CurrentPage >= TotalPages)"
                            @onclick="NextPage">

                        ›

                    </button>

                </div>
            }


            <div class="pagination-info">

                @L["PageInfo", CurrentPage, TotalPages]
                ·
                @L["EntriesInfo", PagedStockRows.Count, StockRows.Count]

            </div>

        }

    </div>


    <!-- DELETE MODAL -->
    @if (ShowDeleteModal &&
             StockToDelete != null)
    {
        <div class="delete-modal-backdrop">

            <div class="delete-modal">

                <div class="delete-modal-icon">
                    🗑
                </div>


                <h3>
                    @L["SetStockToZeroQuestion"]
                </h3>

                <p>
                    @L["SetStockToZeroTextStart", StockToDelete.Product?.Name ?? "-"]
                </p>


                <small>

                    @L["StockNotDeletedCorrectionCreated"]

                </small>


                <div class="delete-modal-actions">

                    <button class="btn-secondary"
                            @onclick="CancelDelete">

                        @L["Cancel"]

                    </button>


                    <button class="btn-danger"
                            @onclick="DeleteConfirmed">

                        @L["SetStockToZero"]

                    </button>

                </div>

            </div>

        </div>
    }

</div>


@code {

    // =========================================================
    // DATA
    // =========================================================

    private List<Stock> StockRows = new();

    private List<Warehouse> Warehouses = new();

    private List<WarehouseLocation> FilterLocations = new();


    // =========================================================
    // PAGINATION
    // =========================================================

    private const int PageSize = 10;

    private int CurrentPage = 1;


    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                StockRows.Count /
                (double)PageSize));


    private List<Stock> PagedStockRows =>
        StockRows
            .Skip(
                (CurrentPage - 1) *
                PageSize)
            .Take(PageSize)
            .ToList();


    // =========================================================
    // FILTER
    // =========================================================

    private string SearchTerm =
        string.Empty;

    private int SelectedWarehouseId;

    private int SelectedLocationId;

    private string SelectedStatus =
        "all";


    // =========================================================
    // STATE
    // =========================================================

    private bool IsLoading = true;


    // =========================================================
    // SUMMARY
    // =========================================================

    private decimal TotalQuantity =>
        StockRows.Sum(
            x => x.Quantity);


    private decimal TotalReserved =>
        StockRows.Sum(
            x => x.ReservedQuantity);


    private decimal TotalAvailable =>
        StockRows.Sum(
            x => x.AvailableQuantity);


    private int LowStockCount =>
        StockRows.Count(
            x =>
                x.Quantity <
                (x.Product?.MinimumStock ?? 0));


    // =========================================================
    // DELETE
    // =========================================================

    private Stock? StockToDelete;

    private bool ShowDeleteModal;


    // =========================================================
    // INITIALIZATION
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadWarehouses();

        await LoadLocations();

        await LoadStock();
    }


    // =========================================================
    // LOAD WAREHOUSES
    // =========================================================

    private async Task LoadWarehouses()
    {
        await using var db =
            await DbFactory.CreateDbContextAsync();


        Warehouses =
            await db.Warehouses
                .Where(x =>
                    x.IsActive)
                .OrderBy(x =>
                    x.Name)
                .ToListAsync();
    }


    // =========================================================
    // LOAD LOCATIONS
    // =========================================================

    private async Task LoadLocations()
    {
        await using var db =
            await DbFactory.CreateDbContextAsync();


        var query =
            db.WarehouseLocations
                .Where(x =>
                    x.IsActive)
                .AsQueryable();


        if (SelectedWarehouseId > 0)
        {
            query =
                query.Where(x =>
                    x.WarehouseId ==
                    SelectedWarehouseId);
        }


        FilterLocations =
            await query
                .OrderBy(x =>
                    x.Code)
                .ToListAsync();
    }


    // =========================================================
    // LOAD STOCK
    // =========================================================

    private async Task LoadStock()
    {
        IsLoading = true;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            var query =
                db.Stocks

                    .Include(x =>
                        x.Product)

                    .Include(x =>
                        x.WarehouseLocation)

                        .ThenInclude(x =>
                            x.Warehouse)

                    .AsQueryable();


            // SEARCH

            if (!string.IsNullOrWhiteSpace(
                SearchTerm))
            {
                var search =
                    SearchTerm.Trim();


                query =
                    query.Where(x =>
                        x.Product != null
                        &&
                        (
                            x.Product.Name.Contains(search)
                            ||
                            x.Product.SKU.Contains(search)
                            ||
                            (
                                x.Product.Barcode != null
                                &&
                                x.Product.Barcode.Contains(search)
                            )
                        )
                    );
            }


            // WAREHOUSE

            if (SelectedWarehouseId > 0)
            {
                query =
                    query.Where(x =>
                        x.WarehouseLocation != null
                        &&
                        x.WarehouseLocation.WarehouseId ==
                        SelectedWarehouseId);
            }


            // LOCATION

            if (SelectedLocationId > 0)
            {
                query =
                    query.Where(x =>
                        x.WarehouseLocationId ==
                        SelectedLocationId);
            }


            var rows =
                await query

                    .OrderBy(x =>
                        x.Product!.Name)

                    .ThenBy(x =>
                        x.WarehouseLocation!.Code)

                    .ToListAsync();


            // STATUS

            if (SelectedStatus == "low")
            {
                rows =
                    rows
                        .Where(x =>
                            x.Quantity <
                            (x.Product?.MinimumStock ?? 0))
                        .ToList();
            }
            else if (SelectedStatus == "ok")
            {
                rows =
                    rows
                        .Where(x =>
                            x.Quantity >=
                            (x.Product?.MinimumStock ?? 0))
                        .ToList();
            }
            else if (SelectedStatus == "available")
            {
                rows =
                    rows
                        .Where(x =>
                            x.AvailableQuantity > 0)
                        .ToList();
            }
            else if (SelectedStatus == "empty")
            {
                rows =
                    rows
                        .Where(x =>
                            x.Quantity <= 0)
                        .ToList();
            }


            StockRows = rows;


            // RESET PAGINATION

            CurrentPage = 1;
        }
        finally
        {
            IsLoading = false;
        }
    }


    // =========================================================
    // LIVE SEARCH
    // =========================================================

    private async Task SearchChanged(
        ChangeEventArgs args)
    {
        SearchTerm =
            args.Value?.ToString()
            ?? string.Empty;

        CurrentPage = 1;

        await LoadStock();
    }


    // =========================================================
    // FILTER CHANGED
    // =========================================================

    private async Task FilterChanged()
    {
        await LoadLocations();


        if (SelectedLocationId > 0 &&
            !FilterLocations.Any(
                x =>
                    x.Id ==
                    SelectedLocationId))
        {
            SelectedLocationId = 0;
        }


        await LoadStock();
    }


    // =========================================================
    // PAGINATION
    // =========================================================

    private void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
        }
    }


    private void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
        }
    }


    private void GoToPage(int page)
    {
        if (page < 1)
        {
            page = 1;
        }


        if (page > TotalPages)
        {
            page = TotalPages;
        }


        CurrentPage = page;
    }


    private List<int> GetPageNumbers()
    {
        var pages =
            new List<int>();


        var start =
            Math.Max(
                1,
                CurrentPage - 2);


        var end =
            Math.Min(
                TotalPages,
                CurrentPage + 2);


        for (
            var i = start;
            i <= end;
            i++)
        {
            pages.Add(i);
        }


        return pages;
    }


    // =========================================================
    // EXCEL EXPORT
    // =========================================================

    private async Task ExportExcel()
    {
        var data =
            PagedStockRows
                .Where(x => x != null)
                .ToList();


        if (data.Count == 0)
        {
            return;
        }


        var fileBytes =
            ExcelExport.Export(
                data,

                L["Stock"].Value,

                $"{L["Stock"].Value} – {L["Page"].Value} {CurrentPage}",

                (L["SKU"].Value,
                    x => x.Product?.SKU ?? "-"),

                (L["Product"].Value,
                    x => x.Product?.Name ?? "-"),

                (L["Barcode"].Value,
                    x => x.Product?.Barcode ?? ""),

                (L["Warehouse"].Value,
                    x =>
                        x.WarehouseLocation?
                            .Warehouse?
                            .Name ?? "-"),

                (L["Location"].Value,
                    x =>
                        x.WarehouseLocation == null
                            ? "-"
                            : string.IsNullOrWhiteSpace(
                                x.WarehouseLocation.Name)
                                ? x.WarehouseLocation.Code
                                : $"{x.WarehouseLocation.Code} - {x.WarehouseLocation.Name}"),

                (L["StockQuantity"].Value,
                    x => x.Quantity),

                (L["Reserved"].Value,
                    x => x.ReservedQuantity),

                (L["Available"].Value,
                    x => x.AvailableQuantity),

                (L["MinimumStock"].Value,
                    x =>
                        x.Product?.MinimumStock ?? 0),

                (L["Status"].Value,
                    x =>
                        x.Quantity <= 0
                            ? L["Empty"].Value
                            : x.Quantity <
                              (x.Product?.MinimumStock ?? 0)
                                ? L["Low"].Value
                                : x.AvailableQuantity <= 0
                                    ? L["Reserved"].Value
                                    : L["Ok"].Value)
            );


        var base64 =
            Convert.ToBase64String(
                fileBytes);


        await JS.InvokeVoidAsync(
            "downloadFile",

            $"{L["Stock"].Value}_Seite_{CurrentPage}.xlsx",

            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",

            base64);
    }


    // =========================================================
    // INITIALS
    // =========================================================

    private string GetInitials(
        string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }


        var words =
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);


        if (words.Length == 1)
        {
            return words[0]
                .Substring(
                    0,
                    Math.Min(
                        2,
                        words[0].Length))
                .ToUpper();
        }


        return
            $"{words[0][0]}{words[1][0]}"
            .ToUpper();
    }


    // =========================================================
    // DELETE CONFIRM
    // =========================================================

    private void ConfirmDelete(
        Stock stock)
    {
        StockToDelete =
            stock;

        ShowDeleteModal =
            true;
    }


    // =========================================================
    // DELETE CANCEL
    // =========================================================

    private void CancelDelete()
    {
        StockToDelete =
            null;

        ShowDeleteModal =
            false;
    }


    // =========================================================
    // DELETE CONFIRMED
    // =========================================================

    private async Task DeleteConfirmed()
    {
        if (StockToDelete == null)
        {
            return;
        }


        await using var db =
            await DbFactory.CreateDbContextAsync();


        var stock =
            await db.Stocks
                .FirstOrDefaultAsync(
                    x =>
                        x.Id ==
                        StockToDelete.Id);


        if (stock == null)
        {
            CancelDelete();

            return;
        }


        // CREATE CORRECTION MOVEMENT

        if (stock.Quantity > 0)
        {
            var movement =
                new StockMovement
                {
                    ProductId =
                        stock.ProductId,

                    Quantity =
                        stock.Quantity,

                    Type =
                        StockMovementType.Korrektur,

                    FromWarehouseLocationId =
                        stock.WarehouseLocationId,

                    ToWarehouseLocationId =
                        null,

                    ReferenceNumber =
                        null,

                    Note =
                        L["StockManuallySetToZero"].Value,

                    UserId =
                        null,

                    CreatedAt =
                        DateTime.UtcNow
                };


            db.StockMovements.Add(
                movement);
        }


        // SET STOCK TO ZERO

        stock.Quantity =
            0;

        stock.ReservedQuantity =
            0;

        stock.UpdatedAt =
            DateTime.UtcNow;


        await db.SaveChangesAsync();


        StockToDelete =
            null;

        ShowDeleteModal =
            false;


        await LoadStock();
    }

}