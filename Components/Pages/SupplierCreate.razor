@page "/suppliers/create"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using WarehouseManagement.Data
@using WarehouseManagement.Localization
@using WarehouseManagement.Models

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["NewSupplier"]</PageTitle>

<div class="product-form-page">

    <div class="page-header">

        <div>

            <h1>@L["NewSupplier"]</h1>

            <p>
                @L["CreateNewSupplierDescription"]
            </p>

        </div>

        <a href="/suppliers"
           class="btn-secondary">

            ← @L["Back"]

        </a>

    </div>


    <div class="form-card">

        <EditForm Model="@Model"
                  OnValidSubmit="@SaveSupplier"
                  FormName="SupplierCreateForm">

            <DataAnnotationsValidator />


            <!-- =====================================================
                 SUPPLIER INFORMATION
                 ===================================================== -->

            <div class="form-section">

                <div class="form-section-title">

                    <h2>
                        @L["SupplierInformation"]
                    </h2>

                    <p>
                        @L["BasicSupplierInformation"]
                    </p>

                </div>


                <div class="form-grid">


                    <!-- COMPANY NAME -->

                    <div class="form-group">

                        <label>
                            @L["CompanyName"] <span>*</span>
                        </label>

                        <InputText @bind-Value="Model.CompanyName"
                                   class="form-control"
                                   placeholder="@L["CompanyNamePlaceholder"]" />

                        <ValidationMessage For="@(() => Model.CompanyName)" />

                    </div>


                    <!-- SUPPLIER NUMBER -->

                    <div class="form-group">

                        <label>
                            @L["SupplierNumber"]
                        </label>

                        <InputText @bind-Value="Model.SupplierNumber"
                                   class="form-control"
                                   placeholder="@L["SupplierNumberPlaceholder"]" />

                        <ValidationMessage For="@(() => Model.SupplierNumber)" />

                    </div>


                    <!-- CONTACT PERSON -->

                    <div class="form-group">

                        <label>
                            @L["ContactPerson"]
                        </label>

                        <InputText @bind-Value="Model.ContactPerson"
                                   class="form-control"
                                   placeholder="@L["ContactPersonPlaceholder"]" />

                    </div>


                    <!-- VAT NUMBER -->

                    <div class="form-group">

                        <label>
                            @L["VatNumber"]
                        </label>

                        <InputText @bind-Value="Model.VatNumber"
                                   class="form-control"
                                   placeholder="@L["VatNumberPlaceholder"]" />

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 CONTACT
                 ===================================================== -->

            <div class="form-section">

                <div class="form-section-title">

                    <h2>
                        @L["Contact"]
                    </h2>

                    <p>
                        @L["SupplierContactInformation"]
                    </p>

                </div>


                <div class="form-grid">


                    <!-- EMAIL -->

                    <div class="form-group">

                        <label>
                            @L["Email"]
                        </label>

                        <InputText @bind-Value="Model.Email"
                                   class="form-control"
                                   type="email"
                                   placeholder="@L["EmailPlaceholder"]" />

                        <ValidationMessage For="@(() => Model.Email)" />

                    </div>


                    <!-- PHONE -->

                    <div class="form-group">

                        <label>
                            @L["Phone"]
                        </label>

                        <InputText @bind-Value="Model.Phone"
                                   class="form-control"
                                   placeholder="@L["PhonePlaceholder"]" />

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 ADDRESS
                 ===================================================== -->

            <div class="form-section">

                <div class="form-section-title">

                    <h2>
                        @L["Address"]
                    </h2>

                </div>


                <div class="form-grid">


                    <!-- STREET -->

                    <div class="form-group">

                        <label>
                            @L["Street"]
                        </label>

                        <InputText @bind-Value="Model.Street"
                                   class="form-control"
                                   placeholder="@L["StreetPlaceholder"]" />

                    </div>


                    <!-- POSTAL CODE -->

                    <div class="form-group">

                        <label>
                            @L["PostalCode"]
                        </label>

                        <InputText @bind-Value="Model.PostalCode"
                                   class="form-control"
                                   placeholder="@L["PostalCodePlaceholder"]" />

                    </div>


                    <!-- CITY -->

                    <div class="form-group">

                        <label>
                            @L["City"]
                        </label>

                        <InputText @bind-Value="Model.City"
                                   class="form-control"
                                   placeholder="@L["CityPlaceholder"]" />

                    </div>


                    <!-- COUNTRY -->

                    <div class="form-group">

                        <label>
                            @L["Country"]
                        </label>

                        <InputText @bind-Value="Model.Country"
                                   class="form-control"
                                   placeholder="@L["CountryPlaceholder"]" />

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 NOTE
                 ===================================================== -->

            <div class="form-section">

                <div class="form-section-title">

                    <h2>
                        @L["Note"]
                    </h2>

                </div>


                <div class="form-group">

                    <InputTextArea @bind-Value="Model.Note"
                                   class="form-control textarea"
                                   rows="5"
                                   placeholder="@L["OptionalNotePlaceholder"]" />

                </div>

            </div>


            <!-- =====================================================
                 STATUS
                 ===================================================== -->

            <div class="form-section">

                <div class="form-group checkbox-group">

                    <label class="checkbox-label">

                        <InputCheckbox @bind-Value="Model.IsActive" />

                        <span>
                            @L["SupplierIsActive"]
                        </span>

                    </label>

                </div>

            </div>


            <!-- =====================================================
                 ERROR
                 ===================================================== -->
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="form-error">

                    @ErrorMessage

                </div>
            }


            <!-- =====================================================
                 ACTIONS
                 ===================================================== -->

            <div class="form-actions">

                <a href="/suppliers"
                   class="btn-secondary">

                    @L["Cancel"]

                </a>


                <button type="submit"
                        class="btn-primary"
                        disabled="@IsSaving">

                    @(IsSaving
                        ? L["Saving"]
                        : L["SaveSupplier"])

                </button>

            </div>

        </EditForm>

    </div>

</div>


@code {

    private SupplierModel Model = new();

    private bool IsSaving;

    private string? ErrorMessage;


    // =========================================================
    // SAVE SUPPLIER
    // =========================================================

    private async Task SaveSupplier()
    {
        if (IsSaving)
            return;


        IsSaving = true;

        ErrorMessage = null;


        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            var companyName =
                Model.CompanyName.Trim();


            // =================================================
            // SUPPLIER NUMBER CHECK
            // =================================================

            if (!string.IsNullOrWhiteSpace(
                Model.SupplierNumber))
            {
                var number =
                    Model.SupplierNumber.Trim();


                var exists =
                    await db.Suppliers
                        .AnyAsync(x =>
                            x.SupplierNumber == number);


                if (exists)
                {
                    ErrorMessage =
                        L["SupplierNumberAlreadyExists"];

                    return;
                }
            }


            // =================================================
            // CREATE SUPPLIER
            // =================================================

            var supplier =
                new Supplier
                {
                    CompanyName =
                        companyName,

                    SupplierNumber =
                        string.IsNullOrWhiteSpace(
                            Model.SupplierNumber)
                            ? null
                            : Model.SupplierNumber.Trim(),

                    ContactPerson =
                        string.IsNullOrWhiteSpace(
                            Model.ContactPerson)
                            ? null
                            : Model.ContactPerson.Trim(),

                    Email =
                        string.IsNullOrWhiteSpace(
                            Model.Email)
                            ? null
                            : Model.Email.Trim(),

                    Phone =
                        string.IsNullOrWhiteSpace(
                            Model.Phone)
                            ? null
                            : Model.Phone.Trim(),

                    Street =
                        string.IsNullOrWhiteSpace(
                            Model.Street)
                            ? null
                            : Model.Street.Trim(),

                    PostalCode =
                        string.IsNullOrWhiteSpace(
                            Model.PostalCode)
                            ? null
                            : Model.PostalCode.Trim(),

                    City =
                        string.IsNullOrWhiteSpace(
                            Model.City)
                            ? null
                            : Model.City.Trim(),

                    Country =
                        string.IsNullOrWhiteSpace(
                            Model.Country)
                            ? null
                            : Model.Country.Trim(),

                    VatNumber =
                        string.IsNullOrWhiteSpace(
                            Model.VatNumber)
                            ? null
                            : Model.VatNumber.Trim(),

                    Note =
                        string.IsNullOrWhiteSpace(
                            Model.Note)
                            ? null
                            : Model.Note.Trim(),

                    IsActive =
                        Model.IsActive,

                    CreatedAt =
                        DateTime.UtcNow
                };


            db.Suppliers.Add(
                supplier);


            await db.SaveChangesAsync();


            Navigation.NavigateTo(
                "/suppliers");
        }
        catch (Exception ex)
        {
            ErrorMessage =
                L["ErrorSaving", ex.Message];
        }
        finally
        {
            IsSaving = false;
        }
    }


    // =========================================================
    // FORM MODEL
    // =========================================================

    private class SupplierModel
    {
        [Required(
            ErrorMessageResourceType =
                typeof(SharedResource),
            ErrorMessageResourceName =
                "CompanyNameRequired")]
        [MaxLength(200)]
        public string CompanyName { get; set; }
            = string.Empty;


        [MaxLength(100)]
        public string? SupplierNumber { get; set; }


        [MaxLength(150)]
        public string? ContactPerson { get; set; }


        [EmailAddress(
            ErrorMessageResourceType =
                typeof(SharedResource),
            ErrorMessageResourceName =
                "InvalidEmailAddress")]
        [MaxLength(200)]
        public string? Email { get; set; }


        [MaxLength(50)]
        public string? Phone { get; set; }


        [MaxLength(300)]
        public string? Street { get; set; }


        [MaxLength(20)]
        public string? PostalCode { get; set; }


        [MaxLength(100)]
        public string? City { get; set; }


        [MaxLength(100)]
        public string? Country { get; set; }


        [MaxLength(50)]
        public string? VatNumber { get; set; }


        [MaxLength(500)]
        public string? Note { get; set; }


        public bool IsActive { get; set; } = true;
    }

}