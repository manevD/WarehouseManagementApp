@page "/stock/outgoing"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using WarehouseManagement.Data
@using WarehouseManagement.Localization
@using WarehouseManagement.Models
@rendermode InteractiveServer

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["OutgoingGoods"]</PageTitle>

<div class="product-form-page">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="page-header">

        <div>

            <h1>@L["OutgoingGoods"]</h1>

            <p>
                @L["OutgoingGoodsDescription"]
            </p>

        </div>

        <a href="/stock"
           class="btn-secondary">

            ← @L["Back"]

        </a>

    </div>


    <div class="form-card">

        <EditForm Model="@Model"
                  OnValidSubmit="@BookOutgoing"
                  FormName="StockOutgoingForm">

            <DataAnnotationsValidator />


            <!-- =====================================================
                 WARENAUSGANG
                 ===================================================== -->

            <div class="form-section">

                <div class="form-section-title">

                    <h2>@L["OutgoingGoods"]</h2>

                    <p>
                        @L["SelectProductWarehouseLocationQuantity"]
                    </p>

                </div>


                <div class="form-grid">


                    <!-- =================================================
                         PRODUKT
                         ================================================= -->

                    <div class="form-group">

                        <label>
                            @L["Product"] <span>*</span>
                        </label>

                        <SearchableSelect TItem="Product"
                  TValue="int"
                  Items="Products"
                  Value="@Model.ProductId"
                  ValueChanged="OnProductChanged"
                  ValueSelector="@(p => p.Id)"
                  TextSelector="@(p => $"{p.SKU} - {p.Name}")"
                  Placeholder="@L["SelectProduct"]"
                  NoResultsText="@L["NoResultsFound"]" />

                        @if (Model.ProductId <= 0 &&
                             ShowProductValidation)
                        {
                            <div class="validation-message">

                                @L["ProductSelectionRequired"]

                            </div>
                        }

                    </div>


                    <!-- =================================================
                         LAGER
                         ================================================= -->

                    <div class="form-group">

                        <label>
                            @L["Warehouse"] <span>*</span>
                        </label>

                        <SearchableSelect TItem="Warehouse"
                  TValue="int"
                  Items="Warehouses"
                  Value="@Model.WarehouseId"
                  ValueChanged="OnWarehouseChanged"
                  ValueSelector="@(x => x.Id)"
                  TextSelector="@(x => x.Name)"
                  Placeholder="@L["SelectWarehouse"]"
                  NoResultsText="@L["NoResultsFound"]"
                  Disabled="@(Model.ProductId <= 0)" />

                        @if (Model.WarehouseId <= 0 &&
                             ShowWarehouseValidation)
                        {
                            <div class="validation-message">

                                @L["WarehouseSelectionRequired"]

                            </div>
                        }

                    </div>


                    <!-- =================================================
                         LAGERPLATZ
                         ================================================= -->

                    <div class="form-group">

                        <label>
                            @L["Location"] <span>*</span>
                        </label>

                       <SearchableSelect TItem="WarehouseLocation"
                  TValue="int"
                  Items="Locations"
                  Value="@Model.WarehouseLocationId"
                  ValueChanged="OnLocationChanged"
                  ValueSelector="@(x => x.Id)"
                  TextSelector="@(x => $"{x.Code}{(string.IsNullOrWhiteSpace(x.Name) ? "" : $" - {x.Name}")}")"
                  Placeholder="@L["SelectLocation"]"
                  NoResultsText="@L["NoResultsFound"]"
                  Disabled="@(Model.WarehouseId <= 0)" />

                        @if (Locations.Count == 0 &&
                             Model.WarehouseId > 0)
                        {
                            <div class="form-hint">

                                @L["NoAvailableStockAtWarehouse"]

                            </div>
                        }


                        @if (Model.WarehouseLocationId <= 0 &&
                             ShowLocationValidation)
                        {
                            <div class="validation-message">

                                @L["LocationSelectionRequired"]

                            </div>
                        }

                    </div>


                    <!-- =================================================
                         VERFÜGBARER BESTAND
                         ================================================= -->

                    <div class="form-group">

                        <label>
                            @L["AvailableStock"]
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@AvailableQuantity.ToString("N2")"
                               readonly />

                    </div>


                    <!-- =================================================
                         MENGE
                         ================================================= -->

                    <div class="form-group">

                        <label>
                            @L["Quantity"] <span>*</span>
                        </label>

                        <InputNumber @bind-Value="Model.Quantity"
                                     class="form-control"
                                     step="0.01"
                                     min="0.01"
                                     disabled="@(Model.WarehouseLocationId <= 0)" />

                        @if (Model.Quantity <= 0 &&
                             ShowQuantityValidation)
                        {
                            <div class="validation-message">

                                @L["QuantityMustBeGreaterThanZero"]

                            </div>
                        }


                        @if (Model.Quantity > AvailableQuantity &&
                             Model.WarehouseLocationId > 0 &&
                             Model.Quantity > 0)
                        {
                            <div class="form-error">
                                @L["QuantityExceedsAvailableStockStart", @AvailableQuantity.ToString("N2")]
                            </div>
                        }

                    </div>


                    <!-- =================================================
                         REFERENZNUMMER
                         ================================================= -->

                    <div class="form-group">

                        <label>
                            @L["ReferenceNumber"]
                        </label>

                        <InputText @bind-Value="Model.ReferenceNumber"
                                   class="form-control"
                                   placeholder="@L["OutgoingReferencePlaceholder"]" />

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 NOTIZ
                 ===================================================== -->

            <div class="form-section">

                <div class="form-section-title">

                    <h2>@L["Note"]</h2>

                    <p>
                        @L["OptionalOutgoingGoodsInformation"]
                    </p>

                </div>


                <div class="form-group">

                    <InputTextArea @bind-Value="Model.Note"
                                   class="form-control textarea"
                                   rows="4"
                                   placeholder="@L["NotePlaceholder"]" />

                </div>

            </div>


            <!-- =====================================================
                 ERROR
                 ===================================================== -->
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="form-error">
                    @ErrorMessage
                </div>
            }


            <!-- =====================================================
                 SUCCESS
                 ===================================================== -->
            @if (!string.IsNullOrWhiteSpace(SuccessMessage))
            {
                <div class="form-success">
                    @SuccessMessage
                </div>
            }


            <!-- =====================================================
                 ACTIONS
                 ===================================================== -->

            <div class="form-actions">

                <a href="/stock"
                   class="btn-secondary">

                    @L["Cancel"]

                </a>

                <button type="submit"
                        class="btn-primary"
                        disabled="@IsSaving">

                    @(IsSaving
                        ? L["Booking"]
                        : L["BookOutgoingGoods"])

                </button>

            </div>

        </EditForm>

    </div>

</div>


@code {

    [SupplyParameterFromQuery(Name = "purchaseOrderId")]
    public int? QueryPurchaseOrderId { get; set; }

    [SupplyParameterFromQuery(Name = "productId")]
    public int? QueryProductId { get; set; }


    // =========================================================
    // DATA
    // =========================================================

    private OutgoingModel Model = new();

    private List<Product> Products = new();

    private List<Warehouse> Warehouses = new();

    private List<WarehouseLocation> Locations = new();


    // =========================================================
    // STATE
    // =========================================================

    private decimal AvailableQuantity;

    private bool IsSaving;

    private string? ErrorMessage;

    private string? SuccessMessage;

    private bool ShowProductValidation;

    private bool ShowWarehouseValidation;

    private bool ShowLocationValidation;

    private bool ShowQuantityValidation;


    // =========================================================
    // INITIALIZATION
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        await using var db =
            await DbFactory.CreateDbContextAsync();


        // =====================================================
        // PRODUCTS
        // =====================================================

        Products =
            await db.Products
                .Where(x =>
                    x.IsActive)
                .OrderBy(x =>
                    x.Name)
                .ToListAsync();


        Warehouses.Clear();
        Locations.Clear();


        // =====================================================
        // OPEN PURCHASE ORDER / PRODUCT FROM QUERY STRING
        // =====================================================

        if (QueryPurchaseOrderId.HasValue &&
            QueryPurchaseOrderId.Value > 0 &&
            QueryProductId.HasValue &&
            QueryProductId.Value > 0)
        {
            var purchaseOrder =
                await db.PurchaseOrders
                    .Include(x => x.Items)
                    .FirstOrDefaultAsync(x =>
                        x.Id == QueryPurchaseOrderId.Value);

            if (purchaseOrder != null)
            {
                var orderItem =
                    purchaseOrder.Items
                        .FirstOrDefault(x =>
                            x.ProductId == QueryProductId.Value &&
                            x.Quantity > x.DeliveredQuantity);

                if (orderItem != null)
                {
                    Model.ProductId =
                        orderItem.ProductId;

                    // Preselect the still-open quantity.
                    Model.Quantity =
                        Math.Max(
                            0,
                            orderItem.Quantity -
                            orderItem.DeliveredQuantity);

                    // Only warehouses with available stock
                    // for this product are shown.
                    Warehouses =
                        await db.Warehouses
                            .Where(warehouse =>
                                warehouse.IsActive &&
                                db.WarehouseLocations.Any(location =>
                                    location.WarehouseId == warehouse.Id &&
                                    location.IsActive &&
                                    db.Stocks.Any(stock =>
                                        stock.ProductId == Model.ProductId &&
                                        stock.WarehouseLocationId == location.Id &&
                                        stock.Quantity > stock.ReservedQuantity)))
                            .OrderBy(warehouse => warehouse.Name)
                            .ToListAsync();
                }
            }
        }
    }


    // =========================================================
    // PRODUCT CHANGED
    // =========================================================

   private async Task OnProductChanged(int productId)
{
    ErrorMessage = null;
    SuccessMessage = null;

    ShowProductValidation = false;
    ShowWarehouseValidation = false;
    ShowLocationValidation = false;
    ShowQuantityValidation = false;

    Model.ProductId = productId;

    Model.WarehouseId = 0;
    Model.WarehouseLocationId = 0;
    Model.Quantity = 0;

    AvailableQuantity = 0;

    Locations.Clear();
    Warehouses.Clear();

    if (Model.ProductId <= 0)
    {
        StateHasChanged();
        return;
    }

    await using var db =
        await DbFactory.CreateDbContextAsync();

    Warehouses =
        await db.Warehouses
            .Where(warehouse =>
                warehouse.IsActive
                &&
                db.WarehouseLocations.Any(location =>
                    location.WarehouseId == warehouse.Id
                    &&
                    location.IsActive
                    &&
                    db.Stocks.Any(stock =>
                        stock.ProductId == Model.ProductId
                        &&
                        stock.WarehouseLocationId == location.Id
                        &&
                        stock.Quantity > stock.ReservedQuantity)))
            .OrderBy(warehouse => warehouse.Name)
            .ToListAsync();

    StateHasChanged();
}

    // =========================================================
    // WAREHOUSE CHANGED
    // =========================================================

    private async Task OnWarehouseChanged(int warehouseId)
{
    ErrorMessage = null;
    SuccessMessage = null;

    ShowWarehouseValidation = false;
    ShowLocationValidation = false;

    Model.WarehouseId = warehouseId;

    if (warehouseId > 0 &&
        Model.ProductId > 0 &&
        !Warehouses.Any(x => x.Id == warehouseId))
    {
        Model.WarehouseId = 0;
        warehouseId = 0;
    }

    Model.WarehouseLocationId = 0;
    Model.Quantity = 0;

    AvailableQuantity = 0;

    Locations.Clear();

    if (warehouseId <= 0 ||
        Model.ProductId <= 0)
    {
        StateHasChanged();
        return;
    }

    await using var db =
        await DbFactory.CreateDbContextAsync();

    Locations =
        await db.WarehouseLocations
            .Where(location =>
                location.IsActive
                &&
                location.WarehouseId == warehouseId
                &&
                db.Stocks.Any(stock =>
                    stock.ProductId == Model.ProductId
                    &&
                    stock.WarehouseLocationId == location.Id
                    &&
                    stock.Quantity > stock.ReservedQuantity))
            .OrderBy(location => location.Code)
            .ToListAsync();

    StateHasChanged();
}

    // =========================================================
    // LOCATION CHANGED
    // =========================================================

    private async Task OnLocationChanged(int locationId)
{
    ErrorMessage = null;
    SuccessMessage = null;

    ShowLocationValidation = false;

    if (locationId > 0 &&
        !Locations.Any(x => x.Id == locationId))
    {
        locationId = 0;
    }

    Model.WarehouseLocationId = locationId;

    Model.Quantity = 0;

    AvailableQuantity = 0;

    if (locationId <= 0 ||
        Model.ProductId <= 0)
    {
        StateHasChanged();
        return;
    }

    await LoadAvailableStock();

    StateHasChanged();
}

    // =========================================================
    // LOAD AVAILABLE STOCK
    // =========================================================

    private async Task LoadAvailableStock()
    {
        AvailableQuantity = 0;


        if (Model.ProductId <= 0 ||
            Model.WarehouseLocationId <= 0)
        {
            return;
        }


        await using var db =
            await DbFactory.CreateDbContextAsync();


        var stock =
            await db.Stocks
                .FirstOrDefaultAsync(x =>
                    x.ProductId ==
                        Model.ProductId
                    &&
                    x.WarehouseLocationId ==
                        Model.WarehouseLocationId);


        if (stock == null)
        {
            AvailableQuantity = 0;

            return;
        }


        AvailableQuantity =
            stock.AvailableQuantity;
    }


    // =========================================================
    // BOOK OUTGOING
    // =========================================================

    private async Task BookOutgoing()
    {
        if (IsSaving)
            return;


        ErrorMessage = null;

        SuccessMessage = null;

        ShowProductValidation = false;

        ShowWarehouseValidation = false;

        ShowLocationValidation = false;

        ShowQuantityValidation = false;


        // =====================================================
        // PRODUCT
        // =====================================================

        if (Model.ProductId <= 0)
        {
            ShowProductValidation = true;

            ErrorMessage =
                L["ProductSelectionRequired"];

            return;
        }


        // =====================================================
        // WAREHOUSE
        // =====================================================

        if (Model.WarehouseId <= 0)
        {
            ShowWarehouseValidation = true;

            ErrorMessage =
                L["WarehouseSelectionRequired"];

            return;
        }


        // =====================================================
        // LOCATION
        // =====================================================

        if (Model.WarehouseLocationId <= 0)
        {
            ShowLocationValidation = true;

            ErrorMessage =
                L["LocationSelectionRequired"];

            return;
        }


        // =====================================================
        // QUANTITY
        // =====================================================

        if (Model.Quantity <= 0)
        {
            ShowQuantityValidation = true;

            ErrorMessage =
                L["QuantityMustBeGreaterThanZero"];

            return;
        }


        IsSaving = true;


        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            // =================================================
            // PRODUCT VALIDATION
            // =================================================

            var product =
                await db.Products
                    .FirstOrDefaultAsync(x =>
                        x.Id ==
                            Model.ProductId
                        &&
                        x.IsActive);


            if (product == null)
            {
                ErrorMessage =
                    L["SelectedProductNotFound"];

                return;
            }


            // =================================================
            // WAREHOUSE VALIDATION
            // =================================================

            var warehouse =
                await db.Warehouses
                    .FirstOrDefaultAsync(x =>
                        x.Id ==
                            Model.WarehouseId
                        &&
                        x.IsActive);


            if (warehouse == null)
            {
                ErrorMessage =
                    L["SelectedWarehouseNotFound"];

                return;
            }


            // =================================================
            // LOCATION VALIDATION
            // =================================================

            var location =
                await db.WarehouseLocations
                    .FirstOrDefaultAsync(x =>
                        x.Id ==
                            Model.WarehouseLocationId
                        &&
                        x.WarehouseId ==
                            Model.WarehouseId
                        &&
                        x.IsActive);


            if (location == null)
            {
                ErrorMessage =
                    L["SelectedLocationNotFound"];

                return;
            }


            // =================================================
            // STOCK
            // =================================================

            var stock =
                await db.Stocks
                    .FirstOrDefaultAsync(x =>
                        x.ProductId ==
                            Model.ProductId
                        &&
                        x.WarehouseLocationId ==
                            Model.WarehouseLocationId);


            if (stock == null)
            {
                ErrorMessage =
                    L["NoStockAtLocation"];

                return;
            }


            // =================================================
            // AVAILABLE STOCK
            // =================================================

            var available =
                stock.AvailableQuantity;


            if (available <= 0)
            {
                ErrorMessage =
                    L["NoAvailableStockAtLocation"];

                return;
            }


            if (Model.Quantity > available)
            {
                ErrorMessage =
                    L["InsufficientAvailableStock",
                        available.ToString("N2")];

                return;
            }


            // =================================================
            // TRANSACTION
            // =================================================

            await using var transaction =
                await db.Database
                    .BeginTransactionAsync();


            try
            {
                // =============================================
                // REDUCE STOCK
                // =============================================

                stock.Quantity -=
                    Model.Quantity;


                stock.UpdatedAt =
                    DateTime.UtcNow;


                // =============================================
                // MOVEMENT
                // =============================================

                var movement =
                    new StockMovement
                    {
                        ProductId =
                            Model.ProductId,

                        Quantity =
                            Model.Quantity,

                        Type =
                            StockMovementType.Warenausgang,

                        FromWarehouseLocationId =
                            Model.WarehouseLocationId,

                        ToWarehouseLocationId =
                            null,

                        ReferenceNumber =
                            string.IsNullOrWhiteSpace(
                                Model.ReferenceNumber)
                                ? null
                                : Model.ReferenceNumber.Trim(),

                        Note =
                            string.IsNullOrWhiteSpace(
                                Model.Note)
                                ? null
                                : Model.Note.Trim(),

                        UserId =
                            null,

                        CreatedAt =
                            DateTime.UtcNow
                    };


                db.StockMovements.Add(
                    movement);


                // =============================================
                // SAVE
                // =============================================

                await db.SaveChangesAsync();


                await transaction.CommitAsync();
            }
            catch
            {
                await transaction.RollbackAsync();

                throw;
            }


            // =================================================
            // SUCCESS
            // =================================================

            var bookedQuantity =
                Model.Quantity;


            SuccessMessage =
                L["OutgoingGoodsSuccess",
                    bookedQuantity.ToString("N2")];


            // =================================================
            // UPDATE DISPLAYED STOCK
            // =================================================

            AvailableQuantity =
                stock.AvailableQuantity;


            Model.Quantity =
                0;


            StateHasChanged();
        }
        catch (Exception ex)
        {
            ErrorMessage =
                L["OutgoingGoodsBookingError",
                    ex.Message];
        }
        finally
        {
            IsSaving = false;
        }
    }


    // =========================================================
    // MODEL
    // =========================================================

    private class OutgoingModel
    {
        public int ProductId { get; set; }

        public int WarehouseId { get; set; }

        public int WarehouseLocationId { get; set; }

        public decimal Quantity { get; set; }

        public string? ReferenceNumber { get; set; }

        public string? Note { get; set; }
    }

}