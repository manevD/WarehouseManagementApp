        <section class="demo-section"
                 id="demo">

            <div class="container">

                <div class="demo-wrapper">


                    <div class="demo-info">

                        <span class="section-tag">
                            Persönliche Demo
                        </span>


                        <h2>
                            Sehen Sie selbst,
                            <em>was Ihr Lager heute schon können kann.</em>
                        </h2>


                        <p>

                            In einer persönlichen Demo zeigen wir
                            Ihnen die wichtigsten Funktionen von
                            Warehouse Management und besprechen,
                            wie Ihre bestehenden Prozesse abgebildet
                            werden können.

                        </p>


                        <p class="demo-note">
                            ◷ Persönlich · Unverbindlich · Auf Deutsch
                        </p>


                        <div class="demo-benefits">

                            <span>
                                ✓ Keine Vorbereitung notwendig
                            </span>

                            <span>
                                ✓ An Ihrem Anwendungsfall orientiert
                            </span>

                            <span>
                                ✓ Konkrete nächste Schritte
                            </span>

                        </div>

                    </div>



                    <div class="demo-card glass-card">

                        <h3>
                            Demo-Termin anfragen
                        </h3>


                        <p class="card-subtitle">
                            Wir melden uns innerhalb eines Werktags bei Ihnen.
                        </p>


                        <EditForm Model="DemoRequestItem"
                                  OnValidSubmit="SubmitDemo"
                                  FormName="SubmitDemoForm"
                                  OnInvalidSubmit="InvalidForm">

                            <DataAnnotationsValidator />


                            <div class="form-group">

                                <label>
                                    Vor- und Nachname *
                                </label>

                                <InputText @bind-Value="DemoRequestItem.Name"
                                           class="form-control"
                                           placeholder="Anna Müller" />

                                <ValidationMessage For="@(() => DemoRequestItem.Name)"
                                                   class="val-msg" />

                            </div>



                            <div class="form-row">


                                <div class="form-group">

                                    <label>
                                        Unternehmen *
                                    </label>

                                    <InputText @bind-Value="DemoRequestItem.Company"
                                               class="form-control"
                                               placeholder="Muster GmbH" />

                                    <ValidationMessage For="@(() => DemoRequestItem.Company)"
                                                       class="val-msg" />

                                </div>



                                <div class="form-group">

                                    <label>
                                        Geschäftliche E-Mail *
                                    </label>

                                    <InputText @bind-Value="DemoRequestItem.Email"
                                               type="email"
                                               class="form-control"
                                               placeholder="anna@muster.de" />

                                    <ValidationMessage For="@(() => DemoRequestItem.Email)"
                                                       class="val-msg" />

                                </div>

                            </div>



                            <div class="form-group">

                                <label>
                                    Branche
                                </label>

                                <InputSelect @bind-Value="DemoRequestItem.Industry"
                                             class="form-control">

                                    <option value="">
                                        Bitte auswählen...
                                    </option>

                                    <option value="Großhandel">
                                        Großhandel
                                    </option>

                                    <option value="Baustoffhandel">
                                        Baustoffhandel
                                    </option>

                                    <option value="Ersatzteilhandel">
                                        Ersatzteilhandel
                                    </option>

                                    <option value="Produktionsbetrieb">
                                        Produktionsbetrieb
                                    </option>

                                    <option value="Online-Handel / E-Commerce">
                                        Online-Handel / E-Commerce
                                    </option>

                                    <option value="Technischer Handel">
                                        Technischer Handel
                                    </option>

                                    <option value="Andere">
                                        Andere
                                    </option>

                                </InputSelect>

                            </div>



                            <div class="form-group">

                                <label>
                                    Was möchten Sie verbessern?
                                </label>

                                <InputTextArea @bind-Value="DemoRequestItem.Message"
                                               class="form-control textarea"
                                               placeholder="Erzählen Sie uns kurz von Ihrem Lager, Ihren aktuellen Prozessen und Ihren Herausforderungen..." />

                            </div>



                            <button type="submit"
                                    class="btn btn-primary btn-full">

                                Demo anfragen

                                <span>
                                    →
                                </span>

                            </button>



                            @if (Submitted)
                            {
                                <div class="alert alert-success">

                                    Vielen Dank!
                                    Ihre Anfrage ist eingegangen.
                                    Wir melden uns bald bei Ihnen.

                                </div>
                            }

                        </EditForm>



                        @if (!string.IsNullOrWhiteSpace(EmailError))
                        {
                            <div class="alert alert-danger"
                                 style="white-space: pre-wrap;">

                                @EmailError

                            </div>
                        }

                    </div>

                </div>

            </div>

        </section>

    </main>



