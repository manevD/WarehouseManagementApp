@page "/"
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager Navigation
@layout PublicLayout
<PageTitle>Warehouse Management | Lagerverwaltung, die mitwächst</PageTitle>

<div class="index-page">
<header class="site-header">
    <div class="container nav">
        <a class="brand" href="#top" aria-label="Warehouse Management Startseite">
            <span class="brand-mark">⌂</span>
            <span>Warehouse<small>Management</small></span>
        </a>

        <nav class="nav-links @(MenuOpen ? "open" : string.Empty)">
            <a href="#loesung" @onclick="CloseMenu">Lösung</a>
            <a href="#branchen" @onclick="CloseMenu">Branchen</a>
            <a href="#funktionen" @onclick="CloseMenu">Funktionen</a>
            <a href="#ablauf" @onclick="CloseMenu">Ablauf</a>
            <a href="#faq" @onclick="CloseMenu">FAQ</a>
            <a href="#demo" @onclick="CloseMenu">Demo</a>
        </nav>

        <div class="nav-actions">
            <span class="language">DE⌄</span>
            <a class="btn btn-primary" href="#demo">Demo buchen <span>→</span></a>
            <button class="menu-toggle" type="button" aria-label="Menü öffnen" @onclick="ToggleMenu">☰</button>
        </div>
    </div>
</header>

<main id="top">
    <section class="hero">
        <div class="container hero-grid">
            <div class="hero-copy">
                <span class="eyebrow">Die Lagerverwaltung für morgen</span>
                <h1 class="display">Lager im Griff.<br /><em>Geschäft im Fluss.</em></h1>
                <p class="hero-lead">
                    Warehouse Management bringt Produkte, Bestände, Bestellungen und Menschen in einem System zusammen – damit Ihr Lager mit Ihrem Unternehmen wächst.
                </p>
                <div class="hero-ctas">
                    <a class="btn btn-primary" href="#demo">Persönliche Demo buchen <span>→</span></a>
                    <a class="btn btn-ghost" href="#funktionen">Mehr erfahren <span>→</span></a>
                </div>
                <div class="microproof"><span class="avatars">MK&nbsp; LS&nbsp; AN&nbsp; +4</span> Für Teams, die den Überblick behalten wollen.</div>
            </div>

            <div class="dashboard-stage">
                <div class="browser-window">
                    <div class="browser-bar"><i></i><i></i><i></i></div>
                    <img src="/images/DemoImg.png" alt="Warehouse Management Dashboard mit Bestandsübersicht und Lagerbewegungen" />
                </div>
                <div class="float-card card-one"><strong>✓ 100 %</strong><small>Bestandsklarheit</small></div>
                <div class="float-card card-two"><strong>+ 1 System</strong><small>für alle Prozesse</small></div>
            </div>
        </div>
    </section>

    <section class="industry-strip">
        <div class="container strip-inner">
            <p>Eine Plattform für <strong>mehr Kontrolle, weniger Suchaufwand und schnellere Abläufe.</strong></p>
            <div class="logos"><span>GROSSHANDEL</span><span>BAUSTOFFE</span><span>PRODUKTION</span><span>E-COMMERCE</span></div>
        </div>
    </section>

    <section class="section" id="loesung">
        <div class="container">
            <div class="section-heading">
                <span class="eyebrow">Eine Lösung. Viele Möglichkeiten.</span>
                <h2 class="display">Vom Wareneingang bis zum Versand – alles an einem Ort.</h2>
                <p>Schluss mit Excel-Listen, Insellösungen und dem Suchen nach dem aktuellen Bestand. Warehouse Management macht Ihre Lagerprozesse sichtbar, planbar und skalierbar.</p>
            </div>
            <div class="benefits">
                <article class="benefit"><span class="icon-box">▦</span><h3>Ein Bestand. Eine Wahrheit.</h3><p>Sehen Sie jederzeit, was auf Lager ist, wo es liegt und was sich bewegt – in Echtzeit und ohne Rückfragen.</p></article>
                <article class="benefit"><span class="icon-box green">⌘</span><h3>Prozesse, die mitdenken.</h3><p>Wareneingang, Umlagerung, Inventur und Warenausgang: standardisieren Sie Abläufe und reduzieren Sie Fehler.</p></article>
                <article class="benefit"><span class="icon-box orange">✦</span><h3>Bereit für Ihr Wachstum.</h3><p>Starten Sie fokussiert und erweitern Sie flexibel – mit Rollen, Workflows, Excel-Import und Integrationen.</p></article>
            </div>
        </div>
    </section>

    <section class="section industries" id="branchen">
        <div class="container">
            <div class="section-heading">
                <span class="eyebrow">Für Ihre Branche gebaut</span>
                <h2 class="display">Ein System, das Ihre Realität versteht.</h2>
                <p>Ob viele Artikel, schnelle Bewegungen oder komplexe Abläufe: Warehouse Management passt sich an Ihre Prozesse an – nicht umgekehrt.</p>
            </div>
            <div class="industry-grid">
                <article class="industry"><span>01</span><h3>Großhandel</h3><p>Viele Artikel, viele Aufträge, volle Kontrolle. Optimieren Sie Einkauf, Bestand und Lieferung.</p><b>→</b></article>
                <article class="industry"><span>02</span><h3>Baustoffhandel</h3><p>Sperrige Waren und viele Lagerplätze? Behalten Sie Mengen, Orte und Bewegungen im Blick.</p><b>→</b></article>
                <article class="industry"><span>03</span><h3>Ersatzteilhandel</h3><p>Tausende SKUs zuverlässig verwalten. Finden, prüfen und versenden Sie jedes Teil schneller.</p><b>→</b></article>
                <article class="industry"><span>04</span><h3>Produktions-<br />betriebe</h3><p>Material rein, Produktion läuft, Fertigware raus. Bilden Sie Ihren Materialfluss digital ab.</p><b>→</b></article>
                <article class="industry"><span>05</span><h3>Online-Händler</h3><p>Stock, Orders und Fulfillment verbinden – für weniger Fehlbestände und zufriedene Kunden.</p><b>→</b></article>
            </div>
        </div>
    </section>

    <section class="section stats-section">
        <div class="container stats-grid">
            <div><strong>1</strong><span>zentrale Plattform</span></div>
            <div><strong>24/7</strong><span>Bestandsübersicht</span></div>
            <div><strong>100 %</strong><span>Prozessklarheit</span></div>
            <div><strong>5</strong><span>Branchen im Fokus</span></div>
        </div>
    </section>

    <section class="section" id="funktionen">
        <div class="container feature-split">
            <div>
                <span class="eyebrow">Volle Kontrolle im Alltag</span>
                <h2 class="display">Weniger Verwaltung. Mehr Bewegung.</h2>
                <p>Vom ersten Artikel bis zur letzten Lieferung: Ihr Team arbeitet mit klaren Informationen und einfachen Schritten. Das Dashboard zeigt, was wichtig ist – sofort.</p>
                <ul class="checklist">
                    <li>✓ Artikel- &amp; Produktverwaltung</li><li>✓ Lagerplätze &amp; Bestände</li><li>✓ Wareneingang &amp; -ausgang</li><li>✓ Inventur &amp; Bewegungen</li><li>✓ Rollen &amp; Rechte</li><li>✓ Individuelle Workflows</li>
                </ul>
            </div>
            <div class="ops-card"><div class="ops-top"><span>BESTANDSENTWICKLUNG</span><b>● LIVE</b></div><div class="ops-number">96,8 %</div><small>Bestandsgenauigkeit · aktueller Monat</small><div class="bar-chart"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div><div class="chart-label"><span>KW 32</span><span>KW 33</span><span>KW 34</span><span>KW 35</span></div></div>
        </div>
    </section>

    <section class="section workflow-section" id="ablauf">
        <div class="container">
            <div class="section-heading centered-heading">
                <span class="eyebrow">So einfach kann Lager sein</span>
                <h2 class="display">Ein klarer Ablauf für jeden Schritt.</h2>
                <p>Vom Eintreffen der Ware bis zum Versand unterstützt Warehouse Management Ihr Team mit einem durchgängigen Prozess.</p>
            </div>
            <div class="workflow-grid">
                <article class="workflow-step"><span class="step-number">01</span><div class="step-icon">↓</div><h3>Wareneingang</h3><p>Lieferungen erfassen, Mengen prüfen und direkt dem richtigen Lagerplatz zuordnen.</p></article>
                <article class="workflow-step"><span class="step-number">02</span><div class="step-icon">⌘</div><h3>Einlagern &amp; bewegen</h3><p>Bestände umlagern, Plätze organisieren und jede Bewegung nachvollziehbar dokumentieren.</p></article>
                <article class="workflow-step"><span class="step-number">03</span><div class="step-icon">▦</div><h3>Bestand verwalten</h3><p>Artikel, Mindestbestände, Kategorien und Lieferanten in einer aktuellen Übersicht steuern.</p></article>
                <article class="workflow-step"><span class="step-number">04</span><div class="step-icon">↑</div><h3>Warenausgang</h3><p>Aufträge sicher kommissionieren und Waren schnell, korrekt und transparent ausbuchen.</p></article>
            </div>
        </div>
    </section>

    <section class="section modules-section">
        <div class="container modules-grid">
            <div class="module-copy"><span class="eyebrow">Alles, was Ihr Team braucht</span><h2 class="display">Ein System. Viele starke Werkzeuge.</h2><p>Mit klaren Modulen behalten Sie die Kontrolle über Ihre täglichen Abläufe – ohne unnötige Komplexität.</p></div>
            <div class="module-list">
                <div><b>01</b><span><strong>Artikelverwaltung</strong><small>SKU, Kategorien, Einheiten und Mindestbestände</small></span><em>→</em></div>
                <div><b>02</b><span><strong>Lager &amp; Lagerplätze</strong><small>Zonen, Plätze und Bestände auf einen Blick</small></span><em>→</em></div>
                <div><b>03</b><span><strong>Lieferanten &amp; Kunden</strong><small>Stammdaten zentral und sauber organisiert</small></span><em>→</em></div>
                <div><b>04</b><span><strong>Rollen, Rechte &amp; Workflows</strong><small>Jeder sieht und erledigt genau das Richtige</small></span><em>→</em></div>
            </div>
        </div>
    </section>

    <section class="section faq-section" id="faq">
        <div class="container faq-grid">
            <div><span class="eyebrow">Häufige Fragen</span><h2 class="display">Klarheit beginnt mit Antworten.</h2><p>Sie möchten wissen, ob Warehouse Management zu Ihrem Betrieb passt? Hier finden Sie die wichtigsten Antworten.</p><a class="btn btn-ghost" href="#demo">Frage im Demo-Termin klären →</a></div>
            <div class="faq-list">
                <details open><summary>Für welche Unternehmen ist die Lösung geeignet?</summary><p>Für Unternehmen mit eigenem Lager und vielen Artikelbewegungen – vom Großhandel über Baustoff- und Ersatzteilhandel bis zu Produktion und E-Commerce.</p></details>
                <details><summary>Kann ich meine bestehenden Daten übernehmen?</summary><p>Ja. Artikel- und Stammdaten können strukturiert per Excel importiert und Schritt für Schritt geprüft werden.</p></details>
                <details><summary>Kann ich mehrere Benutzer verwalten?</summary><p>Ja. Rollen und Rechte ermöglichen individuelle Zugriffe für Lager, Einkauf, Verkauf, Verwaltung und Management.</p></details>
                <details><summary>Wie läuft die Demo ab?</summary><p>In rund 30 Minuten besprechen wir Ihre Prozesse und zeigen Ihnen anhand Ihres Anwendungsfalls, wie die Lösung unterstützen kann.</p></details>
            </div>
        </div>
    </section>

    <section class="demo" id="demo">
        <div class="container demo-wrap">
            <div class="demo-copy"><span class="eyebrow">Lernen Sie uns kennen</span><h2 class="display">Sehen Sie,<br /><em>was möglich ist.</em></h2><p>In 30 Minuten zeigen wir Ihnen, wie Warehouse Management Ihre Abläufe vereinfachen kann – abgestimmt auf Ihre Branche und Ihre Prozesse.</p><p class="demo-note">◷ Persönlich. Unverbindlich. Auf Deutsch.</p><div class="demo-benefits"><span>✓ Ohne Vorbereitung</span><span>✓ Auf Ihre Branche zugeschnitten</span><span>✓ Konkrete nächste Schritte</span></div></div>
            <div class="form-card">
                <h3>Demo-Termin anfragen</h3><p>Wir melden uns innerhalb eines Werktags bei Ihnen.</p>
                <EditForm Model="DemoRequestItem" OnValidSubmit="SubmitDemo">
                    <DataAnnotationsValidator />
                    <div class="form-grid">
                            <div class="field"><label>Vor- und Nachname *</label><InputText @bind-Value="DemoRequestItem.Name" placeholder="Anna Müller" /><ValidationMessage For="@(() => DemoRequestItem.Name)" /></div>
                            <div class="field"><label>Unternehmen *</label><InputText @bind-Value="DemoRequestItem.Company" placeholder="Muster GmbH" /><ValidationMessage For="@(() => DemoRequestItem.Company)" /></div>
                        <div class="field"><label>Geschäftliche E-Mail *</label><InputText @bind-Value="DemoRequestItem.Email" type="email" placeholder="anna@muster.de" /><ValidationMessage For="@(() => DemoRequestItem.Email)" /></div>
                            <div class="field"><label>Branche</label><InputSelect @bind-Value="DemoRequestItem.Industry"><option>Großhandel</option><option>Baustoffhandel</option><option>Ersatzteilhandel</option><option>Produktionsbetrieb</option><option>Online-Handel / E-Commerce</option><option>Andere</option></InputSelect></div>
                        <div class="field full"><label>Was möchten Sie verbessern?</label><InputTextArea @bind-Value="DemoRequestItem.Message" placeholder="Erzählen Sie uns kurz von Ihrem Lager..." /></div>
                    </div>
                    <button class="btn btn-primary submit-button" type="submit">Demo anfragen <span>→</span></button>
                    @if (Submitted)
                    {
                        <div class="form-success">Vielen Dank! Ihre Anfrage ist eingegangen. Wir melden uns bald.</div>
                    }
                </EditForm>
            </div>
        </div>
    </section>
</main>

<footer><div class="container footer-inner"><span>Warehouse Management</span><div><a href="#loesung">Lösung</a><a href="#branchen">Branchen</a><a href="#funktionen">Funktionen</a><a href="#demo">Demo buchen</a></div><small>© 2026 Warehouse Management</small></div></footer>
</div>

