@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager Navigation
@layout PublicLayout

<PageTitle>Warehouse Management | Lagerverwaltung, die mitwächst</PageTitle>

<div class="page-wrapper">
    <!-- Header Navigation -->
    <header class="header">
        <div class="container header-container">
            <a class="brand" href="#top" aria-label="Warehouse Management Startseite">
                <div class="brand-logo">⌂</div>
                <div class="brand-text">Warehouse<span>Management</span></div>
            </a>

            <nav class="nav-menu @(MenuOpen ? "active" : string.Empty)">
                <a href="#loesung" @onclick="CloseMenu">Lösung</a>
                <a href="#branchen" @onclick="CloseMenu">Branchen</a>
                <a href="#funktionen" @onclick="CloseMenu">Funktionen</a>
                <a href="#ablauf" @onclick="CloseMenu">Ablauf</a>
                <a href="#faq" @onclick="CloseMenu">FAQ</a>
                <a href="#demo" @onclick="CloseMenu">Demo</a>
            </nav>

            <div class="header-actions">
                <span class="language">DE</span>
                <a class="btn btn-primary" href="#demo">Demo buchen <span>→</span></a>
                <button class="mobile-toggle" type="button" aria-label="Menü öffnen" @onclick="ToggleMenu">☰</button>
            </div>
        </div>
    </header>

    <main id="top">
        <!-- Hero Section -->
        <section class="hero">
            <div class="container hero-grid">
                <div class="hero-content">
                    <span class="badge">Die Lagerverwaltung für morgen</span>
                    <h1 class="hero-title">Lager im Griff.<br /><span>Geschäft im Fluss.</span></h1>
                    <p class="hero-subtitle">
                        Warehouse Management bringt Produkte, Bestände, Bestellungen und Menschen in einem System zusammen – damit Ihr Lager mit Ihrem Unternehmen wächst.
                    </p>
                    <div class="hero-actions">
                        <a class="btn btn-primary" href="#demo">Persönliche Demo buchen <span>→</span></a>
                        <a class="btn btn-secondary" href="#funktionen">Mehr erfahren <span>→</span></a>
                    </div>
                    <div class="microproof"><span class="avatars">MK&nbsp; LS&nbsp; AN&nbsp; +4</span> Für Teams, die den Überblick behalten wollen.</div>
                </div>

                <div class="hero-media">
                    <div class="glass-card mockup-card">
                        <img src="/images/DemoImg.png" alt="Warehouse Management Dashboard mit Bestandsübersicht und Lagerbewegungen" class="dashboard-img" />
                        <div class="floating-badge badge-top">
                            <span class="status-dot"></span> ✓ 100 % Bestandsklarheit
                        </div>
                        <div class="floating-badge badge-bottom">
                            + 1 System für alle Prozesse
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Industry Strip -->
        <section class="industry-strip">
            <div class="container strip-inner">
                <p>Eine Plattform für <strong>mehr Kontrolle, weniger Suchaufwand und schnellere Abläufe.</strong></p>
                <div class="logos"><span>GROSSHANDEL</span><span>BAUSTOFFE</span><span>PRODUKTION</span><span>E-COMMERCE</span></div>
            </div>
        </section>

        <!-- Lösung Section -->
        <section class="section" id="loesung">
            <div class="container">
                <div class="section-heading">
                    <span class="section-tag">Eine Lösung. Viele Möglichkeiten.</span>
                    <h2>Vom Wareneingang bis zum Versand – alles an einem Ort.</h2>
                    <p>Schluss mit Excel-Listen, Insellösungen und dem Suchen nach dem aktuellen Bestand. Warehouse Management macht Ihre Lagerprozesse sichtbar, planbar und skalierbar.</p>
                </div>
                <div class="benefits-grid">
                    <article class="benefit-card glass-card">
                        <div class="icon-box">▦</div>
                        <h3>Ein Bestand. Eine Wahrheit.</h3>
                        <p>Sehen Sie jederzeit, was auf Lager ist, wo es liegt und was sich bewegt – in Echtzeit und ohne Rückfragen.</p>
                    </article>
                    <article class="benefit-card glass-card">
                        <div class="icon-box green">⌘</div>
                        <h3>Prozesse, die mitdenken.</h3>
                        <p>Wareneingang, Umlagerung, Inventur und Warenausgang: standardisieren Sie Abläufe und reduzieren Sie Fehler.</p>
                    </article>
                    <article class="benefit-card glass-card">
                        <div class="icon-box orange">✦</div>
                        <h3>Bereit für Ihr Wachstum.</h3>
                        <p>Starten Sie fokussiert und erweitern Sie flexibel – mit Rollen, Workflows, Excel-Import und Integrationen.</p>
                    </article>
                </div>
            </div>
        </section>

        <!-- Branchen Section -->
        <section class="section industries-section" id="branchen">
            <div class="container">
                <div class="section-heading">
                    <span class="section-tag">Für Ihre Branche gebaut</span>
                    <h2>Ein System, das Ihre Realität versteht.</h2>
                    <p>Ob viele Artikel, schnelle Bewegungen oder komplexe Abläufe: Warehouse Management passt sich an Ihre Prozesse an – nicht umgekehrt.</p>
                </div>
                <div class="industry-grid">
                    <article class="industry-card"><span>01</span><h3>Großhandel</h3><p>Viele Artikel, viele Aufträge, volle Kontrolle. Optimieren Sie Einkauf, Bestand und Lieferung.</p><b>→</b></article>
                    <article class="industry-card"><span>02</span><h3>Baustoffhandel</h3><p>Sperrige Waren und viele Lagerplätze? Behalten Sie Mengen, Orte und Bewegungen im Blick.</p><b>→</b></article>
                    <article class="industry-card"><span>03</span><h3>Ersatzteilhandel</h3><p>Tausende SKUs zuverlässig verwalten. Finden, prüfen und versenden Sie jedes Teil schneller.</p><b>→</b></article>
                    <article class="industry-card"><span>04</span><h3>Produktionsbetriebe</h3><p>Material rein, Produktion läuft, Fertigware raus. Bilden Sie Ihren Materialfluss digital ab.</p><b>→</b></article>
                    <article class="industry-card"><span>05</span><h3>Online-Händler</h3><p>Stock, Orders und Fulfillment verbinden – für weniger Fehlbestände und zufriedene Kunden.</p><b>→</b></article>
                </div>
            </div>
        </section>

        <!-- Stats Section -->
        <section class="stats-section">
            <div class="container stats-grid">
                <div><strong>1</strong><span style="color:black;">zentrale Plattform</span></div>
                <div><strong>24/7</strong><span style="color:black;">Bestandsübersicht</span></div>
                <div><strong>100 %</strong><span style="color:black;">Prozessklarheit</span></div>
                <div><strong>5</strong><span style="color:black;">Branchen im Fokus</span></div>
            </div>
        </section>

        <!-- Funktionen Section -->
        <section class="section" id="funktionen">
            <div class="container feature-split">
                <div class="feature-text">
                    <span class="section-tag">Volle Kontrolle im Alltag</span>
                    <h2>Weniger Verwaltung. Mehr Bewegung.</h2>
                    <p>Vom ersten Artikel bis zur letzten Lieferung: Ihr Team arbeitet mit klaren Informationen und einfachen Schritten. Das Dashboard zeigt, was wichtig ist – sofort.</p>
                    <ul class="checklist">
                        <li>✓ Artikel- &amp; Produktverwaltung</li>
                        <li>✓ Lagerplätze &amp; Bestände</li>
                        <li>✓ Wareneingang &amp; -ausgang</li>
                        <li>✓ Inventur &amp; Bewegungen</li>
                        <li>✓ Rollen &amp; Rechte</li>
                        <li>✓ Individuelle Workflows</li>
                    </ul>
                </div>
                <div class="ops-card glass-card">
                    <div class="ops-top"><span>BESTANDSENTWICKLUNG</span><b class="live-tag">● LIVE</b></div>
                    <div class="ops-number">96,8 %</div>
                    <small>Bestandsgenauigkeit · aktueller Monat</small>
                    <div class="bar-chart"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
                    <div class="chart-label"><span>KW 32</span><span>KW 33</span><span>KW 34</span><span>KW 35</span></div>
                </div>
            </div>
        </section>

        <!-- Ablauf Section -->
        <section class="section workflow-section" id="ablauf">
            <div class="container">
                <div class="section-heading centered-heading">
                    <span class="section-tag">So einfach kann Lager sein</span>
                    <h2>Ein klarer Ablauf für jeden Schritt.</h2>
                    <p>Vom Eintreffen der Ware bis zum Versand unterstützt Warehouse Management Ihr Team mit einem durchgängigen Prozess.</p>
                </div>
                <div class="workflow-grid">
                    <article class="workflow-step"><span class="step-number">01</span><div class="step-icon">↓</div><h3>Wareneingang</h3><p>Lieferungen erfassen, Mengen prüfen und direkt dem richtigen Lagerplatz zuordnen.</p></article>
                    <article class="workflow-step"><span class="step-number">02</span><div class="step-icon">⌘</div><h3>Einlagern &amp; bewegen</h3><p>Bestände umlagern, Plätze organisieren und jede Bewegung nachvollziehbar dokumentieren.</p></article>
                    <article class="workflow-step"><span class="step-number">03</span><div class="step-icon">▦</div><h3>Bestand verwalten</h3><p>Artikel, Mindestbestände, Kategorien und Lieferanten in einer aktuellen Übersicht steuern.</p></article>
                    <article class="workflow-step"><span class="step-number">04</span><div class="step-icon">↑</div><h3>Warenausgang</h3><p>Aufträge sicher kommissionieren und Waren schnell, korrekt und transparent ausbuchen.</p></article>
                </div>
            </div>
        </section>

        <!-- Modulen Section -->
        <section class="section modules-section">
            <div class="container modules-grid">
                <div class="module-copy">
                    <span class="section-tag">Alles, was Ihr Team braucht</span>
                    <h2>Ein System. Viele starke Werkzeuge.</h2>
                    <p>Mit klaren Modulen behalten Sie die Kontrolle über Ihre täglichen Abläufe – ohne unnötige Komplexität.</p>
                </div>
                <div class="module-list">
                    <div class="module-item"><b>01</b><span><strong>Artikelverwaltung</strong><small>SKU, Kategorien, Einheiten und Mindestbestände</small></span><em>→</em></div>
                    <div class="module-item"><b>02</b><span><strong>Lager &amp; Lagerplätze</strong><small>Zonen, Plätze und Bestände auf einen Blick</small></span><em>→</em></div>
                    <div class="module-item"><b>03</b><span><strong>Lieferanten &amp; Kunden</strong><small>Stammdaten zentral und sauber organisiert</small></span><em>→</em></div>
                    <div class="module-item"><b>04</b><span><strong>Rollen, Rechte &amp; Workflows</strong><small>Jeder sieht und erledigt genau das Richtige</small></span><em>→</em></div>
                </div>
            </div>
        </section>

        <!-- FAQ Section -->
        <section class="section faq-section" id="faq">
            <div class="container faq-grid">
                <div>
                    <span class="section-tag">Häufige Fragen</span>
                    <h2>Klarheit beginnt mit Antworten.</h2>
                    <p>Sie möchten wissen, ob Warehouse Management zu Ihrem Betrieb passt? Hier finden Sie die wichtigsten Antworten.</p>
                    <a class="btn btn-secondary" href="#demo">Frage im Demo-Termin klären →</a>
                </div>
                <div class="faq-list">
                    <details open><summary>Für welche Unternehmen ist die Lösung geeignet?</summary><p>Für Unternehmen mit eigenem Lager und vielen Artikelbewegungen – vom Großhandel über Baustoff- und Ersatzteilhandel bis zu Produktion und E-Commerce.</p></details>
                    <details><summary>Kann ich meine bestehenden Daten übernehmen?</summary><p>Ja. Artikel- und Stammdaten können strukturiert per Excel importiert und Schritt für Schritt geprüft werden.</p></details>
                    <details><summary>Kann ich mehrere Benutzer verwalten?</summary><p>Ja. Rollen und Rechte ermöglichen individuelle Zugriffe für Lager, Einkauf, Verkauf, Verwaltung und Management.</p></details>
                    <details><summary>Wie läuft die Demo ab?</summary><p>In rund 30 Minuten besprechen wir Ihre Prozesse und zeigen Ihnen anhand Ihres Anwendungsfalls, wie die Lösung unterstützen kann.</p></details>
                </div>
            </div>
        </section>

        <!-- Demo Form Section -->
        <section class="demo-section" id="demo">
            <div class="container">
                <div class="demo-wrapper">
                    <div class="demo-info">
                        <span class="section-tag">Lernen Sie uns kennen</span>
                        <h2>Sehen Sie, <em>was möglich ist.</em></h2>
                        <p>In 30 Minuten zeigen wir Ihnen, wie Warehouse Management Ihre Abläufe vereinfachen kann – abgestimmt auf Ihre Branche und Ihre Prozesse.</p>
                        <p class="demo-note">◷ Persönlich. Unverbindlich. Auf Deutsch.</p>
                        <div class="demo-benefits">
                            <span>✓ Ohne Vorbereitung</span>
                            <span>✓ Auf Ihre Branche zugeschnitten</span>
                            <span>✓ Konkrete nächste Schritte</span>
                        </div>
                    </div>

                    <div class="demo-card glass-card">
                        <h3>Demo-Termin anfragen</h3>
                        <p class="card-subtitle">Wir melden uns innerhalb eines Werktags bei Ihnen.</p>

                        <EditForm Model="DemoRequestItem" OnValidSubmit="SubmitDemo" FormName="SubmitDemoForm"  OnInvalidSubmit="InvalidForm">
                            <DataAnnotationsValidator />

                            <div class="form-group">
                                <label>Vor- und Nachname *</label>
                                <InputText @bind-Value="DemoRequestItem.Name" class="form-control" placeholder="Anna Müller" />
                                <ValidationMessage For="@(() => DemoRequestItem.Name)" class="val-msg" />
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label>Unternehmen *</label>
                                    <InputText @bind-Value="DemoRequestItem.Company" class="form-control" placeholder="Muster GmbH" />
                                    <ValidationMessage For="@(() => DemoRequestItem.Company)" class="val-msg" />
                                </div>

                                <div class="form-group">
                                    <label>Geschäftliche E-Mail *</label>
                                    <InputText @bind-Value="DemoRequestItem.Email" type="email" class="form-control" placeholder="anna@muster.de" />
                                    <ValidationMessage For="@(() => DemoRequestItem.Email)" class="val-msg" />
                                </div>
                            </div>

                            <div class="form-group">
                                <label>Branche</label>
                                <InputSelect @bind-Value="DemoRequestItem.Industry" class="form-control">
                                    <option value="">Bitte auswählen...</option>
                                    <option value="Großhandel">Großhandel</option>
                                    <option value="Baustoffhandel">Baustoffhandel</option>
                                    <option value="Ersatzteilhandel">Ersatzteilhandel</option>
                                    <option value="Produktionsbetrieb">Produktionsbetrieb</option>
                                    <option value="Online-Handel / E-Commerce">Online-Handel / E-Commerce</option>
                                    <option value="Andere">Andere</option>
                                </InputSelect>
                            </div>

                            <div class="form-group">
                                <label>Was möchten Sie verbessern?</label>
                                <InputTextArea @bind-Value="DemoRequestItem.Message" class="form-control textarea" placeholder="Erzählen Sie uns kurz von Ihrem Lager..." />
                            </div>

                            <button type="submit" class="btn btn-primary btn-full">
                                Demo anfragen <span>→</span>
                            </button>

                            @if (Submitted)
                            {
                                <div class="alert alert-success">
                                    Vielen Dank! Ihre Anfrage ist eingegangen. Wir melden uns bald.
                                </div>
                            }
                        </EditForm>
                        @if (!string.IsNullOrWhiteSpace(EmailError))
                        {
                            <div class="alert alert-danger" style="white-space: pre-wrap;">
                                @EmailError
                            </div>
                        }

                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer>
        <div class="container footer-inner">
            <span>Warehouse Management</span>
            <div class="footer-links">
                <a href="#loesung">Lösung</a>
                <a href="#branchen">Branchen</a>
                <a href="#funktionen">Funktionen</a>
                <a href="#demo">Demo buchen</a>
            </div>
            <small>© 2026 Warehouse Management</small>
        </div>
    </footer>
</div>
