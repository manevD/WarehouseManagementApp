                 id="loesung">

            <div class="container">

                <div class="section-heading">

                    <span class="section-tag">
                        Mehr als eine Lagerliste
                    </span>


                    <h2>
                        Vom Einkauf bis zum Warenausgang –
                        alles miteinander verbunden.
                    </h2>


                    <p>

                        Moderne Lagerverwaltung bedeutet nicht nur,
                        den aktuellen Bestand zu kennen.
                        Sie bedeutet, jeden relevanten Prozess
                        miteinander zu verbinden.

                    </p>

                </div>


                <div class="benefits-grid">


                    <article class="benefit-card glass-card">

                        <div class="icon-box">
                            ▦
                        </div>

                        <h3>
                            Ein zentraler Datenbestand
                        </h3>

                        <p>

                            Produkte, Kategorien, Lager,
                            Lagerplätze, Lieferanten, Kunden
                            und Bestellungen werden zentral
                            verwaltet.

                        </p>

                    </article>



                    <article class="benefit-card glass-card">

                        <div class="icon-box green">
                            ↔
                        </div>

                        <h3>
                            Jeder Warenfluss nachvollziehbar
                        </h3>

                        <p>

                            Wareneingänge, Warenausgänge,
                            Umlagerungen, Korrekturen und
                            Inventuren werden dokumentiert.

                        </p>

                    </article>



                    <article class="benefit-card glass-card">

                        <div class="icon-box orange">
                            ◈
                        </div>

                        <h3>
                            Informationen für Entscheidungen
                        </h3>

                        <p>

                            Bestandsberichte, Lagerwert,
                            Bewegungen, Niedrigbestände,
                            Produkte und Lieferanten
                            übersichtlich auswerten.

                        </p>

                    </article>

                </div>

            </div>

        </section>



        <!-- =========================================================
             COMPLETE WAREHOUSE FLOW
             ========================================================= -->

        <section class="section workflow-section"
                 id="prozesse">

            <div class="container">

                <div class="section-heading centered-heading">

                    <span class="section-tag">
                        Der komplette Warenfluss
                    </span>


                    <h2>
                        Ein durchgängiger Prozess statt
                        vieler Einzellösungen.
                    </h2>


                    <p>

                        Jeder Schritt baut auf dem vorherigen auf.
                        So bleibt Ihr Bestand nachvollziehbar
                        und Ihre Mitarbeiter arbeiten mit denselben Daten.

                    </p>

                </div>


                <div class="workflow-grid">


                    <article class="workflow-step">

                        <span class="step-number">
                            01
                        </span>

                        <div class="step-icon">
                            ↓
                        </div>

                        <h3>
                            Einkauf
                        </h3>

                        <p>

                            Lieferanten verwalten,
                            Bestellungen erstellen und
                            benötigte Waren planen.

                        </p>

                    </article>



                    <article class="workflow-step">

                        <span class="step-number">
                            02
                        </span>

                        <div class="step-icon">
                            📦
                        </div>

                        <h3>
                            Wareneingang
                        </h3>

                        <p>

                            Gelieferte Mengen erfassen
                            und Waren dem richtigen
                            Lager beziehungsweise Lagerplatz zuordnen.

                        </p>

                    </article>



                    <article class="workflow-step">

                        <span class="step-number">
                            03
                        </span>

                        <div class="step-icon">
                            ⌖
                        </div>

                        <h3>
                            Einlagern
                        </h3>

                        <p>

                            Bestände gezielt auf Lagerplätze
                            verteilen und jederzeit wissen,
                            wo sich ein Artikel befindet.

                        </p>

                    </article>



                    <article class="workflow-step">

                        <span class="step-number">
                            04
                        </span>

                        <div class="step-icon">
                            ↔
                        </div>

                        <h3>
                            Umlagern
                        </h3>

                        <p>

                            Waren zwischen Lagerplätzen
                            oder Lagern bewegen und jede
                            Bewegung dokumentieren.

                        </p>

                    </article>



                    <article class="workflow-step">

                        <span class="step-number">
                            05
                        </span>

                        <div class="step-icon">
                            ☷
                        </div>

                        <h3>
                            Bestellung
                        </h3>

                        <p>

                            Kundenbestellungen verwalten,
                            Positionen prüfen und verfügbare
                            Bestände berücksichtigen.

                        </p>

                    </article>



                    <article class="workflow-step">

                        <span class="step-number">
                            06
                        </span>

                        <div class="step-icon">
                            ↑
                        </div>

                        <h3>
                            Warenausgang
                        </h3>

                        <p>

                            Waren kontrolliert ausbuchen
                            und den Bestand automatisch
                            aktuell halten.

                        </p>

                    </article>

                </div>

            </div>

        </section>



