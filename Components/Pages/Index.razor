@page "/"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Forms

@inject NavigationManager Navigation

@layout PublicLayout

<PageTitle>Warehouse Management | Die digitale Lösung für moderne Lager</PageTitle>


<div class="page-wrapper">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <header class="header">

        <div class="container header-container">

            <a class="brand"
               href="#top"
               aria-label="Warehouse Management Startseite">

                <div class="brand-logo">
                    W
                </div>

                <div class="brand-text">
                    Warehouse<span>Management</span>
                </div>

            </a>


            <nav class="nav-menu @(MenuOpen ? "active" : string.Empty)">

                <a href="#loesung"
                   @onclick="CloseMenu">
                    Lösung
                </a>

                <a href="#funktionen"
                   @onclick="CloseMenu">
                    Funktionen
                </a>

                <a href="#prozesse"
                   @onclick="CloseMenu">
                    Prozesse
                </a>

                <a href="#branchen"
                   @onclick="CloseMenu">
                    Branchen
                </a>

                <a href="#reports"
                   @onclick="CloseMenu">
                    Reports
                </a>

                <a href="#faq"
                   @onclick="CloseMenu">
                    FAQ
                </a>

            </nav>


            <div class="header-actions">

                <span class="language">
                    DE
                </span>

                <a class="btn btn-primary"
                   href="#demo">

                    Demo buchen
                    <span>→</span>

                </a>


                <button class="mobile-toggle"
                        type="button"
                        aria-label="Menü öffnen"
                        @onclick="ToggleMenu">

                    ☰

                </button>

            </div>

        </div>

    </header>



    <main id="top">


        <!-- =========================================================
             HERO
             ========================================================= -->

        <section class="hero">

            <div class="container hero-grid">

                <div class="hero-content">

                    <span class="badge">
                        Digitale Lagerverwaltung für moderne Unternehmen
                    </span>


                    <h1 class="hero-title">

                        Ihr Lager.
                        <br />

                        <span>
                            Ein System. Volle Kontrolle.
                        </span>

                    </h1>


                    <p class="hero-subtitle">

                        Warehouse Management verbindet Produkte, Lager,
                        Lagerplätze, Bestände, Einkauf, Bestellungen,
                        Wareneingang, Warenausgang und Inventur
                        in einer zentralen Plattform.

                    </p>


                    <div class="hero-actions">

                        <a class="btn btn-primary"
                           href="#demo">

                            Persönliche Demo buchen
                            <span>→</span>

                        </a>


                        <a class="btn btn-secondary"
                           href="#funktionen">

                            Funktionen entdecken
                            <span>→</span>

                        </a>

                    </div>


                    <div class="microproof">

                        <span class="avatars">
                            Lager&nbsp;&nbsp;Einkauf&nbsp;&nbsp;Verkauf&nbsp;&nbsp;Management
                        </span>

                        <span>
                            Eine Plattform für Ihre täglichen Prozesse.
                        </span>

                    </div>

                </div>



                <div class="hero-media">

                    <div class="glass-card mockup-card">

                        <img src="/images/DemoImg.png"
                             alt="Warehouse Management Dashboard"
                             class="dashboard-img" />


                        <div class="floating-badge badge-top">

                            <span class="status-dot"></span>

                            Bestände jederzeit im Blick

                        </div>


                        <div class="floating-badge badge-bottom">

                            ✓ Einkauf · Lager · Verkauf · Reports

                        </div>

                    </div>

                </div>

            </div>

        </section>



        <!-- =========================================================
             TRUST / INTRO
             ========================================================= -->

        <section class="industry-strip">

            <div class="container strip-inner">

                <p>
                    Eine zentrale Plattform für
                    <strong>
                        strukturierte Lagerprozesse,
                        aktuelle Bestände und klare Entscheidungen.
                    </strong>
                </p>


                <div class="logos">

                    <span>GROSSHANDEL</span>
                    <span>BAUSTOFFHANDEL</span>
                    <span>ERSATZTEILE</span>
                    <span>PRODUKTION</span>
                    <span>E-COMMERCE</span>

                </div>

            </div>

        </section>



        <!-- =========================================================
             PROBLEM / SOLUTION
             ========================================================= -->

