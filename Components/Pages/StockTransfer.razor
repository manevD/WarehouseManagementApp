@page "/stock/transfer"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using WarehouseManagement.Data
@using WarehouseManagement.Localization
@using WarehouseManagement.Models

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["StockTransfer"]</PageTitle>

<div class="product-form-page">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="page-header">

        <div>

            <h1>@L["StockTransfer"]</h1>

            <p>
                @L["StockTransferDescription"]
            </p>

        </div>

        <a href="/stock"
           class="btn-secondary">

            ← @L["Back"]

        </a>

    </div>


    <div class="form-card">

        <EditForm Model="@Model"
                  OnValidSubmit="@BookTransfer"
                  FormName="StockTransferForm">

            <DataAnnotationsValidator />


            <!-- =====================================================
                 UMLAGERUNG
                 ===================================================== -->

            <div class="form-section">

                <div class="form-section-title">

                    <h2>@L["StockTransfer"]</h2>

                    <p>
                        @L["SelectProductSourceTarget"]
                    </p>

                </div>


                <div class="form-grid">


                    <!-- =================================================
                         PRODUKT
                         ================================================= -->

                    <div class="form-group">

                        <label>
                            @L["Product"] <span>*</span>
                        </label>

                        <select class="form-control"
                                value="@Model.ProductId"
                                @onchange="OnProductChanged">

                            <option value="0">
                                @L["SelectProduct"]
                            </option>

                            @foreach (var product in Products)
                            {
                                <option value="@product.Id">
                                    @product.SKU - @product.Name
                                </option>
                            }

                        </select>

                        <ValidationMessage For="@(() => Model.ProductId)" />

                    </div>


                    <!-- =================================================
                         VON LAGER
                         ================================================= -->

                    <div class="form-group">

                        <label>
                            @L["FromWarehouse"] <span>*</span>
                        </label>

                        <select class="form-control"
                                value="@Model.FromWarehouseId"
                                @onchange="OnFromWarehouseChanged"
                                disabled="@(Model.ProductId <= 0)">

                            <option value="0">
                                @L["SelectWarehouse"]
                            </option>

                            @foreach (var warehouse in FromWarehouses)
                            {
                                <option value="@warehouse.Id">
                                    @warehouse.Name
                                </option>
                            }

                        </select>

                        <ValidationMessage For="@(() => Model.FromWarehouseId)" />

                    </div>


                    <!-- =================================================
                         VON LAGERPLATZ
                         ================================================= -->

                    <div class="form-group">

                        <label>
                            @L["FromLocation"] <span>*</span>
                        </label>

                        <select class="form-control"
                                value="@Model.FromWarehouseLocationId"
                                @onchange="OnFromLocationChanged"
                                disabled="@(Model.FromWarehouseId <= 0)">

                            <option value="0">
                                @L["SelectLocation"]
                            </option>

                            @foreach (var location in FromLocations)
                            {
                                <option value="@location.Id">

                                    @location.Code

                                    @if (!string.IsNullOrWhiteSpace(location.Name))
                                    {
                                        @($" - {location.Name}")
                                    }

                                </option>
                            }

                        </select>

                        @if (Model.FromWarehouseId > 0 &&
                             FromLocations.Count == 0)
                        {
                            <div class="form-hint">
                                @L["NoAvailableStockAtWarehouse"]
                            </div>
                        }

                        <ValidationMessage For="@(() => Model.FromWarehouseLocationId)" />

                    </div>


                    <!-- =================================================
                         VERFÜGBARER BESTAND
                         ================================================= -->

                    <div class="form-group">

                        <label>
                            @L["AvailableStock"]
                        </label>

                        <input class="form-control"
                               value="@AvailableStock.ToString("N2")"
                               readonly />

                    </div>


                    <!-- =================================================
                         MENGE
                         ================================================= -->

                    <div class="form-group">

                        <label>
                            @L["Quantity"] <span>*</span>
                        </label>

                        <InputNumber @bind-Value="Model.Quantity"
                                     class="form-control"
                                     step="0.01"
                                     min="0.01"
                                     disabled="@(Model.FromWarehouseLocationId <= 0)" />

                        <ValidationMessage For="@(() => Model.Quantity)" />

                        @if (Model.Quantity > AvailableStock &&
                             Model.FromWarehouseLocationId > 0)
                        {
                            <div class="form-error">

                                @L["QuantityExceedsAvailableStock"]

                            </div>
                        }

                    </div>


                    <!-- =================================================
                         NACH LAGER
                         ================================================= -->

                    <div class="form-group">

                        <label>
                            @L["ToWarehouse"] <span>*</span>
                        </label>

                        <select class="form-control"
                                value="@Model.ToWarehouseId"
                                @onchange="OnToWarehouseChanged"
                                disabled="@(Model.ProductId <= 0)">

                            <option value="0">
                                @L["SelectWarehouse"]
                            </option>

                            @foreach (var warehouse in Warehouses)
                            {
                                <option value="@warehouse.Id">
                                    @warehouse.Name
                                </option>
                            }

                        </select>

                        <ValidationMessage For="@(() => Model.ToWarehouseId)" />

                    </div>


                    <!-- =================================================
                         NACH LAGERPLATZ
                         ================================================= -->

                    <div class="form-group">

                        <label>
                            @L["ToLocation"] <span>*</span>
                        </label>

                        <select class="form-control"
                                value="@Model.ToWarehouseLocationId"
                                @onchange="OnToLocationChanged"
                                disabled="@(Model.ToWarehouseId <= 0)">

                            <option value="0">
                                @L["SelectLocation"]
                            </option>

                            @foreach (var location in ToLocations)
                            {
                                <option value="@location.Id">

                                    @location.Code

                                    @if (!string.IsNullOrWhiteSpace(location.Name))
                                    {
                                        @($" - {location.Name}")
                                    }

                                </option>
                            }

                        </select>

                        <ValidationMessage For="@(() => Model.ToWarehouseLocationId)" />

                    </div>


                    <!-- =================================================
                         REFERENZ
                         ================================================= -->

                    <div class="form-group">

                        <label>
                            @L["ReferenceNumber"]
                        </label>

                        <InputText @bind-Value="Model.ReferenceNumber"
                                   class="form-control"
                                   placeholder="@L["ReferenceNumberPlaceholder"]" />

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 NOTE
                 ===================================================== -->

            <div class="form-section">

                <div class="form-section-title">

                    <h2>@L["Note"]</h2>

                    <p>
                        @L["OptionalTransferInformation"]
                    </p>

                </div>

                <div class="form-group">

                    <InputTextArea @bind-Value="Model.Note"
                                   class="form-control textarea"
                                   rows="4"
                                   placeholder="@L["NotePlaceholder"]" />

                </div>

            </div>


            <!-- =====================================================
                 ERROR
                 ===================================================== -->
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="form-error">
                    @ErrorMessage
                </div>
            }


            <!-- =====================================================
                 SUCCESS
                 ===================================================== -->
            @if (!string.IsNullOrWhiteSpace(SuccessMessage))
            {
                <div class="form-success">
                    @SuccessMessage
                </div>
            }


            <!-- =====================================================
                 ACTIONS
                 ===================================================== -->

            <div class="form-actions">

                <a href="/stock"
                   class="btn-secondary">

                    @L["Cancel"]

                </a>

                <button type="submit"
                        class="btn-primary"
                        disabled="@IsSaving">

                    @(IsSaving
                        ? L["Booking"]
                        : L["BookTransfer"])

                </button>

            </div>

        </EditForm>

    </div>

</div>


@code {

    // =========================================================
    // DATA
    // =========================================================

    private TransferModel Model = new();

    private List<Product> Products = new();

    private List<Warehouse> Warehouses = new();

    private List<Warehouse> FromWarehouses = new();

    private List<WarehouseLocation> FromLocations = new();

    private List<WarehouseLocation> ToLocations = new();


    // =========================================================
    // STATE
    // =========================================================

    private decimal AvailableStock;

    private bool IsSaving;

    private string? ErrorMessage;

    private string? SuccessMessage;


    // =========================================================
    // INITIAL LOAD
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        await using var db =
            await DbFactory.CreateDbContextAsync();


        Products =
            await db.Products
                .Where(x =>
                    x.IsActive)
                .OrderBy(x =>
                    x.Name)
                .ToListAsync();


        // Destination warehouses and locations
        // are loaded after product selection.

        Warehouses.Clear();

        FromWarehouses.Clear();

        FromLocations.Clear();

        ToLocations.Clear();
    }


    // =========================================================
    // PRODUCT CHANGED
    // =========================================================

    private async Task OnProductChanged(
        ChangeEventArgs e)
    {
        ErrorMessage = null;

        SuccessMessage = null;

        AvailableStock = 0;


        // =====================================================
        // PRODUCT ID
        // =====================================================

        if (!int.TryParse(
                e.Value?.ToString(),
                out var productId))
        {
            productId = 0;
        }


        Model.ProductId =
            productId;


        // =====================================================
        // RESET SOURCE
        // =====================================================

        Model.FromWarehouseId =
            0;

        Model.FromWarehouseLocationId =
            0;


        // =====================================================
        // RESET TARGET
        // =====================================================

        Model.ToWarehouseId =
            0;

        Model.ToWarehouseLocationId =
            0;


        Model.Quantity =
            0;


        FromWarehouses.Clear();

        FromLocations.Clear();

        Warehouses.Clear();

        ToLocations.Clear();


        // =====================================================
        // NO PRODUCT
        // =====================================================

        if (Model.ProductId <= 0)
        {
            StateHasChanged();

            return;
        }


        await using var db =
            await DbFactory.CreateDbContextAsync();


        // =====================================================
        // SOURCE WAREHOUSES
        //
        // Only warehouses where the selected product
        // has at least one active location with
        // available stock.
        // =====================================================

        FromWarehouses =
            await db.Warehouses
                .Where(warehouse =>

                    warehouse.IsActive

                    &&

                    db.WarehouseLocations.Any(location =>

                        location.IsActive

                        &&

                        location.WarehouseId ==
                            warehouse.Id

                        &&

                        db.Stocks.Any(stock =>

                            stock.ProductId ==
                                Model.ProductId

                            &&

                            stock.WarehouseLocationId ==
                                location.Id

                            &&

                            stock.Quantity >
                                stock.ReservedQuantity

                        )

                    )

                )
                .OrderBy(warehouse =>
                    warehouse.Name)
                .ToListAsync();


        // =====================================================
        // TARGET WAREHOUSES
        //
        // All active warehouses can be selected.
        // =====================================================

        Warehouses =
            await db.Warehouses
                .Where(x =>
                    x.IsActive)
                .OrderBy(x =>
                    x.Name)
                .ToListAsync();


        StateHasChanged();
    }


    // =========================================================
    // SOURCE WAREHOUSE CHANGED
    // =========================================================

    private async Task OnFromWarehouseChanged(
        ChangeEventArgs e)
    {
        ErrorMessage = null;

        SuccessMessage = null;


        if (!int.TryParse(
                e.Value?.ToString(),
                out var warehouseId))
        {
            warehouseId = 0;
        }


        Model.FromWarehouseId =
            warehouseId;


        Model.FromWarehouseLocationId =
            0;


        AvailableStock =
            0;


        Model.Quantity =
            0;


        FromLocations.Clear();


        if (warehouseId <= 0 ||
            Model.ProductId <= 0)
        {
            StateHasChanged();

            return;
        }


        // Make sure the selected warehouse
        // is actually available for the product.

        if (!FromWarehouses.Any(x =>
                x.Id == warehouseId))
        {
            Model.FromWarehouseId = 0;

            StateHasChanged();

            return;
        }


        await using var db =
            await DbFactory.CreateDbContextAsync();


        // =====================================================
        // SOURCE LOCATIONS
        //
        // Only locations where the selected product
        // has available stock.
        // =====================================================

        FromLocations =
            await db.WarehouseLocations
                .Where(location =>

                    location.IsActive

                    &&

                    location.WarehouseId ==
                        warehouseId

                    &&

                    db.Stocks.Any(stock =>

                        stock.ProductId ==
                            Model.ProductId

                        &&

                        stock.WarehouseLocationId ==
                            location.Id

                        &&

                        stock.Quantity >
                            stock.ReservedQuantity

                    )

                )
                .OrderBy(location =>
                    location.Code)
                .ToListAsync();


        StateHasChanged();
    }


    // =========================================================
    // SOURCE LOCATION CHANGED
    // =========================================================

    private async Task OnFromLocationChanged(
        ChangeEventArgs e)
    {
        ErrorMessage = null;

        SuccessMessage = null;


        if (!int.TryParse(
                e.Value?.ToString(),
                out var locationId))
        {
            locationId = 0;
        }


        // Make sure the selected location
        // belongs to the selected source warehouse.

        if (locationId > 0 &&
            !FromLocations.Any(x =>
                x.Id == locationId))
        {
            locationId = 0;
        }


        Model.FromWarehouseLocationId =
            locationId;


        AvailableStock =
            0;


        Model.Quantity =
            0;


        if (locationId <= 0 ||
            Model.ProductId <= 0)
        {
            StateHasChanged();

            return;
        }


        await LoadAvailableStock();


        StateHasChanged();
    }


    // =========================================================
    // TARGET WAREHOUSE CHANGED
    // =========================================================

    private async Task OnToWarehouseChanged(
        ChangeEventArgs e)
    {
        ErrorMessage = null;

        SuccessMessage = null;


        if (!int.TryParse(
                e.Value?.ToString(),
                out var warehouseId))
        {
            warehouseId = 0;
        }


        Model.ToWarehouseId =
            warehouseId;


        Model.ToWarehouseLocationId =
            0;


        ToLocations.Clear();


        if (warehouseId <= 0)
        {
            StateHasChanged();

            return;
        }


        // Make sure the selected warehouse is active.

        if (!Warehouses.Any(x =>
                x.Id == warehouseId))
        {
            Model.ToWarehouseId = 0;

            StateHasChanged();

            return;
        }


        await using var db =
            await DbFactory.CreateDbContextAsync();


        // =====================================================
        // ALL ACTIVE TARGET LOCATIONS
        // =====================================================

        ToLocations =
            await db.WarehouseLocations
                .Where(location =>

                    location.IsActive

                    &&

                    location.WarehouseId ==
                        warehouseId

                )
                .OrderBy(location =>
                    location.Code)
                .ToListAsync();


        StateHasChanged();
    }


    // =========================================================
    // TARGET LOCATION CHANGED
    // =========================================================

    private Task OnToLocationChanged(
        ChangeEventArgs e)
    {
        if (int.TryParse(
                e.Value?.ToString(),
                out var locationId))
        {
            // Make sure the location is one
            // of the currently loaded target locations.

            if (locationId > 0 &&
                !ToLocations.Any(x =>
                    x.Id == locationId))
            {
                locationId = 0;
            }

            Model.ToWarehouseLocationId =
                locationId;
        }
        else
        {
            Model.ToWarehouseLocationId =
                0;
        }


        ErrorMessage = null;

        SuccessMessage = null;


        StateHasChanged();


        return Task.CompletedTask;
    }


    // =========================================================
    // LOAD AVAILABLE STOCK
    // =========================================================

    private async Task LoadAvailableStock()
    {
        AvailableStock =
            0;


        if (Model.ProductId <= 0 ||
            Model.FromWarehouseLocationId <= 0)
        {
            return;
        }


        await using var db =
            await DbFactory.CreateDbContextAsync();


        var stock =
            await db.Stocks
                .FirstOrDefaultAsync(x =>

                    x.ProductId ==
                        Model.ProductId

                    &&

                    x.WarehouseLocationId ==
                        Model.FromWarehouseLocationId

                );


        if (stock != null)
        {
            AvailableStock =
                stock.AvailableQuantity;
        }
    }


    // =========================================================
    // BOOK TRANSFER
    // =========================================================

    private async Task BookTransfer()
    {
        if (IsSaving)
            return;


        IsSaving = true;

        ErrorMessage = null;

        SuccessMessage = null;


        try
        {
            // =================================================
            // PRODUCT
            // =================================================

            if (Model.ProductId <= 0)
            {
                ErrorMessage =
                    L["ProductSelectionRequired"];

                return;
            }


            // =================================================
            // SOURCE WAREHOUSE
            // =================================================

            if (Model.FromWarehouseId <= 0)
            {
                ErrorMessage =
                    L["SourceWarehouseSelectionRequired"];

                return;
            }


            // =================================================
            // SOURCE LOCATION
            // =================================================

            if (Model.FromWarehouseLocationId <= 0)
            {
                ErrorMessage =
                    L["SourceLocationSelectionRequired"];

                return;
            }


            // =================================================
            // TARGET WAREHOUSE
            // =================================================

            if (Model.ToWarehouseId <= 0)
            {
                ErrorMessage =
                    L["TargetWarehouseSelectionRequired"];

                return;
            }


            // =================================================
            // TARGET LOCATION
            // =================================================

            if (Model.ToWarehouseLocationId <= 0)
            {
                ErrorMessage =
                    L["TargetLocationSelectionRequired"];

                return;
            }


            // =================================================
            // SAME LOCATION
            // =================================================

            if (Model.FromWarehouseLocationId ==
                Model.ToWarehouseLocationId)
            {
                ErrorMessage =
                    L["SameLocationError"];

                return;
            }


            // =================================================
            // QUANTITY
            // =================================================

            if (Model.Quantity <= 0)
            {
                ErrorMessage =
                    L["QuantityMustBeGreaterThanZero"];

                return;
            }


            await using var db =
                await DbFactory.CreateDbContextAsync();


            // =================================================
            // PRODUCT
            // =================================================

            var product =
                await db.Products
                    .FirstOrDefaultAsync(x =>
                        x.Id == Model.ProductId &&
                        x.IsActive);


            if (product == null)
            {
                ErrorMessage =
                    L["SelectedProductNotFound"];

                return;
            }


            // =================================================
            // SOURCE WAREHOUSE
            // =================================================

            var sourceWarehouse =
                await db.Warehouses
                    .FirstOrDefaultAsync(x =>
                        x.Id == Model.FromWarehouseId &&
                        x.IsActive);


            if (sourceWarehouse == null)
            {
                ErrorMessage =
                    L["SelectedWarehouseNotFound"];

                return;
            }


            // =================================================
            // TARGET WAREHOUSE
            // =================================================

            var targetWarehouse =
                await db.Warehouses
                    .FirstOrDefaultAsync(x =>
                        x.Id == Model.ToWarehouseId &&
                        x.IsActive);


            if (targetWarehouse == null)
            {
                ErrorMessage =
                    L["SelectedWarehouseNotFound"];

                return;
            }


            // =================================================
            // SOURCE STOCK
            // =================================================

            var sourceStock =
                await db.Stocks
                    .FirstOrDefaultAsync(x =>

                        x.ProductId ==
                            Model.ProductId

                        &&

                        x.WarehouseLocationId ==
                            Model.FromWarehouseLocationId

                    );


            if (sourceStock == null)
            {
                ErrorMessage =
                    L["NoStockAtSourceLocation"];

                return;
            }


            // =================================================
            // AVAILABLE STOCK
            // =================================================

            var available =
                sourceStock.AvailableQuantity;


            if (available <= 0)
            {
                ErrorMessage =
                    L["NoAvailableStockAtSourceLocation"];

                return;
            }


            if (Model.Quantity > available)
            {
                ErrorMessage =
                    L[
                        "InsufficientAvailableStock",
                        available.ToString("N2")
                    ];

                return;
            }


            // =================================================
            // SOURCE LOCATION
            // =================================================

            var fromLocation =
                await db.WarehouseLocations
                    .FirstOrDefaultAsync(x =>

                        x.Id ==
                            Model.FromWarehouseLocationId

                        &&

                        x.WarehouseId ==
                            Model.FromWarehouseId

                        &&

                        x.IsActive

                    );


            if (fromLocation == null)
            {
                ErrorMessage =
                    L["SourceLocationNotFound"];

                return;
            }


            // =================================================
            // TARGET LOCATION
            // =================================================

            var toLocation =
                await db.WarehouseLocations
                    .FirstOrDefaultAsync(x =>

                        x.Id ==
                            Model.ToWarehouseLocationId

                        &&

                        x.WarehouseId ==
                            Model.ToWarehouseId

                        &&

                        x.IsActive

                    );


            if (toLocation == null)
            {
                ErrorMessage =
                    L["TargetLocationNotFound"];

                return;
            }


            // =================================================
            // TARGET STOCK
            // =================================================

            var targetStock =
                await db.Stocks
                    .FirstOrDefaultAsync(x =>

                        x.ProductId ==
                            Model.ProductId

                        &&

                        x.WarehouseLocationId ==
                            Model.ToWarehouseLocationId

                    );


            // =================================================
            // TRANSACTION
            // =================================================

            await using var transaction =
                await db.Database
                    .BeginTransactionAsync();


            try
            {
                // =============================================
                // REMOVE FROM SOURCE
                // =============================================

                sourceStock.Quantity -=
                    Model.Quantity;

                sourceStock.UpdatedAt =
                    DateTime.UtcNow;


                // =============================================
                // ADD TO TARGET
                // =============================================

                if (targetStock == null)
                {
                    targetStock =
                        new Stock
                        {
                            ProductId =
                                Model.ProductId,

                            WarehouseLocationId =
                                Model.ToWarehouseLocationId,

                            Quantity =
                                Model.Quantity,

                            ReservedQuantity =
                                0,

                            UpdatedAt =
                                DateTime.UtcNow
                        };

                    db.Stocks.Add(
                        targetStock);
                }
                else
                {
                    targetStock.Quantity +=
                        Model.Quantity;

                    targetStock.UpdatedAt =
                        DateTime.UtcNow;
                }


                // =============================================
                // STOCK MOVEMENT
                // =============================================

                var movement =
                    new StockMovement
                    {
                        ProductId =
                            Model.ProductId,

                        Quantity =
                            Model.Quantity,

                        Type =
                            StockMovementType.Umlagerung,

                        FromWarehouseLocationId =
                            Model.FromWarehouseLocationId,

                        ToWarehouseLocationId =
                            Model.ToWarehouseLocationId,

                        ReferenceNumber =
                            string.IsNullOrWhiteSpace(
                                Model.ReferenceNumber)
                                ? null
                                : Model.ReferenceNumber.Trim(),

                        Note =
                            string.IsNullOrWhiteSpace(
                                Model.Note)
                                ? null
                                : Model.Note.Trim(),

                        UserId =
                            null,

                        CreatedAt =
                            DateTime.UtcNow
                    };


                db.StockMovements.Add(
                    movement);


                // =============================================
                // SAVE
                // =============================================

                await db.SaveChangesAsync();


                await transaction.CommitAsync();
            }
            catch
            {
                await transaction.RollbackAsync();

                throw;
            }


            // =================================================
            // SUCCESS
            // =================================================

            var movedQuantity =
                Model.Quantity;


            SuccessMessage =
                L[
                    "StockTransferSuccess",
                    movedQuantity.ToString("N2")
                ];


            // =================================================
            // RESET FORM
            // =================================================

            Model =
                new TransferModel();


            FromWarehouses.Clear();

            FromLocations.Clear();

            ToLocations.Clear();

            Warehouses.Clear();

            AvailableStock =
                0;


            StateHasChanged();
        }
        catch (Exception ex)
        {
            ErrorMessage =
                L[
                    "StockTransferBookingError",
                    ex.Message
                ];
        }
        finally
        {
            IsSaving = false;
        }
    }


    // =========================================================
    // MODEL
    // =========================================================

    private class TransferModel
    {
        public int ProductId { get; set; }

        public int FromWarehouseId { get; set; }

        public int FromWarehouseLocationId { get; set; }

        public int ToWarehouseId { get; set; }

        public int ToWarehouseLocationId { get; set; }

        public decimal Quantity { get; set; }

        public string? ReferenceNumber { get; set; }

        public string? Note { get; set; }
    }

}