@page "/warehouses/create"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using WarehouseManagement.Data
@using WarehouseManagement.Models

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>Neues Lager</PageTitle>

<div class="product-form-page">

    <div class="page-header">

        <div>
            <h1>Neues Lager</h1>
            <p>Neues Lager anlegen.</p>
        </div>

        <a href="/warehouses"
           class="btn-secondary">
            ← Zurück
        </a>

    </div>

    <div class="form-card">

        <EditForm Model="@Model"
                  OnValidSubmit="@SaveWarehouse"
                  FormName="WarehouseCreateForm">

            <DataAnnotationsValidator />

            <div class="form-section">

                <div class="form-section-title">

                    <h2>Lagerinformationen</h2>

                    <p>
                        Grundlegende Informationen zum Lager.
                    </p>

                </div>

                <div class="form-grid">

                    <!-- NAME -->

                    <div class="form-group">

                        <label>
                            Name <span>*</span>
                        </label>

                        <InputText @bind-Value="Model.Name"
                                   class="form-control"
                                   placeholder="z.B. Hauptlager München" />

                        <ValidationMessage For="@(() => Model.Name)" />

                    </div>


                    <!-- ACTIVE -->

                    <div class="form-group checkbox-group">

                        <label class="checkbox-label">

                            <InputCheckbox @bind-Value="Model.IsActive" />

                            <span>
                                Lager ist aktiv
                            </span>

                        </label>

                    </div>

                </div>

            </div>


            <!-- DESCRIPTION -->

            <div class="form-section">

                <div class="form-section-title">

                    <h2>Beschreibung</h2>

                </div>

                <div class="form-group">

                    <InputTextArea @bind-Value="Model.Description"
                                   class="form-control textarea"
                                   rows="5"
                                   placeholder="Beschreibung..." />

                </div>

            </div>


            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="form-error">
                    @ErrorMessage
                </div>
            }


            <div class="form-actions">

                <a href="/warehouses"
                   class="btn-secondary">
                    Abbrechen
                </a>

                <button type="submit"
                        class="btn-primary"
                        disabled="@IsSaving">

                    @(IsSaving
                        ? "Speichern..."
                        : "Lager speichern")

                </button>

            </div>

        </EditForm>

    </div>

</div>


@code {

    private WarehouseModel Model = new();

    private bool IsSaving;

    private string? ErrorMessage;


    private async Task SaveWarehouse()
    {
        if (IsSaving)
            return;

        IsSaving = true;
        ErrorMessage = null;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

            var name = Model.Name.Trim();


            // Name darf nicht doppelt sein

            var exists = await db.Warehouses
                .AnyAsync(x => x.Name == name);

            if (exists)
            {
                ErrorMessage =
                    "Ein Lager mit diesem Namen existiert bereits.";

                return;
            }


            var warehouse = new Warehouse
            {
                Name = name,

                Description =
                    string.IsNullOrWhiteSpace(Model.Description)
                        ? null
                        : Model.Description.Trim(),

                IsActive = Model.IsActive
            };


            db.Warehouses.Add(warehouse);

            await db.SaveChangesAsync();

            Navigation.NavigateTo("/warehouses");
        }
        catch (Exception ex)
        {
            ErrorMessage =
                $"Fehler beim Speichern: {ex.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }


    private class WarehouseModel
    {
        [Required(
            ErrorMessage =
                "Name ist erforderlich.")]

        [MaxLength(100)]
        public string Name { get; set; }
            = string.Empty;


        [MaxLength(500)]
        public string? Description { get; set; }


        public bool IsActive { get; set; } = true;
    }

}