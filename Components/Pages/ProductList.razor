@page "/products"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using WarehouseManagement.Data
@using WarehouseManagement.Models
@using WarehouseManagement.Services

@inject ExcelExportService ExcelExport
@inject IJSRuntime JS
@inject ApplicationDbContext Db
@inject NavigationManager Navigation


<PageTitle>Produkte</PageTitle>


<div class="products-page">

    <!-- HEADER -->

    <div class="page-header">

        <div>

            <h1>
                Produkte
            </h1>

            <p>
                Verwalten Sie Ihre Produkte und Artikel.
            </p>

        </div>


        <div>

            <button type="button"
                    class="btn-secondary"
                    @onclick="ExportExcel" disabled="@(PagedProducts.Count == 0)">

                📊 Excel exportieren

            </button>


            <a href="/products/create"
               class="btn-primary">

                <span>+</span>

                Neuer Artikel

            </a>

        </div>

    </div>


    <!-- FILTER BAR -->

    <div class="filter-card">


        <div class="search-box">

            <span class="search-icon">
                ⌕
            </span>


            <input type="text"
                   placeholder="Produkt suchen..."
                   @bind="SearchTerm"
                   @bind:event="oninput"
                   @bind:after="SearchChanged" />

        </div>


        <select class="filter-select"
                @bind="SelectedCategoryId"
                @bind:after="FilterChanged">

            <option value="0">
                Alle Kategorien
            </option>


            @foreach (var category in Categories)
            {
                <option value="@category.Id">
                    @category.Name
                </option>
            }

        </select>


        <select class="filter-select"
                @bind="SelectedStatus"
                @bind:after="FilterChanged">

            <option value="all">
                Alle Status
            </option>

            <option value="active">
                Aktiv
            </option>

            <option value="inactive">
                Inaktiv
            </option>

        </select>

    </div>


    <!-- PRODUCT TABLE -->

    <div class="products-card">


        <div class="products-card-header">

            <div>

                <strong>
                    Produktliste
                </strong>

                <span>
                    @Products.Count Produkte
                </span>

            </div>

        </div>


        @if (IsLoading)
        {
            <div class="loading-state">

                Produkte werden geladen...

            </div>
        }
        else if (Products.Count == 0)
        {
            <div class="empty-products">


                <div class="empty-products-icon">
                    📦
                </div>


                <h3>
                    Keine Produkte gefunden
                </h3>


                <p>
                    Es wurden noch keine Produkte angelegt.
                </p>


                <a href="/products/create"
                   class="btn-primary">

                    + Neuer Artikel

                </a>


            </div>
        }
        else
        {

            <div class="products-table-wrapper">


                <table class="products-table">


                    <thead>

                        <tr>

                            <th>
                                SKU
                            </th>

                            <th>
                                Produkt
                            </th>

                            <th>
                                Kategorie
                            </th>

                            <th>
                                Barcode
                            </th>

                            <th>
                                Verkaufspreis
                            </th>

                            <th>
                                Mindestbestand
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                            </th>

                        </tr>

                    </thead>


                    <tbody>


                        @foreach (var product in PagedProducts)
                        {
                            <tr>


                                <!-- SKU -->

                                <td>

                                    <span class="product-sku">

                                        @product.SKU

                                    </span>

                                </td>


                                <!-- PRODUCT -->

                                <td>

                                    <div class="product-name">


                                        <div class="product-avatar">

                                            @GetInitials(
                                                product.Name)

                                        </div>


                                        <div>

                                            <strong>
                                                @product.Name
                                            </strong>


                                            @if (!string.IsNullOrWhiteSpace(
                                                product.Description))
                                            {
                                                <small>
                                                    @product.Description
                                                </small>
                                            }

                                        </div>


                                    </div>

                                </td>


                                <!-- CATEGORY -->

                                <td>

                                    @if (product.Category != null)
                                    {
                                        <span class="category-badge">

                                            @product.Category.Name

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- BARCODE -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        product.Barcode))
                                    {
                                        <span class="barcode">

                                            @product.Barcode

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- PRICE -->

                                <td>

                                    <strong>

                                        @product.SalePrice.ToString("N2") €

                                    </strong>

                                </td>


                                <!-- MINIMUM STOCK -->

                                <td>

                                    @product.MinimumStock.ToString("N0")

                                </td>


                                <!-- STATUS -->

                                <td>

                                    @if (product.IsActive)
                                    {
                                        <span class="status-badge status-active">

                                            Aktiv

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">

                                            Inaktiv

                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->

                                <td>

                                    <div class="product-actions">


                                        <a href="/products/edit/@product.Id"
                                           class="action-button"
                                           title="Bearbeiten">

                                            ✎

                                        </a>


                                        <button class="action-button delete-button"
                                                title="Löschen"
                                                @onclick="() => ConfirmDelete(product)">

                                            🗑

                                        </button>


                                    </div>

                                </td>


                            </tr>
                        }


                    </tbody>

                </table>


            </div>


            <!-- PAGINATION -->
            @if (TotalPages > 1)
            {
                <div class="pagination">


                    <button type="button"
                            class="pagination-button"
                            disabled="@(CurrentPage <= 1)"
                            @onclick="PreviousPage">

                        ‹

                    </button>


                    <div class="pagination-pages">


                        @for (int page = 1; page <= TotalPages; page++)
                        {
                            var pageNumber = page;


                            <button type="button"
                                    class="pagination-button @(CurrentPage == pageNumber ? "active" : "")"
                                    @onclick="() => GoToPage(pageNumber)">

                                @pageNumber

                            </button>
                        }


                    </div>


                    <button type="button"
                            class="pagination-button"
                            disabled="@(CurrentPage >= TotalPages)"
                            @onclick="NextPage">

                        ›

                    </button>


                </div>
            }


            <div class="pagination-info">

                Seite @CurrentPage von @TotalPages
                ·
                @PagedProducts.Count von @Products.Count Produkten

            </div>

        }

    </div>


    <!-- DELETE MODAL -->
    @if (ShowDeleteModal && ProductToDelete != null)
    {
        <div class="delete-modal-backdrop">


            <div class="delete-modal">


                <div class="delete-modal-icon">
                    🗑
                </div>


                <h3>
                    Produkt deaktivieren?
                </h3>


                <p>

                    Möchten Sie

                    <strong>
                        @ProductToDelete.Name
                    </strong>

                    wirklich deaktivieren?

                </p>


                <small>

                    Der Artikel wird nicht gelöscht.
                    Er wird nur als inaktiv markiert.

                </small>


                <div class="delete-modal-actions">


                    <button class="btn-secondary"
                            @onclick="CancelDelete">

                        Abbrechen

                    </button>


                    <button class="btn-danger"
                            @onclick="DeleteConfirmed">

                        Deaktivieren

                    </button>


                </div>


            </div>

        </div>
    }

</div>


@code {

    // =========================================================
    // PAGINATION
    // =========================================================

    private const int PageSize = 10;

    private int CurrentPage = 1;


    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                Products.Count /
                (double)PageSize));


    private List<Product> PagedProducts =>
        Products
            .Skip(
                (CurrentPage - 1) *
                PageSize)
            .Take(PageSize)
            .ToList();


    private void GoToPage(int page)
    {
        if (page < 1 ||
            page > TotalPages)
        {
            return;
        }

        CurrentPage = page;
    }


    private void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
        }
    }


    private void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
        }
    }


    // =========================================================
    // DATA
    // =========================================================

    private List<Product> Products = new();

    private List<Category> Categories = new();

    private string SearchTerm =
        string.Empty;

    private int SelectedCategoryId = 0;

    private string SelectedStatus =
        "all";

    private bool IsLoading = true;


    // =========================================================
    // DELETE
    // =========================================================

    private Product? ProductToDelete;

    private bool ShowDeleteModal;


    // =========================================================
    // INITIALIZE
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        Categories =
            await Db.Categories
                .Where(x => x.IsActive)
                .OrderBy(x => x.Name)
                .ToListAsync();


        await LoadProducts();
    }


    // =========================================================
    // LOAD PRODUCTS
    // =========================================================

    private async Task LoadProducts()
    {
        IsLoading = true;


        var query =
            Db.Products
                .Include(x => x.Category)
                .AsQueryable();


        // SEARCH

        if (!string.IsNullOrWhiteSpace(
            SearchTerm))
        {

            var search =
                SearchTerm.Trim();


            query =
                query.Where(x =>
                    x.Name.Contains(search) ||
                    x.SalePrice.ToString().Contains(search) ||
                    x.PurchasePrice.ToString().Contains(search) ||
                    x.SKU.Contains(search) ||
                    (x.Barcode != null &&
                     x.Barcode.Contains(search)));

        }


        // CATEGORY

        if (SelectedCategoryId > 0)
        {

            query =
                query.Where(x =>
                    x.CategoryId ==
                    SelectedCategoryId);

        }


        // STATUS

        if (SelectedStatus == "active")
        {

            query =
                query.Where(x =>
                    x.IsActive);

        }
        else if (SelectedStatus == "inactive")
        {

            query =
                query.Where(x =>
                    !x.IsActive);

        }


        // LOAD

        Products =
            await query
                .OrderBy(x => x.Name)
                .ToListAsync();


        // RESET PAGINATION

        CurrentPage = 1;

        IsLoading = false;
    }


    // =========================================================
    // SEARCH
    // =========================================================

    private async Task SearchChanged()
    {
        CurrentPage = 1;

        await LoadProducts();
    }


    // =========================================================
    // FILTER
    // =========================================================

    private async Task FilterChanged()
    {
        CurrentPage = 1;

        await LoadProducts();
    }


    // =========================================================
    // EXCEL EXPORT
    // =========================================================

    private async Task ExportExcel()
    {

        var data =
            PagedProducts
                .Where(x => x != null)
                .ToList();


        if (data.Count == 0)
        {
            return;
        }


        var fileBytes =
            ExcelExport.Export(
                data,

                "Produkte",

                $"Produkte – Seite {CurrentPage}",

                ("SKU",
                    x => x.SKU ?? ""),

                ("Produkt",
                    x => x.Name ?? ""),

                ("Beschreibung",
                    x => x.Description ?? ""),

                ("Kategorie",
                    x => x.Category?.Name ?? ""),

                ("Barcode",
                    x => x.Barcode ?? ""),

                ("Einkaufspreis",
                    x => x.PurchasePrice),

                ("Verkaufspreis",
                    x => x.SalePrice),

                ("Mindestbestand",
                    x => x.MinimumStock),

                ("Status",
                    x => x.IsActive
                        ? "Aktiv"
                        : "Inaktiv")
            );


        var base64 =
            Convert.ToBase64String(
                fileBytes);


        await JS.InvokeVoidAsync(
            "downloadFile",

            $"Produkte_Seite_{CurrentPage}.xlsx",

            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",

            base64);
    }


    // =========================================================
    // DELETE PRODUCT
    // =========================================================

    private async Task DeleteProduct(
        Product product)
    {

        var confirmed =
            await Task.FromResult(true);


        if (!confirmed)
        {
            return;
        }


        product.IsActive = false;


        await Db.SaveChangesAsync();


        await LoadProducts();
    }


    // =========================================================
    // INITIALS
    // =========================================================

    private string GetInitials(
        string name)
    {

        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }


        var words =
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);


        if (words.Length == 1)
        {

            return words[0]
                .Substring(
                    0,
                    Math.Min(
                        2,
                        words[0].Length))
                .ToUpper();

        }


        return
            $"{words[0][0]}{words[1][0]}"
            .ToUpper();
    }


    // =========================================================
    // DELETE MODAL
    // =========================================================

    private void ConfirmDelete(
        Product product)
    {

        ProductToDelete =
            product;

        ShowDeleteModal = true;
    }


    private void CancelDelete()
    {

        ProductToDelete = null;

        ShowDeleteModal = false;
    }


    private async Task DeleteConfirmed()
    {

        if (ProductToDelete == null)
        {
            return;
        }


        ProductToDelete.IsActive =
            false;


        await Db.SaveChangesAsync();


        ProductToDelete = null;

        ShowDeleteModal = false;


        await LoadProducts();
    }

}