@page "/hr"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Forms

@inject NavigationManager Navigation

@layout PublicLayout

<PageTitle>
    Upravljanje Skladištem | Digitalno rješenje za moderna skladišta
</PageTitle>

<div class="page-wrapper">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <header class="header">

        <div class="container header-container">

            <!-- LOGO -->
            <a class="brand"
               href="/hr#tophr"
               aria-label="Upravljanje skladištem početna stranica">

                <div class="brand-logo">
                    <img class="brand-logo-image"
                         src="/images/wm-logo-premium.webp"
                         alt="Upravljanje Skladištem" />
                </div>

            </a>


            <!-- NAVIGATION -->
            <nav class="nav-menu @(MenuOpen ? "active" : string.Empty)">

                <a href="/hr#loesunghr"
                   @onclick="CloseMenu">
                    Rješenje
                </a>

                <a href="/hr#functionhr"
                   @onclick="CloseMenu">
                    Funkcije
                </a>

                <a href="/hr#prozessehr"
                   @onclick="CloseMenu">
                    Procesi
                </a>

                <a href="/hr#branchenhr"
                   @onclick="CloseMenu">
                    Industrije
                </a>

                <a href="/hr#reportshr"
                   @onclick="CloseMenu">
                    Izvještaji
                </a>

                <a href="/hr#faqhr"
                   @onclick="CloseMenu">
                    Česta pitanja
                </a>

            </nav>


            <!-- HEADER ACTIONS -->
            <div class="header-actions">

                <!-- LANGUAGE SELECTOR -->
                <div class="language-selector">

                    <a href="/"
                       class="language"
                       title="Deutsch">

                        DE

                    </a>

                    <a href="/en"
                       class="language"
                       title="English">

                        EN

                    </a>

                    <a href="/hr"
                       class="language active"
                       title="Hrvatski">

                        HR

                    </a>

                    <a href="/mk"
                       class="language"
                       title="Македонски">

                        MK

                    </a>

                </div>


                <!-- DEMO BUTTON -->
                <a class="btn btn-primary"
                   href="/hr#demohr">

                    Zatražite demo

                    <span>→</span>

                </a>

                <!-- MOBILE LANGUAGE SELECTOR -->
                <div class="mobile-language-selector">
                    <a href="/"
                       class="mobile-language @(IsActiveLanguage("de") ? "active" : "")">
                        DE
                    </a>

                    <a href="/en"
                       class="mobile-language @(IsActiveLanguage("en") ? "active" : "")">
                        EN
                    </a>

                    <a href="/hr"
                       class="mobile-language @(IsActiveLanguage("hr") ? "active" : "")">
                        HR
                    </a>

                    <a href="/mk"
                       class="mobile-language @(IsActiveLanguage("mk") ? "active" : "")">
                        MK
                    </a>
                </div>

                <!-- MOBILE MENU -->
                <button class="mobile-toggle"
                        type="button"
                        aria-label="Otvori izbornik"
                        @onclick="ToggleMenu">

                    ☰

                </button>

            </div>

        </div>

    </header>


    <!-- =========================================================
         MAIN
         ========================================================= -->

    <main id="tophr">


        <!-- =========================================================
             HERO
             ========================================================= -->

        <section class="hero">

            <div class="container hero-grid">

                <div class="hero-content">

                    <span class="badge">
                        Digitalno upravljanje skladištem za moderne tvrtke
                    </span>


                    <h1 class="hero-title">

                        Vaše skladište.
                        <br />

                        <span>
                            Jedan sustav. Potpuna kontrola.
                        </span>

                    </h1>


                    <p class="hero-subtitle">

                        Upravljanje skladištem povezuje proizvode, skladišta,
                        skladišna mjesta, zalihe, nabavu, narudžbe,
                        zaprimanje robe, izdavanje robe i inventuru
                        na jednoj središnjoj platformi.

                    </p>


                    <div class="hero-actions">

                        <a class="btn btn-primary"
                           href="/hr#demohr">

                            Zatražite personalizirani demo

                            <span>→</span>

                        </a>


                        <a class="btn btn-secondary"
                           href="/hr#functionhr">

                            Istražite funkcije

                            <span>→</span>

                        </a>

                    </div>


                    <div class="microproof">

                        <span class="avatars">
                            Skladište&nbsp;&nbsp;Nabava&nbsp;&nbsp;Prodaja&nbsp;&nbsp;Upravljanje
                        </span>

                        <span>
                            Jedna platforma za vaše svakodnevne poslovne procese.
                        </span>

                    </div>

                </div>


                <div class="hero-media">

                    <div class="glass-card mockup-card">

                        <img src="/images/DemoImg.png"
                             alt="Nadzorna ploča za upravljanje skladištem"
                             class="dashboard-img" />


                        <div class="floating-badge badge-top">

                            <span class="status-dot"></span>

                            Zalihe uvijek pod kontrolom

                        </div>


                        <div class="floating-badge badge-bottom">

                            ✓ Nabava · Skladište · Prodaja · Izvještaji

                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- =========================================================
             TRUST / INTRO
             ========================================================= -->

        <section class="industry-strip">

            <div class="container strip-inner">

                <p>

                    Jedna središnja platforma za

                    <strong>
                        strukturirane skladišne procese,
                        ažurne zalihe i jasne odluke.
                    </strong>

                </p>


                <div class="logos">

                    <span>VELEPRODAJA</span>
                    <span>TRGOVINA GRAĐEVINSKIM MATERIJALOM</span>
                    <span>REZERVNI DIJELOVI</span>
                    <span>PROIZVODNJA</span>
                    <span>E-TRGOVINA</span>

                </div>

            </div>

        </section>


        <!-- =========================================================
             PROBLEM / SOLUTION
             ========================================================= -->

        <section class="section"
                 id="loesunghr">

            <div class="container">

                <div class="section-heading">

                    <span class="section-tag">
                        Više od običnog popisa skladišta
                    </span>


                    <h2>
                        Od nabave do izdavanja robe –
                        sve je međusobno povezano.
                    </h2>


                    <p>

                        Moderno upravljanje skladištem ne znači samo
                        poznavati trenutno stanje zaliha.
                        Ono znači povezivanje svakog relevantnog procesa
                        u jednu cjelinu.

                    </p>

                </div>


                <div class="benefits-grid">


                    <article class="benefit-card glass-card">

                        <div class="icon-box">
                            ▦
                        </div>

                        <h3>
                            Jedna središnja baza podataka
                        </h3>

                        <p>

                            Proizvodi, kategorije, skladišta,
                            skladišna mjesta, dobavljači, kupci
                            i narudžbe upravljaju se središnje.

                        </p>

                    </article>


                    <article class="benefit-card glass-card">

                        <div class="icon-box green">
                            ↔
                        </div>

                        <h3>
                            Sljedivost svakog kretanja robe
                        </h3>

                        <p>

                            Ulazi robe, izlazi robe,
                            premještanja, korekcije i
                            inventure u potpunosti se dokumentiraju.

                        </p>

                    </article>


                    <article class="benefit-card glass-card">

                        <div class="icon-box orange">
                            ◈
                        </div>

                        <h3>
                            Informacije za donošenje odluka
                        </h3>

                        <p>

                            Jasna analiza izvještaja o zalihama, vrijednosti skladišta,
                            kretanjima robe, niskim zalihama,
                            proizvodima i dobavljačima.

                        </p>

                    </article>

                </div>

            </div>

        </section>


        <!-- =========================================================
             COMPLETE WAREHOUSE FLOW
             ========================================================= -->

        <section class="section workflow-section"
                 id="prozessehr">

            <div class="container">

                <div class="section-heading centered-heading">

                    <span class="section-tag">
                        Cjelokupni tijek robe
                    </span>


                    <h2>
                        Cjelovit proces umjesto
                        mnoštva pojedinačnih rješenja.
                    </h2>


                    <p>

                        Svaki korak nadograđuje se na prethodni.
                        Tako vaše zalihe ostaju potpuno sljedive,
                        a vaši zaposlenici rade s identičnim podacima.

                    </p>

                </div>


                <div class="workflow-grid">


                    <article class="workflow-step">

                        <span class="step-number">
                            01
                        </span>

                        <div class="step-icon">
                            ↓
                        </div>

                        <h3>
                            Nabava
                        </h3>

                        <p>

                            Upravljajte dobavljačima,
                            izradite narudžbenice i
                            planirajte potrebnu robu.

                        </p>

                    </article>


                    <article class="workflow-step">

                        <span class="step-number">
                            02
                        </span>

                        <div class="step-icon">
                            📦
                        </div>

                        <h3>
                            Zaprimanje robe
                        </h3>

                        <p>

                            Evidentirajte isporučene količine
                            i dodijelite robu odgovarajućem
                            skladištu ili skladišnom mjestu.

                        </p>

                    </article>


                    <article class="workflow-step">

                        <span class="step-number">
                            03
                        </span>

                        <div class="step-icon">
                            ⌖
                        </div>

                        <h3>
                            Skladištenje
                        </h3>

                        <p>

                            Rasporedite zalihe na konkretna skladišna mjesta
                            i u svakom trenutku znajte
                            gdje se artikl nalazi.

                        </p>

                    </article>


                    <article class="workflow-step">

                        <span class="step-number">
                            04
                        </span>

                        <div class="step-icon">
                            ↔
                        </div>

                        <h3>
                            Premještanje
                        </h3>

                        <p>

                            Premještajte robu između skladišnih mjesta
                            ili skladišta i dokumentirajte svako kretanje.

                        </p>

                    </article>


                    <article class="workflow-step">

                        <span class="step-number">
                            05
                        </span>

                        <div class="step-icon">
                            ☷
                        </div>

                        <h3>
                            Narudžba
                        </h3>

                        <p>

                            Upravljajte narudžbama kupaca,
                            provjerite stavke i uzmite u obzir
                            dostupne zalihe.

                        </p>

                    </article>


                    <article class="workflow-step">

                        <span class="step-number">
                            06
                        </span>

                        <div class="step-icon">
                            ↑
                        </div>

                        <h3>
                            Izdavanje robe
                        </h3>

                        <p>

                            Kontrolirano otpisujte i izdajte robu
                            te automatski održavajte zalihe
                            ažurnima.

                        </p>

                    </article>

                </div>

            </div>

        </section>


        <!-- =========================================================
             FEATURES
             ========================================================= -->

        <section class="section"
                 id="functionhr">

            <div class="container">

                <div class="section-heading">

                    <span class="section-tag">
                        Najvažniji alati
                    </span>


                    <h2>
                        Sve što je potrebno modernom skladištu.
                    </h2>


                    <p>

                        Od upravljanja matičnim podacima do
                        detaljne analize zaliha –
                        Upravljanje skladištem objedinjuje vaše procese
                        u jednom sustavu.

                    </p>

                </div>


                <div class="industry-grid">


                    <article class="industry-card">

                        <span>01</span>

                        <h3>
                            Proizvodi i kategorije
                        </h3>

                        <p>

                            Upravljajte proizvodima središnje,
                            kategorizirajte ih i organizirajte uz SKU,
                            barkod, cijene i minimalne zalihe.

                        </p>

                        <b>→</b>

                    </article>


                    <article class="industry-card">

                        <span>02</span>

                        <h3>
                            Skladišta i skladišne lokacije
                        </h3>

                        <p>

                            Upravljajte s više skladišta i strukturiranim
                            skladišnim mjestima. Brzo saznajte
                            gdje se koji artikl nalazi.

                        </p>

                        <b>→</b>

                    </article>


                    <article class="industry-card">

                        <span>03</span>

                        <h3>
                            Upravljanje zalihama
                        </h3>

                        <p>

                            Pratite trenutne zalihe,
                            rezervirane količine,
                            dostupne količine i
                            minimalne zalihe.

                        </p>

                        <b>→</b>

                    </article>


                    <article class="industry-card">

                        <span>04</span>

                        <h3>
                            Dobavljači
                        </h3>

                        <p>

                            Upravljajte dobavljačima središnje
                            i povežite ih sa svojim procesima nabave.

                        </p>

                        <b>→</b>

                    </article>


                    <article class="industry-card">

                        <span>05</span>

                        <h3>
                            Kupci i narudžbe
                        </h3>

                        <p>

                            Strukturirano upravljajte kupcima i narudžbama
                            te uzmite zalihe u obzir prilikom obrade narudžbi.

                        </p>

                        <b>→</b>

                    </article>


                    <article class="industry-card">

                        <span>06</span>

                        <h3>
                            Inventura
                        </h3>

                        <p>

                            Izradite inventure,
                            usporedite stanje u sustavu s prebrojanim količinama
                            i jednostavno pratite razlike.

                        </p>

                        <b>→</b>

                    </article>


                    <article class="industry-card">

                        <span>07</span>

                        <h3>
                            Kretanje robe
                        </h3>

                        <p>

                            Transparentno dokumentirajte ulaze, izlaze,
                            premještanja, inventure i ručne korekcije.

                        </p>

                        <b>→</b>

                    </article>


                    <article class="industry-card">

                        <span>08</span>

                        <h3>
                            Uloge i korisnici
                        </h3>

                        <p>

                            Upravljajte korisnicima i strukturirajte pristupe
                            putem uloga i detaljnih dozvola.

                        </p>

                        <b>→</b>

                    </article>

                </div>

            </div>

        </section>


        <!-- =========================================================
             PURCHASE ORDERS
             ========================================================= -->

        <section class="section modules-section">

            <div class="container modules-grid">


                <div class="module-copy">

                    <span class="section-tag">
                        Digitalna nabava
                    </span>


                    <h2>
                        Narudžbe dobavljačima
                        bez gubitka pregleda.
                    </h2>


                    <p>

                        Izrađujte i upravljajte narudžbama kod dobavljača
                        te imajte jasan pregled nad isporučenim
                        i preostalim količinama.

                    </p>


                    <ul class="checklist">

                        <li>
                            ✓ Upravljanje dobavljačima
                        </li>

                        <li>
                            ✓ Narudžbe dobavljačima
                        </li>

                        <li>
                            ✓ Stavke narudžbe
                        </li>

                        <li>
                            ✓ Status narudžbe
                        </li>

                        <li>
                            ✓ Djelomične isporuke
                        </li>

                        <li>
                            ✓ Isporučene količine
                        </li>

                    </ul>

                </div>


                <div class="ops-card glass-card">

                    <div class="ops-top">

                        <span>
                            NARUDŽBA DOBAVLJAČU
                        </span>

                        <b class="live-tag">
                            AKTIVNO
                        </b>

                    </div>


                    <div class="ops-number">
                        Narudžba
                    </div>


                    <small>
                        Dobavljač · Stavke · Količine · Status
                    </small>


                    <div style="margin-top:30px;">

                        <div style="display:flex;justify-content:space-between;margin-bottom:12px;">

                            <span>
                                Naručeno
                            </span>

                            <strong>
                                100
                            </strong>

                        </div>


                        <div style="display:flex;justify-content:space-between;margin-bottom:12px;">

                            <span>
                                Isporučeno
                            </span>

                            <strong>
                                70
                            </strong>

                        </div>


                        <div style="display:flex;justify-content:space-between;">

                            <span>
                                Preostalo
                            </span>

                            <strong>
                                30
                            </strong>

                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- =========================================================
             STOCK
             ========================================================= -->

        <section class="section">

            <div class="container feature-split">


                <div class="feature-text">

                    <span class="section-tag">
                        Razumijevanje zaliha
                    </span>


                    <h2>
                        Ne samo gledati zalihe.
                        Razumijte zalihe.
                    </h2>


                    <p>

                        Upravljanje skladištem razlikuje
                        fizičke, rezervirane i dostupne zalihe.

                        Tako dobivate realnu sliku
                        stvarnog kapaciteta vašeg skladišta.

                    </p>


                    <ul class="checklist">

                        <li>
                            ✓ Ukupne zalihe
                        </li>

                        <li>
                            ✓ Rezervirane zalihe
                        </li>

                        <li>
                            ✓ Dostupne zalihe
                        </li>

                        <li>
                            ✓ Minimalne zalihe
                        </li>

                        <li>
                            ✓ Niske zalihe
                        </li>

                        <li>
                            ✓ Manjak količina
                        </li>

                    </ul>

                </div>


                <div class="ops-card glass-card">

                    <div class="ops-top">

                        <span>
                            PREGLED ZALIHA
                        </span>

                        <b class="live-tag">
                            UŽIVO
                        </b>

                    </div>


                    <div class="ops-number">
                        Status zaliha
                    </div>


                    <small>
                        Središnji pregled vaših skladišnih zaliha
                    </small>


                    <div style="margin-top:30px;">

                        <div style="display:flex;justify-content:space-between;margin-bottom:16px;">

                            <span>
                                Ukupne zalihe
                            </span>

                            <strong>
                                8.642
                            </strong>

                        </div>


                        <div style="display:flex;justify-content:space-between;margin-bottom:16px;">

                            <span>
                                Rezervirano
                            </span>

                            <strong>
                                1.186
                            </strong>

                        </div>


                        <div style="display:flex;justify-content:space-between;margin-bottom:16px;">

                            <span>
                                Dostupno
                            </span>

                            <strong>
                                7.456
                            </strong>

                        </div>


                        <div style="display:flex;justify-content:space-between;">

                            <span>
                                Niske zalihe
                            </span>

                            <strong>
                                24
                            </strong>

                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- =========================================================
             REPORTS
             ========================================================= -->

        <section class="section industries-section"
                 id="reportshr">

            <div class="container">

                <div class="section-heading">

                    <span class="section-tag">
                        Izvještaji i analize
                    </span>


                    <h2>
                        Prevorite skladišne podatke
                        u jasne i korisne informacije.
                    </h2>


                    <p>

                        Brže saznajte što se događa,
                        gdje nastaju uska grla i kolika je ukupna vrijednost
                        vaših trenutnih zaliha.

                    </p>

                </div>


                <div class="industry-grid">


                    <article class="industry-card">

                        <span>01</span>

                        <h3>
                            Izvještaj o zalihama
                        </h3>

                        <p>
                            Trenutne zalihe grupirane po skladištu,
                            skladišnom mjestu i proizvodu.
                        </p>

                        <b>→</b>

                    </article>


                    <article class="industry-card">

                        <span>02</span>

                        <h3>
                            Vrijednost skladišta
                        </h3>

                        <p>
                            Ukupna nabavna i prodajna vrijednost
                            vaših trenutnih zaliha.
                        </p>

                        <b>→</b>

                    </article>


                    <article class="industry-card">

                        <span>03</span>

                        <h3>
                            Kretanje robe
                        </h3>

                        <p>
                            Povijest ulaza, izlaza, premještanja,
                            inventura i korekcija.
                        </p>

                        <b>→</b>

                    </article>


                    <article class="industry-card">

                        <span>04</span>

                        <h3>
                            Izvještaj o niskim zalihama
                        </h3>

                        <p>
                            Prepoznajte proizvode čija je zaliha
                            pala ispod definirane minimalne količine.
                        </p>

                        <b>→</b>

                    </article>


                    <article class="industry-card">

                        <span>05</span>

                        <h3>
                            Izvještaj o proizvodima
                        </h3>

                        <p>
                            Analizirajte kretanje i trendove zaliha
                            pojedinih proizvoda.
                        </p>

                        <b>→</b>

                    </article>


                    <article class="industry-card">

                        <span>06</span>

                        <h3>
                            Izvještaj o dobavljačima
                        </h3>

                        <p>
                            Pregledno analizirajte dobavljače i njihovu
                            povijest kretanja robe.
                        </p>

                        <b>→</b>

                    </article>

                </div>

            </div>

        </section>


        <!-- =========================================================
             INVENTORY
             ========================================================= -->

        <section class="section">

            <div class="container modules-grid">


                <div class="module-copy">

                    <span class="section-tag">
                        Moderna inventura
                    </span>


                    <h2>
                        Sustavna inventura umjesto
                        papirnatih lista i ručne potrage.
                    </h2>


                    <p>

                        Kreirajte zadatak inventure,
                        odaberite ciljno skladište,
                        unesite prebrojane količine
                        i izravno ih usporedite
                        sa stanjem u sustavu.

                    </p>


                    <ul class="checklist">

                        <li>
                            ✓ Kreiranje inventure
                        </li>

                        <li>
                            ✓ Odabir skladišta
                        </li>

                        <li>
                            ✓ Unos stavki
                        </li>

                        <li>
                            ✓ Usporedba sa stanjem u sustavu
                        </li>

                        <li>
                            ✓ Prepoznavanje razlika
                        </li>

                        <li>
                            ✓ Završetak inventure
                        </li>

                    </ul>

                </div>


                <div class="ops-card glass-card">

                    <div class="ops-top">

                        <span>
                            INVENTURA
                        </span>

                        <b class="live-tag">
                            REVIZIJA
                        </b>

                    </div>


                    <div class="ops-number">
                        Razlika
                    </div>


                    <small>
                        Stanje u sustavu u odnosu na prebrojano stanje
                    </small>


                    <div style="margin-top:35px;">

                        <div style="display:flex;justify-content:space-between;margin-bottom:18px;">

                            <span>
