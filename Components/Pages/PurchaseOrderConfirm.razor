@page "/purchase-orders/confirm/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using WarehouseManagement.Data
@using WarehouseManagement.Localization
@using WarehouseManagement.Models

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ConfirmPurchaseOrder"]</PageTitle>

@if (IsLoading)
{
    <div class="loading-state">
        @L["PurchaseOrderLoading"]
    </div>
}
else if (Order == null)
{
    <div class="empty-products">

        <div class="empty-products-icon">
            ⚠
        </div>

        <h3>
            @L["PurchaseOrderNotFound"]
        </h3>

        <a href="/purchase-orders"
           class="btn-primary">

            @L["BackToPurchaseOrders"]

        </a>

    </div>
}
else if (Order.Status != PurchaseOrderStatus.Entwurf)
{
    <div class="empty-products">

        <div class="empty-products-icon">
            🔒
        </div>

        <h3>
            @L["PurchaseOrderCannotBeConfirmed"]
        </h3>

        <p>
            @L["PurchaseOrderStatusInfo"]
            <strong>
                @GetStatusText(Order.Status)
            </strong>.
        </p>

        <a href="/purchase-orders/details/@Order.Id"
           class="btn-primary">

            @L["ToPurchaseOrder"]

        </a>

    </div>
}
else
{
    <div class="product-form-page">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="page-header">

            <div>

                <h1>
                    @L["ConfirmPurchaseOrder"]
                </h1>

                <p>
                    @Order.OrderNumber
                    -
                    @(Order.Supplier?.CompanyName ?? "-")
                </p>

            </div>

            <a href="/purchase-orders/details/@Order.Id"
               class="btn-secondary">

                ← @L["Back"]

            </a>

        </div>


        <!-- =====================================================
             WARNING
             ===================================================== -->

        <div class="confirm-warning">

            <div class="confirm-warning-icon">
                ⚠
            </div>

            <div>

                <strong>
                    @L["ConfirmPurchaseOrderQuestion"]
                </strong>

                <p>

                    @L["PurchaseOrderConfirmationWarning"]

                    @L["StockNotChangedOnConfirmation"]

                    @L["StockUpdatedOnReceipt"]

                </p>

            </div>

        </div>


        <div class="form-card">

            <!-- =================================================
                 BESTELLUNG
                 ================================================= -->

            <div class="form-section">

                <div class="form-section-title">

                    <h2>
                        @L["PurchaseOrderData"]
                    </h2>

                </div>


                <div class="form-grid">


                    <!-- ORDER NUMBER -->

                    <div class="form-group">

                        <label>
                            @L["OrderNumber"]
                        </label>

                        <input class="form-control"
                               value="@Order.OrderNumber"
                               disabled />

                    </div>


                    <!-- SUPPLIER -->

                    <div class="form-group">

                        <label>
                            @L["Supplier"]
                        </label>

                        <input class="form-control"
                               value="@(
                               Order.Supplier?.CompanyName
                               ?? "-"
                                                   )"
                               disabled />

                    </div>


                    <!-- DATE -->

                    <div class="form-group">

                        <label>
                            @L["OrderDate"]
                        </label>

                        <input class="form-control"
                               value="@Order.OrderDate.Date"
                               disabled />

                    </div>


                    <!-- REFERENCE -->

                    <div class="form-group">

                        <label>
                            @L["ReferenceNumber"]
                        </label>

                        <input class="form-control"
                               value="@(Order.ReferenceNumber ?? "-")"
                               disabled />

                    </div>

                </div>

            </div>


            <!-- =================================================
                 SUPPLIER
                 ================================================= -->

            <div class="form-section">

                <div class="form-section-title">

                    <h2>
                        @L["Supplier"]
                    </h2>

                </div>


                @if (Order.Supplier != null)
                {
                    <div class="supplier-detail-card">

                        <div class="product-avatar">

                            @GetInitials(
                                Order.Supplier.CompanyName)

                        </div>


                        <div class="supplier-detail-content">

                            <strong>
                                @Order.Supplier.CompanyName
                            </strong>


                            @if (!string.IsNullOrWhiteSpace(
                                Order.Supplier.SupplierNumber))
                            {
                                <span>

                                    @L["SupplierNumberLabel"]:
                                    @Order.Supplier.SupplierNumber

                                </span>
                            }


                            @if (!string.IsNullOrWhiteSpace(
                                Order.Supplier.ContactPerson))
                            {
                                <span>

                                    @L["ContactPerson"]:
                                    @Order.Supplier.ContactPerson

                                </span>
                            }


                            @if (!string.IsNullOrWhiteSpace(
                                Order.Supplier.Email))
                            {
                                <span>
                                    @Order.Supplier.Email
                                </span>
                            }


                            @if (!string.IsNullOrWhiteSpace(
                                Order.Supplier.Phone))
                            {
                                <span>
                                    @Order.Supplier.Phone
                                </span>
                            }

                        </div>

                    </div>
                }

            </div>


            <!-- =================================================
                 ITEMS
                 ================================================= -->

            <div class="form-section">

                <div class="form-section-title">

                    <h2>
                        @L["OrderItems"]
                    </h2>

                    <p>
                        @L["PurchaseOrderItemsDescription"]
                    </p>

                </div>


                @if (Order.Items.Count == 0)
                {
                    <div class="empty-products">

                        <div class="empty-products-icon">
                            📦
                        </div>

                        <h3>
                            @L["NoPurchaseOrderItems"]
                        </h3>

                    </div>
                }
                else
                {
                    <div class="products-table-wrapper">

                        <table class="products-table">

                            <thead>

                                <tr>

                                    <th>
                                        @L["Product"]
                                    </th>

                                    <th>
                                        @L["SKU"]
                                    </th>

                                    <th>
                                        @L["Quantity"]
                                    </th>

                                    <th>
                                        @L["UnitPrice"]
                                    </th>

                                    <th>
                                        @L["Total"]
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var item in Order.Items)
                                {
                                    <tr>

                                        <!-- PRODUCT -->

                                        <td>

                                            <div class="product-name">

                                                <div class="product-avatar">

                                                    @GetInitials(
                                                        item.Product?.Name)

                                                </div>

                                                <div>

                                                    <strong>

                                                        @(item.Product?.Name
                                                            ?? "-")

                                                    </strong>

                                                    @if (!string.IsNullOrWhiteSpace(
                                                        item.Product?.Barcode))
                                                    {
                                                        <small>

                                                            @item.Product.Barcode

                                                        </small>
                                                    }

                                                </div>

                                            </div>

                                        </td>


                                        <!-- SKU -->

                                        <td>

                                            @(item.Product?.SKU ?? "-")

                                        </td>


                                        <!-- QUANTITY -->

                                        <td>

                                            <strong>

                                                @item.Quantity.ToString("N2")

                                            </strong>

                                        </td>


                                        <!-- UNIT PRICE -->

                                        <td>

                                            @item.UnitPrice.ToString("N2")
                                            €

                                        </td>


                                        <!-- TOTAL -->

                                        <td>

                                            <strong>

                                                @(
                                                    (
                                                        item.Quantity *
                                                        item.UnitPrice
                                                    )
                                                    .ToString("N2")
                                                )
                                                €

                                            </strong>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>


            <!-- =================================================
                 SUMMARY
                 ================================================= -->

            <div class="form-section">

                <div class="stock-summary-grid">

                    <div class="stock-summary-card">

                        <span>
                            @L["Positions"]
                        </span>

                        <strong>
                            @Order.Items.Count
                        </strong>

                    </div>


                    <div class="stock-summary-card">

                        <span>
                            @L["TotalQuantity"]
                        </span>

                        <strong>
                            @TotalQuantity.ToString("N2")
                        </strong>

                    </div>


                    <div class="stock-summary-card">

                        <span>
                            @L["OrderValue"]
                        </span>

                        <strong>
                            @Order.Total.ToString("N2") €
                        </strong>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 NOTE
                 ================================================= -->
            @if (!string.IsNullOrWhiteSpace(
                            Order.Note))
            {
                <div class="form-section">

                    <div class="form-section-title">

                        <h2>
                            @L["Note"]
                        </h2>

                    </div>

                    <div class="note-box">

                        @Order.Note

                    </div>

                </div>
            }


            <!-- =================================================
                 ERROR
                 ================================================= -->
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="form-error">

                    @ErrorMessage

                </div>
            }


            <!-- =================================================
                 ACTIONS
                 ================================================= -->

            <div class="form-actions">

                <a href="/purchase-orders/details/@Order.Id"
                   class="btn-secondary">

                    @L["Cancel"]

                </a>


                <button type="button"
                        class="btn-primary"
                        disabled="@IsSaving"
                        @onclick="ConfirmOrder">

                    @(IsSaving
                        ? L["Confirming"]
                        : L["ConfirmPurchaseOrderButton"])

                </button>

            </div>

        </div>

    </div>
}


@code {

    // =========================================================
    // PARAMETER
    // =========================================================

    [Parameter]
    public int Id { get; set; }


    // =========================================================
    // DATA
    // =========================================================

    private PurchaseOrder? Order;


    // =========================================================
    // STATE
    // =========================================================

    private bool IsLoading = true;

    private bool IsSaving;

    private string? ErrorMessage;


    // =========================================================
    // SUMMARY
    // =========================================================

    private decimal TotalQuantity =>
        Order?.Items.Sum(x =>
            x.Quantity) ?? 0;


    // =========================================================
    // INITIALIZATION
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadOrder();
    }


    // =========================================================
    // LOAD ORDER
    // =========================================================

    private async Task LoadOrder()
    {
        IsLoading = true;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            Order =
                await db.PurchaseOrders

                    .AsNoTracking()

                    .Include(x =>
                        x.Supplier)

                    .Include(x =>
                        x.Items)

                        .ThenInclude(x =>
                            x.Product)

                    .FirstOrDefaultAsync(x =>
                        x.Id == Id);
        }
        finally
        {
            IsLoading = false;
        }
    }


    // =========================================================
    // CONFIRM
    // =========================================================

    private async Task ConfirmOrder()
    {
        if (Order == null ||
            IsSaving)
        {
            return;
        }


        IsSaving = true;

        ErrorMessage = null;


        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            // =================================================
            // LOAD ACTUAL ORDER
            // =================================================

            var order =
                await db.PurchaseOrders

                    .FirstOrDefaultAsync(x =>
                        x.Id == Id);


            if (order == null)
            {
                ErrorMessage =
                    L["PurchaseOrderNotFound"];

                return;
            }


            // =================================================
            // STATUS CHECK
            // =================================================

            if (order.Status !=
                PurchaseOrderStatus.Entwurf)
            {
                ErrorMessage =
                    L["PurchaseOrderAlreadyProcessed"];

                return;
            }


            // =================================================
            // SUPPLIER CHECK
            // =================================================

            var supplierExists =
                await db.Suppliers

                    .AnyAsync(x =>
                        x.Id ==
                        order.SupplierId

                        &&

                        x.IsActive);


            if (!supplierExists)
            {
                ErrorMessage =
                    L["PurchaseOrderSupplierNotFound"];

                return;
            }


            // =================================================
            // ITEMS CHECK
            // =================================================

            var itemsExist =
                await db.PurchaseOrderItems

                    .AnyAsync(x =>
                        x.PurchaseOrderId ==
                        order.Id);


            if (!itemsExist)
            {
                ErrorMessage =
                    L["PurchaseOrderWithoutItemsCannotBeConfirmed"];

                return;
            }


            // =================================================
            // CONFIRM
            // =================================================

            order.Status =
                PurchaseOrderStatus.Bestellt;


            order.UpdatedAt =
                DateTime.UtcNow;


            await db.SaveChangesAsync();


            // =================================================
            // GO TO DETAILS
            // =================================================

            Navigation.NavigateTo(
                $"/purchase-orders/details/{order.Id}");
        }
        catch (Exception ex)
        {
            ErrorMessage =
                L["PurchaseOrderConfirmationError", ex.Message];
        }
        finally
        {
            IsSaving = false;
        }
    }


    // =========================================================
    // STATUS TEXT
    // =========================================================

    private string GetStatusText(
        PurchaseOrderStatus status)
    {
        return status switch
        {
            PurchaseOrderStatus.Entwurf =>
                L["PurchaseOrderStatusDraft"],

            PurchaseOrderStatus.Bestellt =>
                L["PurchaseOrderStatusOrdered"],

            PurchaseOrderStatus.TeilweiseGeliefert =>
                L["PurchaseOrderStatusPartiallyDelivered"],

            PurchaseOrderStatus.Geliefert =>
                L["PurchaseOrderStatusDelivered"],

            PurchaseOrderStatus.Storniert =>
                L["PurchaseOrderStatusCancelled"],

            _ =>
                status.ToString()
        };
    }


    // =========================================================
    // INITIALS
    // =========================================================

    private string GetInitials(
        string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";


        var words =
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);


        if (words.Length == 1)
        {
            return words[0]
                .Substring(
                    0,
                    Math.Min(
                        2,
                        words[0].Length))
                .ToUpper();
        }


        return
            $"{words[0][0]}{words[1][0]}"
                .ToUpper();
    }

}