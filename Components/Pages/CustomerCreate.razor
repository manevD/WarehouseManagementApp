@page "/customers/create"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using WarehouseManagement.Data
@using WarehouseManagement.Localization
@using WarehouseManagement.Models

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["NewCustomer"]</PageTitle>

<div class="product-form-page">

    <div class="page-header">

        <div>
            <h1>@L["NewCustomer"]</h1>
            <p>@L["CreateCustomerDescription"]</p>
        </div>

        <a href="/customers"
           class="btn-secondary">
            ← @L["Back"]
        </a>

    </div>


    <div class="form-card">

        <EditForm Model="@Model"
                  OnValidSubmit="@SaveCustomer"
                  FormName="CustomerCreateForm">

            <DataAnnotationsValidator />


            <!-- =====================================================
                 KUNDENINFORMATIONEN
                 ===================================================== -->

            <div class="form-section">

                <div class="form-section-title">

                    <h2>@L["CustomerInformation"]</h2>

                    <p>
                        @L["BasicCustomerInformation"]
                    </p>

                </div>


                <div class="form-grid">


                    <div class="form-group">

                        <label>
                            @L["CompanyName"] <span>*</span>
                        </label>

                        <InputText @bind-Value="Model.CompanyName"
                                   class="form-control"
                                   placeholder="@L["CompanyNamePlaceholder"]" />

                        <ValidationMessage For="@(() => Model.CompanyName)" />

                    </div>


                    <div class="form-group">

                        <label>
                            @L["CustomerNumber"]
                        </label>

                        <InputText @bind-Value="Model.CustomerNumber"
                                   class="form-control"
                                   placeholder="@L["CustomerNumberPlaceholder"]" />

                        <ValidationMessage For="@(() => Model.CustomerNumber)" />

                    </div>


                    <div class="form-group">

                        <label>
                            @L["ContactPerson"]
                        </label>

                        <InputText @bind-Value="Model.ContactPerson"
                                   class="form-control"
                                   placeholder="@L["ContactPersonPlaceholder"]" />

                    </div>


                    <div class="form-group">

                        <label>
                            @L["VatNumber"]
                        </label>

                        <InputText @bind-Value="Model.VatNumber"
                                   class="form-control"
                                   placeholder="@L["VatNumberPlaceholder"]" />

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 KONTAKT
                 ===================================================== -->

            <div class="form-section">

                <div class="form-section-title">

                    <h2>@L["Contact"]</h2>

                </div>


                <div class="form-grid">


                    <div class="form-group">

                        <label>
                            @L["Email"]
                        </label>

                        <InputText @bind-Value="Model.Email"
                                   class="form-control"
                                   type="email"
                                   placeholder="@L["EmailPlaceholder"]" />

                        <ValidationMessage For="@(() => Model.Email)" />

                    </div>


                    <div class="form-group">

                        <label>
                            @L["Phone"]
                        </label>

                        <InputText @bind-Value="Model.Phone"
                                   class="form-control"
                                   placeholder="@L["PhonePlaceholder"]" />

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 ADRESSE
                 ===================================================== -->

            <div class="form-section">

                <div class="form-section-title">

                    <h2>@L["Address"]</h2>

                </div>


                <div class="form-grid">


                    <div class="form-group">

                        <label>
                            @L["Street"]
                        </label>

                        <InputText @bind-Value="Model.Street"
                                   class="form-control"
                                   placeholder="@L["StreetPlaceholder"]" />

                    </div>


                    <div class="form-group">

                        <label>
                            @L["PostalCode"]
                        </label>

                        <InputText @bind-Value="Model.PostalCode"
                                   class="form-control"
                                   placeholder="@L["PostalCodePlaceholder"]" />

                    </div>


                    <div class="form-group">

                        <label>
                            @L["City"]
                        </label>

                        <InputText @bind-Value="Model.City"
                                   class="form-control"
                                   placeholder="@L["CityPlaceholder"]" />

                    </div>


                    <div class="form-group">

                        <label>
                            @L["Country"]
                        </label>

                        <InputText @bind-Value="Model.Country"
                                   class="form-control"
                                   placeholder="@L["CountryPlaceholder"]" />

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 NOTIZ
                 ===================================================== -->

            <div class="form-section">

                <div class="form-section-title">

                    <h2>@L["Note"]</h2>

                </div>


                <div class="form-group">

                    <InputTextArea @bind-Value="Model.Note"
                                   class="form-control textarea"
                                   rows="5"
                                   placeholder="@L["OptionalNotePlaceholder"]" />

                </div>

            </div>


            <!-- =====================================================
                 STATUS
                 ===================================================== -->

            <div class="form-section">

                <div class="form-group checkbox-group">

                    <label class="checkbox-label">

                        <InputCheckbox @bind-Value="Model.IsActive" />

                        <span>
                            @L["CustomerIsActive"]
                        </span>

                    </label>

                </div>

            </div>


            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="form-error">
                    @ErrorMessage
                </div>
            }


            <div class="form-actions">

                <a href="/customers"
                   class="btn-secondary">
                    @L["Cancel"]
                </a>

                <button type="submit"
                        class="btn-primary"
                        disabled="@IsSaving">

                    @(IsSaving
                        ? L["Saving"]
                        : L["SaveCustomer"])

                </button>

            </div>

        </EditForm>

    </div>

</div>


@code {

    private CustomerModel Model = new();

    private bool IsSaving;

    private string? ErrorMessage;


    private async Task SaveCustomer()
    {
        if (IsSaving)
            return;


        IsSaving = true;

        ErrorMessage = null;


        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            if (!string.IsNullOrWhiteSpace(
                Model.CustomerNumber))
            {
                var number =
                    Model.CustomerNumber.Trim();


                var exists =
                    await db.Customers
                        .AnyAsync(x =>
                            x.CustomerNumber == number);


                if (exists)
                {
                    ErrorMessage =
                        L["CustomerNumberAlreadyExists"];

                    return;
                }
            }


            var customer =
                new Customer
                {
                    CompanyName =
                        Model.CompanyName.Trim(),

                    CustomerNumber =
                        string.IsNullOrWhiteSpace(
                            Model.CustomerNumber)
                            ? null
                            : Model.CustomerNumber.Trim(),

                    ContactPerson =
                        string.IsNullOrWhiteSpace(
                            Model.ContactPerson)
                            ? null
                            : Model.ContactPerson.Trim(),

                    Email =
                        string.IsNullOrWhiteSpace(
                            Model.Email)
                            ? null
                            : Model.Email.Trim(),

                    Phone =
                        string.IsNullOrWhiteSpace(
                            Model.Phone)
                            ? null
                            : Model.Phone.Trim(),

                    Street =
                        string.IsNullOrWhiteSpace(
                            Model.Street)
                            ? null
                            : Model.Street.Trim(),

                    PostalCode =
                        string.IsNullOrWhiteSpace(
                            Model.PostalCode)
                            ? null
                            : Model.PostalCode.Trim(),

                    City =
                        string.IsNullOrWhiteSpace(
                            Model.City)
                            ? null
                            : Model.City.Trim(),

                    Country =
                        string.IsNullOrWhiteSpace(
                            Model.Country)
                            ? null
                            : Model.Country.Trim(),

                    VatNumber =
                        string.IsNullOrWhiteSpace(
                            Model.VatNumber)
                            ? null
                            : Model.VatNumber.Trim(),

                    Note =
                        string.IsNullOrWhiteSpace(
                            Model.Note)
                            ? null
                            : Model.Note.Trim(),

                    IsActive =
                        Model.IsActive,

                    CreatedAt =
                        DateTime.UtcNow
                };


            db.Customers.Add(customer);

            await db.SaveChangesAsync();


            Navigation.NavigateTo("/customers");
        }
        catch (Exception ex)
        {
            ErrorMessage =
                L["ErrorSaving", ex.Message];
        }
        finally
        {
            IsSaving = false;
        }
    }


    private class CustomerModel
    {
        [Required(
            ErrorMessageResourceType = typeof(SharedResource),
            ErrorMessageResourceName = "CompanyNameRequired")]
        [MaxLength(200)]
        public string CompanyName { get; set; }
            = string.Empty;


        [MaxLength(100)]
        public string? CustomerNumber { get; set; }


        [MaxLength(150)]
        public string? ContactPerson { get; set; }


        [EmailAddress(
            ErrorMessageResourceType = typeof(SharedResource),
            ErrorMessageResourceName = "InvalidEmailAddress")]
        [MaxLength(200)]
        public string? Email { get; set; }


        [MaxLength(50)]
        public string? Phone { get; set; }


        [MaxLength(300)]
        public string? Street { get; set; }


        [MaxLength(20)]
        public string? PostalCode { get; set; }


        [MaxLength(100)]
        public string? City { get; set; }


        [MaxLength(100)]
        public string? Country { get; set; }


        [MaxLength(50)]
        public string? VatNumber { get; set; }


        [MaxLength(500)]
        public string? Note { get; set; }


        public bool IsActive { get; set; } = true;
    }

}