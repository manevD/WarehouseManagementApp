@page "/stock/movements"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@using WarehouseManagement.Data
@using WarehouseManagement.Localization
@using WarehouseManagement.Models
@using WarehouseManagement.Services

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ExcelExportService ExcelExport
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["StockMovements"]</PageTitle>

<style>
    .movements-filter {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .movements-filter-row {
        display: grid;
        grid-template-columns: minmax(300px, 2fr) minmax(160px, 1fr) minmax(160px, 1fr) minmax(180px, 1.1fr) minmax(180px, 1.1fr);
        gap: 10px;
        width: 100%;
    }

        .movements-filter-row > * {
            min-width: 0;
        }

        .movements-filter-row .search-box {
            width: 100%;
            max-width: none;
        }

        .movements-filter-row .filter-select {
            width: 100%;
        }

    .movements-date-row {
        display: grid;
        grid-template-columns: 1fr 1fr auto;
        gap: 10px;
        align-items: end;
        width: 100%;
    }

    .movements-date-group {
        display: flex;
        flex-direction: column;
        gap: 5px;
        min-width: 0;
    }

        .movements-date-group label {
            font-size: 12px;
            color: #6b7280;
        }

        .movements-date-group input {
            width: 100%;
            height: 40px;
            border: 1px solid var(--border);
            border-radius: 7px;
            padding: 0 10px;
            background: white;
            font-size: 13px;
            color: #374151;
        }

    .movements-reset-button {
        height: 40px;
        white-space: nowrap;
    }

    @@media (max-width: 1200px) {
        .movements-filter-row {
            grid-template-columns: minmax(280px, 2fr) minmax(160px, 1fr) minmax(160px, 1fr);
        }
    }

    @@media (max-width: 850px) {
        .movements-filter-row {
            grid-template-columns: minmax(260px, 2fr) minmax(170px, 1fr);
        }

        .movements-date-row {
            grid-template-columns: 1fr 1fr;
        }

        .movements-reset-button {
            grid-column: 1 / -1;
            width: fit-content;
        }
    }

    @@media (max-width: 600px) {
        .movements-filter-row {
            grid-template-columns: 1fr;
        }

        .movements-date-row {
            grid-template-columns: 1fr;
        }

        .movements-reset-button {
            grid-column: auto;
            width: 100%;
        }
    }
</style>

<div class="stock-page">

    <!-- HEADER -->

    <div class="page-header">

        <div>

            <h1>@L["StockMovements"]</h1>

            <p>
                @L["StockMovementsDescription"]
            </p>

        </div>

        <div>

            <button type="button"
                    class="btn-secondary"
                    @onclick="ExportExcel"
                    disabled="@(PagedMovements.Count == 0)">

                📊 @L["ExportExcel"]

            </button>

            <a href="/stock"
               class="btn-secondary">

                ← @L["Stock"]

            </a>

        </div>

    </div>


    <!-- FILTER -->

    <div class="filter-card movements-filter">

        <!-- FIRST ROW -->

        <div class="movements-filter-row">

            <!-- SEARCH -->

            <div class="search-box">

                <span class="search-icon">
                    ⌕
                </span>

                <input type="text"
                       placeholder="@L["SearchMovementsPlaceholder"]"
                       @bind="SearchTerm"
                       @bind:event="oninput"
                       @bind:after="SearchChanged" />

            </div>


            <!-- TYPE -->

            <select class="filter-select"
                    @bind="SelectedType"
                    @bind:after="FilterChanged">

                <option value="0">
                    @L["AllMovements"]
                </option>

                <option value="@((int)StockMovementType.Wareneingang)">
                    @L["IncomingGoods"]
                </option>

                <option value="@((int)StockMovementType.Warenausgang)">
                    @L["OutgoingGoods"]
                </option>

                <option value="@((int)StockMovementType.Umlagerung)">
                    @L["StockTransfer"]
                </option>

                <option value="@((int)StockMovementType.Inventur)">
                    @L["Inventory"]
                </option>

                <option value="@((int)StockMovementType.Korrektur)">
                    @L["Correction"]
                </option>

            </select>


            <!-- WAREHOUSE -->

            <select class="filter-select"
                    @bind="SelectedWarehouseId"
                    @bind:after="WarehouseChanged">

                <option value="0">
                    @L["AllWarehouses"]
                </option>

                @foreach (var warehouse in Warehouses)
                {
                    <option value="@warehouse.Id">
                        @warehouse.Name
                    </option>
                }

            </select>


            <!-- LOCATION -->

            <select class="filter-select"
                    @bind="SelectedLocationId"
                    @bind:after="FilterChanged">

                <option value="0">
                    @L["AllLocations"]
                </option>

                @foreach (var location in Locations)
                {
                    <option value="@location.Id">

                        @location.Code

                        @if (!string.IsNullOrWhiteSpace(location.Name))
                        {
                            @($" - {location.Name}")
                        }

                    </option>
                }

            </select>


            <!-- SUPPLIER -->

            <select class="filter-select"
                    @bind="SelectedSupplierId"
                    @bind:after="FilterChanged">

                <option value="0">
                    @L["AllSuppliers"]
                </option>

                @foreach (var supplier in Suppliers)
                {
                    <option value="@supplier.Id">

                        @supplier.CompanyName

                        @if (!string.IsNullOrWhiteSpace(
                            supplier.SupplierNumber))
                        {
                            @($" ({supplier.SupplierNumber})")
                        }

                    </option>
                }

            </select>

        </div>


        <!-- SECOND ROW -->

        <div class="movements-date-row">

            <div class="movements-date-group">

                <label>
                    @L["From"]
                </label>

                <input type="date"
                       @bind="FromDate"
                       @bind:after="FilterChanged" />

            </div>


            <div class="movements-date-group">

                <label>
                    @L["To"]
                </label>

                <input type="date"
                       @bind="ToDate"
                       @bind:after="FilterChanged" />

            </div>


            <button type="button"
                    class="btn-secondary movements-reset-button"
                    @onclick="ResetFilters">

                @L["ResetFilters"]

            </button>

        </div>

    </div>


    <!-- ACTIVE FILTER INFO -->
    @if (HasActiveFilters)
    {
        <div class="filter-info">

            <span>
                @L["FiltersActive"]
            </span>

            <strong>
                @L["MovementsCount", Movements.Count]
            </strong>

        </div>
    }


    <!-- SUMMARY -->

    <div class="stock-summary-grid">

        <div class="stock-summary-card">

            <span>
                @L["Movements"]
            </span>

            <strong>
                @Movements.Count
            </strong>

        </div>


        <div class="stock-summary-card">

            <span>
                @L["IncomingGoods"]
            </span>

            <strong>
                @IncomingCount
            </strong>

        </div>


        <div class="stock-summary-card">

            <span>
                @L["OutgoingGoods"]
            </span>

            <strong>
                @OutgoingCount
            </strong>

        </div>


        <div class="stock-summary-card">

            <span>
                @L["StockTransfer"]
            </span>

            <strong>
                @TransferCount
            </strong>

        </div>


        <div class="stock-summary-card">

            <span>
                @L["Correction"]
            </span>

            <strong>
                @CorrectionCount
            </strong>

        </div>

    </div>


    <!-- TABLE -->

    <div class="products-card">

        <div class="products-card-header">

            <div>

                <strong>
                    @L["MovementHistory"]
                </strong>

                <span>
                    @L["EntriesCount", Movements.Count]
                </span>

            </div>

        </div>


        @if (IsLoading)
        {
            <div class="loading-state">

                @L["MovementsLoading"]

            </div>
        }
        else if (Movements.Count == 0)
        {
            <div class="empty-products">

                <div class="empty-products-icon">
                    ↔
                </div>

                <h3>
                    @L["NoMovementsFound"]
                </h3>

                <p>
                    @L["NoMovementsForFilters"]
                </p>

            </div>
        }
        else
        {
            <div class="products-table-wrapper">

                <table class="products-table">

                    <thead>

                        <tr>

                            <th>
                                @L["Date"]
                            </th>

                            <th>
                                @L["Product"]
                            </th>

                            <th>
                                @L["Type"]
                            </th>

                            <th>
                                @L["Quantity"]
                            </th>

                            <th>
                                @L["From"]
                            </th>

                            <th>
                                @L["To"]
                            </th>

                            <th>
                                @L["Supplier"]
                            </th>

                            <th>
                                @L["PurchaseOrder"]
                            </th>

                            <th>
                                @L["ReferenceNumber"]
                            </th>

                            <th>
                                @L["Note"]
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var movement in PagedMovements)
                        {
                            <tr>

                                <!-- DATE -->

                                <td>

                                    <div class="movement-date">

                                        <strong>
                                            @movement.CreatedAt
                                        </strong>

                                    </div>

                                </td>


                                <!-- PRODUCT -->

                                <td>

                                    <div class="product-name">

                                        <div class="product-avatar">

                                            @GetInitials(
                                                movement.Product?.Name)

                                        </div>

                                        <div>

                                            <strong>
                                                @(movement.Product?.Name ?? "-")
                                            </strong>

                                            <small>
                                                @(movement.Product?.SKU ?? "-")
                                            </small>

                                        </div>

                                    </div>

                                </td>


                                <!-- TYPE -->

                                <td>

                                    @switch (movement.Type)
                                    {
                                        case StockMovementType.Wareneingang:

                                            <span class="movement-badge movement-in">
                                                + @L["IncomingGoods"]
                                            </span>

                                            break;


                                        case StockMovementType.Warenausgang:

                                            <span class="movement-badge movement-out">
                                                − @L["OutgoingGoods"]
                                            </span>

                                            break;


                                        case StockMovementType.Umlagerung:

                                            <span class="movement-badge movement-transfer">
                                                ↔ @L["StockTransfer"]
                                            </span>

                                            break;


                                        case StockMovementType.Inventur:

                                            <span class="movement-badge movement-inventory">
                                                @L["Inventory"]
                                            </span>

                                            break;


                                        case StockMovementType.Korrektur:

                                            <span class="movement-badge movement-correction">
                                                @L["Correction"]
                                            </span>

                                            break;


                                        default:

                                            <span class="movement-badge">
                                                @movement.Type
                                            </span>

                                            break;
                                    }

                                </td>


                                <!-- QUANTITY -->

                                <td>

                                    <strong>

                                        @if (movement.Type ==
                                            StockMovementType.Warenausgang)
                                        {
                                            <span>
                                                −@movement.Quantity.ToString("N2")
                                            </span>
                                        }
                                        else if (movement.Type ==
                                                 StockMovementType.Wareneingang)
                                        {
                                            <span>
                                                +@movement.Quantity.ToString("N2")
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                @movement.Quantity.ToString("N2")
                                            </span>
                                        }

                                    </strong>

                                </td>


                                <!-- FROM -->

                                <td>

                                    @if (movement.FromWarehouseLocation != null)
                                    {
                                        <div class="movement-location">

                                            <strong>
                                                @movement.FromWarehouseLocation.Code
                                            </strong>

                                            @if (movement.FromWarehouseLocation.Warehouse != null)
                                            {
                                                <small>
                                                    @movement.FromWarehouseLocation.Warehouse.Name
                                                </small>
                                            }

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- TO -->

                                <td>

                                    @if (movement.ToWarehouseLocation != null)
                                    {
                                        <div class="movement-location">

                                            <strong>
                                                @movement.ToWarehouseLocation.Code
                                            </strong>

                                            @if (movement.ToWarehouseLocation.Warehouse != null)
                                            {
                                                <small>
                                                    @movement.ToWarehouseLocation.Warehouse.Name
                                                </small>
                                            }

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- SUPPLIER -->

                                <td>

                                    @if (movement.Supplier != null)
                                    {
                                        <div class="movement-location">

                                            <strong>
                                                @movement.Supplier.CompanyName
                                            </strong>

                                            @if (!string.IsNullOrWhiteSpace(
                                                movement.Supplier.SupplierNumber))
                                            {
                                                <small>
                                                    @movement.Supplier.SupplierNumber
                                                </small>
                                            }

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- PURCHASE ORDER -->

                                <td>

                                    @if (movement.PurchaseOrder != null)
                                    {
                                        <a href="/purchase-orders/details/@movement.PurchaseOrder.Id"
                                           class="order-number-link">

                                            @movement.PurchaseOrder.OrderNumber

                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- REFERENCE -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        movement.ReferenceNumber))
                                    {
                                        <span>
                                            @movement.ReferenceNumber
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- NOTE -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        movement.Note))
                                    {
                                        <span class="movement-note">
                                            @movement.Note
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- PAGINATION -->
            @if (TotalPages > 1)
            {
                <div class="pagination">

                    <button type="button"
                            class="pagination-button"
                            disabled="@(CurrentPage <= 1)"
                            @onclick="PreviousPage">

                        ‹

                    </button>


                    <div class="pagination-pages">

                        @for (int page = 1; page <= TotalPages; page++)
                        {
                            var pageNumber = page;

                            <button type="button"
                                    class="pagination-button @(CurrentPage == pageNumber ? "active" : "")"
                                    @onclick="() => GoToPage(pageNumber)">

                                @pageNumber

                            </button>
                        }

                    </div>


                    <button type="button"
                            class="pagination-button"
                            disabled="@(CurrentPage >= TotalPages)"
                            @onclick="NextPage">

                        ›

                    </button>

                </div>
            }


            <div class="pagination-info">

                @L[
                    "PaginationInfo",
                    CurrentPage,
                    TotalPages,
                    PagedMovements.Count,
                    Movements.Count
                ]

            </div>
        }

    </div>

</div>


@code {

    // =========================================================
    // DATA
    // =========================================================

    private List<StockMovement> Movements = new();

    private List<Warehouse> Warehouses = new();

    private List<WarehouseLocation> Locations = new();

    private List<Supplier> Suppliers = new();


    // =========================================================
    // PAGINATION
    // =========================================================

    private const int PageSize = 10;

    private int CurrentPage = 1;

    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                Movements.Count /
                (double)PageSize));

    private List<StockMovement> PagedMovements =>
        Movements
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();


    // =========================================================
    // FILTER
    // =========================================================

    private string SearchTerm = string.Empty;

    private int SelectedType;

    private int SelectedWarehouseId;

    private int SelectedLocationId;

    private int SelectedSupplierId;

    private DateTime? FromDate;

    private DateTime? ToDate;


    // =========================================================
    // STATE
    // =========================================================

    private bool IsLoading = true;


    // =========================================================
    // SUMMARY
    // =========================================================

    private int IncomingCount =>
        Movements.Count(x =>
            x.Type ==
            StockMovementType.Wareneingang);


    private int OutgoingCount =>
        Movements.Count(x =>
            x.Type ==
            StockMovementType.Warenausgang);


    private int TransferCount =>
        Movements.Count(x =>
            x.Type ==
            StockMovementType.Umlagerung);


    private int CorrectionCount =>
        Movements.Count(x =>
            x.Type ==
            StockMovementType.Korrektur);


    // =========================================================
    // ACTIVE FILTERS
    // =========================================================

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(SearchTerm)
        ||
        SelectedType > 0
        ||
        SelectedWarehouseId > 0
        ||
        SelectedLocationId > 0
        ||
        SelectedSupplierId > 0
        ||
        FromDate.HasValue
        ||
        ToDate.HasValue;


    // =========================================================
    // INITIALIZATION
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadWarehouses();

        await LoadSuppliers();

        await LoadLocations();

        await LoadMovements();
    }


    // =========================================================
    // LOAD WAREHOUSES
    // =========================================================

    private async Task LoadWarehouses()
    {
        await using var db =
            await DbFactory.CreateDbContextAsync();

        Warehouses =
            await db.Warehouses
                .AsNoTracking()
                .Where(x =>
                    x.IsActive)
                .OrderBy(x =>
                    x.Name)
                .ToListAsync();
    }


    // =========================================================
    // LOAD SUPPLIERS
    // =========================================================

    private async Task LoadSuppliers()
    {
        await using var db =
            await DbFactory.CreateDbContextAsync();

        Suppliers =
            await db.Suppliers
                .AsNoTracking()
                .Where(x =>
                    x.IsActive)
                .OrderBy(x =>
                    x.CompanyName)
                .ToListAsync();
    }


    // =========================================================
    // LOAD LOCATIONS
    // =========================================================

    private async Task LoadLocations()
    {
        await using var db =
            await DbFactory.CreateDbContextAsync();

        var query =
            db.WarehouseLocations
                .AsNoTracking()
                .Where(x =>
                    x.IsActive)
                .AsQueryable();


        if (SelectedWarehouseId > 0)
        {
            query =
                query.Where(x =>
                    x.WarehouseId ==
                    SelectedWarehouseId);
        }


        Locations =
            await query
                .OrderBy(x =>
                    x.Code)
                .ToListAsync();
    }


    // =========================================================
    // LOAD MOVEMENTS
    // =========================================================

    private async Task LoadMovements()
    {
        IsLoading = true;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            var query =
                db.StockMovements
                    .AsNoTracking()

                    .Include(x =>
                        x.Product)

                    .Include(x =>
                        x.Supplier)

                    .Include(x =>
                        x.PurchaseOrder)

                    .Include(x =>
                        x.FromWarehouseLocation)
                    .ThenInclude(x =>
                        x.Warehouse)

                    .Include(x =>
                        x.ToWarehouseLocation)
                    .ThenInclude(x =>
                        x.Warehouse)

                    .AsQueryable();


            // =================================================
            // SEARCH
            // =================================================

            if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                var search =
                    SearchTerm.Trim();


                query =
                    query.Where(x =>

                        (
                            x.Product != null
                            &&
                            x.Product.Name.Contains(search)
                        )

                        ||

                        (
                            x.Product != null
                            &&
                            x.Product.SKU.Contains(search)
                        )

                        ||

                        (
                            x.Product != null
                            &&
                            x.Product.Barcode != null
                            &&
                            x.Product.Barcode.Contains(search)
                        )

                        ||

                        (
                            x.Note != null
                            &&
                            x.Note.Contains(search)
                        )

                        ||

                        (
                            x.ReferenceNumber != null
                            &&
                            x.ReferenceNumber.Contains(search)
                        )

                        ||

                        (
                            x.Supplier != null
                            &&
                            x.Supplier.CompanyName.Contains(search)
                        )

                        ||

                        (
                            x.Supplier != null
                            &&
                            x.Supplier.SupplierNumber != null
                            &&
                            x.Supplier.SupplierNumber.Contains(search)
                        )

                        ||

                        (
                            x.PurchaseOrder != null
                            &&
                            x.PurchaseOrder.OrderNumber.Contains(search)
                        )

                    );
            }


            // =================================================
            // TYPE
            // =================================================

            if (SelectedType > 0)
            {
                var type =
                    (StockMovementType)SelectedType;

                query =
                    query.Where(x =>
                        x.Type == type);
            }


            // =================================================
            // WAREHOUSE
            // =================================================

            if (SelectedWarehouseId > 0)
            {
                query =
                    query.Where(x =>

                        (
                            x.FromWarehouseLocation != null
                            &&
                            x.FromWarehouseLocation.WarehouseId ==
                                SelectedWarehouseId
                        )

                        ||

                        (
                            x.ToWarehouseLocation != null
                            &&
                            x.ToWarehouseLocation.WarehouseId ==
                                SelectedWarehouseId
                        )

                    );
            }


            // =================================================
            // LOCATION
            // =================================================

            if (SelectedLocationId > 0)
            {
                query =
                    query.Where(x =>

                        (
                            x.FromWarehouseLocationId ==
                                SelectedLocationId
                        )

                        ||

                        (
                            x.ToWarehouseLocationId ==
                                SelectedLocationId
                        )

                    );
            }


            // =================================================
            // SUPPLIER
            // =================================================

            if (SelectedSupplierId > 0)
            {
                query =
                    query.Where(x =>
                        x.SupplierId ==
                        SelectedSupplierId);
            }


            // =================================================
            // FROM DATE
            // =================================================

            if (FromDate.HasValue)
            {
                var from =
                    FromDate.Value.Date;

                query =
                    query.Where(x =>
                        x.CreatedAt >= from);
            }


            // =================================================
            // TO DATE
            // =================================================

            if (ToDate.HasValue)
            {
                var to =
                    ToDate.Value.Date.AddDays(1);

                query =
                    query.Where(x =>
                        x.CreatedAt < to);
            }


            // =================================================
            // LOAD
            // =================================================

            Movements =
                await query
                    .OrderByDescending(x =>
                        x.CreatedAt)
                    .ToListAsync();


            CurrentPage = 1;
        }
        finally
        {
            IsLoading = false;
        }
    }


    // =========================================================
    // PAGINATION
    // =========================================================

    private void GoToPage(int page)
    {
        if (page < 1 || page > TotalPages)
            return;

        CurrentPage = page;
    }


    private void PreviousPage()
    {
        if (CurrentPage > 1)
            CurrentPage--;
    }


    private void NextPage()
    {
        if (CurrentPage < TotalPages)
            CurrentPage++;
    }


    // =========================================================
    // EXCEL EXPORT
    // =========================================================

    private async Task ExportExcel()
    {
        var data =
            PagedMovements
                .Where(x => x != null)
                .ToList();


        if (data.Count == 0)
            return;


        var fileBytes =
            ExcelExport.Export(
                data,
                "Bewegungen",
                $"{L["StockMovements"]} – {L["Page"]} {CurrentPage}",

                ("Datum", x =>
                    x.CreatedAt),

                ("SKU", x =>
                    x.Product?.SKU ?? ""),

                ("Produkt", x =>
                    x.Product?.Name ?? ""),

                ("Typ", x =>
                    GetMovementTypeText(x.Type)),

                ("Menge", x =>
                    x.Quantity),

                ("Von", x =>
                    x.FromWarehouseLocation == null
                        ? ""
                        : $"{x.FromWarehouseLocation.Code} - {x.FromWarehouseLocation.Warehouse?.Name ?? ""}"),

                ("Nach", x =>
                    x.ToWarehouseLocation == null
                        ? ""
                        : $"{x.ToWarehouseLocation.Code} - {x.ToWarehouseLocation.Warehouse?.Name ?? ""}"),

                ("Lieferant", x =>
                    x.Supplier?.CompanyName ?? ""),

                ("Bestellung", x =>
                    x.PurchaseOrder?.OrderNumber ?? ""),

                ("Referenz", x =>
                    x.ReferenceNumber ?? ""),

                ("Notiz", x =>
                    x.Note ?? "")
            );


        var base64 =
            Convert.ToBase64String(fileBytes);


        await JS.InvokeVoidAsync(
            "downloadFile",
            $"{L["StockMovements"]}_{L["Page"]}_{CurrentPage}.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            base64);
    }


    // =========================================================
    // MOVEMENT TYPE TEXT
    // =========================================================

    private string GetMovementTypeText(
        StockMovementType type)
    {
        return type switch
        {
            StockMovementType.Wareneingang =>
                L["IncomingGoods"].Value,

            StockMovementType.Warenausgang =>
                L["OutgoingGoods"].Value,

            StockMovementType.Umlagerung =>
                L["StockTransfer"].Value,

            StockMovementType.Inventur =>
                L["Inventory"].Value,

            StockMovementType.Korrektur =>
                L["Correction"].Value,

            _ =>
                type.ToString()
        };
    }


