    // =========================================================
    // INVENTORY STATUS LOCALIZATION
    // =========================================================

    private string GetInventoryStatusText(
        InventoryStatus status)
    {
        return status switch
        {
            InventoryStatus.Entwurf =>
                L["InventoryStatusDraft"],

            InventoryStatus.InBearbeitung =>
                L["InventoryStatusInProgress"],

            InventoryStatus.Abgeschlossen =>
                L["InventoryStatusCompleted"],

            _ => status.ToString()
        };
    }
