@page "/inventory/edit/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using WarehouseManagement.Data
@using WarehouseManagement.Localization
@using WarehouseManagement.Models
@using WarehouseManagement.Components

@inject IStringLocalizer<SharedResource> L
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation


<PageTitle>@L["InventoryDetails"]</PageTitle>


@if (IsLoading)
{
    <div class="loading-state">
        @L["InventoryLoading"]
    </div>
}
else if (Inventory == null)
{
    <div class="empty-products">

        <div class="empty-products-icon">
            ⚠
        </div>

        <h3>
            @L["InventoryNotFound"]
        </h3>

        <a href="/inventory"
           class="btn-primary">
            @L["BackToInventories"]
        </a>

    </div>
}
else
{
    <div class="product-form-page">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="page-header">

            <div>

                <h1>
                    @L["InventoryNumber", Inventory.Id]
                </h1>

                <p>
                    @(Inventory.Warehouse?.Name ?? "-")
                </p>

            </div>

            <div class="page-header-actions">

                <a href="/inventory"
                   class="btn-secondary">
                    ← @L["Back"]
                </a>

                @if (Inventory.Status != InventoryStatus.Abgeschlossen)
                {
                    <button type="button"
                            class="btn-secondary"
                            disabled="@IsSaving"
                            @onclick="SaveInventory">

                        @(IsSaving
                            ? L["Saving"]
                            : L["SaveDraft"])

                    </button>

                    <button type="button"
                            class="btn-primary"
                            disabled="@(IsSaving || Items.Count == 0)"
                            @onclick="ShowCompleteConfirmation">

                        ✓ @L["CompleteInventory"]

                    </button>
                }

            </div>

        </div>


        <!-- =====================================================
             STATUS / INFO
             ===================================================== -->

        <div class="inventory-info-bar">

            <div class="inventory-info-item">

                <span class="inventory-info-label">
                    @L["Status"]
                </span>

                @if (Inventory.Status == InventoryStatus.Entwurf)
                {
                    <span class="status-badge status-draft">
                        @GetInventoryStatusText(
                            InventoryStatus.Entwurf)
                    </span>
                }
                else if (Inventory.Status == InventoryStatus.InBearbeitung)
                {
                    <span class="status-badge status-warning">
                        @GetInventoryStatusText(
                            InventoryStatus.InBearbeitung)
                    </span>
                }
                else
                {
                    <span class="status-badge status-active">
                        @GetInventoryStatusText(
                            InventoryStatus.Abgeschlossen)
                    </span>
                }

            </div>


            <div class="inventory-info-item">

                <span class="inventory-info-label">
                    @L["Warehouse"]
                </span>

                <strong>
                    @(Inventory.Warehouse?.Name ?? "-")
                </strong>

            </div>


            <div class="inventory-info-item">

                <span class="inventory-info-label">
                    @L["CreatedAt"]
                </span>

                <strong>
                    @Inventory.CreatedAt
                </strong>

            </div>


            @if (Inventory.CompletedAt.HasValue)
            {
                <div class="inventory-info-item">

                    <span class="inventory-info-label">
                        @L["CompletedAt"]
                    </span>

                    <strong>
                        @Inventory.CompletedAt.Value
                    </strong>

                </div>
            }

        </div>


        <!-- =====================================================
             MESSAGE
             ===================================================== -->
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="form-error mb-3">
                @ErrorMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(SuccessMessage))
        {
            <div class="form-success mb-3">
                @SuccessMessage
            </div>
        }


        <!-- =====================================================
             MAIN CARD
             ===================================================== -->

        <div class="form-card">

            <!-- =================================================
                 SUMMARY
                 ================================================= -->

            <div class="form-section">

                <div class="form-section-title">

                    <h2>
                        @L["InventoryOverview"]
                    </h2>

                    <p>
                        @L["InventoryComparisonDescription"]
                    </p>

                </div>


                <div class="stock-summary-grid">

                    <div class="stock-summary-card">

                        <span>
                            @L["Positions"]
                        </span>

                        <strong>
                            @Items.Count
                        </strong>

                    </div>


                    <div class="stock-summary-card">

                        <span>
                            @L["SystemStock"]
                        </span>

                        <strong>
                            @TotalSystemQuantity
                        </strong>

                    </div>


                    <div class="stock-summary-card">

                        <span>
                            @L["Counted"]
                        </span>

                        <strong>
                            @TotalCountedQuantity
                        </strong>

                    </div>


                    <div class="stock-summary-card">

                        <span>
                            @L["DifferentPositions"]
                        </span>

                        <strong>
                            @DifferenceCount
                        </strong>

                    </div>


                    <div class="stock-summary-card">

                        <span>
                            @L["TotalDifference"]
                        </span>

                        <strong>
                            @FormatDifference(TotalDifference)
                        </strong>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 NOTE
                 ================================================= -->
            @if (!string.IsNullOrWhiteSpace(Inventory.Note))
            {
                <div class="form-section">

                    <div class="form-section-title">

                        <h2>
                            @L["Note"]
                        </h2>

                    </div>

                    <div class="note-box">
                        @Inventory.Note
                    </div>

                </div>
            }


            <!-- =================================================
                 SEARCH
                 ================================================= -->

            <div class="form-section">

                <div class="form-section-title">

                    <h2>
                        @L["StockCount"]
                    </h2>

                    <p>
                        @L["EnterCountedQuantities"]
                    </p>

                </div>


                <div class="filter-card">

                    <div class="search-box">

                        <span class="search-icon">
                            🔎
                        </span>

                        <input type="text"
                               placeholder="@L["SearchProductSkuLocation"]"
                               @bind="SearchText"
                               @bind:event="oninput" />

                    </div>


                    <SearchableSelect TItem="WarehouseLocation"
                                      TValue="int"
                                      Items="Locations"
                                      Value="SelectedLocationId"
                                      ValueChanged="OnLocationChanged"
                                      ValueSelector="@(x => x.Id)"
                                      TextSelector="@(x => string.IsNullOrWhiteSpace(x.Name)
                                                              ? x.Code
                                                              : $"{x.Code} - {x.Name}")"
                                      Placeholder="@L["AllLocations"]"
                                      NoResultsText="@L["NoResultsFound"]"
                                      ShowAllOption="true"
                                      AllOptionText="@L["AllLocations"]"
                                      AllValue="0" />


                    @if (!string.IsNullOrWhiteSpace(SearchText)
                        || SelectedLocationId > 0)
                    {
                        <button type="button"
                                class="btn-secondary"
                                @onclick="ClearFilters">

                            @L["ResetFilters"]

                        </button>
                    }

                </div>

            </div>


            <!-- =================================================
                 ITEMS TABLE
                 ================================================= -->

            <div class="form-section">

                @if (FilteredItems.Count == 0)
                {
                    <div class="empty-products">

                        <div class="empty-products-icon">
                            📦
                        </div>

                        <h3>
                            @L["NoPositionsFound"]
                        </h3>

                        <p>
                            @L["NoPositionMatchesFilter"]
                        </p>

                    </div>
                }
                else
                {
                    <div class="products-table-wrapper">

                        <table class="products-table">

                            <thead>

                                <tr>

                                    <th>
                                        @L["Product"]
                                    </th>

                                    <th>
                                        SKU
                                    </th>

                                    <th>
                                        @L["Location"]
                                    </th>

                                    <th>
                                        @L["SystemStock"]
                                    </th>

                                    <th>
                                        @L["Counted"]
                                    </th>

                                    <th>
                                        @L["Difference"]
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var item in FilteredItems)
                                {
                                    <tr>

                                        <!-- PRODUCT -->

                                        <td>

                                            <div class="product-name">

                                                <div class="product-avatar">
                                                    @GetInitials(
                                                        item.ProductName)
                                                </div>

                                                <div>

                                                    <strong>
                                                        @item.ProductName
                                                    </strong>

                                                    @if (!string.IsNullOrWhiteSpace(
                                                        item.Barcode))
                                                    {
                                                        <small>
                                                            @item.Barcode
                                                        </small>
                                                    }

                                                </div>

                                            </div>

                                        </td>


                                        <!-- SKU -->

                                        <td>
                                            @item.SKU
                                        </td>


                                        <!-- LOCATION -->

                                        <td>

                                            <div class="movement-location">

                                                <strong>
                                                    @item.LocationCode
                                                </strong>

                                                @if (!string.IsNullOrWhiteSpace(
                                                    item.LocationName))
                                                {
                                                    <small>
                                                        @item.LocationName
                                                    </small>
                                                }

                                            </div>

                                        </td>


                                        <!-- SYSTEM -->

                                        <td>

                                            <strong>
                                                @item.SystemQuantity.ToString("N2")
                                            </strong>

                                        </td>


                                        <!-- COUNTED -->

                                        <td style="min-width:150px;">

                                            @if (Inventory.Status ==
                                                InventoryStatus.Abgeschlossen)
                                            {
                                                <strong>
                                                    @(item.CountedQuantity?.ToString("N2") ?? "-")
                                                </strong>
                                            }
                                            else
                                            {
                                                <input type="number"
                                                       class="form-control"
                                                       min="0"
                                                       step="0.01"
                                                       value="@(item.CountedQuantity?
                                                                                                                                                           .ToString(
                                                                                                                                                               System.Globalization
                                                                                                                                                                   .CultureInfo
                                                                                                                                                                   .InvariantCulture)
                                                                                                                                                           ?? "")"
                                                       @oninput="e =>
                                                                                                                                                           CountedQuantityChanged(
                                                                                                                                                               item,
                                                                                                                                                               e.Value?.ToString())" />
                                            }

                                        </td>


                                        <!-- DIFFERENCE -->

                                        <td>

                                            @{
                                                var difference =
                                                    (item.CountedQuantity ?? 0)
                                                    - item.SystemQuantity;
                                            }

                                            @if (difference > 0)
                                            {
                                                <span class="status-badge status-active">
                                                    +@difference.ToString("N2")
                                                </span>
                                            }
                                            else if (difference < 0)
                                            {
                                                <span class="status-badge status-low">
                                                    @difference.ToString("N2")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-badge">
                                                    0,00
                                                </span>
                                            }

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>


            <!-- =================================================
                 BOTTOM ACTIONS
                 ================================================= -->

            <div class="form-actions">

                <a href="/inventory"
                   class="btn-secondary">
                    ← @L["Back"]
                </a>
                &nbsp;

                @if (Inventory.Status != InventoryStatus.Abgeschlossen)
                {
                    <button type="button"
                            class="btn-secondary"
                            disabled="@IsSaving"
                            @onclick="SaveInventory">

                        @(IsSaving
                            ? L["Saving"]
                            : L["SaveDraft"])

                    </button>

                    <button type="button"
                            class="btn-primary"
                            disabled="@(IsSaving || Items.Count == 0)"
                            @onclick="ShowCompleteConfirmation">

                        ✓ @L["CompleteInventory"]

                    </button>
                }

            </div>

        </div>

    </div>


    <!-- =========================================================
         CONFIRM COMPLETE
         ========================================================= -->
    @if (ShowCompleteDialog)
    {
        <div class="modal-backdrop-custom">

            <div class="confirm-dialog">

                <div class="confirm-warning-icon">
                    ⚠
                </div>

                <h3>
                    @L["CompleteInventoryQuestion"]
                </h3>

                <p>
                    @L["CompleteInventoryDescription"]
                </p>


                @if (DifferenceCount > 0)
                {
                    <div class="confirm-warning">

                        <strong>
                            @L[
                                "DifferentPositionsWithCount",
                                DifferenceCount
                            ]
                        </strong>

                        <p>
                            @L["TotalDifferenceWithValue",
                                FormatDifference(TotalDifference)]
                        </p>

                    </div>
                }


                <div class="form-actions">

                    <button type="button"
                            class="btn-secondary"
                            disabled="@IsSaving"
                            @onclick="CancelComplete">

                        @L["Cancel"]

                    </button>


                    <button type="button"
                            class="btn-primary"
                            disabled="@IsSaving"
                            @onclick="CompleteInventory">

                        @(IsSaving
                            ? L["Completing"]
                            : L["YesCompleteInventory"])

                    </button>

                </div>

            </div>

        </div>
    }
}


@code {

    // =========================================================
    // PARAMETER
    // =========================================================

    [Parameter]
    public int Id { get; set; }


    // =========================================================
    // DATA
    // =========================================================

    private Inventory? Inventory;

    private List<InventoryRow> Items = new();

    private List<WarehouseLocation> Locations = new();


    // =========================================================
    // FILTER
    // =========================================================

    private string SearchText = string.Empty;

    private int SelectedLocationId;


    // =========================================================
    // STATE
    // =========================================================

    private bool IsLoading = true;

    private bool IsSaving;

    private bool ShowCompleteDialog;

    private string? ErrorMessage;

    private string? SuccessMessage;


    // =========================================================
    // FILTERED ITEMS
    // =========================================================

    private List<InventoryRow> FilteredItems =>
        Items
            .Where(x =>
                string.IsNullOrWhiteSpace(SearchText)
                ||
                x.ProductName.Contains(
                    SearchText,
                    StringComparison.OrdinalIgnoreCase)
                ||
                x.SKU.Contains(
                    SearchText,
                    StringComparison.OrdinalIgnoreCase)
                ||
                x.LocationCode.Contains(
                    SearchText,
                    StringComparison.OrdinalIgnoreCase)
                ||
                (
                    !string.IsNullOrWhiteSpace(x.LocationName)
                    &&
                    x.LocationName.Contains(
                        SearchText,
                        StringComparison.OrdinalIgnoreCase)
                )
                ||
                (
                    !string.IsNullOrWhiteSpace(x.Barcode)
                    &&
                    x.Barcode.Contains(
                        SearchText,
                        StringComparison.OrdinalIgnoreCase)
                ))
            .Where(x =>
                SelectedLocationId == 0
                ||
                x.WarehouseLocationId ==
                    SelectedLocationId)
            .OrderBy(x => x.LocationCode)
            .ThenBy(x => x.ProductName)
            .ToList();


    // =========================================================
    // SUMMARY
    // =========================================================

    private decimal TotalSystemQuantity =>
        Items.Sum(x => x.SystemQuantity);


    private decimal TotalCountedQuantity =>
        Items.Sum(x => x.CountedQuantity ?? 0);


    private decimal TotalDifference =>
        Items.Sum(x =>
            (x.CountedQuantity ?? 0)
            - x.SystemQuantity);


    private int DifferenceCount =>
        Items.Count(x =>
            (x.CountedQuantity ?? 0)
            != x.SystemQuantity);


    // =========================================================
    // INITIALIZATION
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadInventory();
    }


    // =========================================================
    // LOAD
    // =========================================================

    private async Task LoadInventory()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            Inventory =
                await db.Inventories
                    .AsNoTracking()
                    .Include(x => x.Warehouse)
                    .FirstOrDefaultAsync(x =>
                        x.Id == Id);


            if (Inventory == null)
                return;


            Items =
                await db.InventoryItems
                    .AsNoTracking()
                    .Where(x =>
                        x.InventoryId == Id)
                    .Include(x => x.Product)
                    .Include(x => x.WarehouseLocation)
                    .Select(x => new InventoryRow
                    {
                        Id = x.Id,

                        ProductId = x.ProductId,

                        WarehouseLocationId =
                            x.WarehouseLocationId,

                        ProductName =
                            x.Product != null
                                ? x.Product.Name
                                : "-",

                        SKU =
                            x.Product != null
                                ? x.Product.SKU
                                : "-",

                        Barcode =
                            x.Product != null
                                ? x.Product.Barcode
                                : null,

                        LocationCode =
                            x.WarehouseLocation != null
                                ? x.WarehouseLocation.Code
                                : "-",

                        LocationName =
                            x.WarehouseLocation != null
                                ? x.WarehouseLocation.Name
                                : null,

                        SystemQuantity =
                            x.SystemQuantity,

                        CountedQuantity =
                            x.CountedQuantity
                    })
                    .OrderBy(x =>
                        x.LocationCode)
                    .ThenBy(x =>
                        x.ProductName)
                    .ToListAsync();


            Locations =
                await db.WarehouseLocations
                    .AsNoTracking()
                    .Where(x =>
                        x.WarehouseId ==
                            Inventory.WarehouseId
                        &&
                        x.IsActive)
                    .OrderBy(x =>
                        x.Code)
                    .ToListAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage =
                L["ErrorLoadingInventory", ex.Message];
        }
        finally
        {
            IsLoading = false;
        }
    }


    // =========================================================
    // COUNTED QUANTITY
    // =========================================================

    private void CountedQuantityChanged(
        InventoryRow item,
        string? value)
    {
        if (Inventory?.Status ==
            InventoryStatus.Abgeschlossen)
        {
            return;
        }


        if (string.IsNullOrWhiteSpace(value))
        {
            item.CountedQuantity = null;
            SuccessMessage = null;
            return;
        }


        if (decimal.TryParse(
            value,
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture,
            out var quantity))
        {
            item.CountedQuantity =
                Math.Max(0, quantity);

            SuccessMessage = null;
        }
    }


    // =========================================================
    // SAVE
    // =========================================================

    private async Task SaveInventory()
    {
        if (Inventory == null ||
            Inventory.Status ==
                InventoryStatus.Abgeschlossen ||
            IsSaving)
        {
            return;
        }


        IsSaving = true;
        ErrorMessage = null;
        SuccessMessage = null;


        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            var inventory =
                await db.Inventories
                    .Include(x => x.Items)
                    .FirstOrDefaultAsync(x =>
                        x.Id == Id);


            if (inventory == null)
            {
                ErrorMessage =
                    L["InventoryNotFound"];

                return;
            }


            if (inventory.Status ==
                InventoryStatus.Abgeschlossen)
            {
                ErrorMessage =
                    L["InventoryAlreadyCompleted"];

                return;
            }


            foreach (var dbItem in inventory.Items)
            {
                var row =
                    Items.FirstOrDefault(x =>
                        x.Id == dbItem.Id);


                if (row == null)
                    continue;


                dbItem.CountedQuantity =
                    row.CountedQuantity;

                dbItem.Difference =
                    Math.Round(
                        (row.CountedQuantity ?? 0)
                        - dbItem.SystemQuantity,
                        2);
            }


            if (inventory.Status ==
                InventoryStatus.Entwurf)
            {
                inventory.Status =
                    InventoryStatus.InBearbeitung;
            }


            await db.SaveChangesAsync();


            Inventory.Status =
                inventory.Status;


            SuccessMessage =
                L["InventorySaved"];
        }
        catch (Exception ex)
        {
            ErrorMessage =
                L["ErrorSavingInventory", ex.Message];
        }
        finally
        {
            IsSaving = false;
        }
    }


    // =========================================================
    // COMPLETE CONFIRMATION
    // =========================================================

    private void ShowCompleteConfirmation()
    {
        if (Inventory == null ||
            Inventory.Status ==
                InventoryStatus.Abgeschlossen)
        {
            return;
        }


        ErrorMessage = null;
        SuccessMessage = null;

        ShowCompleteDialog = true;
    }


    private void CancelComplete()
    {
        ShowCompleteDialog = false;
    }


    // =========================================================
    // COMPLETE INVENTORY
    // =========================================================

    private async Task CompleteInventory()
    {
        if (Inventory == null ||
            Inventory.Status ==
                InventoryStatus.Abgeschlossen ||
            IsSaving)
        {
            return;
        }


        IsSaving = true;
        ErrorMessage = null;
        SuccessMessage = null;


        await using var db =
            await DbFactory.CreateDbContextAsync();

        await using var transaction =
            await db.Database.BeginTransactionAsync();


        try
        {
            var inventory =
                await db.Inventories
                    .Include(x => x.Items)
                    .FirstOrDefaultAsync(x =>
                        x.Id == Id);


            if (inventory == null)
            {
                ErrorMessage =
                    L["InventoryNotFound"];

                return;
            }


            if (inventory.Status ==
                InventoryStatus.Abgeschlossen)
            {
                ErrorMessage =
                    L["InventoryAlreadyCompleted"];

                return;
            }


            foreach (var dbItem in inventory.Items)
            {
                var row =
                    Items.FirstOrDefault(x =>
                        x.Id == dbItem.Id);


                if (row == null)
                {
                    throw new InvalidOperationException(
                        L["InventoryPositionNotFound"]);
                }


                if (!row.CountedQuantity.HasValue)
                {
                    throw new InvalidOperationException(
                        L[
                            "NoQuantityForProduct",
                            row.ProductName
                        ]);
                }


                var countedQuantity =
                    row.CountedQuantity.Value;


                if (countedQuantity < 0)
                {
                    throw new InvalidOperationException(
                        L["CountedQuantityCannotBeNegative"]);
                }


                // -------------------------------------------------
                // CURRENT STOCK
                // -------------------------------------------------

                var stock =
                    await db.Stocks
                        .FirstOrDefaultAsync(x =>
                            x.ProductId ==
                                dbItem.ProductId
                            &&
                            x.WarehouseLocationId ==
                                dbItem.WarehouseLocationId);


                if (stock == null)
                {
                    throw new InvalidOperationException(
                        L[
                            "NoStockForProduct",
                            dbItem.ProductId
                        ]);
                }


                /*
                 * WICHTIG:
                 *
                 * Die Differenz wird gegen den AKTUELLEN Bestand
                 * berechnet.
                 *
                 * Falls seit Start der Inventur ein Wareneingang,
                 * Warenausgang oder eine Umlagerung stattgefunden
                 * hat, überschreiben wir den Bestand nicht blind.
                 */

                var currentQuantity =
                    stock.Quantity;

                var difference =
                    countedQuantity -
                    currentQuantity;


                dbItem.CountedQuantity =
                    countedQuantity;

                dbItem.Difference =
                    countedQuantity -
                    dbItem.SystemQuantity;


                // -------------------------------------------------
                // NO DIFFERENCE
                // -------------------------------------------------

                if (difference == 0)
                    continue;


                // -------------------------------------------------
                // RESERVED STOCK PROTECTION
                // -------------------------------------------------

                if (countedQuantity <
                    stock.ReservedQuantity)
                {
                    throw new InvalidOperationException(
                        L[
                            "CountedBelowReserved",
                            countedQuantity,
                            stock.ReservedQuantity
                        ]);
                }


                // -------------------------------------------------
                // STOCK MOVEMENT
                // -------------------------------------------------

                var movement =
                    new StockMovement
                    {
                        ProductId =
                            dbItem.ProductId,

                        Quantity =
                            Math.Abs(difference),

                        Type =
                            StockMovementType.Inventur,

                        FromWarehouseLocationId =
                            difference < 0
                                ? dbItem.WarehouseLocationId
                                : null,

                        ToWarehouseLocationId =
                            difference > 0
                                ? dbItem.WarehouseLocationId
                                : null,

                        ReferenceNumber =
                            $"INV-{inventory.Id}",

                        Note =
                            L[
                                "InventoryMovementNote",
                                inventory.Id,
                                currentQuantity,
                                countedQuantity
                            ],

                        CreatedAt =
                            DateTime.UtcNow
                    };


                db.StockMovements.Add(
                    movement);


                // -------------------------------------------------
                // UPDATE STOCK
                // -------------------------------------------------

                stock.Quantity =
                    countedQuantity;

                stock.UpdatedAt =
                    DateTime.UtcNow;
            }


            // =====================================================
            // COMPLETE
            // =====================================================

            inventory.Status =
                InventoryStatus.Abgeschlossen;

            inventory.CompletedAt =
                DateTime.UtcNow;


            await db.SaveChangesAsync();

            await transaction.CommitAsync();


            ShowCompleteDialog = false;


            await LoadInventory();


            SuccessMessage =
                L["InventoryCompletedSuccessfully"];
        }
        catch (Exception ex)
        {
            await transaction.RollbackAsync();

            ErrorMessage =
                L[
                    "ErrorCompletingInventory",
                    ex.Message
                ];
        }
        finally
        {
            IsSaving = false;
        }
    }


