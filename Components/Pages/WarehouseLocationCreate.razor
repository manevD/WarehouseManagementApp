@page "/locations/create"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using WarehouseManagement.Data
@using WarehouseManagement.Localization
@using WarehouseManagement.Models

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["NewStorageLocation"]</PageTitle>

<div class="product-form-page">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="page-header">

        <div>

            <h1>
                @L["NewStorageLocation"]
            </h1>

            <p>
                @L["CreateNewStorageLocationDescription"]
            </p>

        </div>


        <a href="/locations"
           class="btn-secondary">

            ← @L["Back"]

        </a>

    </div>


    <!-- =========================================================
         FORM
         ========================================================= -->

    <div class="form-card">

        <EditForm Model="@Model"
                  OnValidSubmit="@SaveLocation"
                  FormName="WarehouseLocationCreateForm">

            <DataAnnotationsValidator />


            <!-- =================================================
                 STORAGE LOCATION INFORMATION
                 ================================================= -->

            <div class="form-section">

                <div class="form-section-title">

                    <h2>
                        @L["StorageLocationInformation"]
                    </h2>

                    <p>
                        @L["StorageLocationInformationDescription"]
                    </p>

                </div>


                <div class="form-grid">


                    <!-- =========================================
                         WAREHOUSE
                         ========================================= -->

                    <div class="form-group">

                        <label>
                            @L["Warehouse"]
                            <span>*</span>
                        </label>


                        <SearchableSelect TItem="Warehouse"
                                          TValue="int"
                                          Items="Warehouses"
                                          @bind-Value="Model.WarehouseId"
                                          ValueSelector="@(x => x.Id)"
                                          TextSelector="@(x => x.Name ?? "")"
                                          Placeholder="@L["SelectWarehouse"]"
                                          NoResultsText="@L["NoResultsFound"]"
                                          Disabled="@IsSaving" />


                        <ValidationMessage
                            For="@(() => Model.WarehouseId)" />

                    </div>


                    <!-- =========================================
                         CODE
                         ========================================= -->

                    <div class="form-group">

                        <label>
                            @L["Code"]
                            <span>*</span>
                        </label>


                        <InputText @bind-Value="Model.Code"
                                   class="form-control"
                                   placeholder="@L["StorageLocationCodePlaceholder"]" />


                        <ValidationMessage
                            For="@(() => Model.Code)" />

                    </div>


                    <!-- =========================================
                         NAME
                         ========================================= -->

                    <div class="form-group">

                        <label>
                            @L["Name"]
                        </label>


                        <InputText @bind-Value="Model.Name"
                                   class="form-control"
                                   placeholder="@L["StorageLocationNamePlaceholder"]" />

                    </div>


                    <!-- =========================================
                         ACTIVE
                         ========================================= -->

                    <div class="form-group checkbox-group">

                        <label class="checkbox-label">

                            <InputCheckbox
                                @bind-Value="Model.IsActive" />

                            <span>
                                @L["StorageLocationIsActive"]
                            </span>

                        </label>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 DESCRIPTION
                 ================================================= -->

            <div class="form-section">

                <div class="form-section-title">

                    <h2>
                        @L["Description"]
                    </h2>

                </div>


                <div class="form-group">

                    <InputTextArea
                        @bind-Value="Model.Description"
                        class="form-control textarea"
                        rows="5"
                        placeholder="@L["StorageLocationDescriptionPlaceholder"]" />

                </div>

            </div>


            <!-- =================================================
                 ERROR
                 ================================================= -->

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="form-error">

                    @ErrorMessage

                </div>
            }


            <!-- =================================================
                 ACTIONS
                 ================================================= -->

            <div class="form-actions">

                <a href="/locations"
                   class="btn-secondary">

                    @L["Cancel"]

                </a>


                <button type="submit"
                        class="btn-primary"
                        disabled="@IsSaving">

                    @(IsSaving
                        ? L["Saving"]
                        : L["SaveStorageLocation"])

                </button>

            </div>

        </EditForm>

    </div>

</div>


@code {

    // =========================================================
    // MODEL
    // =========================================================

    private LocationModel Model = new();


    // =========================================================
    // DATA
    // =========================================================

    private List<Warehouse> Warehouses = new();


    // =========================================================
    // STATE
    // =========================================================

    private bool IsSaving;

    private string? ErrorMessage;


    // =========================================================
    // INITIALIZE
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        await using var db =
            await DbFactory.CreateDbContextAsync();


        Warehouses =
            await db.Warehouses
                .Where(x => x.IsActive)
                .OrderBy(x => x.Name)
                .ToListAsync();
    }


    // =========================================================
    // SAVE LOCATION
    // =========================================================

    private async Task SaveLocation()
    {
        if (IsSaving)
        {
            return;
        }


        IsSaving = true;

        ErrorMessage = null;


        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();


            // =================================================
            // NORMALIZE CODE
            // =================================================

            var code =
                Model.Code
                    .Trim()
                    .ToUpper();


            // =================================================
            // CHECK WAREHOUSE
            // =================================================

            var warehouseExists =
                await db.Warehouses
                    .AnyAsync(x =>
                        x.Id ==
                            Model.WarehouseId
                        &&
                        x.IsActive);


            if (!warehouseExists)
            {
                ErrorMessage =
                    L["SelectedWarehouseNotFound"].Value;

                return;
            }


            // =================================================
            // CHECK DUPLICATE CODE
            // =================================================

            var codeExists =
                await db.WarehouseLocations
                    .AnyAsync(x =>
                        x.WarehouseId ==
                            Model.WarehouseId
                        &&
                        x.Code == code);


            if (codeExists)
            {
                ErrorMessage =
                    L["StorageLocationCodeAlreadyExists"].Value;

                return;
            }


            // =================================================
            // CREATE LOCATION
            // =================================================

            var location =
                new WarehouseLocation
                {
                    WarehouseId =
                        Model.WarehouseId,

                    Code =
                        code,

                    Name =
                        string.IsNullOrWhiteSpace(
                            Model.Name)

                            ? null

                            : Model.Name.Trim(),

                    Description =
                        string.IsNullOrWhiteSpace(
                            Model.Description)

                            ? null

                            : Model.Description.Trim(),

                    IsActive =
                        Model.IsActive
                };


            // =================================================
            // SAVE
            // =================================================

            db.WarehouseLocations.Add(
                location);


            await db.SaveChangesAsync();


            // =================================================
            // REDIRECT
            // =================================================

            Navigation.NavigateTo(
                "/locations");
        }
        catch (Exception ex)
        {
            ErrorMessage =
                $"{L["ErrorSaving"].Value}: {ex.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }


    // =========================================================
    // FORM MODEL
    // =========================================================

    private class LocationModel
    {
        // =====================================================
        // WAREHOUSE
        // =====================================================

        [Range(
            1,
            int.MaxValue,
            ErrorMessageResourceType =
                typeof(SharedResource),
            ErrorMessageResourceName =
                "WarehouseRequired")]
        public int WarehouseId { get; set; }


        // =====================================================
        // CODE
        // =====================================================

        [Required(
            ErrorMessageResourceType =
                typeof(SharedResource),
            ErrorMessageResourceName =
                "CodeRequired")]
        [MaxLength(50)]
        public string Code { get; set; }
            = string.Empty;


        // =====================================================
        // NAME
        // =====================================================

        [MaxLength(200)]
        public string? Name { get; set; }


        // =====================================================
        // DESCRIPTION
        // =====================================================

        [MaxLength(500)]
        public string? Description { get; set; }


        // =====================================================
        // ACTIVE
        // =====================================================

        public bool IsActive { get; set; } = true;
    }

}