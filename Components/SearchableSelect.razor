@typeparam TItem
@typeparam TValue
@implements IAsyncDisposable

@using Microsoft.JSInterop
@inject IJSRuntime JS

<div @ref="SelectElement"
     class="searchable-select @(Disabled ? "disabled" : "")">

    <div class="searchable-select-input">

        <input type="text"
               class="form-control"
               value="@SearchText"
               @oninput="OnSearchInput"
               @onclick="OpenDropdown"
               disabled="@Disabled"
               placeholder="@Placeholder"
               autocomplete="off" />

        <span class="searchable-select-arrow"
              @onclick="ToggleDropdown">
            @(IsOpen ? "▲" : "▼")
        </span>

    </div>


    @if (IsOpen && !Disabled)
    {
        <div class="searchable-select-dropdown">

            @* ALL OPTION *@
            @if (ShowAllOption)
            {
                <button type="button"
                        class="searchable-select-option searchable-select-all"
                        @onclick="SelectAll">

                    @AllOptionText

                </button>
            }


            @* SEARCH RESULTS *@
            @if (FilteredItems.Any())
            {
                @foreach (var item in FilteredItems)
                {
                    <button type="button"
                            class="searchable-select-option"
                            @onclick="() => SelectItem(item)">

                        @TextSelector(item)

                    </button>
                }
            }
            else
            {
                <div class="searchable-select-no-results">
                    @NoResultsText
                </div>
            }

        </div>
    }

</div>


@code {

    // =========================================================
    // PARAMETERS
    // =========================================================

    [Parameter]
    public IEnumerable<TItem> Items { get; set; }
        = Enumerable.Empty<TItem>();


    [Parameter]
    public TValue Value { get; set; }
        = default!;


    [Parameter]
    public EventCallback<TValue> ValueChanged { get; set; }


    [Parameter]
    public Func<TItem, TValue> ValueSelector { get; set; }
        = default!;


    [Parameter]
    public Func<TItem, string> TextSelector { get; set; }
        = default!;


    [Parameter]
    public string Placeholder { get; set; }
        = "Search...";


    [Parameter]
    public string NoResultsText { get; set; }
        = "No results found";


    [Parameter]
    public bool Disabled { get; set; }


    // =========================================================
    // ALL OPTION
    // =========================================================

    [Parameter]
    public bool ShowAllOption { get; set; }


    [Parameter]
    public string AllOptionText { get; set; }
        = "All";


    [Parameter]
    public TValue AllValue { get; set; }
        = default!;


    // =========================================================
    // AFTER VALUE CHANGED
    // =========================================================

    [Parameter]
    public EventCallback AfterValueChanged { get; set; }


    // =========================================================
    // STATE
    // =========================================================

    private bool IsOpen;

    private string SearchText = "";

    private TValue LastValue = default!;

    private bool IsInitialized;

    private ElementReference SelectElement;

    private IJSObjectReference? JsModule;

    private DotNetObjectReference<SearchableSelect<TItem, TValue>>?
        DotNetReference;


    // =========================================================
    // FILTERED ITEMS
    // =========================================================

    private IEnumerable<TItem> FilteredItems
    {
        get
        {
            if (Items == null)
                return Enumerable.Empty<TItem>();

            if (string.IsNullOrWhiteSpace(SearchText))
                return Items;

            return Items.Where(item =>
            {
                if (TextSelector == null)
                    return false;

                var text = TextSelector(item);

                return !string.IsNullOrWhiteSpace(text)
                       &&
                       text.Contains(
                           SearchText,
                           StringComparison.OrdinalIgnoreCase);
            });
        }
    }


    // =========================================================
    // PARAMETERS CHANGED
    // =========================================================

    protected override void OnParametersSet()
    {
        var valueChanged =
            !EqualityComparer<TValue>.Default.Equals(
                Value,
                LastValue);


        if (!IsInitialized || valueChanged)
        {
            LastValue = Value;


            // ALL VALUE
            if (EqualityComparer<TValue>.Default.Equals(
                    Value,
                    AllValue))
            {
                SearchText = "";
            }
            else
            {
                var selectedItem =
                    Items.FirstOrDefault(item =>
                        EqualityComparer<TValue>.Default.Equals(
                            ValueSelector(item),
                            Value));


                if (selectedItem is not null)
                {
                    SearchText =
                        TextSelector(selectedItem);
                }
                else
                {
                    SearchText = "";
                }
            }


            IsInitialized = true;
        }


        if (Disabled)
        {
            IsOpen = false;
        }
    }


    // =========================================================
    // OPEN
    // =========================================================

    private async Task OpenDropdown()
    {
        if (Disabled)
            return;


        IsOpen = true;

        await RegisterOutsideClick();
    }


    // =========================================================
    // TOGGLE
    // =========================================================

    private async Task ToggleDropdown()
    {
        if (Disabled)
            return;


        IsOpen = !IsOpen;


        if (IsOpen)
        {
            await RegisterOutsideClick();
        }
        else
        {
            await UnregisterOutsideClick();
        }
    }


    // =========================================================
    // SEARCH
    // =========================================================

    private async Task OnSearchInput(
        ChangeEventArgs e)
    {
        if (Disabled)
            return;


        SearchText =
            e.Value?.ToString() ?? "";


        IsOpen = true;


        await RegisterOutsideClick();
    }


    // =========================================================
    // SELECT ITEM
    // =========================================================

    private async Task SelectItem(
        TItem item)
    {
        if (ValueSelector == null ||
            TextSelector == null)
        {
            return;
        }


        var selectedValue =
            ValueSelector(item);


        Value =
            selectedValue;


        LastValue =
            selectedValue;


        SearchText =
            TextSelector(item);


        IsOpen = false;


        await ValueChanged.InvokeAsync(
            selectedValue);


        await AfterValueChanged.InvokeAsync();


        await UnregisterOutsideClick();
    }


    // =========================================================
    // SELECT ALL
    // =========================================================

    private async Task SelectAll()
    {
        Value =
            AllValue;


        LastValue =
            AllValue;


        SearchText =
            "";


        IsOpen = false;


        await ValueChanged.InvokeAsync(
            AllValue);


        await AfterValueChanged.InvokeAsync();


        await UnregisterOutsideClick();
    }


    // =========================================================
    // JS MODULE
    // =========================================================

    private async Task EnsureJsModule()
    {
        if (JsModule is not null)
            return;


        JsModule =
            await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./Components/SearchableSelect.razor.js");
    }


    // =========================================================
    // REGISTER OUTSIDE CLICK
    // =========================================================

    private async Task RegisterOutsideClick()
    {
        await EnsureJsModule();


        DotNetReference ??=
            DotNetObjectReference.Create(this);


        await JsModule!.InvokeVoidAsync(
            "register",
            DotNetReference,
            SelectElement);
    }


    // =========================================================
    // UNREGISTER OUTSIDE CLICK
    // =========================================================

    private async Task UnregisterOutsideClick()
    {
        try
        {
            if (JsModule is not null)
            {
                await JsModule.InvokeVoidAsync(
                    "unregister",
                    DotNetReference,
                    SelectElement);
            }
        }
        catch
        {
            // Ignore JS errors during disposal
        }
    }


    // =========================================================
    // CLOSE FROM JS
    // =========================================================

    [JSInvokable]
    public Task CloseDropdown()
    {
        if (IsOpen)
        {
            IsOpen = false;

            StateHasChanged();
        }


        return Task.CompletedTask;
    }


    // =========================================================
    // DISPOSE
    // =========================================================

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (JsModule is not null)
            {
                await JsModule.InvokeVoidAsync(
                    "unregister",
                    DotNetReference,
                    SelectElement);


                await JsModule.DisposeAsync();
            }
        }
        catch
        {
            // Ignore JS errors during disposal
        }


        DotNetReference?.Dispose();
    }
}